pe":"text","text":" them from a Credential Offer (OpenID4VCI 1.0, HAIP 1.0),"},{"type":"text","text":" "},{"type":"text","text":"with the authorization code or the pre-authorized code grant, deferred"},{"type":"text","text":" "},{"type":"text","text":"issuance, batches of copies and refresh."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Presenting","type":"text"}],"type":"strong"},{"text":" them in answer to an ","type":"text"},{"type":"codeVoice","code":"openid4vp:\/\/"},{"text":" request","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VP 1.0, HAIP 1.0), to Safari’s Digital Credentials API as an","type":"text"},{"text":" ","type":"text"},{"text":"iOS document provider (","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":", ISO\/IEC TS 18013-7), and in"},{"text":" ","type":"text"},{"text":"person over Bluetooth (ISO\/IEC 18013-5), where the app can also be the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"reader."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The protocols run in OID4VCgo’s Go code, compiled into the ","type":"text"},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":" "},{"type":"text","text":"framework this package links: every network request, every protocol"},{"type":"text","text":" "},{"type":"text","text":"message and every check on what comes back. Your app supplies the"},{"type":"text","text":" "},{"type":"text","text":"platform, through three protocols: a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true},{"type":"text","text":" whose keys never leave"},{"type":"text","text":" "},{"type":"text","text":"the Secure Enclave, a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","isActive":true},{"text":" under the device’s data","type":"text"},{"type":"text","text":" "},{"type":"text","text":"protection, and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"},{"type":"text","text":" that attests the wallet. It also"},{"type":"text","text":" "},{"type":"text","text":"owns the UI: every session stops where the holder needs to decide."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OID4VCgo is OpenID Certified for the OpenID4VCI and OpenID4VP wallet"},{"type":"text","text":" "},{"type":"text","text":"roles under HAIP, over links. The Digital Credentials API and in-person"},{"type":"text","text":" "},{"type":"text","text":"presentation aren’t covered by that certification."}]},{"type":"paragraph","inlineContent":[{"text":"Start with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","type":"reference"},{"text":", then the article for each task.","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"url":"\/documentation\/oid4vcwallet\/gettingstarted","title":"Getting started","abstract":[{"text":"Add the package, give the wallet its keys, its storage and a Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Provider, and create it at launch.","type":"text"}],"role":"article","kind":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyAgreementUnsupported":{"kind":"symbol","abstract":[{"type":"text","text":"A key that can’t agree keys: the wallet signs instead of using a MAC."}],"url":"\/documentation\/oid4vcwallet\/keyagreementunsupported","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyAgreementUnsupported","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyA