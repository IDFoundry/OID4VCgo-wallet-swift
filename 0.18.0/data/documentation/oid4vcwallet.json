ter (OpenID4VCI 1.0 §9). It’s"},{"type":"text","text":" "},{"type":"text","text":"kept in the credential store until it’s issued, denied or abandoned,"},{"type":"text","text":" "},{"type":"text","text":"so it survives the app quitting."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","title":"DeferredCredential","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/deferredcredential"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"url":"\/documentation\/oid4vcwallet\/issuance","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"Receives one offer’s credentials: show ","type":"text"},{"type":"codeVoice","code":"offer"},{"text":"; then","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":", open the URL in ASWebAuthenticationSession and"},{"type":"text","text":" "},{"type":"codeVoice","code":"completeAuthorization(redirect:)"},{"type":"text","text":", or "},{"code":"redeemPreAuthorizedCode(pin:)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"code":"requestCredentials()","type":"codeVoice"},{"type":"text","text":"; "},{"code":"close()","type":"codeVoice"},{"type":"text","text":" when done."}],"title":"Issuance","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issuance"}],"navigatorTitle":[{"kind":"identifier","text":"Issuance"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Logo":{"type":"topic","kind":"symbol","title":"Logo","url":"\/documentation\/oid4vcwallet\/logo","abstract"