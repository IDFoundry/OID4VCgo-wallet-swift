documentation\/OID4VCWallet\/PresentingInPerson","type":"topic","abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,","type":"text"},{"text":" ","type":"text"},{"text":"with ISO\/IEC 18013-5 device retrieval.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"title":"inAppGroup(_:options:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inAppGroup"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Options","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"FileCredentialStore","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC"}],"url":"\/documentation\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","abstract":[{"text":"A store in the app group ","type":"text"},{"type":"codeVoice","code":"identifier"},{"text":"’s container","type":"text"},{"text":" ","type":"text"},{"text":"(Library\/Application Support\/credentials there), which the app and","type":"text"},{"text":" ","type":"text"},{"text":"its extensions listing the group in their","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"text":" entitlement share.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/doc