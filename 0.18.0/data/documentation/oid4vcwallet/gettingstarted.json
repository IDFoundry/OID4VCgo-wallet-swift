","kind":"keyword"},{"text":" ","kind":"text"},{"text":"network","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"type":"topic","title":"network"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileCredentialStore","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/filecredentialstore","title":"FileCredentialStore","abstract":[{"text":"A credential store of files: one per credential record, in a directory","type":"text"},{"text":" ","type":"text"},{"text":"of the app’s (Application Support, by default). Records are written","type":"text"},{"text":" ","type":"text"},{"text":"with the given file protection — complete by default: readable only","type":"text"},{"text":" ","type":"text"},{"text":"while the device is unlocked — and kept out of backups by default,","type":"text"},{"text":" ","type":"text"},{"text":"since a credential is useless without its holder key, which is in","type":"text"},{"text":" ","type":"text"},{"text":"this device’s Secure Enclave and can’t be restored elsewhere.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"FileCredentialStore","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"title":"WalletConfiguration","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletConfiguration","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration","role":"symbol","navigatorTitle":[{"text":"WalletConfiguration","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","type":"topic","abstract":[{"text":"NewWallet’s configuration.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"abstract":[{"text":"Tell the holder what went wrong, retry what may succeed, and log what","type":"text"},{"text":" ","type":"text"},{"text":"helps without personal data.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","title":"Handling errors","kind":"article","type":"topic","role":"article","url":"\/documentation\/oid4vcwallet\/handlingerrors"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"abstract":[{"text":"The Keychain access group holder keys are made in, when the","type":"text"},{"text":" ","type":"text"},{"text":"app shares them with an extension — a document provider","type":"text"},{"text":" ","type":"text"},{"text":"presenting credentials, say — that lists the group in its","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","title":"holderAccessGroup","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderAccessGroup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup"},"doc://oid4