letconfiguration\/batchsize","abstract":[{"type":"text","text":"How many copies of each credential to request when an issuer"},{"type":"text","text":" "},{"type":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"type":"text","text":"it’s capped at the issuer’s batch size."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProvider"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","title":"WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WalletProvider"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReader":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityReader"}],"url":"\/documentation\/oid4vcwallet\/proximityreader","title":"ProximityReader","abstract":[{"type":"text","text":"An ISO\/IEC 18013-5 mdoc reader: a verifier asking for an mdoc in"},{"type":"text","text":" "},{"type":"text","text":"person over BLE. It needs no "},{"type":"codeVoice","code":"Wallet"},{"type":"text","text":". The key store holds the"},{"type":"text","text":" "},{"type":"text","text":"reader’s key, "},{"type":"codeVoice","code":"ProximityReaderConfiguration.readerKeyID"},{"type":"text","text":"; none for a"},{"type":"text","text":" "},{"type":"text","text":"reader that doesn’t sign."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ProximityReader"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/tlsPins":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/tlspins","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","type":"topic","role":"symbol","kind":"symbol","title":"tlsPins","abstract":[{"type":"text","text":"Pins hosts’ certificates for the wallet’s own HTTPS requests:"},{"type":"text","text":" "},{"type":"text","text":"host → base64 SHA-256 digests of a certificate’s"},{"type":"text","text":" "},{"type":"text","text":"SubjectPublicKeyInfo, one of which a certificate in the verified"},{"type":"text","text":" "},{"type":"text","text":"chain must have, or the request fails as "},{"type":"codeVoice","code":"tlsPin"},{"type":"text","text":" before anything"},{"type":"text","text":" "},{"type":"text","text":"is sent. A host is a name, or "},{"type":"codeVoice","code":"*."},{"type":"text","text":" and one, matching any name a"},{"type":"text","text":" "},{"type":"text","text":"label below it; not an IP address. Pins add to certificate"},{"type":"text","text":" "},{"type":"text","text":"verification, never replace it: pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},