ce. Keep one"},{"type":"text","text":" "},{"type":"text","text":"wallet process writing it. Every "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true},{"type":"text","text":" over a"},{"type":"text","text":" "},{"type":"text","text":"registry in the same file, in this process, shares its locks, so it"},{"type":"text","text":" "},{"type":"text","text":"registers once and makes its assertions in order however many"},{"type":"text","text":" "},{"type":"text","text":"providers the app makes."}],"type":"topic","title":"FileInstanceRegistry","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileInstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"FileInstanceRegistry"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol","type":"topic","title":"OID4VCWallet","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"role":"collection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileInstanceRegistry/instance()":{"url":"\/documentation\/oid4vcwallet\/fileinstanceregistry\/instance()","title":"instance()","abstract":[],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"instance","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet18RegisteredInstanceV","text":"RegisteredInstance","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oi