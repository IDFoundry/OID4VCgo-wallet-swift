:"text","text":"atomically, so a reader never sees part of it, and kept out of"},{"type":"text","text":" "},{"type":"text","text":"backups: a restored instance ID is useless without its registration"},{"type":"text","text":" "},{"type":"text","text":"key and App Attest key, which never leave this device. Keep one"},{"type":"text","text":" "},{"type":"text","text":"wallet process writing it. Every "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true},{"type":"text","text":" over a"},{"type":"text","text":" "},{"type":"text","text":"registry in the same file, in this process, shares its locks, so it"},{"type":"text","text":" "},{"type":"text","text":"registers once and makes its assertions in order however many"},{"type":"text","text":" "},{"type":"text","text":"providers the app makes."}],"type":"topic","title":"FileInstanceRegistry","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileInstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"FileInstanceRegistry"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol","type":"topic","title":"OID4VCWallet","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"role":"collection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InstanceRegistry":{"url":"\/documentation\/oid4vcwallet\/instanceregistry","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","kind":"symbol","type":"topic","title":"InstanceRegistry","abstract":[{"type":"text","text":"Where "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" keeps the wallet’s registration, so the"},{"type":"text","text":" "},{"type":"text","text":"installation registers once, across launches. An instance ID isn’t a"},{"type":"text","text":" "},{"type":"text","text":"secret — every request naming it is signed with the registration key"},{"type":"text","text":" "},{"type":"text","text":"— but losing it loses the instance: the wallet then registers again,"},{"type":"text","text":" "},{"type":"text","text":"with a new registration key and App Attest key, and the instance keys"},{"type":"text","text":" "},{"type":"text","text":"the lost instance recorded can’t be attested again."},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" keeps it in a file;"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" is for tests. Over either, every"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" in the process registering or asserting for"},{"type":"text","text":" "},{"type":"text","text":"the same registration takes turns; over a registry of another type,"},{"type":"text","text":" "},{"type":"text","text":"a provider takes turns only with itself: keep one provider for it."}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"InstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"InstanceRegistry"}]},"doc://oid4vcwallet.OID4VCWallet/documentatio