xt":"with the authorization code or the pre-authorized code grant, deferred","type":"text"},{"text":" ","type":"text"},{"text":"issuance, batches of copies and refresh.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Presenting"}],"type":"strong"},{"text":" them in answer to an ","type":"text"},{"code":"openid4vp:\/\/","type":"codeVoice"},{"text":" request","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VP 1.0, HAIP 1.0), to Safari’s Digital Credentials API as an","type":"text"},{"text":" ","type":"text"},{"text":"iOS document provider (","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":", ISO\/IEC TS 18013-7), and in","type":"text"},{"text":" ","type":"text"},{"text":"person over Bluetooth (ISO\/IEC 18013-5), where the app can also be the","type":"text"},{"text":" ","type":"text"},{"text":"reader.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The protocols run in OID4VCgo’s Go code, compiled into the "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":" "},{"type":"text","text":"framework this package links: every network request, every protocol"},{"type":"text","text":" "},{"type":"text","text":"message and every check on what comes back. Your app supplies the"},{"type":"text","text":" "},{"type":"text","text":"platform, through three protocols: a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore"},{"type":"text","text":" whose keys never leave"},{"type":"text","text":" "},{"type":"text","text":"the Secure Enclave, a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore"},{"type":"text","text":" under the device’s data"},{"type":"text","text":" "},{"type":"text","text":"protection, and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"},{"type":"text","text":" that attests the wallet. It also"},{"type":"text","text":" "},{"type":"text","text":"owns the UI: every session stops where the holder needs to decide."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"OID4VCgo is OpenID Certified for the OpenID4VCI and OpenID4VP wallet"},{"type":"text","text":" "},{"type":"text","text":"roles under HAIP, over links. The Digital Credentials API and in-person"},{"type":"text","text":" "},{"type":"text","text":"presentation aren’t covered by that certification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Start with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted"},{"type":"text","text":", then the article for each task."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[[]]},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Issuance","kind":"identifier"}],"kind":"symbol","title":"Issuance","url":"\/documentation\/oid4vcwallet\/issuance","navigatorTitle":[{"text":"Issuance","kind":"identifier"}],"abstract":[{"text":"Receives one offer’s credentials: show ","type":"text"},{"code":"offer","type":"codeVoice"},{"text":"; then","type":"text"},{"text":" ","type":"text"},{"code":"beginAuthorization()","type":"codeVoice"},{"text":", open the URL in ASWebAuthenticationSession and","type":"text"},{"text":" ","type":"text"},{"code":"completeAuthorization(redirect:)","type":"codeVoice"},{"type":"text","text":", or "},{"code":"redeemPreAuthorizedCode(pin:)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"code":"requestCredentials()","type":"codeVoice"},{"type":"text","text":"; "},{"code":"close()","type":"codeVoice"},{"type":"text","text":" when done."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialDetail":{"title":"CredentialDetail","url":"\/documentation\/oid4vcwallet\/credentialdetail","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialDetail","abstract":[{"text":"A credential with its claims, for display.","type":"text"}],"navigatorTitle":[{"text":"CredentialDetail","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CredentialDetail","kind":"identifier"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"title":"Offer","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","type":"topic","abstract":[{"text":"What a Credential Offer offers.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Offer"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/offer","navigatorTitle":[{"kind":"identifier","text":"Offer"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityTimeouts":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityTimeouts","kind":"identifier"}],"kind":"symbol","title":"ProximityTimeouts","url":"\/documentation\/oid4vcwallet\/proximitytimeouts","navigatorTitle":[{"text":"ProximityTimeouts","kind":"identifier"}],"abstract":[{"text":"How long an in-person session waits (ISO\/IEC 18013-5 recommends at","type":"text"},{"text":" ","type":"text"},{"text":"least 30 seconds from engagement to the request, §8.2.3, and 300","type":"text"},{"text":" ","type":"text"},{"text":"seconds of inactivity before ending a session, §9.1.1.4).","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4