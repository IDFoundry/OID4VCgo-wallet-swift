re written","type":"text"},{"text":" ","type":"text"},{"text":"with the given file protection — complete by default: readable only","type":"text"},{"text":" ","type":"text"},{"text":"while the device is unlocked — and kept out of backups by default,","type":"text"},{"text":" ","type":"text"},{"text":"since a credential is useless without its holder key, which is in","type":"text"},{"text":" ","type":"text"},{"text":"this device’s Secure Enclave and can’t be restored elsewhere.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileCredentialStore"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/filecredentialstore","navigatorTitle":[{"kind":"identifier","text":"FileCredentialStore"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"kind":"symbol","title":"holderAccessGroup","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"type":"topic","role":"symbol","identifier":"doc:\/\