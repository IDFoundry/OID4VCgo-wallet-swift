vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"],"anchor":"Essentials"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"HttpWalletProvider","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"],"kind":"mentions"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The installation registers once, at its first Wallet Attestation:","type":"text"},{"text":" ","type":"text"},{"text":"over a ","type":"text"},{"type":"codeVoice","code":"registration"},{"text":" challenge, it makes a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"registration key","type":"text"}]},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"key store of its own ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","isActive":true},{"type":"text","text":") and an App Attest"},{"type":"text","text":" "},{"type":"text","text":"key, has Apple attest the App Attest key over the client data"},{"type":"text","text":" "},{"type":"text","text":"naming the registration key, registers both ("},{"type":"codeVoice","code":"POST \/v1\/instances"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and keeps the instance ID and the two keys’ IDs in its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","isActive":true},{"type":"text","text":". The registration key signs every later"},{"type":"text","text":" "},{"type":"text","text":"request ("},{"type":"codeVoice","code":"Wallet-Provider-Request"},{"type":"text","text":"); no attestation names it. If"},{"type":"text","text":" "},{"type":"text","text":"the registration, its key or the App Attest key is lost, the next"},{"type":"text","text":" "},{"type":"text","text":"Wallet Attestation registers again, with new keys. An App Attest"},{"type":"text","text":" "},{"type":"text","text":"key a registration made but couldn’t register — App Attest’s"},{"type":"text","text":" "},{"type":"text","text":"server or the provider unavailable, or no connection — is kept, in"},{"type":"text","text":" "},{"type":"text","text":"this process, and tried again by the next registration, as Apple"},{"type":"text","text":" "},{"type":"text","text":"asks; it’s dropped when the provider or App Attest refuses it."}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)"},{"type":"text","text":" asks for a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the instance key ("},{"type":"codeVoice","code":"instance_key"},{"type":"text","text":"). The first time,"},{"type":"text","text":" "},{"type":"text","text":"it sends an App Attest assertion over a fresh "},{"type":"codeVoice","code":"instance"},{"type":"text","text":" challenge"},{"type":"text","text":" "},{"type":"text","text":"and the key, which the provider records the key with; once it has,"},{"type":"text","text":" "},{"type":"text","text":"the key alone — and the assertion again if the provider no longer"},{"type":"text","text":" "},{"type":"text","text":"has its record ("},{"type":"codeVoice","code":"evidence_required"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","type":"reference"},{"text":" asks for a Key","type":"text"},{"text":" ","type":"text"},{"text":"Attestation over the holder keys, with one assertion over a","type":"text"},{"text":" ","type":"text"},{"code":"holder","type":"codeVoice"},{"text":" challenge and all of them, for the issuance of its","type":"text"},{"text":" ","type":"text"},{"text":"instance key, which a Wallet Attestation recorded.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"App Attest attests the app, not the wallet’s keys: the provider"},{"type":"text","text":" "},{"type":"text","text":"learns that a genuine copy of the app on a genuine Apple device asked"},{"type":"text","text":" "},{"type":"text","text":"for them, not where they are. Make them in the Secure Enclave all the"},{"type":"text","text":" "},{"type":"text","text":"same ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true,"type":"reference"},{"type":"text","text":"‘s default). Where App Attest isn’t"},{"type":"text","text":" "},{"type":"text","text":"supported — the Simulator, some older devices — the wallet can’t"},{"type":"text","text":" "},{"type":"text","text":"register, and every attestation fails as "},{"code":".platform","type":"codeVoice"},{"type":"text","text":": there’s no"},{"type":"text","text":" "},{"type":"text","text":"unattested path, in development either. A development build (the"},{"type":"text","text":" "},{"code":"com.apple.developer.devicecheck.appattest-environment","type":"codeVoice"},{"type":"text","text":" entitlement"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"code":"development","type":"codeVoice"},{"type":"text","text":") makes development-environment keys, which only"},{"type":"text","text":" "},{"type":"text","text":"a provider configured for them accepts."}]},{"type":"paragraph","inlineContent":[{"text":"Assertions are made one at a time, each sent before the next is made,","type":"text"},{"text":" ","type":"text"},{"text":"as the provider accepts only an assertion whose counter exceeds the","type":"text"},{"text":" ","type":"text"},{"text":"last it took, and the installation registers once. Every","type":"text"},{"text":" ","type":"text"},{"code":"HttpWalletProvider","type":"codeVoice"},{"text":" over the same ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference"},{"text":" file (or","type":"text"},{"text":" ","type":"text"},{"text":"the same ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference"},{"text":") in the process shares that","type":"text"},{"text":" ","type":"text"},{"text":"order, so a wallet rebuilt mid-issuance with a new provider is still","type":"text"},{"text":" ","type":"text"},{"text":"serialised with the old one. Over a registry of its own type, a","type":"text"},{"text":" ","type":"text"},{"text":"provider serialises only its own calls: keep one provider for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It sends nothing but to its base URL, over https, following no"},{"type":"text","text":" "},{"type":"text","text":"redirect, with its timeout for each request, and reads at most"},{"type":"text","text":" "},{"type":"text","text":"256 KiB of an answer. It checks a Wallet Attestation is for the"},{"type":"text","text":" "},{"type":"text","text":"client and the instance key, and a Key Attestation is over the nonce"},{"type":"text","text":" "},{"type":"text","text":"sent and attests only keys sent; their signatures are the issuer’s to"},{"type":"text","text":" "},{"type":"text","text":"verify."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Failures reach the wallet as "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":"s: one the network or the"},{"type":"text","text":" "},{"type":"text","text":"provider’s availability caused (no connection, a timeout, HTTP 5xx or"},{"type":"text","text":" "},{"type":"text","text":"429, a challenge that expired before it was used, App Attest’s server"},{"type":"text","text":" "},{"type":"text","text":"unavailable) as "},{"type":"codeVoice","code":".network"},{"type":"text","text":", which may be retried"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","isActive":true},{"type":"text","text":"); a refusal"},{"type":"text","text":" "},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError","type":"reference"},{"text":") as ","type":"text"},{"code":".platform","type":"codeVoice"},{"text":", its ","type":"text"},{"code":"protocolError","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the protocol’s error code (","type":"text"},{"code":"instance_not_active","type":"codeVoice"},{"text":", ","type":"text"},{"code":"instance_revoked","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"invalid_signed_request","type":"codeVoice"},{"text":", …), which ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" explains to","type":"text"},{"text":" ","type":"text"},{"text":"the holder. On ","type":"text"},{"code":"instance_revoked","type":"codeVoice"},{"text":", it forgets the","type":"text"},{"text":" ","type":"text"},{"text":"registration and deletes its registration key: the next Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Attestation registers the installation again. The revoked instance’s","type":"text"},{"text":" ","type":"text"},{"text":"instance keys stay its own (","type":"text"},{"code":"instance_key_registered","type":"codeVoice"},{"text":"), so a","type":"text"},{"text":" ","type":"text"},{"text":"credential whose refresh needs one must be received again. On","type":"text"},{"text":" ","type":"text"},{"code":"instance_not_active","type":"codeVoice"},{"text":" (suspended) it keeps the registration: tell the","type":"text"},{"text":" ","type":"text"},{"text":"holder, as the provider may resume it. A signed request refused as","type":"text"},{"text":" ","type":"text"},{"code":"invalid_signed_request","type":"codeVoice"},{"type":"text","text":" isn’t retried: check the device’s clock, and"},{"type":"text","text":" "},{"type":"text","text":"that the provider still knows the instance."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"OID4VCWallet"}],"title":"HttpWalletProvider","externalID":"s:12OID4VCWallet18HttpWalletProviderC","roleHeading":"Class","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"navigatorTitle":[{"text":"HttpWalletProvider","kind":"identifier"}],"symbolKind":"class"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider"},"abstract":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","isActive":true},{"text":" over the Wallet Provider HTTP protocol, version","type":"text"},{"text":" ","type":"text"},{"text":"1, that OID4VCgo’s ","type":"text"},{"type":"codeVoice","code":"walletprovider.Provider.Handler"},{"text":" serves","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","isActive":true},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"with Apple App Attest (","type":"text"},{"type":"codeVoice","code":"apple-app-attest"},{"text":") as its evidence:","type":"text"}],"kind":"symbol","references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryInstanceRegistry":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"kind":"symbol","title":"InMemoryInstanceRegistry","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"url":"\/documentation\/oid4vcwallet\/inmemoryinstanceregistry","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry"},{"type":"text","text":" in memory, lost when the app quits: for tests."},{"type":"text","text":" "},{"type":"text","text":"Every "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider"},{"type":"text","text":" over the same registry shares its locks."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderUnavailableError":{"role":"symbol","title":"WalletProviderUnavailableError","abstract":[{"text":"The Wallet Provider couldn’t answer — HTTP 5xx or 429 — or the","type":"text"},{"text":" ","type":"text"},{"text":"challenge a request named expired or was used before it arrived","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"invalid_challenge"},{"text":"), or App Attest’s server is unavailable. It","type":"text"},{"text":" ","type":"text"},{"text":"reaches the wallet as ","type":"text"},{"type":"codeVoice","code":".network"},{"text":": try again, which gets new","type":"text"},{"text":" ","type":"text"},{"text":"challenges.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walletproviderunavailableerror","navigatorTitle":[{"text":"WalletProviderUnavailableError","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProviderUnavailableError","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"role":"article","title":"Handling errors","abstract":[{"type":"text","text":"Tell the holder what went wrong, retry what may succeed, and log what"},{"type":"text","text":" "},{"type":"text","text":"helps without personal data."}],"url":"\/documentation\/oid4vcwallet\/handlingerrors","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","kind":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/registrationKeyTagPrefix":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyTagPrefix","abstract":[{"text":"The Keychain tag prefix of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()"},{"text":"‘s keys. The","type":"text"},{"text":" ","type":"text"},{"text":"wallet’s own ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore"},{"text":" mustn’t cover it, as its default","type":"text"},{"text":" ","type":"text"},{"text":"prefix doesn’t: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)"},{"text":" refuses a","type":"text"},{"text":" ","type":"text"},{"text":"store whose prefix covers or falls under it, rather than delete","type":"text"},{"text":" ","type":"text"},{"text":"the registration key.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/registrationkeytagprefix","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registrationKeyTagPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"title":"registrationKeyTagPrefix"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"role":"symbol","title":"KeychainKeyStore","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"text":" ","type":"text"},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"KeychainKeyStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/RegisteredInstance":{"role":"symbol","title":"RegisteredInstance","abstract":[{"type":"text","text":"The wallet’s registration with a Wallet Provider: its registration"},{"type":"text","text":" "},{"type":"text","text":"key, its App Attest key and the instance ID the provider gave for"},{"type":"text","text":" "},{"type":"text","text":"them (WALLET_PROVIDER.md, "},{"type":"codeVoice","code":"POST \/v1\/instances"},{"type":"text","text":"). One per installation."}],"url":"\/documentation\/oid4vcwallet\/registeredinstance","navigatorTitle":[{"kind":"identifier","text":"RegisteredInstance"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegisteredInstance"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"title":"Going to production","abstract":[{"type":"text","text":"What a wallet needs before real holders use it."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","kind":"article","role":"article","url":"\/documentation\/oid4vcwallet\/goingtoproduction","type":"topic"},"https://github.com/IDFoundry/OID4VCgo/blob/main/mobile/WALLET_PROVIDER.md":{"url":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"link","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","titleInlineContent":[{"text":"WALLET_PROVIDER.md","type":"text"}],"title":"WALLET_PROVIDER.md"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"role":"symbol","title":"WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"url":"\/documentation\/oid4vcwallet\/walletprovider","navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"kind":"symbol","title":"HttpWalletProvider","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"topic","rol