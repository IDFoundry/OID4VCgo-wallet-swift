ctive":true},{"type":"text","text":". From OID4VCWallet 0.27.0."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/isNoCurrentCRL"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"title":"WalletProvider","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/walletprovider","role":"symbol","abstract":[{"text":"The Wallet Provider’s backend, which attests the wallet and its keys","type":"text"},{"text":" ","type":"text"},{"text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results","type":"text"},{"text":" ","type":"text"},{"text":"are compact JWTs. A real one attests only after checking platform","type":"text"},{"text":" ","type":"text"},{"text":"evidence (App Attest) that it’s talking to the genuine app.","type":"text"}],"navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"}}}