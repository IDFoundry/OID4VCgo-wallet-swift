{"abstract":[{"type":"text","text":"Replaces the record under "},{"type":"codeVoice","code":"id"},{"type":"text","text":" with "},{"type":"codeVoice","code":"record"},{"type":"text","text":" — or deletes it, when"},{"type":"text","text":" "},{"type":"codeVoice","code":"record"},{"type":"text","text":" is nil — only if what’s stored there is, byte for byte,"},{"type":"text","text":" "},{"type":"codeVoice","code":"expected"},{"type":"text","text":" (nil: no record), and returns what was stored before,"},{"type":"text","text":" "},{"type":"text","text":"whether or not it replaced it."}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/credentialstore\/compareandswap(id:expected:record:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/compareAndSwap(id:expected:record:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compareAndSwap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"expected","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"record","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vc