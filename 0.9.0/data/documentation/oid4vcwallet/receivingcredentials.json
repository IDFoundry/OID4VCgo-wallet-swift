{"sections":[],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"title":"Receiving credentials","anchor":"Receiving-credentials","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An issuer offers credentials with an "},{"type":"codeVoice","code":"openid-credential-offer:\/\/"},{"type":"text","text":" link,"},{"type":"text","text":" "},{"type":"text","text":"as a QR code or a link the holder opens. Register the"},{"type":"text","text":" "},{"type":"codeVoice","code":"openid-credential-offer"},{"type":"text","text":" URL scheme in the app’s Info.plist so links"},{"type":"text","text":" "},{"type":"text","text":"open the app, and hand the link to "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","isActive":true,"type":"reference"},{"type":"text","text":". It"},{"type":"text","text":" "},{"type":"text","text":"resolves the offer and the issuer’s metadata, and returns an"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","isActive":true,"type":"reference"},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","isActive":true,"type":"reference"},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The offer names one of two grants:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authorization code:"}],"type":"strong"},{"text":" the holder signs in at the issuer’s pages, in","type":"text"},{"text":" ","type":"text"},{"text":"a browser, which redirects back to the wallet’s redirect URI.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Pre-authorized code:","type":"text"}],"type":"strong"},{"type":"text","text":" the issuer has already authenticated the"},{"type":"text","text":" "},{"type":"text","text":"holder, and may ask for a PIN it sent them separately"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property"},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Either way, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"type":"text","text":" then requests, checks and"},{"type":"text","text":" "},{"type":"text","text":"stores the credentials, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()"},{"type":"text","text":" ends the issuance."}]},{"type":"heading","level":3,"text":"Receive an offer","anchor":"Receive-an-offer"},{"syntax":"swift","type":"codeListing","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","type":"reference","isActive":true},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"type":"text","text":" "},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}]},{"type":"heading","anchor":"Open-the-issuers-page","text":"Open the issuer’s page","level":3},{"type":"paragraph","inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","isActive":true},{"type":"text","text":" can begin again. A redirect is used"},{"type":"text","text":" "},{"type":"text","text":"up by "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","isActive":true},{"type":"text","text":" whatever happens,"},{"text":" ","type":"text"},{"type":"text","text":"so after a failure there, begin again rather than retrying it."}]},{"type":"heading","level":3,"anchor":"Resume-after-the-app-is-killed","text":"Resume after the app is killed"},{"type":"paragraph","inlineContent":[{"text":"iOS can terminate the app while the holder is at the issuer’s pages.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The authorization in progress is kept in the credential store, so when"},{"type":"text","text":" "},{"type":"text","text":"the redirect arrives at a relaunched app, "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"completes it and returns an issuance ready for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true},{"text":". Handle every redirect this way: in","type":"text"},{"type":"text","text":" "},{"text":"SwiftUI, from ","type":"text"},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":"."}]},{"syntax":"swift","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","type":"reference","isActive":true},{"type":"text","text":"."}]},{"anchor":"Wait-for-a-deferred-credential","level":3,"type":"heading","text":"Wait for a deferred credential"},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","isActive":true,"type":"reference"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","type":"reference"},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","type":"reference"},{"text":").","type":"text"}]},{"level":3,"text":"Look after held credentials","anchor":"Look-after-held-credentials","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()"},{"type":"text","text":" lists them, and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"returns one with its claims, for display. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"carries the issuer’s names, logos and colours, in the holder’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"language ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","isActive":true},{"type":"text","text":" checks revocation against the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"status list, which covers many credentials, so the issuer can’t tell"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}]}]},{"content":[{"inlineContent":[{"text":"Each credential arrives as a batch of copies, each bound to its own","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true},{"text":"), so presentations can’t be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"linked by the credential. When "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reaches zero, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"reference","isActive":true},{"type":"text","text":" replaces them without"},{"type":"text","text":" "},{"type":"text","text":"the holder, if the issuance kept a refresh token"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","type":"reference","isActive":true},{"type":"text","text":"). Otherwise it throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","type":"reference","isActive":true},{"type":"text","text":": receive the credential again."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)"},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"]}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"title":"Receiving credentials","roleHeading":"Article","role":"article"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, checks its"},{"type":"text","text":" "},{"type":"text","text":"signature, and returns the credential with its revocation status"},{"type":"text","text":" "},{"type":"text","text":"recorded. The list covers many credentials, so fetching it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t tell the issuer which one is checked. A credential without"},{"type":"text","text":" "},{"type":"text","text":"a status list is returned as it is."}],"url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","title":"checkStatus(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkStatus"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/display":{"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialDisplayV","text":"CredentialDisplay"},{"kind":"text","text":"?"}],"url":"\/documentation\/oid4vcwallet\/credentialsummary\/display","abstract":[{"text":"How to show it, from the issuer’s metadata when it was received.","type":"text"}],"title":"display","role":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"type":"topic","abstract":[{"text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s","type":"text"},{"text":" ","type":"text"},{"text":"kept in the credential store until it’s issued, denied or abandoned,","type":"text"},{"text":" ","type":"text"},{"text":"so it survives the app quitting.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/deferredcredential","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","title":"DeferredCredential","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/resumeIssuance(redirect:)":{"type":"topic","title":"resumeIssuance(redirect:)","abstract":[{"type":"text","text":"Completes an authorization begun before the app was suspended or"},{"type":"text","text":" "},{"type":"text","text":"relaunched: "},{"type":"codeVoice","code":"redirect"},{"type":"text","text":" is the issuer’s redirect back to the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI, delivered to the app ("},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":"). Returns the"},{"type":"text","text":" "},{"type":"text","text":"issuance ready for "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":". A redirect matching no"},{"type":"text","text":" "},{"type":"text","text":"authorization in progress — not this wallet’s, already completed,"},{"type":"text","text":" "},{"type":"text","text":"or expired — throws "},{"type":"codeVoice","code":".notFound"},{"type":"text","text":"."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resumeIssuance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Issuance","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet8IssuanceC"}],"role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Replaces a "},{"code":"refreshable","type":"codeVoice"},{"type":"text","text":" credential’s copies with a fresh batch,"},{"type":"text","text":" "},{"type":"text","text":"each bound to a new attested key, without the holder (OpenID4VCI"},{"type":"text","text":" "},{"type":"text","text":"1.0 §13.5). Use it when "},{"code":"copiesLeft","type":"codeVoice"},{"type":"text","text":" runs low. Throws"},{"type":"text","text":" "},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"type":"text","text":" when it can’t be refreshed:"},{"type":"text","text":" "},{"type":"text","text":"receive it again from a new offer."}],"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","title":"refreshCredential(id:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","kind":"typeIdentifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/offer":{"type":"topic","title":"offer","abstract":[{"type":"text","text":"What’s offered: show it before going on."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","url":"\/documentation\/oid4vcwallet\/issuance\/offer","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"offer"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12OID4VCWallet5OfferV","kind":"typeIdentifier","text":"Offer"}],"role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer/txCode-swift.property":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The PIN to ask the holder for, for a pre-authorized code offer."}],"url":"\/documentation\/oid4vcwallet\/offer\/txcode-swift.property","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","title":"txCode","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"txCode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TxCode","preciseIdentifier":"s:12OID4VCWallet5OfferV6TxCodeV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/abandonDeferred(id:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"abandonDeferred"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"url":"\/documentation\/oid4vcwallet\/