ame a"},{"type":"text","text":" "},{"type":"text","text":"label below it; not an IP address. Pins add to certificate"},{"type":"text","text":" "},{"type":"text","text":"verification, never replace it: pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},{"type":"text","text":"doesn’t break the app, and keep a backup pin. They cover the"},{"type":"text","text":" "},{"type":"text","text":"requests the SDK makes (issuers, Authorization Servers,"},{"type":"text","text":" "},{"type":"text","text":"Verifiers, status lists), not the app’s own, such as to its"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider: pin that client yourself."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/tlspins","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tlsPins","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]]","kind":"text"}],"role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryCredentialStore":{"kind":"symbol","title":"InMemoryCredentialStore","abstract":[{"type":"text","text":"A credential store in memory, for tests and development."}],"navigatorTitle":[{"text":"InMemoryCredentialStore","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryCredentialStore","url":"\/documentation\/oid4vcwallet\/inmemorycredentialstore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryCredentialStore","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requestRefresh":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","k