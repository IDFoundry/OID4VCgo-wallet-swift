{"kind":"symbol","metadata":{"roleHeading":"Framework","symbolKind":"module","title":"OID4VCWallet","role":"collection","externalID":"OID4VCWallet","modules":[{"name":"OID4VCWallet"}]},"abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"OID4VCWallet is the wallet side of "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"for iOS 16 and macOS 13 and later. It handles SD-JWT VC and ISO mdoc"},{"type":"text","text":" "},{"type":"text","text":"credentials:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Receiving"}]},{"type":"text","text":" them from a Credential Offer (OpenID4VCI 1.0, HAIP 1.0),"},{"type":"text","text":" "},{"type":"text","text":"with the authorization code or the pre-authorized code grant, deferred"},{"type":"text","text":" "},{"type":"text","text":"issuance, batches of copies and refresh."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Presenting","type":"text"}]},{"type":"text","text":" them in answer to an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" request"},{"type":"text","text":" "},{"type":"text","text":"(OpenID4VP 1.0, HAIP 1.0), to Safari’s Digital Credentials API as an"},{"type":"text","text":" "},{"type":"text","tex