odeVoice","code":"invalidInput"},{"text":") (from","type":"text"},{"text":" ","type":"text"},{"text":"OID4VCWallet 0.44.0).","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maxAgeSeconds","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","type":"topic","title":"maxAgeSeconds"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/StatusLists/identifierListMaxBytes":{"type":"topic","url":"\/documentation\/oid4vcwallet\/statuslists\/identifierlistmaxbytes","abstract":[{"type":"text","text":"The largest mdoc identifier list "},{"code":"checkStatus","type":"codeVoice"},{"type":"text","text":" reads, in bytes; 0"},{"type":"text","text":" "},{"type":"text","text":"means 4 MiB."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"identifierListMaxBytes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"identifierListMaxBytes","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/StatusLists\/identifierListMaxBytes","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/StatusLists/cacheDir":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/StatusLists\/cacheDir","role":"symbol","url":"\/documentation\/oid4vcwallet\/statuslists\/cachedir","abstract":[{"type":"text","text":"Where "},{"type":"codeVoice","code":"checkStatus"},{"type":"text","text":" keeps the lists it verified across launches: a"},{"type":"text","text":" "},{"type":"text","text":"launch then asks each list’s server whether the list it kept is"},{"type":"text","text":" "},{"type":"text","text":"current, a "},{"type":"codeVoice","code":"304 Not Modified"},{"type":"text","text":" rather than the list, and never uses"},{"type":"text","text":" "},{"type":"text","text":"one the server hasn’t confirmed. The lists are authenticated with"},{"type":"text","text":" "},{"type":"text","text":"a key the library makes and keeps in the Keychain, so one anyone"},{"type":"text","text":" "},{"type":"text","text":"else wrote to the directory is dropped. Nil, the default, keeps"},{"type":"text","text":" "},{"type":"text","text":"them in "},{"type":"codeVoice","code":"oid4vcwallet-status-lists"},{"type":"text","text":" in the app’s Caches directory,"},{"type":"text","text":" "},{"type":"text","text":"with complete file protection, or in memory only when that key"},{"type":"text","text":" "},{"type":"text","text":"can’t be had or the directory made, and on macOS; an absolute"},{"type":"text","text":" "},{"type":"text","text":"path, the app’s own, keeps them there, with the protection the"},{"type":"text","text":" "},{"type":"text","text":"app gives it; empty keeps them in memory only. The directory shows"},{"type":"text","text":" "},{"type":"text","text":"whoever can read it which status lists the wallet checks (their"},{"type":"text","text":" "},{"type":"text","text":"URIs, so the issuers of its credentials, not which entries), the"},{"type":"text","text":" "},{"type":"text","text":"lists themselves, and when each was last checked. A check while"},{"type":"text","text":" "},{"type":"text","text":"the device is locked can’t read this directory under complete"},{"type":"text","text":" "},{"type":"text","text":"protection, and with "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","type":"reference","isActive":true},{"type":"text","text":"‘s default complete"},{"type":"text","text":" "},{"type":"text","text":"protection it can’t read the credential either: it fails as"},{"type":"text","text":" "},{"code":".platform","type":"codeVoice"},{"type":"text","text":". Check status when the app comes to the foreground."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cac