t\/ProximityPresentation\/respond(answers:)","type":"reference"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)"},{"text":") asks once: its holder","type":"text"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","title":"holderUserPresence"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/sweepOrphanedRegistrationKeys()":{"abstract":[{"text":"Deletes every key in the registration key store but the kept","type":"text"},{"text":" ","type":"text"},{"text":"registration’s, and returns how many it deleted: the keys of","type":"text"},{"text":" ","type":"text"},{"text":"registrations that never finished — the app ended in the middle","type":"text"},{"text":" ","type":"text"},{"text":"of one, or was deleted and installed again, which keeps its","type":"text"},{"text":" ","type":"text"},{"text":"Keychain items but not its registry — which nothing else","type":"text"},{"text":" ","type":"text"},{"text":"deletes. Call it at launch. It takes its turn with registrations","type":"text"},{"text":" ","type":"text"},{"text":"over the same registry, so it never deletes the key of one in","type":"text"},{"text":" ","type":"text"},{"text":"progress.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/sweepOrphanedRegi