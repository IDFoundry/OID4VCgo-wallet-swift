{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"anchor":"Presenting-to-Safari","generated":true,"title":"Presenting to Safari"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C","type":"text"},{"text":" ","type":"text"},{"text":"Digital Credentials API, using the ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" protocol (ISO\/IEC TS","type":"text"},{"text":" ","type":"text"},{"text":"18013-7 Annex C). iOS offers the apps that registered a matching","type":"text"},{"text":" ","type":"text"},{"text":"document, and shows the chosen app’s document provider extension for","type":"text"},{"text":" ","type":"text"},{"text":"the holder’s consent. The extension answers through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(shown:readerCertificate:)"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"response goes back through Safari, encrypted to the page, with no","type":"text"},{"text":" ","type":"text"},{"text":"network request from the wallet.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Safari sends only "},{"code":"org-iso-mdoc","type":"codeVoice"},{"type":"text","text":", not OpenID4VP, and on iOS only:"},{"type":"text","text":" "},{"type":"text","text":"Safari on macOS has no document providers."}],"type":"paragraph"},{"text":"Set up the app and its extension","level":3,"anchor":"Set-up-the-app-and-its-extension","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The extension:"}]},{"text":" a target whose Info.plist names the extension","type":"text"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"code":"com.apple.identity-document-services.document-provider-ui","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EXAppExtensionAttributes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EXExtensionPointIdentifier","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The capability:"}]},{"type":"text","text":" Digital Credentials API – Mobile Document"},{"type":"text","text":" "},{"type":"text","text":"Provider, on both the app’s and the extension’s App IDs, with the"},{"type":"text","text":" "},{"text":"doctypes the app presents in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types"},{"type":"text","text":" "},{"type":"text","text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL"},{"type":"text","text":" "},{"type":"text","text":"and Photo ID."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared storage:"}]},{"type":"text","text":" the extension is another process, so the app"},{"type":"text","text":" "},{"type":"text","text":"keeps its credentials in an App Group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true},{"type":"text","text":"), and its holder keys in"},{"type":"text","text":" "},{"type":"text","text":"a Keychain access group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true},{"type":"text","text":"). Instance and DPoP"},{"type":"text","text":" "},{"type":"text","text":"keys, and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true},{"type":"text","text":"‘s registration key, stay in the"},{"type":"text","text":" "},{"type":"text","text":"app’s default group: the extension presents, but doesn’t receive."},{"type":"text","text":" "},{"type":"text","text":"The default group is the first in the app’s "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" "},{"type":"text","text":"entitlement, so list a group only the app has first and the shared"},{"text":" ","type":"text"},{"text":"group after it; listed first, the shared group becomes the default,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and those keys land where the extension can use them. The app saves"},{"type":"text","text":" "},{"type":"text","text":"its configuration where the extension can read it too."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wallet that starts on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/standard(options:)"},{"type":"text","text":" "},{"type":"text","text":"and the default "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore"},{"type":"text","text":" and adds the extension later"},{"type":"text","text":" "},{"type":"text","text":"can’t hand the extension what it already holds: its credentials are"},{"type":"text","text":" "},{"type":"text","text":"bound to holder keys in the app’s own group, and the package has no"},{"type":"text","text":" "},{"type":"text","text":"call that moves credentials or keys to the shared ones. Its holder"},{"type":"text","text":" "},{"type":"text","text":"would receive each credential again. If the app may ever present to"},{"type":"text","text":" "},{"type":"text","text":"Safari, start on the App Group store and the shared holder key group"},{"type":"text","text":" "},{"type":"text","text":"from its first release."}]},{"type":"codeListing","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.wallet<\/string>        <!-- the app's own: the default -->","    <string>$(AppIdentifierPrefix)com.example.wallet.shared<\/string> <!-- shared with the extension -->","<\/array>"],"syntax":null}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"type":"heading","level":3,"text":"Register the documents","anchor":"Register-the-documents"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS offers the app only for documents it registered. Whenever the"},{"type":"text","text":" "},{"type":"text","text":"credentials change — and after status checks, which can make one"},{"type":"text","text":" "},{"type":"text","text":"unpresentable — register each presentable mdoc and remove the rest."},{"type":"text","text":" "},{"type":"codeVoice","code":"supportedAuthorityKeyIdentifiers"},{"type":"text","text":" names the reader CAs, by subject key"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}]},{"code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    \/\/ Presentable: unexpired, not found revoked or suspended, and its key still here.","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\")","        && credential.presentable && credential.holderKeyPresent != false {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Answer-in-the-extension","type":"heading","text":"Answer in the extension","level":3},{"inlineContent":[{"type":"text","text":"iOS hands the extension the request in two stages. First,"},{"type":"text","text":" "},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.request"},{"type":"text","text":" describes what’s asked,"},{"type":"text","text":" "},{"type":"text","text":"for the consent screen: show it with the website’s origin, and the"},{"type":"text","text":" "},{"type":"text","text":"candidates from "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","isActive":true},{"type":"text","text":". Only when the"},{"type":"text","text":" "},{"type":"text","text":"holder shares does iOS release the request itself, to"},{"type":"text","text":" "},{"type":"codeVoice","code":"sendResponse"},{"type":"text","text":"‘s closure. Validate it there, parse it, check it’s what"},{"type":"text","text":" "},{"type":"text","text":"the holder was shown, and answer."}],"type":"paragraph"},{"code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","    @State private var problem: String?","    \/\/\/ The one wallet this request uses, opened when the screen appears.","    @State private var wallet: Wallet?","    \/\/\/ The candidate shared, from `Wallet.mdocCandidates(origin:)`.","    @State private var chosen: CredentialSummary?","","    \/\/\/ The request's first document as iOS parsed it: what the consent","    \/\/\/ screen shows the holder.","    private var shown: (doctype: String, elements: [MdocPresentation.Element])? {","        guard let document = context.request.presentmentRequests.first?.documentRequestSets.first?.requests.first else {","            return nil","        }","        let elements = document.namespaces.flatMap { namespace, elements in","            elements.map { MdocPresentation.Element(namespace: namespace, identifier: $0.key, retain: $0.value.isRetaining) }","        }","        return (document.documentType, elements)","    }","","    var body: some View {","        VStack(alignment: .leading) {","            \/\/ Who asks, and exactly what `share()` answers: the","            \/\/ response is bound to these elements, so the holder must","            \/\/ see each one, and whether the website says it keeps it.","            Text(\"\\(context.requestingWebsiteOrigin?.absoluteString ?? \"An unknown website\") asks for:\")","            if let shown {","                Text(shown.doctype)","                ForEach(Array(shown.elements.enumerated()), id: \\.offset) { _, element in","                    Text(element.retain ? \"\\(element.identifier) (the website will keep it)\" : element.identifier)","                }","            }","            if let problem { Text(problem) }","            if chosen?.linkableHere == true { Text(\"This website could link this to another.\") }","            Button(\"Share\") { Task { await share() } }.disabled(chosen == nil)","            Button(\"Cancel\") { context.cancel() }","        }","        .task {","            guard let shown, let originURL = context.requestingWebsiteOrigin,","                  let origin = MdocPresentation.origin(of: originURL) else { return }","            do {","                let opened = try SharedWallet.open(provider: nil)","                wallet = opened","                \/\/ Every held mdoc is a candidate, an expired or revoked","                \/\/ one too: offer only one that can be presented.","                chosen = try await opened.mdocCandidates(origin: origin)","                    .first { $0.doctype == shown.doctype && $0.presentable }","            } catch {","                problem = \"Can't read the wallet: \\(error)\"","            }","        }","    }","","    \/\/\/ Shares the chosen mdoc, for exactly the document and elements the","    \/\/\/ holder was shown.","    func share() async {","        guard let shown, let chosen, let wallet, let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let agreed = MdocPresentation.Shown(doctype: shown.doctype, elements: shown.elements,","                                            credentialID: chosen.id, toldLinkable: chosen.linkableHere == true)","        do {","            try await context.sendResponse { raw in","                _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                    .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","                let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","                \/\/ Answer only what the holder was shown, or throw","                \/\/ RequestChanged. The holder key signs now: Face ID, if","                \/\/ the key store asks.","                let response = try await presentation.respond(shown: [agreed], readerCertificate: nil)","                return ISO18013MobileDocumentResponse(responseData: response.response)","            }","        } catch {","            \/\/ Nothing was shared: say so, and let the holder cancel.","            problem = \"Not shared: \\(error)\"","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(shown:readerCertificate:)"},{"type":"text","text":" answers the"},{"type":"text","text":" "},{"type":"text","text":"elements the holder was shown, not those the released request names,"},{"type":"text","text":" "},{"type":"text","text":"and refuses, with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/RequestChanged"},{"type":"text","text":", a request that"},{"type":"text","text":" "},{"type":"text","text":"changed in between: a shown document no longer asked for, or asked for"},{"type":"text","text":" "},{"type":"text","text":"with other elements; a chosen credential that no longer answers it; or"},{"type":"text","text":" "},{"type":"text","text":"one that became linkable here when the holder wasn’t told"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Shown\/toldLinkable","isActive":true,"type":"reference"},{"type":"text","text":"). Where the consent screen"},{"type":"text","text":" "},{"type":"text","text":"names the reader (below), pass that reader’s certificate as"},{"type":"text","text":" "},{"code":"readerCertificate","type":"codeVoice"},{"type":"text","text":", and a request signed by any other is refused too."},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/answers(for:readerCertificate:)","isActive":true,"type":"reference"},{"type":"text","text":" makes the"},{"type":"text","text":" "},{"type":"text","text":"same check without answering. The demo wallet’s "},{"code":"DocumentProvider","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"target does all of this, with several documents, a choice of"},{"type":"text","text":" "},{"type":"text","text":"credential and a linkability warning."}],"type":"paragraph"},{"level":3,"anchor":"Name-the-reader","type":"heading","text":"Name the reader"},{"type":"paragraph","inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/VerifierTrust\/mdocReaderRoots","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/VerifierTrust\/mdocReaderRequireEKU","isActive":true,"type":"reference"},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"issued for readers, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/VerifierTrust\/requireTrustedMdocReader"},{"type":"text","text":" "},{"type":"text","text":"refuses requests from any other reader before the holder sees them."}]},{"type":"heading","text":"Warn of linkable presentations","anchor":"Warn-of-linkable-presentations","level":3},{"type":"paragraph","inlineContent":[{"text":"Each candidate’s ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true,"type":"reference"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true,"type":"reference"},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"]}],"metadata":{"role":"article","title":"Presenting to Safari","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article"},"kind":"article","sections":[],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocCandidates","kind":"identifier"},{"text":"(","kind":"text"},{"text":"origin","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary","kind":"typeIdentifier"},{"kind":"text","text":"]"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The held mdocs, each with whether the page at "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" has been"},{"type":"text","text":" "},{"type":"text","text":"shown it and whether presenting it there now would be linkable"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"shownToVerifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"linkableHere"},{"type":"text","text":"): for a document provider’s"},{"type":"text","text":" "},{"type":"text","text":"consent screen, shown before iOS releases the request itself."},{"type":"text","text":" "},{"type":"codeVoice","code":"MdocPresentation.request"},{"type":"text","text":" says the same once it has. Every held"},{"type":"text","text":" "},{"type":"text","text":"mdoc is listed, an expired, revoked or suspended one too: offer the"},{"type":"text","text":" "},{"type":"text","text":"holder only those whose "},{"type":"codeVoice","code":"presentable"},{"type":"text","text":" is true."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","role":"symbol","title":"mdocCandidates(origin:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider":{"abstract":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"},{"text":" over the Wallet Provider HTTP protocol, version","type":"text"},{"text":" ","type":"text"},{"text":"1, that OID4VCgo’s ","type":"text"},{"code":"walletprovider.Provider.Handler","type":"codeVoice"},{"text":" serves","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"with Apple App Attest (","type":"text"},{"code":"apple-app-attest","type":"codeVoice"},{"text":") as its evidence:","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","k