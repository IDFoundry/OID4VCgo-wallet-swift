{"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"anchor":"Essentials","title":"Essentials"}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"title":"Getting started","roleHeading":"Article","role":"article","modules":[{"name":"OID4VCWallet"}]},"kind":"article","abstract":[{"type":"text","text":"Add the package, give the wallet its keys, its storage and a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Provider, and create it at launch."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},{"type":"text","text":" needs four things from your app: its configuration, a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore"},{"type":"text","text":" for its keys, a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore"},{"type":"text","text":" for what it holds, and a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"},{"type":"text","text":" that attests it to issuers. The package has standard"},{"type":"text","text":" "},{"type":"text","text":"stores for the first two; the Wallet Provider is your backend."}]},{"level":3,"type":"heading","text":"Add the package","anchor":"Add-the-package"},{"type":"paragraph","inlineContent":[{"text":"Add OID4VCWallet to your app with Swift Package Manager, from","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift"},{"text":", at the release","type":"text"},{"text":" ","type":"text"},{"text":"whose documentation you’re reading. In ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":null,"code":[".package(url: \"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift\", from: \"<version>\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package links a binary framework, "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", which SwiftPM checks"},{"type":"text","text":" "},{"type":"text","text":"against the checksum in the package’s manifest."}]},{"level":3,"type":"heading","text":"Register the wallet","anchor":"Register-the-wallet"},{"type":"paragraph","inlineContent":[{"text":"Issuers’ Authorization Servers know the wallet as an OAuth client: a","type":"text"},{"text":" ","type":"text"},{"text":"client ID, and a redirect URI the app opens when the holder returns from","type":"text"},{"text":" ","type":"text"},{"text":"the issuer’s pages. Register a private-use URI scheme for it, in the","type":"text"},{"text":" ","type":"text"},{"text":"app’s Info.plist (","type":"text"},{"code":"CFBundleURLTypes","type":"codeVoice"},{"text":"), and pass the URL the app receives","type":"text"},{"text":" ","type":"text"},{"text":"to the issuance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet trusts only what chains to the roots you give it, as PEM"},{"type":"text","text":" "},{"type":"text","text":"certificates: "},{"code":"issuerRoots","type":"codeVoice"},{"type":"text","text":" for credentials, and "},{"code":"verifierRoots","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the Verifiers it answers. A Credential Offer’s issuer isn’t trusted just"},{"type":"text","text":" "},{"type":"text","text":"because it sent the offer."}]},{"type":"heading","anchor":"Provide-the-keys-and-the-storage","level":3,"text":"Provide the keys and the storage"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true},{"type":"text","text":" keeps every key in the Secure Enclave. A holder"},{"type":"text","text":" "},{"type":"text","text":"key — the one a credential copy is bound to — signs when presenting, and"},{"type":"text","text":" "},{"type":"text","text":"the Credential Request’s proof when receiving or refreshing. By default"},{"type":"text","text":" "},{"type":"text","text":"it asks for Face ID, Touch ID or the passcode each time: add an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"text":" to the app’s Info.plist, or iOS asks for the","type":"text"},{"text":" ","type":"text"},{"text":"passcode instead. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","type":"reference","isActive":true},{"text":" describes the trade-off.","type":"text"}]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore"},{"text":" keeps each credential as a file with complete","type":"text"},{"text":" ","type":"text"},{"text":"data protection, out of backups: a credential is useless without its","type":"text"},{"text":" ","type":"text"},{"text":"holder key, which can’t leave this device. An app with a document","type":"text"},{"text":" ","type":"text"},{"text":"provider extension keeps both in places the extension can read too; see","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup"},{"text":". The app and the","type":"text"},{"text":" ","type":"text"},{"text":"extension then share one store: a store of your own implements","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/compareAndSwap(id:expected:record:)"},{"text":" atomically","type":"text"},{"text":" ","type":"text"},{"text":"across both processes, as ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore"},{"text":" does with a file","type":"text"},{"text":" ","type":"text"},{"text":"lock.","type":"text"}],"type":"paragraph"},{"text":"Implement the Wallet Provider","type":"heading","level":3,"anchor":"Implement-the-Wallet-Provider"},{"inlineContent":[{"type":"text","text":"Issuers following HAIP accept only a wallet its Wallet Provider has"},{"type":"text","text":" "},{"type":"text","text":"attested: a Wallet Attestation for the wallet’s instance key, and a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the keys a credential will be bound to. Your backend"},{"type":"text","text":" "},{"type":"text","text":"issues them; the app passes the keys and returns its answers. A Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation request also names the issuance’s instance key, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"walletAttestation"},{"type":"text","text":" attested first, so your backend can give the Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation that key’s status. A real Wallet Provider attests only"},{"type":"text","text":" "},{"type":"text","text":"after checking App Attest evidence that it’s talking to your genuine"},{"type":"text","text":" "},{"type":"text","text":"app."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import OID4VCWallet","","\/\/\/ Asks the app's backend for attestations. The keys are public JWKs,","\/\/\/ as JSON; the answers are compact JWTs.","struct BackendWalletProvider: WalletProvider {","    let backend: URL","","    func walletAttestation(clientID: String, instanceKey: Data) async throws -> String {","        try await post(\"wallet-attestation\", [","            \"client_id\": clientID,","            \"instance_key\": try JSONSerialization.jsonObject(with: instanceKey),","        ])","    }","","    \/\/ instanceKey is the issuance's, which walletAttestation sent first.","    func keyAttestation(instanceKey: Data, keys: [Data], nonce: String) async throws -> String {","        try await post(\"key-attestation\", [","            \"instance_key\": try JSONSerialization.jsonObject(with: instanceKey),","            \"keys\": try keys.map { try JSONSerialization.jsonObject(with: $0) },","            \"nonce\": nonce,","        ])","    }","","    private func post(_ path: String, _ body: [String: Any]) async throws -> String {","        var request = URLRequest(url: backend.appendingPathComponent(path))","        request.httpMethod = \"POST\"","        request.setValue(\"application\/json\", forHTTPHeaderField: \"Content-Type\")","        request.httpBody = try JSONSerialization.data(withJSONObject: body)","        let (data, response) = try await URLSession.shared.data(for: request)","        guard (response as? HTTPURLResponse)?.statusCode == 200 else { throw URLError(.badServerResponse) }","        return String(decoding: data, as: UTF8.self)","    }","}"]},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"URLError"},{"text":" the provider throws reaches the wallet as a retryable","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/network"},{"text":" error; any other is","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/platform"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Create-the-wallet","level":3,"type":"heading","text":"Create the wallet"},{"inlineContent":[{"text":"Create one ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true,"type":"reference"},{"text":" when the app starts, and keep it. Creating it","type":"text"},{"text":" ","type":"text"},{"text":"makes no network requests. At launch, before anything else, sweep the","type":"text"},{"text":" ","type":"text"},{"text":"Keychain of keys no credential uses: an issuance the app quit in the","type":"text"},{"text":" ","type":"text"},{"text":"middle of leaves its keys behind. Each trust role whose roots you set","type":"text"},{"text":" ","type":"text"},{"text":"needs a revocation choice: checked against the CRLs your app fetches","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/revocation","isActive":true},{"text":"), or declined","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/noRevocationCheck","isActive":true},{"text":"); see ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/\/ The app's wallet, created once at launch.","@MainActor","final class AppWallet {","    let wallet: Wallet","    private let keys: KeychainKeyStore","","    init(clientID: String, redirectURI: String, issuerRoots: String, verifierRoots: String, crls: String, provider: URL) throws {","        let configuration = WalletConfiguration(","            clientID: clientID,","            redirectURI: redirectURI,","            issuerRoots: issuerRoots,","            verifierRoots: verifierRoots,","            crls: crls,","            revocation: [.issuer, .status, .verifier])","        keys = KeychainKeyStore()","        wallet = try Wallet(","            configuration: configuration,","            keyStore: keys,","            credentialStore: try FileCredentialStore.standard(),","            provider: BackendWalletProvider(backend: provider))","    }","","    \/\/\/ Run once at launch, before any issuance.","    func start() async throws {","        try await wallet.sweepOrphanedKeys(in: keys)","    }","}"]},{"type":"heading","level":3,"text":"Ship the release build","anchor":"Ship-the-release-build"},{"type":"paragraph","inlineContent":[{"text":"The package links the release build of ","type":"text"},{"code":"Mobile","type":"codeVoice"},{"text":". OID4VCgo’s own tests","type":"text"},{"text":" ","type":"text"},{"text":"use a test build with an in-process issuer and Verifier that a shipped","type":"text"},{"text":" ","type":"text"},{"text":"app must never have; ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","isActive":true,"type":"reference"},{"text":" says which one an app has,","type":"text"},{"text":" ","type":"text"},{"text":"so it can refuse to run on the test build.","type":"text"}]},{"type":"heading","level":3,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","type":"reference","isActive":true}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","type":"reference"}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","title":"WalletProvider","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"text":"evidence (App Attest) that it’s talking to the genuine app.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","title":"OID4VCWallet","role":"collection","type":"topic","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"API, and in person over Bluetooth."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"title":"Going to production","type":"topic","abstract":[{"type":"text","text":"What a wallet needs before real holders use it."}],"kind":"article","url":"\/documentation\/oid4vcwallet\/goingtoproduction","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ReceivingCredentials":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","type":"topic","title":"Receiving credentials","abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"url":"\/documentation\/oid4vcwallet\/receivingcredentials","kind":"article","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/OID4VC/isTestBuild":{"url":"\/documentation\/oid4vcwallet\/oid4vc\/istestbuild","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isTestBuild","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether the linked framework is the test build, carrying an"},{"type":"text","text":" "},{"type":"text","text":"in-process test issuer and Verifier ("},{"type":"codeVoice","code":"-tags mobiletest"},{"type":"text","text":"): an app"},{"type":"text","text":" "},{"text":"should refuse to run on it.","type":"text"}],"type":"topic","kind":"symbol","title":"isTestBuild","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore/compareAndSwap(id:expected:record:)":{"title":"compareAndSwap(id:expected:record:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"compareAndSwap"},{"kind":"text","text":"("},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"expected","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"record","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Replaces the record under "},{"type":"codeVoice","code":"id"},{"type":"text","text":" with "},{"type":"codeVoice","code":"record"},{"type":"text","text":" — or deletes it, when"},{"type":"text","text":" "},{"type":"codeVoice","code":"record"},{"type":"text","text":" is nil — only if what’s stored there is, byte for byte,"},{"type":"text","text":" "},{"code":"expected","type":"codeVoice"},{"text":" (nil: no record), and returns what was stored before,","type":"text"},{"text":" ","type":"text"},{"text":"whether or not it replaced it.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialstore\/compareandswap(id:expected:record:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/compareAndSwap(id:expected:record:)","required":true,"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/platform":{"type":"topic","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/platform","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/platform","title":"platform","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"platform","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"A key store, credential store or Wallet Provider call failed; its"},{"type":"text","text":" "},{"type":"text","text":"message follows."}],"kind":"symbol"},"doc: