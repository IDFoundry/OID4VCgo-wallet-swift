h an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}],"type":"topic","kind":"symbol","title":"holderAccessGroup","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/init(secureenclave:persistent:holderuserpresence:tagprefix:holderaccessgroup:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"secureEnclave","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"persistent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"holderUserPresence","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tagPrefix","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"holderAccessGroup","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Options: by default, Secure Enclave keys kept in the Keychain, and"},{"type":"text","text":" "},{"type":"text","text":"holder keys asking for user presence."}],"type":"topic","kind":"symbol","title":"init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)"},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"batchSize","abstract":[{"type":"text","text":"How many copies of each credential to request when an issuer"},{"type":"text","text":" "},{"type":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"text":"it’s capped at the issuer’s batch size.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(answers:)":{"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(answers:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","text":"Answer"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","text":"Response"}],"abstract":[{"text":"Presents several of the request’s documents in one","type":"text"},{"text":" ","type":"text"},{"text":"EncryptedResponse, each of ","type":"text"},{"type":"codeVoice","code":"answers"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"respond(document:credentialID:elements:)","type":"codeVoice"},{"type":"text","text":" presents one. A document"},{"type":"text","text":" "},{"type":"text","text":"left out isn’t in the response. No document may be answered twice,"},{"type":"text","text":" "},{"type":"text","text":"nor one credential answer two. Each holder key signs now, in the"},{"type":"text","text":" "},{"type":"text","text":"request’s order; a "},{"code":"KeychainKeyStore","type":"codeVoice"},{"type":"text","text":" requiring user presence asks"},{"type":"text","text":" "},{"type":"text","text":"the holder once for them all. On a "},{"code":"WalletError","type":"codeVoice"},{"type":"text","text":" — the prompt"},{"type":"text","text":" "},{"type":"text","text":"cancelled, say — nothing is returned, and the request can be"},{"type":"text","text":" "},{"type":"text","text":"answered again."}],"type":"topic","kind":"symbol","title":"respond(answers:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)"},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","title":"Swift.Sendable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","title":"OID4VCWallet","role":"collection","type":"topic","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"API, and in person over Bluetooth."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"title":"KeychainKeyStore","abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","title":"holderUserPresence","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation, and"},{"type":"text","text":" "},{"type":"text","text":"again if the issuer refuses the nonce — and a refresh can’t"},{"type":"text","text":" "},{"type":"text","text":"run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LAContext.evaluatePolicy"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"text":"and in person — a check the app’s own code keeps, not the","type":"text"},{"text":" ","type":"text"},{"text":"key. For Face ID, the app’s Info.plist must have an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead. A presentation answering several documents"},{"type":"text","text":" "},{"type":"text","text":"at once ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","isActive":true},{"text":") asks once: its holder","type":"text"},{"text":" ","type":"text"},{"text":"keys share one authentication context for that call only.","type":"text"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderUserPresence","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/respond(answers:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"text":"answers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MdocPresentation","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC"},{"text":".","kind":"text"},{"text":"Answer","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Responded","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC9RespondedV"}],"type":"topic","title":"respond(answers:)","abstract":[{"type":"text","text":"Presents several of the request’s documents in one response, each"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"answers"},{"type":"text","text":" as "},{"type":"codeVoice","code":"respond(document:credentialID:elements:)"},{"type":"text","text":" presents"},{"type":"text","text":" "},{"type":"text","text":"one, and sends it, which ends the session. A document left out"},{"type":"text","text":" "},{"type":"text","text":"isn’t in the response: the reader may ask for more than the holder"},{"type":"text","text":" "},{"type":"text","text":"shares. No document may be answered twice, nor one credential"},{"type":"text","text":" "},{"type":"text","text":"answer two. Each holder key signs now, in the request’s order; a"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" requiring user presence asks the holder once for"},{"type":"text","text":" "},{"type":"text","text":"them all ("},{"type":"codeVoice","code":"KeychainKeyStore.Options.holderUserPresence"},{"type":"text","text":"). On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" — the prompt cancelled, say — nothing was sent and"},{"type":"text","text":" "},{"type":"text","text":"the request stands: try again, or "},{"type":"codeVoice","code":"decline"},{"type":"text","text":"."}],"url":"\/documentation\/oid4vcwallet\/proximitypresentation\/respond(answers:)","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/secureEnclave":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/secureenclave","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/secureEnclave","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"secureEnclave","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"secureEnclave","abstract":[{"text":"Generate keys in the Secure Enclave. Off, keys are software","type":"text"},{"text":" ","type":"text"},{"text":"keys — for development, and where there’s no enclave.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/tagPrefix":{"title":"tagPrefix","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/tagprefix","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/tagPrefix","abstract":[{"type":"text","text":"Prefixes every key’s Keychain application tag. Keys under"},{"type":"text","text":" "},{"type":"text","text":"another prefix are never touched, by a sweep or anything else."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"tagPrefix"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct":{"navigatorTitle":[{"kind":"identifier","text":"Options"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct","title":"KeychainKeyStore.Options","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"How the store makes and keeps keys."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}]}}}