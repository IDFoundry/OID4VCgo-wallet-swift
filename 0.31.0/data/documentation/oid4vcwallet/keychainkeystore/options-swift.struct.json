ve an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"text":"; without one, iOS asks for the","type":"text"},{"text":" ","type":"text"},{"text":"passcode instead. A presentation answering several documents","type":"text"},{"text":" ","type":"text"},{"text":"at once (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","isActive":true},{"type":"text","text":") asks once: its holder"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(answers:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","text":"Answer"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","text":"Response"}],"title":"respond(answers:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(answers:)","abstract":[{"text":"Presents several of the request’s documents in one","type":"text"},{"text":" ","type":"text"},{"text":"EncryptedResponse, each of ","type":"text"},{"code":"answers","type"