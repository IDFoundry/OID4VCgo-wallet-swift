stance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","title":"holderAccessGroup","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"abstract":[{"type":"text","text":"How many copies of each credential to request when an issuer"},{"type":"text","text":" "},{"type":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"type":"text","text":"it’s capped at the issuer’s batch size."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","title":"batchSize","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","type":"topic","title":"OID4VCWallet","kind":"symbol","role":"collection","url":"\/documentation\/oid4vcwallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(answers:)":{"abstract":[{"type":"text","text":"Presents several of the request’s documents in one"},{"type":"text","text":" "},{"text":"EncryptedResponse, each of ","type":"text"},{"code":"answers","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"respond(document:credentialID:elements:)","type":"codeVoice"},{"type":"text","text":" presents one. A document"},{"type":"text","text":" "},{"type":"text","text":"left out isn’t in the response. No document may be answered twice,"},{"type":"text","text":" "},{"type":"text","text":"nor one credential answer two. Each holder key signs now, in the"},{"type":"text","text":" "},{"type":"text","text":"request’s order; a "},{"code":"KeychainKeyStore","type":"codeVoice"},{"type":"text","text":" requiring user presence asks"},{"type":"text","text":" "},{"type":"text","text":"the holder once for them all. On a "},{"code":"WalletError","type":"codeVoice"},{"type":"text","text":" — the prompt"},{"type":"text","text":" "},{"type":"text","text":"cancelled, say — nothing is returned, and the request can be"},{"type":"text","text":" "},{"type":"text","text":"answered again."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","text":"Answer"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","text":"Response"}],"type":"topic","title":"respond(answers:)","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(answers:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)":{"abstract":[{"text":"Options: by default, Secure Enclave keys kept in the Keychain, and","type":"text"},{"text":" ","type":"text"},{"text":"holder keys asking for user presence.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"secureEnclave","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"persistent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"holderUserPresence","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tagPrefix","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"holderAccessGroup","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","title":"init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/init(secureenclave:persistent:holderuserpresence:tagprefix:holderaccessgroup:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/secureEnclave":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"secureEnclave"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Generate keys in the Secure Enclave. Off, keys are software","type":"text"},{"text":" ","type":"text"},{"text":"keys — for development, and where there’s no enclave.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/secureenclave","title":"secureEnclave","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/secureEnclave"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","title":"holderUserPresence","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation, and"},{"type":"text","text":" "},{"type":"text","text":"again if the issuer refuses the nonce — and a refresh can’t"},{"type":"text","text":" "},{"type":"text","text":"run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LAContext.evaluatePolicy"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead. A presentation answering several documents"},{"type":"text","text":" "},{"type":"text","text":"at once ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)"},{"type":"text","text":") asks once: its holder"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/respond(answers:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MdocPresentation","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Answer","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Responded","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC9RespondedV"}],"abstract":[{"text":"Presents several of the request’s documents in one response, each","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"answers","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"respond(document:credentialID:elements:)","type":"codeVoice"},{"text":" presents","type":"text"},{"text":" ","type":"text"},{"text":"one, and sends it, which ends the session. A document left out","type":"text"},{"text":" ","type":"text"},{"text":"isn’t in the response: the reader may ask for more than the holder","type":"text"},{"text":" ","type":"text"},{"text":"shares. No document may be answered twice, nor one credential","type":"text"},{"type":"text","text":" "},{"type":"text","text":"answer two. Each holder key signs now, in the request’s order; a"},{"type":"text","text":" "},{"code":"KeychainKeyStore","type":"codeVoice"},{"text":" requiring user presence asks the holder once for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"them all ("},{"code":"KeychainKeyStore.Options.holderUserPresence","type":"codeVoice"},{"type":"text","text":"). On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" — the prompt cancelled, say — nothing was sent and"},{"type":"text","text":" "},{"type":"text","text":"the request stands: try again, or "},{"type":"codeVoice","code":"decline"},{"text":".","type":"text"}],"url":"\/documentation\/oid4vcwallet\/proximitypresentation\/respond(answers:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","title":"respond(answers:)","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct":{"navigatorTitle":[{"kind":"identifier","text":"Options"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"How the store makes and keeps keys."}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct","title":"KeychainKeyStore.Options"},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","type":"unresolvable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"title":"KeychainKeyStore","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"code":"Options.tagPrefix","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/persistent":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/persistent","title":"persistent","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/persistent","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Keep keys in the Keychain, across launches. Off, they live"},{"type":"text","text":" "},{"type":"text","text":"only as long as this store (for tests: the Keychain needs a"},{"type":"text","text":" "},{"type":"text","text":"signed host app on iOS)."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"persistent","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]}}}