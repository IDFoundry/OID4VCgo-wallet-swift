/OID4VCWallet\/InMemoryInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"reference","isActive":true},{"type":"text","text":" over the Wallet Provider HTTP protocol, version"},{"type":"text","text":" "},{"type":"text","text":"1, that OID4VCgo’s "},{"type":"codeVoice","code":"walletprovider.Provider.Handler"},{"type":"text","text":" serves"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"reference","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"with Apple App Attest ("},{"type":"codeVoice","code":"apple-app-attest"},{"type":"text","text":") as its evidence:"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/httpwalletprovider"]}],"metadata":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"externalID":"s:12OID4VCWallet18HttpWalletProviderC","navigatorTitle":[{"kind":"identifier","text":"HttpWalletProvider"}],"title":"HttpWalletProvider","symbolKind":"class","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Class"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"HttpWalletProvider","kind":"identifier"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The installation registers once, at its first Wallet Attestation:"},{"type":"text","text":" "},{"type":"text","text":"over a "},{"type":"codeVoice","code":"registration"},{"type":"text","text":" challenge, it makes a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"registration key"}]},{"type":"text","text":" in a"},{"text":" ","type":"text"},{"type":"text","text":"key store of its own ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","isActive":true,"type":"reference"},{"type":"text","text":") and an App Attest"},{"text":" ","type":"text"},{"type":"text","text":"key, has Apple attest the App Attest key over the client data"},{"type":"text","text":" "},{"type":"text","text":"naming the registration key, registers both ("},{"code":"POST \/v1\/instances","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and keeps the instance ID and the two keys’ IDs in its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","isActive":true},{"text":". The registration key signs every later","type":"text"},{"type":"text","text":" "},{"text":"request (","type":"text"},{"code":"Wallet-Provider-Request","type":"codeVoice"},{"text":"); no attestation names it. If","type":"text"},{"text":" ","type":"text"},{"text":"the registration, its key or the App Attest key is lost, the next","type":"text"},{"type":"text","text":" "},{"text":"Wallet Attestation registers again, with new keys. An App Attest","type":"text"},{"type":"text","text":" "},{"text":"key a registration made but couldn’t register — App Attest’s","type":"text"},{"type":"text","text":" "},{"text":"server or the provider unavailable, or no connection — is kept, in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"this process, and tried again by the next registration, as Apple"},{"type":"text","text":" "},{"type":"text","text":"asks; it’s dropped when the provider or App Attest refuses it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)","type":"reference"},{"type":"text","text":" asks for a Wallet"},{"text":" ","type":"text"},{"text":"Attestation for the instance key (","type":"text"},{"code":"instance_key","type":"codeVoice"},{"text":"). The first time,","type":"text"},{"text":" ","type":"text"},{"text":"it sends an App Attest assertion over a fresh ","type":"text"},{"code":"instance","type":"codeVoice"},{"type":"text","text":" challenge"},{"text":" ","type":"text"},{"text":"and the key, which the provider records the key with; once it has,","type":"text"},{"text":" ","type":"text"},{"text":"the key alone — and the assertion again if the provider no longer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"has its record ("},{"code":"evidence_required","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)"},{"text":" asks for a Key","type":"text"},{"text":" ","type":"text"},{"text":"Attestation over the holder keys, with one assertion over a","type":"text"},{"text":" ","type":"text"},{"code":"holder","type":"codeVoice"},{"text":" challenge and all of them, for the issuance of its","type":"text"},{"type":"text","text":" "},{"type":"text","text":"instance key, which a Wallet Attestation recorded."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"App Attest attests the app, not the wallet’s keys: the provider"},{"type":"text","text":" "},{"type":"text","text":"learns that a genuine copy of the app on a genuine Apple device asked"},{"type":"text","text":" "},{"type":"text","text":"for them, not where they are. Make them in the Secure Enclave all the"},{"text":" ","type":"text"},{"text":"same (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true,"type":"reference"},{"text":"‘s default). Where App Attest isn’t","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"supported — the Simulator, some older devices — the wallet can’t"},{"type":"text","text":" "},{"type":"text","text":"register, and every attestation fails as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":": there’s no"},{"type":"text","text":" "},{"type":"text","text":"unattested path, in development either. A development build (the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"type":"text","text":" entitlement"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"type":"codeVoice","code":"development"},{"type":"text","text":") makes development-environment keys, which only"},{"type":"text","text":" "},{"type":"text","text":"a provider configured for them accepts."}]},{"inlineContent":[{"type":"text","text":"Assertions are made one at a time, each sent before the next is made,"},{"type":"text","text":" "},{"type":"text","text":"as the provider accepts only an assertion whose counter exceeds the"},{"type":"text","text":" "},{"type":"text","text":"last it took, and the installation registers once. Every"},{"type":"text","text":" "},{"type":"codeVoice","code":"HttpWalletProvider"},{"type":"text","text":" over the same "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","isActive":true},{"type":"text","text":" file (or"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","isActive":true},{"type":"text","text":") in the process shares that"},{"type":"text","text":" "},{"type":"text","text":"order, so a wallet rebuilt mid-issuance with a new provider is still"},{"type":"text","text":" "},{"text":"serialised with the old one. Over a registry of its own type, a","type":"text"},{"text":" ","type":"text"},{"text":"provider serialises only its own calls: keep one provider for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It sends nothing but to its base URL, over https, following no","type":"text"},{"text":" ","type":"text"},{"text":"redirect, with its timeout for each request, and reads at most","type":"text"},{"text":" ","type":"text"},{"text":"256 KiB of an answer. It checks a Wallet Attestation is for the","type":"text"},{"text":" ","type":"text"},{"text":"client and the instance key, and a Key Attestation is over the nonce","type":"text"},{"type":"text","text":" "},{"type":"text","text":"sent and attests only keys sent; their signatures are the issuer’s to"},{"text":" ","type":"text"},{"text":"verify.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Failures reach the wallet as "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":"s: one the network or the"},{"type":"text","text":" "},{"type":"text","text":"provider’s availability caused (no connection, a timeout, HTTP 5xx or"},{"type":"text","text":" "},{"type":"text","text":"429, a challenge that expired before it was used, App Attest’s server"},{"type":"text","text":" "},{"type":"text","text":"unavailable) as "},{"type":"codeVoice","code":".network"},{"type":"text","text":", which may be retried"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","isActive":true},{"type":"text","text":"); a refusal"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError","isActive":true},{"type":"text","text":") as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", its message naming the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s error code. On "},{"type":"codeVoice","code":"instance_revoked"},{"type":"text","text":", it forgets the"},{"text":" ","type":"text"},{"text":"registration and deletes its registration key: the next Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Attestation registers the installation again. The revoked instance’s","type":"text"},{"text":" ","type":"text"},{"text":"instance keys stay its own (","type":"text"},{"code":"instance_key_registered","type":"codeVoice"},{"text":"), so a","type":"text"},{"text":" ","type":"text"},{"text":"credential whose refresh needs one must be received again. On","type":"text"},{"text":" ","type":"text"},{"code":"instance_not_active","type":"codeVoice"},{"text":" (suspended) it keeps the registration: tell the","type":"text"},{"text":" ","type":"text"},{"text":"holder, as the provider may resume it. A signed request refused as","type":"text"},{"text":" ","type":"text"},{"code":"invalid_signed_request","type":"codeVoice"},{"type":"text","text":" isn’t retried: check the device’s clock, and"},{"type":"text","text":" "},{"type":"text","text":"that the provider still knows the instance."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/sweepOrphanedKeys(in:)":{"type":"topic","url":"\/documentation\/oid4vcwallet\/wallet\/sweeporphanedkeys(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sweepOrphanedKeys"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16KeychainKeyStoreC","text":"KeychainKeyStore"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"sweepOrphanedKeys(in:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","abstract":[{"type":"text","text":"Deletes every key in "},{"type":"codeVoice","code":"keyStore"},{"type":"text","text":" that none of the wallet’s"},{"type":"text","text":" "},{"type":"text","text":"credentials is bound to — left by an issuance the app quit or"},{"type":"text","text":" "},{"type":"text","text":"crashed in the middle of — and returns how many. Call it at launch,"},{"type":"text","text":" "},{"type":"text","text":"before any issuance or refresh: one in progress holds keys of its"},{"type":"text","text":" "},{"type":"text","text":"own."}],"role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"title":"KeychainKeyStore","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"code":"Options.tagPrefix","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderUnavailableError":{"abstract":[{"text":"The Wallet Provider couldn’t answer — HTTP 5xx or 429 — or the","type":"text"},{"text":" ","type":"text"},{"text":"challenge a request named expired or was used before it arrived","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"invalid_challenge","type":"codeVoice"},{"text":"), or App Attest’s server is unavailable. It","type":"text"},{"text":" ","type":"text"},{"text":"reaches the wallet as ","type":"text"},{"code":".network","type":"codeVoice"},{"text":": try again, which gets new","type":"text"},{"text":" ","type":"text"},{"text":"challenges.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProviderUnavailableError","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"WalletProviderUnavailableError","kind":"identifier"}],"title":"WalletProviderUnavailableError","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/walletproviderunavailableerror"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"type":"topic","url":"\/documentation\/oid4vcwallet\/handlingerrors","title":"Handling errors","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","abstract":[{"text":"Tell the holder what went wrong, retry what may succeed, and log what","type":"text"},{"text":" ","type":"text"},{"text":"helps without personal data.","type":"text"}],"role":"article","kind":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"abstract":[{"type":"text","text":"Add the package, give the wallet its keys, its storage and a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Provider, and create it at launch."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","type":"topic","title":"Getting started","kind":"article","role":"article","url":"\/documentation\/oid4vcwallet\/gettingstarted"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/RegisteredInstance":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RegisteredInstance"}],"abstract":[{"type":"text","text":"The wallet’s registration with a Wallet Provider: its registration"},{"type":"text","text":" "},{"text":"key, its App Attest key and the instance ID the provider gave for","type":"text"},{"text":" ","type":"text"},{"text":"them (WALLET_PROVIDER.md, ","type":"text"},{"type":"codeVoice","code":"POST \/v1\/instances"},{"text":"). One per installation.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/registeredinstance","navigatorTitle":[{"kind":"identifier","text":"RegisteredInstance"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","title":"RegisteredInstance","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/AppAttestService":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppAttestService"}],"abstract":[{"type":"text","text":"Apple App Attest, as "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true},{"type":"text","text":" uses it: the app’s App"},{"type":"text","text":" "},{"type":"text","text":"Attest key, made once at registration, attested by Apple, and"},{"type":"text","text":" "},{"type":"text","text":"asserting over the client data of each later request."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","isActive":true},{"type":"text","text":" is "},{"code":"DCAppAttestService","type":"codeVoice"},{"type":"text","text":"; a test supplies"},{"type":"text","text":" "},{"type":"text","text":"its own."}],"url":"\/documentation\/oid4vcwallet\/appattestservice","navigatorTitle":[{"kind":"identifier","text":"AppAttestService"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","title":"AppAttestService","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"abstract":[{"text":"What a wallet needs before real holders use it.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","type":"topic","title":"Going to production","kind":"article","role":"article","url":"\/documentation\/oid4vcwallet\/goingtoproduction"},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"https://github.com/IDFoundry/OID4VCgo/blob/main/mobile/WALLET_PROVIDER.md":{"titleInlineContent":[{"type":"text","text":"WALLET_PROVIDER.md"}],"url":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","title":"WALLET_PROVIDER.md","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"link"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/registrationKeyTagPrefix":{"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"registrationKeyTagPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"abstract":[{"type":"text","text":"The Keychain tag prefix of "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","type":"reference"},{"type":"text","text":"‘s keys. The"},{"type":"text","text":" "},{"type":"text","text":"wallet’s own "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","type":"reference"},{"type":"text","text":" mustn’t cover it, as its default"},{"type":"text","text":" "},{"type":"text","text":"prefix doesn’t: "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","type":"reference"},{"type":"text","text":" would"},{"type":"text","text":" "},{"type":"text","text":"delete the registration key."}],"url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/registrationkeytagprefix","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4V