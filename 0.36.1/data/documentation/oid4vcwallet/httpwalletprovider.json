ttpWalletProvider\/walletAttestation(clientID:instanceKey:)","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/walletattestation(clientid:instancekey:)","kind":"symbol","title":"walletAttestation(clientID:instanceKey:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"walletAttestation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"clientID","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"instanceKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/sweepOrphanedRegistrationKeys()":{"abstract":[{"text":"Deletes every key in the registration key store but the kept","type":"text"},{"text":" ","type":"text"},{"text":"registration’s, and returns how many it deleted: the keys of","type":"text"},{"text":" ","type":"text"},{"text":"registrations that never finished — the app ended in the middle","type":"text"},{"text":" ","type":"text"},{"text":"of one, or was deleted and installed again, which keeps its","type":"text"},{"text":" ","type":"text"},{"text":"Keychain items but not its registry — which nothing else","type":"text"},{"text":" ","type":"text"},{"text":"deletes. Call it at launch. It takes its turn with registrations","type":"text"},{"text":" ","type":"text"},{"text":"over the same registry, so it never deletes the key of one in","type":"text"},{"text":" ","type":"text"},{"text":"progress.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/sweepOrphanedRegistrationKeys()","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/sweeporphanedregistrationkeys()","kind":"symbol","title":"sweepOrphanedRegistrationKeys()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sweepOrphanedRegistrationKeys"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"code":"Options.tagPrefix","type":"codeVoice"},{"type":"text","text":"), and"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","url":"\/documentation\/oid4vcwallet\/keychainkeystore","kind":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"title":"KeychainKeyStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderRefusedError":{"type":"topic","navigatorTitle":[{"text":"WalletProviderRefusedError","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProviderRefusedError","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletproviderrefusederror","title":"WalletProviderRefusedError","abstract":[{"text":"The Wallet Provider refused a request with one of the protocol’s","type":"text"},{"text":" ","type":"text"},{"text":"errors, or answered other than the protocol documents (a redirect, a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"path it doesn’t serve). It reaches the wallet as "},{"code":".platform","type":"codeVoice"},{"type":"text","text":", its"},{"type":"text","text":" "},{"code":"protocolError","type":"codeVoice"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError\/error","type":"reference","isActive":true},{"text":" when there is one. An app’s own","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"reference","isActive":true},{"type":"text","text":" may throw it too, for the same."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderUnavailableError":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"WalletProviderUnavailableError"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProviderUnavailableError"}],"url":"\/documentation\/oid4vcwallet\/walletproviderunavailableerror","title":"WalletProviderUnavailableError","abstract":[{"text":"The Wallet Provider couldn’t answer — HTTP 5xx or 429 — or the","type":"text"},{"text":" ","type":"text"},{"text":"challenge a request named expired or was used before it arrived","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"invalid_challenge","type":"codeVoice"},{"text":"), or App Attest’s server is unavailable. It","type":"text"},{"text":" ","type":"text"},{"text":"reaches the wallet as ","type":"text"},{"code":".network","type":"codeVoice"},{"text":": try again, which gets new","type":"text"},{"text":" ","type":"text"},{"text":"challenges.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/registrationKeyStore()":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","kind":"symbol","type":"topic","abstract":[{"text":"The registration key’s store: Secure Enclave keys in the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"under ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyTagPrefix","type":"reference","isActive":true},{"text":", apart from the wallet’s keys,","type":"text"},{"text":" ","type":"text"},{"text":"signing without the holder, as instance keys do, and usable only","type":"text"},{"text":" ","type":"text"},{"text":"while the device is unlocked","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"text":").","type":"text"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/registrationkeystore()","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"registrationKeyStore"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16KeychainKeyStoreC","text":"KeychainKeyStore"}],"title":"registrationKeyStore()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OI