identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)"},{"type":"text","text":") asks once: its holder"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}],"title":"holderUserPresence","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)","kind":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/init(secureenclave:persistent:holderuserpresence:tagprefix:holderaccessgroup:)","title":"init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"secureEnclave","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"persistent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"holderUserPresence","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentif