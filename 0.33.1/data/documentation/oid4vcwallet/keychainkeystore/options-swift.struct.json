d4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct"},"abstract":[{"text":"How the store makes and keeps keys.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Options","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]}],"sections":[],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"title":"KeychainKeyStore","url":"\/documentation\/oid4vcwallet\/keychainkeystore","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","role":"symbol","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"kind":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/respond(answers:)":{"title":"respond(answers:)","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/respond(answers:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"answers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MdocPresentation","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC"},{"text":".","kind":"text"},{"text":"Answer","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Responded","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC9RespondedV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","role":"symbol","abstract":[{"text":"Presents several of the request’s documents in one response, each","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"answers","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"respond(document:credentialID:elements:)","type":"codeVoice"},{"text":" presents","type":"text"},{"text":" ","type":"text"},{"text":"one, and sends it, which ends the session. A document left out","type":"text"},{"text":" ","type":"text"},{"text":"isn’t in the response: the reader may ask for more than the holder","type":"text"},{"text":" ","type":"text"},{"text":"shares. No document may be answered twice, nor one credential","type":"text"},{"text":" ","type":"text"},{"text":"answer two. Each holder key signs now, in the request’s order; a","type":"text"},{"text":" ","type":"text"},{"code":"KeychainKeyStore","type":"codeVoice"},{"text":" requiring user presence asks the holder once for","type":"text"},{"text":" ","type":"text"},{"text":"them all (","type":"text"},{"code":"KeychainKeyStore.Options.holderUserPresence","type":"codeVoice"},{"text":"). On a","type":"text"},{"text":" ","type":"text"},{"code":"WalletError","type":"codeVoice"},{"text":" — the prompt cancelled, say —