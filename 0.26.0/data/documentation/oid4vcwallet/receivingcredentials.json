nURL"},{"type":"text","text":"). Returns the"},{"type":"text","text":" "},{"type":"text","text":"issuance ready for "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":". A redirect matching no"},{"type":"text","text":" "},{"type":"text","text":"authorization in progress — not this wallet’s, already completed,"},{"type":"text","text":" "},{"type":"text","text":"or expired — throws "},{"type":"codeVoice","code":".notFound"},{"type":"text","text":"."}],"role":"symbol","title":"resumeIssuance(redirect:)","type":"topic","url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"resumeIssuance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet8IssuanceC","text":"Issuance","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Issuance","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","title":"Issuance","navigatorTitle":[{"text":"Issuance","kind":"identifier"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/issuance","abstract":[{"text":"Receives one offer’s credentials: show ","type":"text"},{"type":"codeVoice","code":"offer"},{"text":"; then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"beginAuthorization()"},{"text":", open the URL in ASWebAuthenticationSession and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"completeAuthorization(redirect:)"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"redeemPreAuthorizedCode(pin:)"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"type":"codeVoice","code":"requestCredentials()"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"close()"},{"text":" when done.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","title":"refreshCredential(id:)","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","abstract":[{"text":"Replaces a ","type":"text"},{"type":"codeVoice","code":"refreshable"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new holder key, without the holder signing in","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VCI 1.0 §13.5). The new holder keys sign the Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request’s proof, so with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyStore.Options.holderUserPresence"},{"text":" ","type":"text"},{"text":"on it asks the holder. Use it when ","type":"text"},{"type":"codeVoice","code":"copiesLeft"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/Result":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","title":"Issuance.Result","navigatorTitle":[{"text":"Result","kind":"identifier"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/issuance\/result","abstract":[{"text":"What ","type":"text"},{"type":"codeVoice","code":"requestCredentials()"},{"text":" obtained.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, and an mdoc’s"},{"type":"text","text":" "},{"type":"text","text":"identifier list, checks their signatures, and returns the"},{"type":"text","text":" "},{"type":"text","text":"credential with its revocation status recorded. Each list covers"},{"type":"text","text":" "},{"type":"text","text":"many credentials, so fetching it doesn’t tell the issuer which"},{"type":"text","text":" "},{"type":"text","text":"one is checked. A credential without a status or identifier list"},{"type":"text","text":" "},{"type":"text","text":"is returned as it is. Revocation is final: a credential found"},{"type":"text","text":" "},{"type":"text","text":"revoked stays so, its lists not fetched again, until the revoked"},{"type":"text","text":" "},{"type":"text","text":"copy expires or the credential is refreshed."}],"role":"symbol","title":"checkStatus(id:)","type":"topic","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)