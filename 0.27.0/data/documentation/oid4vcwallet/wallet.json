","type":"codeVoice"},{"text":", over ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"https","type":"codeVoice"},{"text":" (the lists are signed).","type":"text"},{"text":" ","type":"text"},{"text":"Persist the result’s ","type":"text"},{"code":"crls","type":"codeVoice"},{"text":" for the next launch and schedule the","type":"text"},{"text":" ","type":"text"},{"text":"next refresh at its ","type":"text"},{"code":"nextRefresh","type":"codeVoice"},{"text":" (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Throws ","type":"text"},{"code":"invalidInput","type":"codeVoice"},{"text":" (","type":"text"},{"code":"not_configured","type":"codeVoice"},{"text":") with no distribution","type":"text"},{"text":" ","type":"text"},{"text":"points configured, and ","type":"text"},{"code":"cancelled","type":"codeVoice"},{"text":" when its task is cancelled.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCRLs","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CRLRefreshResult","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16CRLRefreshResultV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCRLs()","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcrls()","role":"symbol","title":"refreshCRLs()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startPresentation(request:)":{"abstract":[{"type":"text","text":"Fetches and verifies an OpenID4VP request (openid4vp:\/\/…), and"},{"text":" ","type":"text"},{"text":"finds the credentials that can answer it.","type":"text"}],"kind":"