its ","type":"text"},{"type":"codeVoice","code":"qrCode"},{"text":". In ","type":"text"},{"type":"codeVoice","code":"modes"},{"text":", both by default, it advertises for a","type":"text"},{"text":" ","type":"text"},{"text":"reader (peripheral server mode) and scans for one (central client","type":"text"},{"text":" ","type":"text"},{"text":"mode) until a reader connects either way; a reader offered both","type":"text"},{"text":" ","type":"text"},{"text":"should choose central client mode. Bluetooth failures end it as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".failed"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"ProximityError"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startProximityPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeouts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ProximityTimeouts","preciseIdentifier":"s:12OID4VCWallet17ProximityTimeoutsV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"modes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ProximityBLEMode","preciseIdentifier":"s:12OID4VCWallet16ProximityBLEModeO"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"ProximityPresentation","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","url":"\/documentation\/oid4vcwallet\/wallet\/startproximitypresentation(timeouts:modes:)","role":"symbol","title":"startProximityPresentation(timeouts:modes:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"abstract":[{"text":"Fetches the issuer’s status list for a credential, and an mdoc’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier list, checks their signatures, and returns the","type":"text"},{"text":" ","type":"text"},{"text":"credential with its revocation status recorded. Each list covers","type":"text"},{"text":" ","type":"text"},{"text":"many credentials, so fetching it doesn’t tell the issuer which","type":"text"},{"text":" ","type":"text"},{"text":"one is checked. A credential without a status or identifier list","type":"text"},{"text":" ","type":"text"},{"text":"is returned as it is. Revocation is final: a credential found","type":"text"},{"text":" ","type":"text"},{"text":"revoked stays so, its lists not fetched again, until the revoked","type":"text"},{"text":" ","type":"text"},{"text":"copy expires or the credential is refreshed.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkStatus"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","role":"symbol","title":"checkStatus(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deleteCredential(id:)":{"abstract":[{"text":"Deletes a credential and its holder keys, and its refresh grant","type":"text"},{"text":" ","type":"text"},{"text":"once no other credential uses it, first revoking the refresh token","type":"text"},{"text":" ","type":"text"},{"text":"