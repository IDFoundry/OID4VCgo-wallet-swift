text"}],"title":"holderAccessGroup","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","kind":"symbol","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct":{"abstract":[{"text":"How the store makes and keeps keys.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Options"}],"title":"KeychainKeyStore.Options"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/secureEnclave":{"abstract":[{"text":"Generate keys in the Secure Enclave. Off, keys are software","type":"text"},{"text":" ","type":"text"},{"text":"keys — for development, and where there’s no enclave.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"secureEnclave"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/secureEnclave","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/secureenclave","role":"symbol","title":"secureEnclave"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","kind":"symbol","title":"batchSize","type":"topic","abstract":[{"text":"How many copies of each credential to request when an issuer","type":"text"},{"text":" ","type":"text"},{"text":"offers batches, each bound to its own key, so each presentation","type":"text"},{"text":" ","type":"text"},{"text":"can use one no Verifier has seen. 0 means the SDK’s default (5);","type":"text"},{"text":" ","type":"text"},{"text":"it’s capped at the issuer’s batch size.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchSize","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true,"type":"reference"},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation, and"},{"type":"text","text":" "},{"type":"text","text":"again if the issuer refuses the nonce — and a refresh can’t"},{"type":"text","text":" "},{"type":"text","text":"run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"code":"LAContext.evaluatePolicy","type":"codeVoice"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead."}],"title":"holderUserPresence","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/persistent":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/persistent","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"persistent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"text":"Keep keys in the Keychain, across launches. Off, they live","type":"text"},{"text":" ","type":"text"},{"text":"only as long as this store (for tests: the Keychain needs a","type":"text"},{"text":" ","type":"text"},{"text":"signed host app on iOS).","type":"text"}],"title":"persistent","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/persistent"},"doc://oid4vcwallet.OID4VCWal