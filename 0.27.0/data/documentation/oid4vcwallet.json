{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"OID4VCWallet is the wallet side of "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"for iOS 16 and macOS 13 and later. It handles SD-JWT VC and ISO mdoc"},{"type":"text","text":" "},{"type":"text","text":"credentials:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Receiving"}],"type":"strong"},{"text":" them from a Credential Offer (OpenID4VCI 1.0, HAIP 1.0),","type":"text"},{"text":" ","type":"text"},{"text":"with the authorization code or the pre-authorized code grant, deferred","type":"text"},{"text":" ","type":"text"},{"text":"issuance, batches of copies and refresh.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Presenting"}],"type":"strong"},{"text":" them in answer to an ","type":"text"},{"code":"openid4vp:\/\/","type":"codeVoice"},{"text":" request","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VP 1.0, HAIP 1.0), to Safari’s Digital Credentials API as an","type":"text"},{"text":" ","type":"text"},{"text":"iOS document provider (","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":", ISO\/IEC TS 18013-7), and in","type":"text"},{"text":" ","type":"text"},{"text":"person over Bluetooth (ISO\/IEC 18013-5), where the app can also be the","type":"text"},{"text":" ","type":"text"},{"text":"reader.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The protocols run in OID4VCgo’s Go code, compiled into the "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":" "},{"type":"text","text":"framework this package links: every network request, every protocol"},{"type":"text","text":" "},{"type":"text","text":"message and every check on what comes back. Your app supplies the"},{"type":"text","text":" "},{"type":"text","text":"platform, through three protocols: a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore"},{"type":"text","text":" whose keys never leave"},{"type":"text","text":" "},{"type":"text","text":"the Secure Enclave, a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore"},{"type":"text","text":" under the device’s data"},{"type":"text","text":" "},{"type":"text","text":"protection, and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"},{"type":"text","text":" that attests the wallet. It also"},{"type":"text","text":" "},{"type":"text","text":"owns the UI: every session stops where the holder needs to decide."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"OID4VCgo is OpenID Certified for the OpenID4VCI and OpenID4VP wallet"},{"type":"text","text":" "},{"type":"text","text":"roles under HAIP, over links. The Digital Credentials API and in-person"},{"type":"text","text":" "},{"type":"text","text":"presentation aren’t covered by that certification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted"},{"type":"text","text":", then the article for each task;"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"},{"type":"text","text":" lists every step in order."}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"sections