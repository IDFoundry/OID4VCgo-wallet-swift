e":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"type":"text","text":"it’s capped at the issuer’s batch size."}],"type":"topic","title":"batchSize"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"code":"Options.tagPrefix","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"type":"topic","title":"KeychainKeyStore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"title":"holderUserPresence","role":"symbol","abstract":[{"text":"Require user presence (Face ID, Touch ID or the passcode) for","type":"text"},{"text":" ","type":"text"},{"text":"every signature with a holder key: to present a credential,","type":"text"},{"text":" ","type":"text"},{"text":"and to sign the Credential Request’s jwt proofs, so receiving","type":"text"},{"text":" ","type":"text"},{"text":"and refreshing credentials ask too — once per copy","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"text":"), or once per Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request when its jwt proof carries a key attestation, and","type":"text"},{"text":" ","type":"text"},{"text":"again if the issuer refuses the nonce — and a refresh can’t","type":"text"},{"text":" ","type":"text"},{"text":"run without the holder. The Secure Enclave","type":"text"},{"text":" ","type":"text"},{"text":"enforces it. Off, the app asks for it itself (with","type":"text"},{"text":" ","type":"text"},{"code":"LAContext.evaluatePolicy","type":"codeVoice"},{"text":") before every presentation — in","type":"text"},{"text":" ","type":"text"},{"text":"the app, from a link, through a document provider extension,","type":"text"},{"text":" ","type":"text"},{"text":"and in person — a check the app’s own code keeps, not the","type":"text"},{"text":" ","type":"text"},{"text":"key. For Face ID, the app’s Info.plist must have an","type":"text"},{"text":" ","type":"text"},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"text":"; without one, iOS asks for the","type":"text"},{"text":" ","type":"text"},{"text":"passcode instead.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","kind":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderUserPresence","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc: