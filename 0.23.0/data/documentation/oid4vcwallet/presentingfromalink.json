{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A Verifier asks with an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" link, as a QR code or a link on"},{"type":"text","text":" "},{"type":"text","text":"its page. Register the "},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":" URL scheme in the app’s Info.plist so"},{"type":"text","text":" "},{"type":"text","text":"links open the app, and hand the link to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","isActive":true},{"type":"text","text":". It fetches the Verifier’s"},{"type":"text","text":" "},{"type":"text","text":"signed request, checks its certificate against"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","isActive":true},{"type":"text","text":", and finds the credentials that"},{"type":"text","text":" "},{"type":"text","text":"can answer it. A request from a Verifier the wallet doesn’t trust"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","isActive":true},{"type":"text","text":" before anything is shown."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","isActive":true},{"type":"text","text":" it returns says:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"who is asking: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","type":"reference"},{"text":", its name, and its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","type":"reference"},{"text":" when a registrar the","type":"text"},{"text":" ","type":"text"},{"text":"wallet trusts (","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","type":"reference"},{"text":") registered it,","type":"text"},{"text":" ","type":"text"},{"text":"with its purpose and the claims it’s registered to ask for;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"what it asks for: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries","type":"reference"},{"text":", each with the held","type":"text"},{"text":" ","type":"text"},{"text":"credentials that can answer it, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the request’s alternatives.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Present","text":"Present","level":3,"type":"heading"},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation: Presentation","    do {","        presentation = try await wallet.startPresentation(request: requestLink)","    } catch let error as WalletError where error.code == .requestRefused {","        \/\/ A refused request: the Verifier was told, and may say where to","        \/\/ take the holder next (OpenID4VP §8.2).","        return wallet.takeRefusalRedirect()","    }","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection: Presentation.Selection","    let disclosures: [Presentation.Disclosure]","    do {","        selection = try await presentation.defaultSelection()","        disclosures = try await presentation.preview(selection: selection)","    } catch {","        \/\/ Nothing can be shown: decline, so the Verifier isn't left waiting.","        _ = try? await presentation.decline()","        throw error","    }","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","isActive":true},{"type":"text","text":" picks the first credential that"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"each query’s "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","isActive":true},{"type":"text","text":" instead: a query that"},{"type":"text","text":" "},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","isActive":true},{"type":"text","text":" otherwise), and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","isActive":true},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"type":"text","text":"agrees."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Open "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","isActive":true},{"type":"text","text":", when the Verifier sends"},{"type":"text","text":" "},{"type":"text","text":"one, in the browser the request came from: it’s how a same-device"},{"type":"text","text":" "},{"type":"text","text":"flow returns to the Verifier’s page. The library refuses http and"},{"type":"text","text":" "},{"type":"text","text":"schemes that run code or read local data, but lets through a scheme the"},{"type":"text","text":" "},{"type":"text","text":"Verifier’s own app may have registered: open an https URL in the"},{"type":"text","text":" "},{"type":"text","text":"browser, any other only through "},{"type":"codeVoice","code":"UIApplication.open"},{"type":"text","text":", never in a web"},{"type":"text","text":" "},{"type":"text","text":"view, and never one in the wallet’s own schemes ("},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"openid-credential-offer"},{"type":"text","text":", its redirect URI’s), which would start"},{"type":"text","text":" "},{"type":"text","text":"another flow in the wallet."}],"type":"paragraph"},{"anchor":"When-the-wallet-refuses-a-request","text":"When the wallet refuses a request","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A request the wallet must not answer — one with "},{"type":"codeVoice","code":"transaction_data"},{"type":"text","text":" it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t support, or a parameter OpenID4VP forbids — makes"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","isActive":true},{"type":"text","text":" throw"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/requestRefused","isActive":true},{"type":"text","text":", its "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/protocolError","isActive":true},{"type":"text","text":" "},{"type":"text","text":"the error code the wallet sent the Verifier, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_transaction_data"},{"type":"text","text":". Nothing is shown to the holder, and nothing"},{"type":"text","text":" "},{"type":"text","text":"is presented. The Verifier may answer the refusal with a redirect:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/takeRefusalRedirect()","isActive":true},{"type":"text","text":" returns it, once, and you open it in"},{"type":"text","text":" "},{"type":"text","text":"the browser the request came from, as a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","isActive":true},{"type":"text","text":", so the holder isn’t left"},{"type":"text","text":" "},{"type":"text","text":"stranded. Tell the holder the request wasn’t answered."}],"type":"paragraph"},{"anchor":"Show-whats-being-asked-beyond-a-registration","text":"Show what’s being asked beyond a registration","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For a Verifier with a verified registration, each query’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","isActive":true},{"type":"text","text":" lists the claims it asks for beyond"},{"type":"text","text":" "},{"type":"text","text":"what it’s registered to request, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll","isActive":true},{"type":"text","text":" whether it names no claims at"},{"type":"text","text":" "},{"type":"text","text":"all. The library flags such a query in full, though OpenID4VP 1.0"},{"type":"text","text":" "},{"type":"text","text":"§6.4.1 reads it as asking for no selectively disclosable claims, so a"},{"type":"text","text":" "},{"type":"text","text":"presentation for it discloses only what the credential always shows."},{"type":"text","text":" "},{"type":"text","text":"Nothing is refused for them: show them, and let the holder decide."}],"type":"paragraph"},{"anchor":"Keep-presentations-unlinkable","text":"Keep presentations unlinkable","level":3,"type":"heading"},{"inlineContent":[{"text":"Each presentation uses a copy of the credential, bound to its own key,","type":"text"},{"text":" ","type":"text"},{"text":"so two Verifiers can’t link the holder’s presentations by the","type":"text"},{"text":" ","type":"text"},{"text":"credential. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","isActive":true,"type":"reference"},{"text":" chooses which copy:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation","isActive":true,"type":"reference"},{"text":", the default: a","type":"text"},{"text":" ","type":"text"},{"text":"copy no Verifier has seen, every time.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","isActive":true,"type":"reference"},{"text":": the copy a Verifier","type":"text"},{"text":" ","type":"text"},{"text":"has seen before, so it can recognize a returning holder, and an unused","type":"text"},{"text":" ","type":"text"},{"text":"one for a new Verifier.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Once every copy is used, one is reused. A candidate’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true,"type":"reference"},{"text":" says whether presenting it now would","type":"text"},{"text":" ","type":"text"},{"text":"hand this Verifier a copy another has seen: warn the holder, and","type":"text"},{"text":" ","type":"text"},{"text":"refresh the credential (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true,"type":"reference"},{"text":") when its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true,"type":"reference"},{"text":" reaches zero.","type":"text"}],"type":"paragraph"},{"anchor":"When-delivery-is-uncertain","text":"When delivery is uncertain","level":3,"type":"heading"},{"inlineContent":[{"text":"If sending the response fails in a way that leaves it unknown whether","type":"text"},{"text":" ","type":"text"},{"text":"the Verifier received it, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","isActive":true,"type":"reference"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","isActive":true,"type":"reference"},{"text":" and doesn’t send it again: the","type":"text"},{"text":" ","type":"text"},{"text":"holder should check with the Verifier before sharing again.","type":"text"}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"role":"article","roleHeading":"Article","title":"Presenting from a link"},"seeAlsoSections":[{"anchor":"Presenting-from-a-link","title":"Presenting from a link","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"sections":[],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/takeRefusalRedirect()":{"url":"\/documentation\/oid4vcwallet\/wallet\/takerefusalredirect()","abstract":[{"text":"Where the Verifier asked to take the holder after the wallet","type":"text"},{"text":" ","type":"text"},{"text":"refused its request: when ","type":"text"},{"type":"codeVoice","code":"startPresentation"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"requestRefused"},{"text":", open this URL, if any, as OpenID4VP §8.2 has a","type":"text"},{"text":" ","type":"text"},{"text":"wallet do. It’s returned once.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeRefusalRedirect","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/takeRefusalRedirect()","role":"symbol","type":"topic","title":"takeRefusalRedirect()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/invalidInput":{"role":"symbol","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/invalidinput","title":"invalidInput","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidInput","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Code","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","kind":"typeIdentifier"}],"type":"topic","abstract":[{"text":"An argument, a link or the configuration is malformed.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidInput"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refreshCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV"}],"abstract":[{"text":"Replaces a ","type":"text"},{"type":"codeVoice","code":"refreshable"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new holder key, without the holder signing in","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VCI 1.0 §13.5). The new holder keys sign the Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request’s proof, so with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyStore.Options.holderUserPresence"},{"text":" ","type":"text"},{"text":"on it asks the holder. Use it when ","type":"text"},{"type":"codeVoice","code":"copiesLeft"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","type":"topic","title":"refreshCredential(id:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startPresentation(request:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/startpresentation(request:)","abstract":[{"text":"Fetches and verifies an OpenID4VP request (openid4vp:\/\/…), and","type":"text"},{"text":" ","type":"text"},{"text":"finds the credentials that can answer it.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"startPresentation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Presentation","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","role":"symbol","type":"topic","title":"startPresentation(request:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/copyPolicy-swift.property":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"copyPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CopyPolicy","preciseIdentifier":"s:12OID4VCWallet19WalletConfigurationV10CopyPolicyO"}],"abstract":[{"text":"Which copy of a credential a presentation uses.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.property","type":"topic","title":"copyPolicy","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/requestRefused":{"url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/requestrefused","abstract":[{"text":"The wallet refused a Verifier’s request it must not answer —","type":"text"},{"text":" ","type":"text"},{"code":"transaction_data","type":"codeVoice"},{"text":" it doesn’t support, or a parameter","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VP forbids — and told the Verifier.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.protocolError"},{"type":"text","text":" is the error code it sent."}],"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requestRefused","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Code","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/requestRefused","role":"symbol","type":"topic","title":"requestRefused"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation":{"role":"symbol","url":"\/documentation\/oid4vcwallet\/presentation","title":"Presentation","navigatorTitle":[{"text":"Presentation","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Presentation","kind":"identifier"}],"type":"topic","abstract":[{"text":"Answers one OpenID4VP request: show ","type":"text"},{"type":"codeVoice","code":"verifier"},{"text":", ","type":"text"},{"type":"codeVoice","code":"queries"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"credentialSets"},{"text":", choose a ","type":"text"},{"type":"codeVoice","code":"Selection"},{"text":" (or start from","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"defaultSelection()"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"preview(selection:)"},{"text":" it, then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"respond(selection:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"decline()"},{"text":". The wal