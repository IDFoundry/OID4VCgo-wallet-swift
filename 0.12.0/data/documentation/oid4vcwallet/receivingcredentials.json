{"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"code":"openid-credential-offer:\/\/","type":"codeVoice"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"code":"openid-credential-offer","type":"codeVoice"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance"},{"text":" whose ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer"},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The offer names one of two grants:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authorization code:","type":"text"}],"type":"strong"},{"text":" the holder signs in at the issuer’s pages, in","type":"text"},{"text":" ","type":"text"},{"text":"a browser, which redirects back to the wallet’s redirect URI.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Pre-authorized code:","type":"text"}],"type":"strong"},{"text":" the issuer has already authenticated the","type":"text"},{"text":" ","type":"text"},{"text":"holder, and may ask for a PIN it sent them separately","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Either way, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"text":" then requests, checks and","type":"text"},{"text":" ","type":"text"},{"text":"stores the credentials, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()"},{"text":" ends the issuance.","type":"text"}],"type":"paragraph"},{"text":"Receive an offer","level":3,"type":"heading","anchor":"Receive-an-offer"},{"type":"codeListing","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"syntax":"swift"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result"},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}],"type":"paragraph"},{"text":"Open the issuer’s page","level":3,"type":"heading","anchor":"Open-the-issuers-page"},{"inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()"},{"text":" can begin again. A redirect is used","type":"text"},{"text":" ","type":"text"},{"text":"up by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)"},{"text":" whatever happens,","type":"text"},{"text":" ","type":"text"},{"text":"so after a failure there, begin again rather than retrying it.","type":"text"}],"type":"paragraph"},{"text":"Resume after the app is killed","level":3,"type":"heading","anchor":"Resume-after-the-app-is-killed"},{"inlineContent":[{"text":"iOS can terminate the app while the holder is at the issuer’s pages.","type":"text"},{"text":" ","type":"text"},{"text":"The authorization in progress is kept in the credential store, so when","type":"text"},{"text":" ","type":"text"},{"text":"the redirect arrives at a relaunched app, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)"},{"text":" ","type":"text"},{"text":"completes it and returns an issuance ready for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"text":". Handle every redirect this way: in","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI, from ","type":"text"},{"code":"onOpenURL","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"syntax":"swift"},{"inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Wait for a deferred credential","level":3,"type":"heading","anchor":"Wait-for-a-deferred-credential"},{"inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)"},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt"},{"text":").","type":"text"}],"type":"paragraph"},{"text":"Look after held credentials","level":3,"type":"heading","anchor":"Look-after-held-credentials"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","isActive":true,"type":"reference"},{"text":" lists them, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"returns one with its claims, for display. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"carries the issuer’s names, logos and colours, in the holder’s","type":"text"},{"text":" ","type":"text"},{"text":"language (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","isActive":true,"type":"reference"},{"text":" checks revocation against the issuer’s","type":"text"},{"text":" ","type":"text"},{"text":"status list, which covers many credentials, so the issuer can’t tell","type":"text"},{"text":" ","type":"text"},{"text":"which one is checked.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Each credential arrives as a batch of copies, each bound to its own","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true,"type":"reference"},{"text":"), so presentations can’t be","type":"text"},{"text":" ","type":"text"},{"text":"linked by the credential. When ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"reaches zero, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true,"type":"reference"},{"text":" replaces them without","type":"text"},{"text":" ","type":"text"},{"text":"the holder, if the issuance kept a refresh token","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","isActive":true,"type":"reference"},{"text":"). Otherwise it throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","isActive":true,"type":"reference"},{"text":": receive the credential again.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","isActive":true,"type":"reference"},{"text":" deletes a credential and its keys,","type":"text"},{"text":" ","type":"text"},{"text":"revoking its refresh token at the issuer.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"]}],"metadata":{"roleHeading":"Article","role":"article","title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Receiving-credentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"title":"Receiving credentials"}],"abstract":[{"text":"Receive the credentials a Credential Offer offers, with either grant,","type":"text"},{"text":" ","type":"text"},{"text":"and look after them once they’re held.","type":"text"}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","kind":"symbol","role":"