eIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"How to show it, from the issuer’s metadata when it was received.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","title":"refreshCredential(id:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","kind":"typeIdentifier"}],"abstract":[{"text":"Replaces a ","type":"text"},{"type":"codeVoice","code":"refreshable"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new attested key, without the holder (OpenID4VCI","type":"text"},{"text":" ","type":"text"},{"text":"1.0 §13.5). Use it when ","type":"text"},{"type":"codeVoice","code":"copiesLeft"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startIssuance(offer:)":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","url":"\/documentation\/oid4vcwallet\/wallet\/