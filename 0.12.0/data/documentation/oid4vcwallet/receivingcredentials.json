"kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Issuance","preciseIdentifier":"s:12OID4VCWallet8IssuanceC","kind":"typeIdentifier"}],"abstract":[{"text":"Completes an authorization begun before the app was suspended or","type":"text"},{"text":" ","type":"text"},{"text":"relaunched: ","type":"text"},{"type":"codeVoice","code":"redirect"},{"text":" is the issuer’s redirect back to the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI, delivered to the app (","type":"text"},{"type":"codeVoice","code":"onOpenURL"},{"text":"). Returns the","type":"text"},{"text":" ","type":"text"},{"text":"issuance ready for ","type":"text"},{"type":"codeVoice","code":"requestCredentials()"},{"text":". A redirect matching no","type":"text"},{"text":" ","type":"text"},{"text":"authorization in progress — not this wallet’s, already completed,","type":"text"},{"text":" ","type":"text"},{"text":"or expired — throws ","type":"text"},{"type":"codeVoice","code":".notFound"},{"text":".","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredStatus":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredStatus","kind":"identifier"}],"title":"DeferredStatus","abstract":[{"text":"A deferred credential’s state, from ","type":"text"},{"type":"codeVoice","code":"Wallet.pollDeferred(id:)"},{"text":".","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"DeferredStatus","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/deferredstatus"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/beginAuthorization()":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","url":"\/documentation\/oid4vcwallet\/issuance\/beginauthorization