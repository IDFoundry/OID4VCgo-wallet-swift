{"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, using the "},{"code":"org-iso-mdoc","type":"codeVoice"},{"type":"text","text":" protocol (ISO\/IEC TS"},{"type":"text","text":" "},{"type":"text","text":"18013-7 Annex C). iOS offers the apps that registered a matching"},{"type":"text","text":" "},{"type":"text","text":"document, and shows the chosen app’s document provider extension for"},{"type":"text","text":" "},{"type":"text","text":"the holder’s consent. The extension answers through"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)"},{"type":"text","text":"; the"},{"type":"text","text":" "},{"type":"text","text":"response goes back through Safari, encrypted to the page, with no"},{"type":"text","text":" "},{"type":"text","text":"network request from the wallet."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Safari sends only "},{"code":"org-iso-mdoc","type":"codeVoice"},{"type":"text","text":", not OpenID4VP, and on iOS only:"},{"type":"text","text":" "},{"type":"text","text":"Safari on macOS has no document providers."}]},{"level":3,"anchor":"Set-up-the-app-and-its-extension","text":"Set up the app and its extension","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"The extension:","type":"text"}],"type":"strong"},{"text":" a target whose Info.plist names the extension","type":"text"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"code":"com.apple.identity-document-services.document-provider-ui","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EXAppExtensionAttributes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EXExtensionPointIdentifier","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"The capability:","type":"text"}],"type":"strong"},{"text":" Digital Credentials API – Mobile Document","type":"text"},{"text":" ","type":"text"},{"text":"Provider, on both the app’s and the extension’s App IDs, with the","type":"text"},{"text":" ","type":"text"},{"text":"doctypes the app presents in the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types","type":"codeVoice"},{"text":" ","type":"text"},{"text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL","type":"text"},{"text":" ","type":"text"},{"text":"and Photo ID.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Shared storage:","type":"text"}],"type":"strong"},{"text":" the extension is another process, so the app","type":"text"},{"text":" ","type":"text"},{"text":"keeps its credentials in an App Group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},{"text":"), and its holder keys in","type":"text"},{"text":" ","type":"text"},{"text":"a Keychain access group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup"},{"text":"). Instance and DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keys stay in the app’s own group: the extension presents, but doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"receive. The app saves its configuration where the extension can","type":"text"},{"text":" ","type":"text"},{"text":"read it too.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"level":3,"anchor":"Register-the-documents","text":"Register the documents","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS offers the app only for documents it registered. Whenever the"},{"type":"text","text":" "},{"type":"text","text":"credentials change, register each presentable mdoc and remove the rest."},{"type":"text","text":" "},{"code":"supportedAuthorityKeyIdentifiers","type":"codeVoice"},{"type":"text","text":" names the reader CAs, by subject key"},{"type":"text","text":" "},{"type":"text","text":"identifier, whose requests the document answers."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"]},{"level":3,"anchor":"Answer-in-the-extension","text":"Answer in the extension","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS hands the extension the request in two stages. First,"},{"type":"text","text":" "},{"code":"ISO18013MobileDocumentRequestContext.request","type":"codeVoice"},{"type":"text","text":" describes what’s asked,"},{"type":"text","text":" "},{"type":"text","text":"for the consent screen: show it with the website’s origin, and the"},{"type":"text","text":" "},{"type":"text","text":"candidates from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)"},{"type":"text","text":". Only when the"},{"type":"text","text":" "},{"type":"text","text":"holder shares does iOS release the request itself, to"},{"type":"text","text":" "},{"code":"sendResponse","type":"codeVoice"},{"type":"text","text":"‘s closure. Validate it there, parse it, check it’s what"},{"type":"text","text":" "},{"type":"text","text":"the holder was shown, and answer."}]},{"type":"codeListing","syntax":"swift","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","","    var body: some View {","        Button(\"Share\") { Task { try await share(credentialID: nil) } }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil) for the request's first document.","    func share(credentialID: String?) async throws {","        guard let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let wallet = try SharedWallet.open(provider: nil)","        try await context.sendResponse { raw in","            _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","            let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","            guard let document = presentation.request.documents.first,","                  let chosen = credentialID ?? document.credentials.first?.id else { throw RequestChanged() }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            let response = try await presentation.respond(document: 0, credentialID: chosen, elements: document.elements)","            return ISO18013MobileDocumentResponse(responseData: response.response)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A real consent screen compares the released request with what it"},{"type":"text","text":" "},{"type":"text","text":"showed — the same document, elements and reader — and refuses one that"},{"type":"text","text":" "},{"type":"text","text":"changed. The demo wallet’s "},{"code":"DocumentProvider","type":"codeVoice"},{"type":"text","text":" target does this in full."}]},{"level":3,"anchor":"Name-the-reader","text":"Name the reader","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC"},{"type":"text","text":" "},{"type":"text","text":"18013-5 reader authentication). When the certificate chains to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader"},{"type":"text","text":" "},{"type":"text","text":"names it; otherwise show only the website’s origin."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU"},{"type":"text","text":" accepts only certificates"},{"type":"text","text":" "},{"type":"text","text":"issued for readers, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader"},{"type":"text","text":" "},{"type":"text","text":"refuses requests from any other reader before the holder sees them."}]},{"level":3,"anchor":"Warn-of-linkable-presentations","text":"Warn of linkable presentations","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each candidate’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere"},{"type":"text","text":" says whether"},{"type":"text","text":" "},{"type":"text","text":"presenting it would hand this website a copy another website has seen,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable"},{"type":"text","text":" whether it did. The"},{"type":"text","text":" "},{"type":"text","text":"extension doesn’t refresh used-up copies: have the app do it when it"},{"type":"text","text":" "},{"type":"text","text":"next becomes active, after listing its credentials again."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"]}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","role":"article","title":"Presenting to Safari"},"kind":"article","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"title":"Presenting to Safari","anchor":"Presenting-to-Safari","generated":true}],"abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"title":"mdocReaderRoots","abstract":[{"text":"PEM certificates: the mdoc readers recognized when one signs an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" request (","type":"text"},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"text":"). Empty:","type":"text"},{"text":" ","type":"text"},{"text":"every such request is shown by its origin.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","title":"holderAccessGroup","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"abstract":[{"text":"The Keychain access group holder keys are made in, when the","type":"text"},{"text":" ","type":"text"},{"text":"app shares them with an extension — a document provider","type":"text"},{"text":" ","type":"text"},{"text":"presenting credentials, say — that lists the group in its","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","title":"OID4VCWallet","url":"\/documentation\/oid4vcwallet","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRequireEKU","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"mdocReaderRequireEKU","abstract":[{"text":"Recognizes only reader certificates with the ISO\/IEC 18013-5","type":"text"},{"text":" ","type":"text"},{"text":"reader authentication extended key usage (1.0.18013.5.1.6), so a","type":"text"},{"text":" ","type":"text"},{"text":"certificate issued for another role under ","type":"text"},{"code":"mdocReaderRoots","type":"codeVoice"},{"text":" ","type":"text"},{"text":"isn’t taken for a reader’s.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkable","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"linkable","abstract":[{"text":"Whether the copy presented had been seen by another Verifier.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/response\/linkable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(document:credentialID:elements:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"document","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"credentialID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"elements","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Element","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC7ElementV","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","kind":"typeIdentifier"}],"title":"respond(document:credentialID:elements:)","abstract":[{"text":"Presents the held mdoc ","type":"text"},{"code":"credentialID","type":"codeVoice"},{"text":" for document number","type":"text"},{"text":" ","type":"text"},{"code":"document","type":"codeVoice"},{"text":", disclosing exactly ","type":"text"},{"code":"elements","ty