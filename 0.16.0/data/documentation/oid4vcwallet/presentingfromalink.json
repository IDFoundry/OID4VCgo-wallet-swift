reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","isActive":true},{"text":", its name, and its","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","type":"reference"},{"type":"text","text":" when a registrar the"},{"type":"text","text":" "},{"type":"text","text":"wallet trusts ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","isActive":true},{"type":"text","text":") registered it,"},{"type":"text","text":" "},{"type":"text","text":"with its purpose and the claims it’s registered to ask for;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"what it asks for: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries"},{"type":"text","text":", each with the held"},{"type":"text","text":" "},{"type":"text","text":"credentials that can answer it, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"the request’s alternatives.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Present","anchor":"Present","level":3,"type":"heading"},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation = try await wallet.