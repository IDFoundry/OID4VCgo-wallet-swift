opic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/linkablehere"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","url":"\/documentation\/oid4vcwallet\/walletconfiguration","title":"WalletConfiguration","abstract":[{"type":"text","text":"NewWallet’s configuration."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"WalletConfiguration","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletConfiguration","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"code":"Options.tagPrefix","type":"codeVoice"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"kind":"symbol","title":"KeychainKeyStore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/OID4VC/isTestBuild":{"title":"isTestBuild","abstract":[{"text":"Whether the linked framework is the test build, carrying an","type":"text"},{"text":" ","type":"text"},{"text":"in-process test issuer and Verifier (","type":"text"},{"code":"-tags mobiletest","type":"codeVoice"},{"text":"): an app","type":"text"},{"text":" ","type":"text"},{"text":"should refuse to run on it.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTestBuild"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","kind":"symbol","url":"\/documentation\/oid4vcwallet\/oid4vc\/istestbuild"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","url":"\/documentation\/oid4vcwallet\/filecredentialstore","title":"FileCredentialStore","abstract":[{"type":"text","text":"A credential store of files: one per credential record, in a directory"},{"type":"text","text":" "},{"type":"text","text":"of the app’s (Application Support, by default). Records are written"},{"type":"text","text":" "},{"type":"text","text":"with the given file protection — complete by default: readable only"},{"type":"text","text":" "},{"type":"text","text":"while the device is unlocked — and kept out of backups by default,"},{"type":"text","text":" "},{"type":"text","text":"since a credential is useless without its holder key, which is in"},{"type":"text","text":" "},{"type":"text","text":"this device’s Secure Enclave and can’t be restored elsewhere."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"FileCredentialStore","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileCredentialStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"abstract":[{"text":"The Wallet Provider’s backend, which attests the wallet and its keys","type":"text"},{"text":" ","type":"text"},{"text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results","type":"text"},{"text":" ","type":"text"},{"text":"are compact JWTs. A real one attests only after checking platform","type":"text"},{"text":" ","type":"text"},{"text":"evidence (App Attest) that it’s talking to the genuine app.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"kind":"symbol","title":"WalletProvider"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/development":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/development","abstract":[{"type":"text","text":"Relaxes what production requires, for a wallet talking to services"},{"type":"text","text":" "},{"type":"text","text":"on a development machine. Never ship an app with it set. It lets"},{"type":"text","text":" "},{"type":"text","text":"issuers, Authorization Servers, Verifiers and status lists be on"},{"type":"text","text":" "},{"type":"text","text":"loopback addresses, over http there too, and skips the production"},{"type":"text","text":" "},{"type":"text","text":"checks on receiving credentials: durable stores and keys, and the"},{"type":"text","text":" "},{"type":"text","text":"random source."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"development"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","kind":"symbol","title":"development"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/verifierRoots":{"abstract":[{"type":"text","text":"PEM certificates: the trust anchors for Verifiers’ requests. A request"},{"type":"text","text":" "},{"type":"text","text":"signed by a certificate that doesn’t chain to them is refused unread."}],"title":"verifierRoots","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifierRoots"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/verifierroots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/tlsPins":{"abstract":[{"text":"Pins hosts’ certificates for the wallet’s own HTTPS requests:","type":"text"},{"text":" ","type":"text"},{"text":"host → base64 SHA-256 digests of a certificate’s","type":"text"},{"text":" ","type":"text"},{"text":"SubjectPublicKeyInfo, one of which a certificate in the verified","type":"text"},{"text":" ","type":"text"},{"text":"chain must have, or the request fails as ","type":"text"},{"code":"tlsPin","type":"codeVoice"},{"text":" before anything","type":"text"},{"text":" ","type":"text"},{"text":"is sent. A host is a name, or ","type":"text"},{"code":"*.","type":"codeVoice"},{"text":" and one, matching any name a","type":"text"},{"text":" ","type":"text"},{"text":"label below it; not an IP address. Pins add to certificate","type":"text"},{"text":" ","type":"text"},{"text":"verification, never replace it: pin a CA’s key, so a leaf renewal","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t break the app, and keep a backup pin. They cover the","type":"text"},{"text":" ","type":"text"},{"text":"requests the SDK makes (issuers, Authorization Servers,","type":"text"},{"text":" ","type":"text"},{"text":"Verifiers, status lists), not the app’s own, such as to its","type":"text"},{"text":" ","type":"text"},{"text":"Wallet Provider: pin that client yourself.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/tlspins","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tlsPins","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" : [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","kind":"symbol","title":"tlsPins"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/registrarRoots":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/registrarroots","title":"registrarRoots","abstract":[{"text":"PEM certificates: the registrars whose registrations of Verifiers","type":"text"},{"text":" ","type":"text"},{"text":"the wallet checks (","type":"text"},{"code":"Presentation.Verifier.registration","type":"codeVoice"},{"text":"). Empty:","type":"text"},{"text":" ","type":"text"},{"text":"registrations are ignored.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registrarRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"abstract":[{"text":"Tell the holder what went wrong, retry what may succeed, and log what","type":"text"},{"text":" ","type":"text"},{"text":"helps without personal data.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/handlingerrors","role":"article","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","kind":"article","title":"Handling errors"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"title":"batchSize","abstract":[{"text":"How many copies of each credential to request when an issuer","type":"text"},{"text":" ","type":"text"},{"text":"offers batches, each bound to its own key, so each presentation","type":"text"},{"text":" ","type":"text"},{"text":"can use one no Verifier has seen. 0 means the SDK’s default (5);","type":"text"},{"text":" ","type":"text"},{"text":"it’s capped at the issuer’s batch size.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore/isDurable":{"url":"\/documentation\/oid4vcwallet\/keystore\/isdurable","title":"isDurable","required":true,"role":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore\/isDurable","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDurable","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"defaultImplementations":1,"kind":"symbol","abstract":[{"type":"text","text":"Whether keys survive the app quitting. Receiving credentials needs"},{"type":"text","text":" "},{"type":"text","text":"a durable store unless the configuration is for development; the"},{"text":" ","type":"text"},{"text":"default is false.","type":"text"}]}}}