,{"text":" can later replace a credential’s","type":"text"},{"text":" ","type":"text"},{"text":"copies without the holder. The server must allow the wallet the","type":"text"},{"text":" ","type":"text"},{"code":"offline_access","type":"codeVoice"},{"text":" scope, or the authorization fails.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestRefresh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"abstract":[{"text":"Add the package, give the wallet its keys, its storage and a Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Provider, and create it at launch.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/gettingstarted","role":"article","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","kind":"article","title":"Getting started"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/message":{"abstract":[{"text":"Detail for logs: at most 300 characters, with no personal data, no","type":"text"},{"text":" ","type":"text"},{"text":"remote party’s own description, and no URL’s path or query.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walleterror\/message","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"message","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/message","kind":"symbol","title":"message"},"doc://oid