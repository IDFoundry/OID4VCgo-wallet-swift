:" ","kind":"text"},{"text":"WalletConfiguration","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"code":"Options.tagPrefix","type":"codeVoice"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"kind":"symbol","title":"KeychainKeyStore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"abstract":[{"type":"text","text":"What a Credential Offer offers."}],"title":"Offer","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Offer","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","navigatorTitle":[{"text":"Offer","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/offer"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"url":"\/documentation\/oid4vcwallet\/mdocpresentation","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request (ISO\/IEC TS 18013-7 Annex C): show"},{"type":"text","text":" "},{"type":"codeVoice","code":"request"},{"type":"text","text":" for the holder’s consent, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" once; to decline,"},{"type":"text","text":" "},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","navigatorTitle":[{"text":"MdocPresentation","kind":"identifier"}],"kind":"symbol","title":"MdocPresentation"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Logo":{"url":"\/documentation\/oid4vcwallet\/logo","title":"Logo","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Logo","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Logo","navigatorTitle":[{"text":"Logo","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"An image the issuer names for display: an https URL or a data: image"},{"type":"text","text":" "},{"type":"text","text":"(nothing else reaches the app), with alternative text."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"abstract":[{"text":"The Wallet Provider’s backend, which attests the wallet and its keys","type":"text"},{"text":" ","type":"text"},{"text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results","type":"text"},{"text":" ","type":"text"},{"text":"are compact JWTs. A real one attests only after checking platform","type":"text"},{"text":" ","type":"text"},{"text":"evidence (App Attest) that it’s talking to the genuine app.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"kind":"symbol","title":"WalletProvider"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError":{"url":"\/documentation\/oid4vcwallet\/walleterror","abstract":[{"type":"text","text":"An error from OID4VCgo: a stable "},{"type":"codeVoice","code":"code"},{"type":"text","text":", the issuer’s, Authorization"},{"type":"text","text":" "},{"type":"text","text":"Server’s or Verifier’s own error code when it gave one"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"protocolError"},{"type":"text","text":"), and a message for logs: it never carries personal"},{"type":"text","text":" "},{"type":"text","text":"data, a remote party’s own description, a URL’s path or query, or"},{"type":"text","text":" "},{"type":"text","text":"control characters. "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"a sentence fit to show the holder; "},{"type":"codeVoice","code":"isRetryable"},{"type":"text","text":" says whether trying"},{"type":"text","text":" "},{"type":"text","text":"the same step again may succeed."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletError","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","navigatorTitle":[{"text":"WalletError","kind":"identifier"}],"kind":"symbol","title":"WalletError"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyAgreement":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyAgreement","url":"\/documentation\/oid4vcwallet\/keyagreement","title":"KeyAgreement","abstract":[{"type":"text","text":"ECDH with the wallet’s holder keys inside the key store, for deviceMac"},{"type":"text","text":" "},{"type":"text","text":"in person (ISO\/IEC 18013-5 §9.1.3.5). A "},{"code":"KeyStore","type":"codeVoice"},{"type":"text","text":" that is also one is"},{"type":"text","text":" "},{"type":"text","text":"used for it when "},{"code":"WalletConfiguration.proximityDeviceAuth","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":".macPreferred","type":"codeVoice"},{"type":"text","text":". "},{"code":"KeychainKeyStore","type":"codeVoice"},{"type":"text","text":" is one."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"KeyAgreement","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyAgreement","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReader":{"abstract":[{"type":"text","text":"An ISO\/IEC 18013-5 mdoc reader: a verifier asking for an mdoc in"},{"type":"text","text":" "},{"type":"text","text":"person over BLE. It needs no "},{"type":"codeVoice","code":"Wallet"},{"type":"text","text":". The key store holds the"},{"type":"text","text":" "},{"type":"text","text":"reader’s key, "},{"type":"codeVoice","code":"ProximityReaderConfiguration.readerKeyID"},{"type":"text","text":"; none for a"},{"type":"text","text":" "},{"type":"text","text":"reader that doesn’t sign."}],"title":"ProximityReader","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityReader","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","navigatorTitle":[{"text":"ProximityReader","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/proximityreader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingFromALink":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","url":"\/documentation\/oid4vcwallet\/presentingfromalink","title":"Presenting from a link","abstract":[{"type":"text","text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,"},{"type":"text","text":" "},{"type":"text","text":"let the holder choose, and present exactly that."}],"type":"topic","role":"article","kind":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","url":"\/documentation\/oid4vcwallet\/filecredentialstore","title":"FileCredentialStore","abstract":[{"type":"text","text":"A credential store of files: one per credential record, in a directory"},{"type":"text","text":" "},{"type":"text","text":"of the app’s (Application Support, by default). Records are written"},{"type":"text","text":" "},{"type":"text","text":"with the given file protection — complete by default: readable only"},{"type":"text","text":" "},{"type":"text","text":"while the device is unlocked — and kept out of backups by default,"},{"type":"text","text":" "},{"type":"text","text":"since a credential is useless without its holder key, which is in"},{"type":"text","text":" "},{"type":"text","text":"this device’s Secure Enclave and can’t be restored elsewhere."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"FileCredentialStore","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileCredentialStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/StoreError":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/StoreError","url":"\/documentation\/oid4vcwallet\/storeerror","title":"StoreError","abstract":[{"type":"text","text":"A store’s or provider’s own failure."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"StoreError","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StoreError","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialDetail":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialDetail","url":"\/documentation\/oid4vcwallet\/credentialdetail","title":"CredentialDetail","abstract":[{"type":"text","text":"A credential with its claims, for display."}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CredentialDetail"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CredentialDetail"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"abstract":[{"text":"Tell the holder what went wrong, retry what may succeed, and log what","type":"text"},{"text":" ","type":"text"},{"text":"helps without personal data.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/handlingerrors","role":"article","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","kind":"article","title":"Handling errors"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","url":"\/documentation\/oid4vcwallet\/keystore","title":"KeyStore","abstract":[{"type":"text","text":"The wallet’s keys: P-256 keys whose private halves never leave the"},{"type":"text","text":" "},{"type":"text","text":"store (the Secure Enclave). "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" is the standard one."},{"type":"text","text":" "},{"type":"text","text":"A thrown error reaches Go and comes back as a "},{"type":"codeVoice","code":".platform"},{"type":"text","text":" WalletError."}],"type":"topic","role":"sym