,{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"invalid_challenge"},{"text":"), or App Attest’s server is unavailable. It","type":"text"},{"type":"text","text":" "},{"type":"text","text":"reaches the wallet as "},{"type":"codeVoice","code":".network"},{"type":"text","text":": try again, which gets new"},{"text":" ","type":"text"},{"type":"text","text":"challenges."}],"title":"WalletProviderUnavailableError","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"WalletProviderUnavailableError","kind":"identifier"}],"navigatorTitle":[{"text":"WalletProviderUnavailableError","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","url":"\/documentation\/oid4vcwallet\/walletproviderunavailableerror"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/defaultTimeout":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/defaultTimeout","kind":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/defaulttimeout","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The default timeout of each request, as the Go client’s."}],"title":"defaultTimeout","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultTimeout"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier","text":"TimeInterval"}]},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeviceAppAttestService":{"url":"\/documentation\/oid4vcwallet\/deviceappattestservice","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","navigatorTitle":[{"kind":"identifier","text":"DeviceAppAttestService"}],"title":"DeviceAppAttestService","role":"symbol","type":"topic","abstract":[{"type":"text","text":"App Attest on this device: "},{"type":"codeVoice","code":"DCAppAttestService.shared"},{"type":"text","text":". Its keys are"},{"type":"text","text":" "},{"type":"text","text":"the environment’s the app’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"type":"text","text":" entitlement"},{"type":"text","text":" "},{"type":"text","text":"names: "},{"type":"codeVoice","code":"development"},{"type":"text","text":" for a development build, "},{"type":"codeVoice","code":"production"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"distributed one, which only a provider accepting that environment"},{"type":"text","text":" "},{"type":"text","text":"takes."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeviceAppAttestService"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryInstanceRegistry":{"kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry"},{"type":"text","text":" in memory, lost when the app quits: for tests."},{"type":"text","text":" "},{"type":"text","text":"Every "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider"},{"type":"text","text":" over the same registry shares its locks."}],"title":"InMemoryInstanceRegistry","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"type":"topic","id