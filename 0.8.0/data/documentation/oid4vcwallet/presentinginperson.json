{"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"In person, the holder shows a QR code and the reader scans it: the","type":"text"},{"text":" ","type":"text"},{"text":"code carries the holder’s ephemeral key and how to reach it over","type":"text"},{"text":" ","type":"text"},{"text":"Bluetooth LE. The two devices then exchange encrypted messages over","type":"text"},{"text":" ","type":"text"},{"text":"GATT. The package carries the Bluetooth side itself: your app shows or","type":"text"},{"text":" ","type":"text"},{"text":"scans the QR code, follows the session’s states, and asks the holder.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Both sides need ","type":"text"},{"code":"NSBluetoothAlwaysUsageDescription","type":"codeVoice"},{"text":" in the app’s","type":"text"},{"text":" ","type":"text"},{"text":"Info.plist. Keep the app in the foreground during a session: neither","type":"text"},{"text":" ","type":"text"},{"text":"side keeps one going while the app is suspended. A session answers one","type":"text"},{"text":" ","type":"text"},{"text":"request. Bluetooth failures are ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError","isActive":true,"type":"reference"},{"text":"s; protocol failures","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","isActive":true,"type":"reference"},{"text":"s.","type":"text"}]},{"type":"heading","level":3,"text":"Share as the holder","anchor":"Share-as-the-holder"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:)","isActive":true,"type":"reference"},{"text":" returns a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","isActive":true,"type":"reference"},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode","isActive":true,"type":"reference"},{"text":" you","type":"text"},{"text":" ","type":"text"},{"text":"show. It advertises until a reader connects, then reports","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)","isActive":true,"type":"reference"},{"text":" with who is asking","type":"text"},{"text":" ","type":"text"},{"text":"and what: ask the holder, then respond or decline.","type":"text"}]},{"type":"codeListing","code":["import Foundation","import OID4VCWallet","","\/\/\/ What the holder agreed to share: a requested document, the held","\/\/\/ mdoc to answer it with, and the elements to disclose.","struct InPersonAnswer {","    let document: Int","    let credentialID: String","    let elements: [MdocPresentation.Element]","}","","\/\/\/ Shares an mdoc in person. `showQRCode` displays the code; `consent`","\/\/\/ shows the reader's request and returns the holder's answer, or nil","\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Show ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader","isActive":true,"type":"reference"},{"text":" on the consent screen. A","type":"text"},{"text":" ","type":"text"},{"text":"reader that signs its request (reader authentication) is named, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity\/Status-swift.enum\/trusted","isActive":true,"type":"reference"},{"text":" when its certificate chains","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true,"type":"reference"},{"text":". An unsigned request could","type":"text"},{"text":" ","type":"text"},{"text":"come from anyone who scanned the code. As over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true,"type":"reference"},{"text":" ends a session","type":"text"},{"text":" ","type":"text"},{"text":"from any other reader before the holder sees it.","type":"text"}]},{"type":"paragra