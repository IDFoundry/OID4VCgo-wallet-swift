{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C","type":"text"},{"text":" ","type":"text"},{"text":"Digital Credentials API, using the ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" protocol (ISO\/IEC TS","type":"text"},{"text":" ","type":"text"},{"text":"18013-7 Annex C). iOS offers the apps that registered a matching","type":"text"},{"text":" ","type":"text"},{"text":"document, and shows the chosen app’s document provider extension for","type":"text"},{"text":" ","type":"text"},{"text":"the holder’s consent. The extension answers through","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","isActive":true,"type":"reference"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"response goes back through Safari, encrypted to the page, with no","type":"text"},{"text":" ","type":"text"},{"text":"network request from the wallet.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Safari sends only ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":", not OpenID4VP, and on iOS only:","type":"text"},{"text":" ","type":"text"},{"text":"Safari on macOS has no document providers.","type":"text"}]},{"level":3,"type":"heading","text":"Set up the app and its extension","anchor":"Set-up-the-app-and-its-extension"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"The extension:"}],"type":"strong"},{"text":" a target whose Info.plist names the extension","type":"text"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"type":"codeVoice","code":"com.apple.identity-document-services.document-provider-ui"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"EXAppExtensionAttributes"},{"text":", ","type":"text"},{"type":"codeVoice","code":"EXExtensionPointIdentifier"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"The capability:"}],"type":"strong"},{"text":" Digital Credentials API – Mobile Document","type":"text"},{"text":" ","type":"text"},{"text":"Provider, on both the app’s and the extension’s App IDs, with the","type":"text"},{"text":" ","type":"text"},{"text":"doctypes the app presents in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types"},{"text":" ","type":"text"},{"text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL","type":"text"},{"text":" ","type":"text"},{"text":"and Photo ID.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Shared storage:"}],"type":"strong"},{"text":" the extension is another process, so the app","type":"text"},{"text":" ","type":"text"},{"text":"keeps its credentials in an App Group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true,"type":"reference"},{"text":"), and its holder keys in","type":"text"},{"text":" ","type":"text"},{"text":"a Keychain access group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true,"type":"reference"},{"text":"). Instance and DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keys stay in the app’s own group: the extension presents, but doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"receive. The app saves its configuration where the extension can","type":"text"},{"text":" ","type":"text"},{"text":"read it too.","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"],"type":"codeListing"},{"level":3,"type":"heading","text":"Register the documents","anchor":"Register-the-documents"},{"type":"paragraph","inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change, register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"code":"supportedAuthorityKeyIdentifiers","type":"codeVoice"},{"text":" names the reader CAs, by subject key","type":"text"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}]},{"syntax":"swift","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"],"type":"codeListing"},{"level":3,"type":"heading","text":"Answer in the extension","anchor":"Answer-in-the-extension"},{"type":"paragraph","inlineContent":[{"text":"iOS hands the extension the request in two stages. First,","type":"text"},{"text":" ","type":"text"},{"code":"ISO18013MobileDocumentRequestContext.request","type":"codeVoice"},{"text":" describes what’s asked,","type":"text"},{"text":" ","type":"text"},{"text":"for the consent screen: show it with the website’s origin, and the","type":"text"},{"text":" ","type":"text"},{"text":"candidates from ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","isActive":true,"type":"reference"},{"text":". Only when the","type":"text"},{"text":" ","type":"text"},{"text":"holder shares does iOS release the request itself, to","type":"text"},{"text":" ","type":"text"},{"code":"sendResponse","type":"codeVoice"},{"text":"‘s closure. Validate it there, parse it, check it’s what","type":"text"},{"text":" ","type":"text"},{"text":"the holder was shown, and answer.","type":"text"}]},{"syntax":"swift","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","","    var body: some View {","        Button(\"Share\") { Task { try await share(credentialID: nil) } }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil) for the request's first document.","    func share(credentialID: String?) async throws {","        guard let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let wallet = try SharedWallet.open(provider: nil)","        try await context.sendResponse { raw in","            _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","            let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","            guard let document = presentation.request.documents.first,","                  let chosen = credentialID ?? document.credentials.first?.id else { throw RequestChanged() }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            let response = try await presentation.respond(document: 0, credentialID: chosen, elements: document.elements)","            return ISO18013MobileDocumentResponse(responseData: response.response)","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A real consent screen compares the released request with what it","type":"text"},{"text":" ","type":"text"},{"text":"showed — the same document, elements and reader — and refuses one that","type":"text"},{"text":" ","type":"text"},{"text":"changed. The demo wallet’s ","type":"text"},{"code":"DocumentProvider","type":"codeVoice"},{"text":" target does this in full.","type":"text"}]},{"level":3,"type":"heading","text":"Name the reader","anchor":"Name-the-reader"},{"type":"paragraph","inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true,"type":"reference"},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"text":"issued for readers, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}]},{"level":3,"type":"heading","text":"Warn of linkable presentations","anchor":"Warn-of-linkable-presentations"},{"type":"paragraph","inlineContent":[{"text":"Each candidate’s ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true,"type":"reference"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true,"type":"reference"},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}]}]}],"kind":"article","abstract":[{"type":"text","text":"Answer a web page’s request for an mdoc over the Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, as an iOS document provider."}],"seeAlsoSections":[{"generated":true,"title":"Presenting to Safari","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"anchor":"Presenting-to-Safari"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Presenting to Safari","modules":[{"name":"OID4VCWallet"}]},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"navigatorTitle":[{"text":"MdocPresentation","kind":"identifier"}],"title":"MdocPresentation","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","abstract":[{"text":"An ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" request (ISO\/IEC TS 18013-7 Annex C): show","type":"text"},{"text":" ","type":"text"},{"code":"request","type":"codeVoice"},{"text":" for the holder’s consent, then ","type":"text"},{"code":"respond","type":"codeVoice"},{"text":" once; to decline,","type":"text"},{"text":" ","type":"text"},{"text":"cancel the platform’s request — nothing is sent to the reader.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/reader":{"title":"reader","kind":"symbol","abstract":[{"type":"text","text":"The subject common name of the reader that signed the request,"},{"type":"text","text":" "},{"type":"text","text":"when its certificate chains to"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletConfiguration.mdocReaderRoots"},{"type":"text","text":"; “” when the holder can"},{"type":"text","text":" "},{"type":"text","text":"only be shown "},{"type":"codeVoice","code":"origin"},{"type":"text","text":"."}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/reader","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"title":"linkable","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkable","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","abstract":[{"type":"text","text":"Whether the copy presented had been seen by another Verifier."}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/response\/linkable","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"title":"holderAccessGroup","abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","type":"topic","title":"mdocReaderRequireEKU","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","kind":"symbol","abstract":[{"type":"text","text":"Recognizes only reader certificates with the ISO\/IEC 18013-5"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage (1.0.18013.5.1.6), so a"},{"type":"text","text":" "},{"type":"text","text":"certificate issued for another role under "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":" "},{"type":"text","text":"isn’t taken for a reader’s."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRequireEKU","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/linkableHere":{"title":"linkableHere","abstract":[{"text":"Whether presenting it to the Verifier asking would hand it a copy","type":"text"},{"text":" ","type":"text"},{"text":"another Verifier has seen. Set only on a presentation’s candidates.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/linkablehere","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkableHere","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","type":"topic","title":"requireTrustedMdocReader","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader","kind":"symbol","abstract":[{"type":"text","text":"Refuses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request no recognized reader signed:"},{"type":"text","text":" "},{"type":"codeVoice","code":"startMdocPresentation"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"untrustedVerifier"},{"type":"text","text":", and nothing is"},{"type":"text","text":" "},{"type":"text","text":"shown to the holder. Needs "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requireTrustedMdocReader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"title":"mdocCandidates(origin:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocCandidates","kind":"identifier"},{"text":"(","kind":"text"},{"text":"origin","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","abstract":[{"type":"text","text":"The held mdocs, each with whether the page at "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" has been"},{"type":"text","text":" "},{"type":"text","text":"shown it and whether presenting it there now would be linkable"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"shownToVerifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"linkableHere"},{"type":"text","text":"): for a document provider’s"},{"type":"text","text":" "},{"type":"text","text":"consent screen, shown before iOS releases the request itself."},{"type":"text","text":" "},{"type":"codeVoice","code":"MdocPresentation.request"},{"type":"text","text":" says the same once it has."}],"url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","type":"topic","title":"mdocReaderRoots","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","kind":"symbol","abstract":[{"type":"text","text":"PEM certificates: the mdoc readers recognized when one signs an"},{"type":"text","text":" "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request ("},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"every such request is shown by its origin."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"title":"inAppGroup(_:options:)","kind":"symbol","abstract":[{"type":"text","text":"A store in the app group "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":"’s container"},{"type"