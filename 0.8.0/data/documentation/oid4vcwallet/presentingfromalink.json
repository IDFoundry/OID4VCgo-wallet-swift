.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true,"type":"reference"},{"text":" reaches zero.","type":"text"}]},{"level":3,"type":"heading","text":"When delivery is uncertain","anchor":"When-delivery-is-uncertain"},{"type":"paragraph","inlineContent":[{"text":"If sending the response fails in a way that leaves it unknown whether","type":"text"},{"text":" ","type":"text"},{"text":"the Verifier received it, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","isActive":true,"type":"reference"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","isActive":true,"type":"reference"},{"text":" and doesn’t send it again: the","type":"text"},{"text":" ","type":"text"},{"text":"holder should check with the Verifier before sharing again.","type":"text"}]}]}],"kind":"article","abstract":[{"type":"text","text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,"},{"type":"text","text":" "},{"type":"text","text":"let the holder choose, and present exactly that."}],"seeAlsoSections":[{"generated":true,"title":"Presenting from a link","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"],"anchor":"Presenting-from-a-link"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Presenting from a link","modules":[{"name":"OID4VCWallet"}]},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},