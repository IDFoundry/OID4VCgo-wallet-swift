nd":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/Result":{"navigatorTitle":[{"text":"Result","kind":"identifier"}],"title":"Issuance.Result","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","abstract":[{"type":"text","text":"What "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":" obtained."}],"url":"\/documentation\/oid4vcwallet\/issuance\/result","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential/accessTokenExpiresAt":{"title":"accessTokenExpiresAt","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenExpiresAt","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation4DateV","kind":"typeIdentifier","text":"Date"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","abstract":[{"type":"text","text":"When the access token it’s polled with expires, if the issuer"},{"type":"text","text":" "},{"type":"text","text":"said: after it, polls fail and it can only be abandoned."}],"url":"\/documentation\/oid4vcwallet\/deferredcredential\/accesstokenexpiresat","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/display":{"title":"display","abstract":[{"text":"How to show it, from the issuer’s metadata when it was received.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/display","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CredentialDisplay","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialDisplayV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"title":"checkStatus(id:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkStatus","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, checks its"},{"type":"text","text":" "},{"type":"text","text":"signature, and returns the credential with its revocation status"},{"type":"text","text":" "},{"type":"text","text":"recorded. The list covers many credentials, so fetching it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t tell the issuer which one is checked. A credential without"},{"type":"text","text":" "},{"type":"text","text":"a status list is returned as it is."}],"url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/reissueRequired":{"title":"reissueRequired","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/reissuerequired","abstract":[{"text":"A credential can’t be refreshed: no refresh token was kept, or","type":"text"},{"text":" ","type":"text"},{"text":"the Authorization Server no longer accepts it. Receive it again","type":"text"},{"text":" ","type":"text"},{"text":"from a new offer.","type":"text"}],"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reissueRequired","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"text":"Code","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/notFound":{"title":"notFound","abstract":[{"text":"No key, credential, deferred credential or authorization in progress","type":"text"},{"text":" ","type":"text"},{"text":"with that ID.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/notfound","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"notFound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WalletError","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Code","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/close()":{"title":"close()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{