":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"title":"KeychainKeyStore","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HttpWalletProvider"}],"title":"HttpWalletProvider","navigatorTitle":[{"kind":"identifier","text":"HttpWalletProvider"}],"url":"\/documentation\/oid4vcwallet\/httpwalletprovider","abstract":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"},{"text":" over the Wallet Provider HTTP protocol, version","type":"text"},{"text":" ","type":"text"},{"text":"1, that OID4VCgo’s ","type":"text"},{"code":"walletprovider.Provider.Handler","type":"codeVoice"},{"text":" serves","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"with Apple App Attest (","type":"text"},{"code":"apple-app-attest","type":"codeVoice"},{"text":") as its evidence:","type":"text"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWalle