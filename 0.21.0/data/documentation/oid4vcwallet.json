"},{"type":"text","text":" "},{"type":"codeVoice","code":"credentialSets"},{"type":"text","text":", choose a "},{"type":"codeVoice","code":"Selection"},{"type":"text","text":" (or start from"},{"type":"text","text":" "},{"type":"codeVoice","code":"defaultSelection()"},{"type":"text","text":"), "},{"code":"preview(selection:)","type":"codeVoice"},{"type":"text","text":" it, then"},{"type":"text","text":" "},{"type":"codeVoice","code":"respond(selection:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"decline()"},{"type":"text","text":". The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"text":"(","type":"text"},{"code":"WalletError.Code.invalidSelection","type":"codeVoice"},{"text":" otherwise).","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Presentation"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/presentation","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","title":"Presentation","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Presentation"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialDisplay":{"role":"symbol","abstract":[{"type":"text","text":"How to show a credential, from the issuer’s metadata (OpenID4VCI 1.0"},{"type":"text","text":" "},{"type":"text","text":"§12.2.4) in the holder’s language: each part only when the issuer"},{"type":"text","text":" "},{"type":"text","text":"gives it. Colours are CSS colours, such as “#12107c”."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialDisplay","title":"CredentialDisplay","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CredentialDisplay"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CredentialDispla