{"type":"text","text":" "},{"type":"text","text":"a sentence fit to show the holder; "},{"type":"codeVoice","code":"isRetryable"},{"type":"text","text":" says whether trying"},{"type":"text","text":" "},{"type":"text","text":"the same step again may succeed."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/VerifiedMdoc/statusList":{"type":"topic","role":"symbol","kind":"symbol","title":"statusList","url":"\/documentation\/oid4vcwallet\/verifiedmdoc\/statuslist","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/statusList","abstract":[{"type":"text","text":"The MSO’s status list reference, unchecked: check it before"},{"type":"text","text":" "},{"type":"text","text":"relying on the document."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statusList","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StatusListReference","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12VerifiedMdocV19StatusListReferenceV"},{"text":"?","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderIdentity":{"title":"ProximityReaderIdentity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityReaderIdentity"}],"url":"\/documentation\/oid4vcwallet\/proximityreaderidentity","navigatorTitle":[{"kind":"identifier","text":"ProximityReaderIdentity"}],"abstract":[{"type":"text","text":"Who sent a request, as the holder sees it."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation":{"title":"ProximityPresentation","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind