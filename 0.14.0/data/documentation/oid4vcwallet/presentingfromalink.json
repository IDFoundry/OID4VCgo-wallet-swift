{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","title":"Presenting from a link","role":"article"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A Verifier asks with an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" link, as a QR code or a link on"},{"type":"text","text":" "},{"type":"text","text":"its page. Register the "},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":" URL scheme in the app’s Info.plist so"},{"type":"text","text":" "},{"type":"text","text":"links open the app, and hand the link to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","isActive":true},{"type":"text","text":". It fetches the Verifier’s"},{"type":"text","text":" "},{"type":"text","text":"signed request, checks its certificate against"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","isActive":true},{"type":"text","text":", and finds the credentials that"},{"type":"text","text":" "},{"type":"text","text":"can answer it. A request from a Verifier the wallet doesn’t trust"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","isActive":true},{"type":"text","text":" before anything is shown."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","isActive":true},{"type":"text","text":" it returns says:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"who is asking: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property"},{"type":"text","text":", its name, and its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration"},{"type":"text","text":" when a registrar the"},{"type":"text","text":" "},{"type":"text","text":"wallet trusts ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots"},{"type":"text","text":") registered it,"},{"type":"text","text":" "},{"type":"text","text":"with its purpose and the claims it’s registered to ask for;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what it asks for: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries"},{"type":"text","text":", each with the held"},{"type":"text","text":" "},{"type":"text","text":"credentials that can answer it, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the request’s alternatives."}]}]}]},{"text":"Present","anchor":"Present","type":"heading","level":3},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation = try await wallet.startPresentation(request: requestLink)","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection = try await presentation.defaultSelection()","    let disclosures = try await presentation.preview(selection: selection)","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","isActive":true},{"type":"text","text":" picks the first credential that"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"each query’s "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","isActive":true},{"type":"text","text":" instead: a query that"},{"type":"text","text":" "},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","isActive":true},{"type":"text","text":" otherwise), and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","isActive":true},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"type":"text","text":"agrees."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Open "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","isActive":true},{"type":"text","text":", when the Verifier sends"},{"type":"text","text":" "},{"type":"text","text":"one, in the browser the request came from: it’s how a same-device"},{"type":"text","text":" "},{"type":"text","text":"flow returns to the Verifier’s page."}],"type":"paragraph"},{"text":"Show what’s being asked beyond a registration","anchor":"Show-whats-being-asked-beyond-a-registration","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"For a Verifier with a verified registration, each query’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","isActive":true},{"type":"text","text":" lists the claims it asks for beyond"},{"type":"text","text":" "},{"type":"text","text":"what it’s registered to request, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll","isActive":true},{"type":"text","text":" whether it asks for every claim."},{"type":"text","text":" "},{"type":"text","text":"Nothing is refused for them: show them, and let the holder decide."}],"type":"paragraph"},{"text":"Keep presentations unlinkable","anchor":"Keep-presentations-unlinkable","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Each presentation uses a copy of the credential, bound to its own key,"},{"type":"text","text":" "},{"type":"text","text":"so two Verifiers can’t link the holder’s presentations by the"},{"type":"text","text":" "},{"type":"text","text":"credential. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","isActive":true},{"type":"text","text":" chooses which copy:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation"},{"type":"text","text":", the default: a"},{"type":"text","text":" "},{"type":"text","text":"copy no Verifier has seen, every time."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier"},{"type":"text","text":": the copy a Verifier"},{"type":"text","text":" "},{"type":"text","text":"has seen before, so it can recognize a returning holder, and an unused"},{"type":"text","text":" "},{"type":"text","text":"one for a new Verifier."}]}]}]},{"inlineContent":[{"type":"text","text":"Once every copy is used, one is reused. A candidate’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"type":"text","text":" says whether presenting it now would"},{"type":"text","text":" "},{"type":"text","text":"hand this Verifier a copy another has seen: warn the holder, and"},{"type":"text","text":" "},{"type":"text","text":"refresh the credential ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true},{"type":"text","text":") when its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true},{"type":"text","text":" reaches zero."}],"type":"paragraph"},{"text":"When delivery is uncertain","anchor":"When-delivery-is-uncertain","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"If sending the response fails in a way that leaves it unknown whether"},{"type":"text","text":" "},{"type":"text","text":"the Verifier received it, "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","isActive":true},{"type":"text","text":" and doesn’t send it again: the"},{"type":"text","text":" "},{"type":"text","text":"holder should check with the Verifier before sharing again."}],"type":"paragraph"}]}],"sections":[],"seeAlsoSections":[{"generated":true,"title":"Presenting from a link","anchor":"Presenting-from-a-link","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/deliveryUnknown":{"title":"deliveryUnknown","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveryUnknown"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code"}],"url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/deliveryunknown","abstract":[{"text":"Sending a presentation failed in a way that leaves it unknown","type":"text"},{"text":" ","type":"text"},{"text":"whether the Verifier received it: it’s not sent again.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/preview(selection:)":{"type":"topic","role":"symbol","kind":"symbol","title":"preview(selection:)","url":"\/documentation\/oid4vcwallet\/presentation\/preview(selection:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","abstract":[{"text":"What responding with ","type":"text"},{"code":"selection","type":"codeVoice"},{"text":" would disclose, without signing","type":"text"},{"text":" ","type":"text"},{"text":"or sending anything.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"preview"},{"kind":"text","text":"("},{"kind":"externalParam","text":"selection"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC9Selectiona","text":"Selection"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC10DisclosureV","text":"Disclosure"},{"kind":"text","text":"]"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/respond(selection:)":{"title":"respond(selection:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"selection"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12OID4VCWallet12PresentationC9Selectiona","kind":"typeIdentifier","text":"Selection"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet12PresentationC9PresentedV","kind":"typeIdentifier","text":"Presented"}],"url":"\/documentation\/oid4vcwallet\/presentation\/respond(selection:)","abstract":[{"type":"text","text":"Presents exactly "},{"type":"codeVoice","code":"selection"},{"type":"text","text":": holder keys sign now, so a key"},{"type":"text","text":" "},{"type":"text","text":"store requiring user presence prompts."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/credentialSets":{"type":"topic","role":"symbol","kind":"symbol","title":"credentialSets","url":"\/documentation\/oid4vcwallet\/presentation\/credentialsets","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","abstract":[{"text":"The request’s sets of alternatives; none means every query must","type":"text"},{"text":" ","type":"text"},{"text":"be answered.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"credentialSets"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC13CredentialSetV","text":"CredentialSet"},{"kind":"text","text":"]"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/credentials":{"title":"credentials","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"credentials"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary"},{"kind":"text","text":"]"}],"url":"\/documentation\/oid4vcwallet\/presentation\/query\/credentials","abstract":[{"type":"text","text":"The held credentials that can answer it."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/copyPolicy-swift.property":{"title":"copyPolicy","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"copyPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet19WalletConfigurationV10CopyPolicyO","text":"CopyPolicy"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.property","abstract":[{"text":"Which copy of a credential a presentation uses.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/copiesLeft":{"title":"copiesLeft","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"copiesLeft","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/oid4vcwallet\/credentialsummary\/copiesleft","abstract":[{"type":"text","text":"How many copies no Verifier has seen."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/defaultSelection()":{"type":"topic","role":"symbol","kind":"symbol","title":"defaultSelection()","url":"\/documentation\/oid4vcwallet\/presentation\/defaultselection()","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","abstract":[{"type":"text","text":"The selection the wallet would make itself, for an app with no"},{"type":"text","text":" "},{"type":"text","text":"policy of its own, or to start from: the first answerable option"},{"type":"text","text":" "},{"type":"text","text":"of each credential set, and each query’s first credential (all of"},{"type":"text","text":" "},{"type":"text","text":"them when it takes several). Throws "},{"type":"codeVoice","code":"noMatchingCredential"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the request can’t be answered."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSelection","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Selection","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC9Selectiona"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Registration":{"title":"Presentation.Registration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Registration"}],"url":"\/documentation\/oid4vcwallet\/presentation\/registration","navigatorTitle":[{"kind":"identifier","text":"Registration"}],"abstract":[{"type":"text","text":"A Verifier’s registration with a registrar: who it is and what it"},{"text":" ","type":"text"},{"type":"text","text":"may request, as the registrar attests."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/verifier-swift.property":{"type":"topic","role":"symbol","kind":"symbol","title":"verifier","url":"\/documentation\/oid4vcwallet\/presentation\/verifier-swift.property","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","abstract":[{"text":"Who is asking.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC8VerifierV","text":"Verifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/untrustedVerifier":{"type":"topic","role":"symbol","kind":"symbol","title":"untrustedVerifier","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/untrustedverifier","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","abstract":[{"type":"text","text":"The Verifier’s request is signed with a certificate that"},{"type":"text","text":" "},{"type":"text","text":"doesn’t chain to "},{"type":"codeVoice","code":"verifierRoots"},{"type":"text","text":": it’s refused unread."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"untrustedVerifier","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"text":"Code","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/queries":{"type":"topic","role":"symbol","kind":"symbol","title":"queries","url":"\/documentation\/oid4vcwallet\/presentation\/queries","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries","abstract":[{"text":"The request’s credential queries, in its order.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"queries"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC5QueryV","text":"Query"},{"kind":"text","text":"]"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/unregisteredAll":{"type":"topic","role":"symbol","kind":"symbol","title":"unregisteredAll","url":"\/documentation\/oid4vcwallet\/presentation\/query\/unregisteredall","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll","abstract":[{"type":"text","text":"Whether it asks for every claim, beyond a verified registration."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unregisteredAll","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"type":"topic","role":"symbol","kind":"symbol","title":"refreshCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","abstract":[{"text":"Replaces a ","type":"text"},{"code":"refreshable","type":"codeVoice"},{"text":" credential’s co