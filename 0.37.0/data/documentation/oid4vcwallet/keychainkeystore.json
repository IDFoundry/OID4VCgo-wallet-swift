"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC","text":"MdocPresentation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","text":"Answer"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC9RespondedV","text":"Responded"}],"type":"topic","title":"respond(answers:)","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/respond(answers:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","abstract":[{"type":"text","text":"Presents several of the request’s documents in one response, each"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"answers"},{"type":"text","text":" as "},{"type":"codeVoice","code":"respond(document:credentialID:elements:)"},{"type":"text","text":" presents"},{"type":"text","text":" "},{"type":"text","text":"one, and sends it, which ends the session. A document left out"},{"type":"text","text":" "},{"type":"text","text":"isn’t in the response: the reader may ask for more than the holder"},{"type":"text","text":" "},{"type":"text","text":"shares. No document may be answered twice, nor one credential"},{"type":"text","text":" "},{"type":"text","text":"answer two. Each holder key signs now, in the request’s order; a"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" requiring user presence asks the holder once for"},{"type":"text","text":" "},{"type":"text","text":"them all ("},{"type":"codeVoice","code":"KeychainKeyStore.Options.holderUserPresence"},{"type":"text","text":"). On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" — the prompt cancelled, say — nothing was sent and"},{"type":"text","text":" "},{"type":"text","text":"the request stands: try again, or "},{"type":"codeVoice","code":"decline"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/publicKey(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/publicKey(id:)","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/publickey(id:)","title":"publicKey(id:)","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"publicKey"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":"?"}],"abstract":[]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct":{"title":"KeychainKeyStore.Options","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Options"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"abstract":[{"text":"How the store makes and keeps keys.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"type":"topic","title":"Presenting in person","url":"\/documentation\/oid4vcwallet\/presentinginperson","abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth