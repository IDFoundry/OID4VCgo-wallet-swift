{"metadata":{"title":"Presenting in person","role":"article","roleHeading":"Article","modules":[{"name":"OID4VCWallet"}]},"seeAlsoSections":[{"anchor":"Presenting-in-person","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"],"generated":true,"title":"Presenting in person"}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentinginperson"]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In person, the holder shows a QR code and the reader scans it: the"},{"type":"text","text":" "},{"type":"text","text":"code carries the holder’s ephemeral key and how to reach it over"},{"type":"text","text":" "},{"type":"text","text":"Bluetooth LE. The two devices then exchange encrypted messages over"},{"type":"text","text":" "},{"type":"text","text":"GATT. The package carries the Bluetooth side itself: your app shows or"},{"type":"text","text":" "},{"type":"text","text":"scans the QR code, follows the session’s states, and asks the holder."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Engagement is by QR code only. NFC engagement (a tap instead of the"},{"type":"text","text":" "},{"type":"text","text":"code) is in OID4VCgo’s Kotlin library, not this package: an iOS holder"},{"type":"text","text":" "},{"type":"text","text":"can’t answer a reader’s tap, and an iOS reader can’t tap a holder. An"},{"type":"text","text":" "},{"type":"text","text":"Android reader or holder that offers both still works with this"},{"type":"text","text":" "},{"type":"text","text":"package over the QR code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both sides need "},{"type":"codeVoice","code":"NSBluetoothAlwaysUsageDescription"},{"type":"text","text":" in the app’s"},{"type":"text","text":" "},{"type":"text","text":"Info.plist. Keep the app in the foreground during a session: neither"},{"type":"text","text":" "},{"type":"text","text":"side keeps one going while the app is suspended. A session answers one"},{"type":"text","text":" "},{"type":"text","text":"request. Bluetooth failures are "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError","type":"reference","isActive":true},{"type":"text","text":"s; protocol failures"},{"type":"text","text":" "},{"type":"text","text":"are "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","type":"reference","isActive":true},{"type":"text","text":"s."}]},{"text":"Share as the holder","type":"heading","level":3,"anchor":"Share-as-the-holder"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","isActive":true,"type":"reference"},{"text":" returns a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","isActive":true,"type":"reference"},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode","isActive":true,"type":"reference"},{"text":" you","type":"text"},{"text":" ","type":"text"},{"text":"show. It offers both ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityBLEMode","isActive":true,"type":"reference"},{"text":"s by default: it advertises","type":"text"},{"text":" ","type":"text"},{"text":"for the reader and scans for it at once, until a reader connects","type":"text"},{"text":" ","type":"text"},{"text":"either way (a reader offered both should connect in central client","type":"text"},{"text":" ","type":"text"},{"text":"mode). Pass ","type":"text"},{"code":"modes","type":"codeVoice"},{"text":" to offer one. It then reports","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)","isActive":true,"type":"reference"},{"text":" with who is asking","type":"text"},{"text":" ","type":"text"},{"text":"and what: ask the holder, then respond or decline.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import OID4VCWallet","","\/\/\/ What the holder agreed to share: a requested document, the held","\/\/\/ mdoc to answer it with, and the elements to disclose.","struct InPersonAnswer {","    let document: Int","    let credentialID: String","    let elements: [MdocPresentation.Element]","}","","\/\/\/ Shares an mdoc in person. `showQRCode` displays the code; `consent`","\/\/\/ shows the reader's request and returns the holder's answer, or nil","\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"]},{"type":"paragraph","inlineContent":[{"text":"Show ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader","isActive":true,"type":"reference"},{"text":" on the consent screen. A","type":"text"},{"text":" ","type":"text"},{"text":"reader that signs its request (reader authentication) is named, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity\/Status-swift.enum\/trusted","isActive":true,"type":"reference"},{"text":" when its certificate chains","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true,"type":"reference"},{"text":". An unsigned request could","type":"text"},{"text":" ","type":"text"},{"text":"come from anyone who scanned the code. As over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true,"type":"reference"},{"text":" ends a session","type":"text"},{"text":" ","type":"text"},{"text":"from any other reader before the holder sees it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/cancel()","isActive":true,"type":"reference"},{"text":" ends a session at any point, as the","type":"text"},{"text":" ","type":"text"},{"text":"holder leaves the screen, say. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","isActive":true,"type":"reference"},{"text":" sets how long it","type":"text"},{"text":" ","type":"text"},{"text":"waits: by default 60 seconds for a reader to connect, 30 for its","type":"text"},{"text":" ","type":"text"},{"text":"request, and 300 for the holder to decide.","type":"text"}]},{"text":"Read as the verifier","type":"heading","level":3,"anchor":"Read-as-the-verifier"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","isActive":true,"type":"reference"},{"text":" needs no ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true,"type":"reference"},{"text":": give it the IACAs whose","type":"text"},{"text":" ","type":"text"},{"text":"mdocs it accepts, and, to sign its requests so holders see who is","type":"text"},{"text":" ","type":"text"},{"text":"asking, a key in a ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true,"type":"reference"},{"text":" and its certificate chain, with the","type":"text"},{"text":" ","type":"text"},{"text":"reader authentication extended key usage","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration","isActive":true,"type":"reference"},{"text":"). The reader is a production one: it","type":"text"},{"text":" ","type":"text"},{"text":"refuses (","type":"text"},{"code":"invalidInput","type":"codeVoice"},{"text":") a configuration that leaves a decision open:","type":"text"},{"text":" ","type":"text"},{"text":"which IACAs issue which document types (","type":"text"},{"code":"anyIssuerForAnyType","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"issuerRootsByDocType","type":"codeVoice"},{"text":"), and each role’s revocation (","type":"text"},{"code":"revocation","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"code":"crls","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"noRevocationCheck","type":"codeVoice"},{"text":" to decline). ","type":"text"},{"code":"development","type":"codeVoice"},{"text":" relaxes","type":"text"},{"text":" ","type":"text"},{"text":"this, for trying out a development issuer’s documents; never ship an","type":"text"},{"text":" ","type":"text"},{"text":"app with it set. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader\/start(qrCode:docType:elements:timeouts:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"takes the holder’s QR code and what to ask for.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Reads an mDL's name and portrait from the holder whose QR code was","\/\/\/ scanned. Returns the verified mdoc, or nil if the holder declined or","\/\/\/ the mdoc isn't known to be unrevoked.","func readInPerson(qrCode: String, issuerRoots: String, crls: String) async throws -> VerifiedMdoc? {","    let reader = try ProximityReader(configuration: ProximityReaderConfiguration(","        issuerRoots: issuerRoots, crls: crls, revocation: [.issuer, .status],","        anyIssuerForAnyType: true))","    let session = try reader.start(qrCode: qrCode, docType: \"org.iso.18013.5.1.mDL\",","                                   elements: [\"org.iso.18013.5.1\": [\"given_name\", \"family_name\", \"portrait\"]])","    for await state in session.states {","        switch state {","        case .verified(let mdoc):","            let status = try await session.checkStatus()","            return status == .valid || status == .noStatus ? mdoc : nil","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc","isActive":true,"type":"reference"},{"text":" carries the disclosed elements, the document signer","type":"text"},{"text":" ","type":"text"},{"text":"and the IACA it chains to, and its validity. Decide which issuers to","type":"text"},{"text":" ","type":"text"},{"text":"accept on ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuerChain","isActive":true,"type":"reference"},{"text":", the verified certificate path:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuer","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/trustAnchor","isActive":true,"type":"reference"},{"text":" are names any","type":"text"},{"text":" ","type":"text"},{"text":"document signer under a trusted IACA can choose, for display.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session doesn’t check revocation itself:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderSession\/checkStatus()","isActive":true},{"type":"text","text":" does, once the session is"},{"type":"text","text":" "},{"type":"codeVoice","code":".verified"},{"type":"text","text":". It fetches the issuer’s status list over the network, so"},{"type":"text","text":" "},{"type":"text","text":"the reader needs a connection then, and verifies the list is signed"},{"type":"text","text":" "},{"type":"text","text":"under the certificate the document names or the CA that signed the"},{"type":"text","text":" "},{"type":"text","text":"document signer (ISO\/IEC 18013-5 §12.3.6). Rely on the document only"},{"type":"text","text":" "},{"type":"text","text":"when it’s "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/valid","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/noStatus","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson"},"abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,","type":"text"},{"text":" ","type":"text"},{"text":"with ISO\/IEC 18013-5 device retrieval.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/Request/reader":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ProximityReaderIdentity","preciseIdentifier":"s:12OID4VCWallet23ProximityReaderIdentityV","kind":"typeIdentifier"}],"title":"reader","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader","abstract":[{"type":"text","text":"Who sent the request."}],"type":"topic","role":"symbol","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/request\/reader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderIdentity":{"url":"\/documentation\/oid4vcwallet\/proximityreaderidentity","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","type":"topic","kind":"symbol","fragments":[{"kind":"keyword