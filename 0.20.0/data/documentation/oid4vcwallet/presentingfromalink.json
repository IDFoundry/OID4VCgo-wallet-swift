{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"],"anchor":"Presenting-from-a-link","title":"Presenting from a link","generated":true}],"metadata":{"title":"Presenting from a link","role":"article","roleHeading":"Article","modules":[{"name":"OID4VCWallet"}]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A Verifier asks with an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" link, as a QR code or a link on"},{"type":"text","text":" "},{"type":"text","text":"its page. Register the "},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":" URL scheme in the app’s Info.plist so"},{"type":"text","text":" "},{"type":"text","text":"links open the app, and hand the link to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)"},{"type":"text","text":". It fetches the Verifier’s"},{"type":"text","text":" "},{"type":"text","text":"signed request, checks its certificate against"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots"},{"type":"text","text":", and finds the credentials that"},{"type":"text","text":" "},{"type":"text","text":"can answer it. A request from a Verifier the wallet doesn’t trust"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier"},{"type":"text","text":" before anything is shown."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation"},{"type":"text","text":" it returns says:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"who is asking: ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","isActive":true},{"text":", its name, and its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","isActive":true},{"text":" when a registrar the","type":"text"},{"text":" ","type":"text"},{"text":"wallet trusts (","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","isActive":true},{"text":") registered it,","type":"text"},{"text":" ","type":"text"},{"text":"with its purpose and the claims it’s registered to ask for;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"what it asks for: ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries","isActive":true},{"text":", each with the held","type":"text"},{"text":" ","type":"text"},{"text":"credentials that can answer it, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the request’s alternatives.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Present","anchor":"Present","level":3,"type":"heading"},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation: Presentation","    do {","        presentation = try await wallet.startPresentation(request: requestLink)","    } catch let error as WalletError where error.code == .requestRefused {","        \/\/ A refused request: the Verifier was told, and may say where to","        \/\/ take the holder next (OpenID4VP §8.2).","        return wallet.takeRefusalRedirect()","    }","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection: Presentation.Selection","    let disclosures: [Presentation.Disclosure]","    do {","        selection = try await presentation.defaultSelection()","        disclosures = try await presentation.preview(selection: selection)","    } catch {","        \/\/ Nothing can be shown: decline, so the Verifier isn't left waiting.","        _ = try? await presentation.decline()","        throw error","    }","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"],"type":"codeListing"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()"},{"type":"text","text":" picks the first credential that"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"each query’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials"},{"type":"text","text":" instead: a query that"},{"type":"text","text":" "},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection"},{"type":"text","text":" otherwise), and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)"},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"type":"text","text":"agrees."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Open "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI"},{"type":"text","text":", when the Verifier sends"},{"type":"text","text":" "},{"type":"text","text":"one, in the browser the request came from: it’s how a same-device"},{"type":"text","text":" "},{"type":"text","text":"flow returns to the Verifier’s page. The library refuses http and"},{"type":"text","text":" "},{"type":"text","text":"schemes that run code or read local data, but lets through a scheme the"},{"type":"text","text":" "},{"type":"text","text":"Verifier’s own app may have registered: open an https URL in the"},{"type":"text","text":" "},{"type":"text","text":"browser, any other only through "},{"type":"codeVoice","code":"UIApplication.open"},{"type":"text","text":", never in a web"},{"type":"text","text":" "},{"type":"text","text":"view, and never one in the wallet’s own schemes ("},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"openid-credential-offer"},{"type":"text","text":", its redirect URI’s), which would start"},{"type":"text","text":" "},{"type":"text","text":"another flow in the wallet."}],"type":"paragraph"},{"text":"When the wallet refuses a request","anchor":"When-the-wallet-refuses-a-request","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A request the wallet must not answer — one with "},{"type":"codeVoice","code":"transaction_data"},{"type":"text","text":" it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t support, or a parameter OpenID4VP forbids — makes"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)"},{"type":"text","text":" throw"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/requestRefused"},{"type":"text","text":", its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/protocolError"},{"type":"text","text":" "},{"type":"text","text":"the error code the wallet sent the Verifier, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_transaction_data"},{"type":"text","text":". Nothing is shown to the holder, and nothing"},{"type":"text","text":" "},{"type":"text","text":"is presented. The Verifier may answer the refusal with a redirect:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/takeRefusalRedirect()"},{"type":"text","text":" returns it, once, and you open it in"},{"type":"text","text":" "},{"type":"text","text":"the browser the request came from, as a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI"},{"type":"text","text":", so the holder isn’t left"},{"type":"text","text":" "},{"type":"text","text":"stranded. Tell the holder the request wasn’t answered."}],"type":"paragraph"},{"text":"Show what’s being asked beyond a registration","anchor":"Show-whats-being-asked-beyond-a-registration","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For a Verifier with a verified registration, each query’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered"},{"type":"text","text":" lists the claims it asks for beyond"},{"type":"text","text":" "},{"type":"text","text":"what it’s registered to request, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll"},{"type":"text","text":" whether it names no claims at"},{"type":"text","text":" "},{"type":"text","text":"all. The library flags such a query in full, though OpenID4VP 1.0"},{"type":"text","text":" "},{"type":"text","text":"§6.4.1 reads it as asking for no selectively disclosable claims, so a"},{"type":"text","text":" "},{"type":"text","text":"presentation for it discloses only what the credential always shows."},{"type":"text","text":" "},{"type":"text","text":"Nothing is refused for them: show them, and let the holder decide."}],"type":"paragraph"},{"text":"Keep presentations unlinkable","anchor":"Keep-presentations-unlinkable","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each presentation uses a copy of the credential, bound to its own key,"},{"type":"text","text":" "},{"type":"text","text":"so two Verifiers can’t link the holder’s presentations by the"},{"type":"text","text":" "},{"type":"text","text":"credential. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","isActive":true},{"type":"text","text":" chooses which copy:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation"},{"text":", the default: a","type":"text"},{"text":" ","type":"text"},{"text":"copy no Verifier has seen, every time.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier"},{"text":": the copy a Verifier","type":"text"},{"text":" ","type":"text"},{"text":"has seen before, so it can recognize a returning holder, and an unused","type":"text"},{"text":" ","type":"text"},{"text":"one for a new Verifier.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Once every copy is used, one is reused. A candidate’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"type":"text","text":" says whether presenting it now would"},{"type":"text","text":" "},{"type":"text","text":"hand this Verifier a copy another has seen: warn the holder, and"},{"type":"text","text":" "},{"type":"text","text":"refresh the credential ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true},{"type":"text","text":") when its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true},{"type":"text","text":" reaches zero."}],"type":"paragraph"},{"text":"When delivery is uncertain","anchor":"When-delivery-is-uncertain","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"If sending the response fails in a way that leaves it unknown whether"},{"type":"text","text":" "},{"type":"text","text":"the Verifier received it, "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","isActive":true},{"type":"text","text":" and doesn’t send it again: the"},{"type":"text","text":" "},{"type":"text","text":"holder should check with the Verifier before sharing again."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"sections":[],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/copyPolicy-swift.property":{"abstract":[{"type":"text","text":"Which copy of a credential a presentation uses."}],"role":"symbol","title":"copyPolicy","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"copyPolicy","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12OID4VCWallet19WalletConfigurationV10CopyPolicyO","kind":"typeIdentifier","text":"CopyPolicy"}],"type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.property","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/deliveryUnknown":{"url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/deliveryunknown","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveryUnknown"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code"}],"title":"deliveryUnknown","role":"symbol","abstract":[{"text":"Sending a presentation failed in a way that leaves it unknown","type":"text"},{"text":" ","type":"text"},{"text":"whether the Verifier received it: it’s not sent again.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/copiesLeft":{"abstract":[{"type":"text","text":"How many copies no Verifier has seen."}],"role":"symbol","title":"copiesLeft","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"copiesLeft","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","url":"\/documentation\/oid4vcwallet\/credentialsummary\/copiesleft"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Selection":{"url":"\/documentation\/oid4vcwallet\/presentation\/selection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","type":"topic","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Selection","kind":"identifier"}],"title":"Presentation.Selection","role":"symbol","abstract":[{"text":"What to present: for each query ID, the IDs of the credentials","type":"text"},{"text":" ","type":"text"},{"text":"chosen to answer it.","type":"text"}],"navigatorTitle":[{"text":"Selection","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/credentialSets":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credentialSets","kind":"identifier"},{"text":": [","kind":"text"},{"text":"CredentialSet","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC13CredentialSetV"},{"text":"]","kind":"text"}],"title":"credentialSets","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","abstract":[{"text":"The request’s sets of alternatives; none means every query must","type":"text"},{"text":" ","type":"text"},{"text":"be answered.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/oid4vcwallet\/presentation\/credentialsets"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refreshCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed"}],"title":"refreshCredential(id:)","role":"symbol","abstract":[{"text":"Replaces a ","type":"text"},{"code":"refreshable","type":"codeVoice"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new attested key, without the holder (OpenID4VCI","type":"text"},{"text":" ","type":"text"},{"text":"1.0 §13.5). Use it when ","type":"text"},{"code":"copiesLeft","type":"codeVoice"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/CopyPolicy-swift.enum/perVerifier":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perVerifier","kind":"identifier"}],"title":"WalletConfiguration.CopyPolicy.perVerifier","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","abstract":[{"text":"A Verifier is shown the copy it has seen before, and only a new","type":"text"},{"text":" ","type":"text"},{"text":"Verifier an unused one: Verifiers can’t link presentations to","type":"text"},{"text":" ","type":"text"},{"text":"each other, but one can recognise a returning holder.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.enum\/perverifier"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startPresentation(request:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC","text":"Presentation"}],"title":"startPresentation(request:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","url":"\/documentation\/oid4vcwallet\/wallet\/startpresentation(request:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Fetches and verifies an OpenID4VP request (openid4vp:\/\/…), and"},{"type":"text","text":" "},{"type":"text","text":"finds the credentials that can answer it."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/queries":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queries","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC5QueryV"},{"text":"]","kind":"text"}],"title":"queries","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries","abstract":[{"text":"The request’s credential queries, in its order.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/oid4vcwallet\/presentation\/querie