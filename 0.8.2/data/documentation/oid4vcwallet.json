":" "},{"type":"text","text":"data, a remote party’s own description, a URL’s path or query, or"},{"type":"text","text":" "},{"type":"text","text":"control characters. "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"a sentence fit to show the holder; "},{"code":"isRetryable","type":"codeVoice"},{"type":"text","text":" says whether trying"},{"type":"text","text":" "},{"type":"text","text":"the same step again may succeed."}],"url":"\/documentation\/oid4vcwallet\/walleterror","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletError"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/JSONValue":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/JSONValue","navigatorTitle":[{"kind":"identifier","text":"JSONValue"}],"title":"JSONValue","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A JSON value."}],"url":"\/documentation\/oid4vcwallet\/jsonvalue","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONValue"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Logo":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Logo"}],"title":"Logo","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"An image the issuer names for display: an https URL or a data: image"},{"text":" ","type":"text"},{"type":"text","text":"(nothing else reaches the app), with alternative text."}],"url":"\/documentation\/oid4vcwallet\/logo","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Logo"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Logo"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityError":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError","navigatorTitle":[{"text":"ProximityError","kind":"identifier"}],"title":"ProximityError","kind":"symbol","role":"symbol","abstract":[{"text":"An in-person session failed over Bluetooth, rather than in the","type":"text"},{"text":" ","type":"text"},{"text":"protocol (","type":"text"},{"code":"WalletError","type":"codeVoice"},{"text":").","type":"text"}],"url":"\/documentation\/oid4vcwallet\/proximityerror","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityError","kind":"identifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/proximitypresentation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityPresentation"}],"navigatorTitle":[{"kind":"identifier","text":"ProximityPresentation"}],"kind":"symbol","abstract":[{"type":"text","text":"The holder’s side of an ISO\/IEC 18013-5 in-person presentation over"},{"type":"text","text":" "},{"type":"text","text":"BLE, in mdoc peripheral server mode: show "},{"type":"codeVoice","code":"qrCode"},{"type":"text","text":", and the reader"},{"type":"text","text":" "},{"type":"text","text":"that scans it connects. Follow "},{"type":"codeVoice","code":"states"},{"type":"text","text":": on "},{"type":"codeVoice","code":".requestReceived"},{"type":"text","text":", ask"},{"type":"text","text":" "},{"type":"text","text":"the holder, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" or "},{"type":"codeVoice","code":"decline"},{"type":"text","text":". "},{"type":"codeVoice","code":"cancel"},{"type":"text","text":" ends it at any"},{"type":"text","text":" "},{"type":"text","text":"point. One request per session. The app’s Info.plist needs"},{"type":"text","text":" "},{"type":"text","text":"NSBluetoothAlwaysUsageDescription."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","title":"ProximityPresentation"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/mdocpresentation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MdocPresentation"}],"navigatorTitle":[{"kind":"identifier","text":"MdocPresentation"}],"kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request (ISO\/IEC TS 18013-7 Annex C): show"},{"type":"text","text":" "},{"type":"codeVoice","code":"request"},{"type":"text","text":" for the holder’s consent, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" once; to decline,"},{"type":"text","text":" "},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","title":"MdocPresentation"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ReceivingCredentials":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","title":"Receiving credentials","kind":"article","role":"article","abstract":[{"text":"Receive the credentials a Credential Offer offers, with either grant,","type":"text"},{"text":" ","type":"text"},{"text":"and look after them once they’re held.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/receivingcredentials","type":"topic"},"https://github.com/IDFoundry/OID4VCgo":{"titleInlineContent":[{"type":"text","text":"OID4VCgo"}],"title":"OID4VCgo","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo","type":"link","url":"https:\/\/github.com\/IDFoundry\/OID4VCgo"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityTimeouts":{"abstract":[{"type":"text","text":"How long an in-person session waits (ISO\/IEC 18013-5 recommends at"},{"type":"text","text":" "},{"type":"text","text":"least 30 seconds from engagement to the request, §8.2.3, and 300"},{"type":"text","text":" "},{"type":"text","text":"seconds of inactivity before ending a session, §9.1.1.4)."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityTimeouts","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"ProximityTimeouts","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/proximitytimeouts","title":"ProximityTimeouts","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProvider"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WalletProvider"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","title":"WalletProvider","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialDisplay":{"abstract":[{"type":"text","text":"How to show a credential, from the issuer’s metadata (OpenID4VCI 1.0"},{"type":"text","text":" "},{"type":"text","text":"§12.2.4) in the holder’s language: each part only when the issuer"},{"type":"text","text":" "},{"type":"text","text":"gives it. Colours are CSS colours, such as “#12107c”."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialDisplay","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CredentialDisplay"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CredentialDisplay"}],"kind":"symbol","title":"CredentialDisplay","url":"\/documentation\/oid4vcwallet\/credentialdisplay","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderConfiguration":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/proximityreaderconfiguration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityReaderConfiguration"}],"navigatorTitle":[{"kind":"identifier","text":"ProximityReaderConfiguration"}],"kind":"symbol","abstract":[{"type":"text","text":"A "},{"code":"ProximityReader","type":"codeVoice"},{"type":"text","text":"’s configuration."}],"title":"ProximityReaderConfiguration","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","navigatorTitle":[{"kind":"identifier","text":"Offer"}],"title":"Offer","kind":"symbol","role":"symbol","abstract":[{"text":"What a Credential Offer offers.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/offer","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Offer"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","navigatorTitle":[{"kind":"identifier","text":"FileCredentialStore"}],"title":"FileCredentialStore","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A credential store of files: one per credential record, in a directory"},{"type":"text","text":" "},{"type":"text","text":"of the app’s (Application Support, by default). Records are written"},{"type":"text","text":" "},{"type":"text","text":"with the given file protection — complete by default: readable only"},{"type":"text","text":" "},{"type":"text","text":"while the device is unlocked — and kept out of backups by default,"},{"type":"text","text":" "},{"type":"text","text":"since a credential is useless without its holder key, which is in"},{"type":"text","text":" "},{"type":"text","text":"this device’s Secure Enclave and can’t be restored elsewhere."}],"url":"\/documentation\/oid4vcwallet\/filecredentialstore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileCredentialStore"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"role":"article","type":"topic","url":"\/documentation\/oid4vcwallet\/handlingerrors","kind":"article","abstract":[{"type":"text","text":"Tell the holder what went wrong, retry what may succeed, and log what"},{"text":" ","type":"text"},{"type":"text","text":"helps without personal data."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","title":"Handling errors"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"title":"DeferredCredential","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s"},{"type":"text","text":" "},{"type":"text","text":"kept in the credential store until it’s issued, denied or abandoned,"},{"text":" ","type":"text"},{"text":"so it survives the app quitting.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/deferredcredential","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStatus":{"abstract":[{"type":"text","text":"A credential’s revocation status in the issuer’s status list, as last"},{"type":"text","text":" "},{"type":"text","text":"checked ("},{"type":"codeVoice","code":"Wallet.checkStatus(id:)"},{"type":"text","text":")."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStatus","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CredentialStatus"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CredentialStatus"}],"url":"\/documentation\/oid4vcwallet\/credentialstatus","title":"CredentialStatus","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingFromALink":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","title":"Presenting from a link","kind":"article","role":"article","abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/presentingfromalink","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"kind":"symbol","title":"KeychainKeyStore","type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyPurpose":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/keypurpose","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyPurpose"}],"navigatorTitle":[{"kind":"identifier","text":"KeyPurpose"}],"kind":"symbol","abstract":[{"type":"text","text":"What a key is for."}],"title":"KeyPurpose","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyPurpose"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary","navigatorTitle":[{"text":"CredentialSummary","kind":"identifier"}],"title":"CredentialSummary","kind":"symbol","role":"symbol","abstract":[{"text":"A credential the wallet holds, as the app shows it.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/credentialsummary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CredentialSummary","kind":"identifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Wallet"}],"title":"Wallet","kind":"symbol","role":"symbol","abstract":[{"text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,","type":"text"},{"text":" ","type":"text"},{"text":"credential store and Wallet Provider.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/wallet","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Wallet"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"role":"article","type":"topic","url":"\/documentation\/oid4vcwallet\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Add the package, give the wallet its keys, its storage and a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Provider, and create it at launch."}],"title":"Getting started","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","title":"Going to production","kind":"article","role":"article","abstract":[{"text":"What a wallet needs before real holders use it.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/goingtoproduction","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/StoreError":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"StoreError"}],"title":"StoreError","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A store’s or provider’s own failure."}],"url":"\/documentation\/oid4vcwallet\/storeerror","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StoreError"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/StoreError"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/OID4VC":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/oid4vc","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OID4VC"}],"navigatorTitle":[{"kind":"identifier","text":"OID4VC"}],"kind":"symbol","abstract":[{"type":"text","text":"OID4VCgo’s mobile API. Every call runs off the caller’s thread: Go"},{"type":"text","text":" "},{"type":"text","text":"calls block, and must never run on the main thread."}],"title":"OID4VC","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReader":{"abstract":[{"type":"text","text":"An ISO\/IEC 18013-5 mdoc reader: a verifier asking for an mdoc in"},{"type":"text","text":" "},{"type":"text","text":"person over BLE. It needs no "},{"code":"Wallet","type":"codeVoice"},{"type":"text","text":". The key store holds the"},{"type":"text","text":" "},{"type":"text","text":"reader’s key, "},{"code":"ProximityReaderConfiguration.readerKeyID","type":"codeVoice"},{"type":"text","text":"; none for a"},{"type":"text","text":" "},{"type":"text","text":"reader that doesn’t sign."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityReader"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ProximityReader"}],"kind":"symbol","title":"ProximityReader","type":"topic","url":"\/documentation\/oid4vcwallet\/proximityreader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore":{"abstract":[{"type":"text","text":"The wallet’s keys: P-256 keys whose private halves never leave the"},{"type":"text","text":" "},{"type":"text","text":"store (the Secure Enclave). "},{"code":"KeychainKeyStore","type":"codeVoice"},{"type":"text","text":" is the standard one."},{"type":"text","text":" "},{"type":"text","text":"A thrown error reaches Go and comes back as a "},{"code":".platform","type":"codeVoice"},{"type":"text","text":" WalletError."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyStore"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KeyStore"}],"kind":"symbol","title":"KeyStore","type":"topic","url":"\/documentation\/oid4vcwallet\/keystore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Presentation"}],"title":"Presentation","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Answers one OpenID4VP request: show "},{"code":"verifier","type":"codeVoice"},{"type":"text","text":", "},{"code":"queries","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"credentialSets","type":"codeVoice"},{"type":"text","text":", choose a "},{"code":"Selection","type":"codeVoice"},{"type":"text","text":" (or start from"},{"type":"text","text":" "},{"code":"defaultSelection()","type":"codeVoice"},{"type":"text","text":"), "},{"code":"preview(selection:)","type":"codeVoice"},{"type":"text","text":" it, then"},{"type":"text","text":" "},{"code":"respond(selection:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"decline()","type":"codeVoice"},{"type":"text","text":". The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"WalletError.Code.invalidSelection","type":"codeVoice"},{"type":"text","text":" otherwise)."}],"url":"\/documentation\/oid4vcwallet\/presentation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Presentation"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"role":"article","type":"topic","url":"\/documentation\/oid4vcwallet\/presentinginperson","kind":"article","abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","title":"Presenting in person"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderIdentity":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/proximityreaderidentity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityReaderIdentity"}],"navigatorTitle":[{"kind":"identifier","text":"ProximityReaderIdentity"}],"kind":"symbol","abstract":[{"type":"text","text":"Who sent a request, as the holder sees it."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","title":"ProximityReaderIdentity"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialDetail":{"abstract":[{"type":"text","text":"A credential with its claims, for display."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialDetail","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CredentialDetail","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"CredentialDetail","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/credentialdetail","title":"CredentialDetail","type":"topic","kind":"symbol"}}}