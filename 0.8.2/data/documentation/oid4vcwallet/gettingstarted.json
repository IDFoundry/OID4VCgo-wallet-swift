{"variants":[{"paths":["\/documentation\/oid4vcwallet\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted"},"abstract":[{"type":"text","text":"Add the package, give the wallet its keys, its storage and a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Provider, and create it at launch."}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","type":"reference","isActive":true},{"type":"text","text":" needs four things from your app: its configuration, a"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","type":"reference","isActive":true},{"type":"text","text":" for its keys, a "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","type":"reference","isActive":true},{"type":"text","text":" for what it holds, and a"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"reference","isActive":true},{"type":"text","text":" that attests it to issuers. The package has standard"},{"type":"text","text":" "},{"type":"text","text":"stores for the first two; the Wallet Provider is your backend."}]},{"type":"heading","level":3,"text":"Add the package","anchor":"Add-the-package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add OID4VCWallet to your app with Swift Package Manager, from"},{"type":"text","text":" "},{"code":"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift","type":"codeVoice"},{"type":"text","text":". In "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":[".package(url: \"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift\", from: \"0.8.0\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package links a binary framework, "},{"code":"Mobile","type":"codeVoice"},{"type":"text","text":", which SwiftPM checks"},{"type":"text","text":" "},{"type":"text","text":"against the checksum in the package’s manifest."}]},{"type":"heading","level":3,"text":"Register the wallet","anchor":"Register-the-wallet"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Issuers’ Authorization Servers know the wallet as an OAuth client: a"},{"type":"text","text":" "},{"type":"text","text":"client ID, and a redirect URI the app opens when the holder returns from"},{"type":"text","text":" "},{"type":"text","text":"the issuer’s pages. Register a private-use URI scheme for it, in the"},{"type":"text","text":" "},{"type":"text","text":"app’s Info.plist ("},{"code":"CFBundleURLTypes","type":"codeVoice"},{"type":"text","text":"), and pass the URL the app receives"},{"type":"text","text":" "},{"type":"text","text":"to the issuance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet trusts only what chains to the roots you give it, as PEM"},{"type":"text","text":" "},{"type":"text","text":"certificates: "},{"code":"issuerRoots","type":"codeVoice"},{"type":"text","text":" for credentials, and "},{"code":"verifierRoots","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the Verifiers it answers. A Credential Offer’s issuer isn’t trusted just"},{"type":"text","text":" "},{"type":"text","text":"because it sent the offer."}]},{"type":"heading","level":3,"text":"Provide the keys and the storage","anchor":"Provide-the-keys-and-the-storage"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","type":"reference","isActive":true},{"type":"text","text":" keeps every key in the Secure Enclave. A holder"},{"type":"text","text":" "},{"type":"text","text":"key — the one a credential is bound to — signs only when presenting, and"},{"type":"text","text":" "},{"type":"text","text":"by default asks for Face ID, Touch ID or the passcode first: add an"},{"type":"text","text":" "},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"type":"text","text":" to the app’s Info.plist, or iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","type":"reference","isActive":true},{"type":"text","text":" keeps each credential as a file with complete"},{"type":"text","text":" "},{"type":"text","text":"data protection, out of backups: a credential is useless without its"},{"type":"text","text":" "},{"type":"text","text":"holder key, which can’t leave this device. An app with a document"},{"type":"text","text":" "},{"type":"text","text":"provider extension keeps both in places the extension can read too; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Implement the Wallet Provider","anchor":"Implement-the-Wallet-Provider"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Issuers following HAIP accept only a wallet its Wallet Provider has"},{"type":"text","text":" "},{"type":"text","text":"attested: a Wallet Attestation for the wallet’s instance key, and a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the keys a credential will be bound to. Your backend"},{"type":"text","text":" "},{"type":"text","text":"issues them; the app passes the keys and returns its answers. A real"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider attests only after checking App Attest evidence that"},{"type":"text","text":" "},{"type":"text","text":"it’s talking to your genuine app."}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Asks the app's backend for attestations. The keys are public JWKs,","\/\/\/ as JSON; the answers are compact JWTs.","struct BackendWalletProvider: WalletProvider {","    let backend: URL","","    func walletAttestation(clientID: String, instanceKey: Data) async throws -> String {","        try await post(\"wallet-attestation\", [","            \"client_id\": clientID,","            \"instance_key\": try JSONSerialization.jsonObject(with: instanceKey),","        ])","    }","","    func keyAttestation(keys: [Data], nonce: String) async throws -> String {","        try await post(\"key-attestation\", [","            \"keys\": try keys.map { try JSONSerialization.jsonObject(with: $0) },","            \"nonce\": nonce,","        ])","    }","","    private func post(_ path: String, _ body: [String: Any]) async throws -> String {","        var request = URLRequest(url: backend.appending(path: path))","        request.httpMethod = \"POST\"","        request.setValue(\"application\/json\", forHTTPHeaderField: \"Content-Type\")","        request.httpBody = try JSONSerialization.data(withJSONObject: body)","        let (data, response) = try await URLSession.shared.data(for: request)","        guard (response as? HTTPURLResponse)?.statusCode == 200 else { throw URLError(.badServerResponse) }","        return String(decoding: data, as: UTF8.self)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"URLError","type":"codeVoice"},{"type":"text","text":" the provider throws reaches the wallet as a retryable"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/network","type":"reference","isActive":true},{"type":"text","text":" error; any other is"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/platform","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Create the wallet","anchor":"Create-the-wallet"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create one "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","type":"reference","isActive":true},{"type":"text","text":" when the app starts, and keep it. Creating it"},{"type":"text","text":" "},{"type":"text","text":"makes no network requests. At launch, before anything else, sweep the"},{"type":"text","text":" "},{"type":"text","text":"Keychain of keys no credential uses: an issuance the app quit in the"},{"type":"text","text":" "},{"type":"text","text":"middle of leaves its keys behind."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ The app's wallet, created once at launch.","@MainActor","final class AppWallet {","    let wallet: Wallet","    private let keys: KeychainKeyStore","","    init(clientID: String, redirectURI: String, issuerRoots: String, verifierRoots: String, provider: URL) throws {","        let configuration = WalletConfiguration(","            clientID: clientID,","            redirectURI: redirectURI,","            issuerRoots: issuerRoots,","            verifierRoots: verifierRoots)","        keys = KeychainKeyStore()","        wallet = try Wallet(","            configuration: configuration,","            keyStore: keys,","            credentialStore: try FileCredentialStore.standard(),","            provider: BackendWalletProvider(backend: provider))","    }","","    \/\/\/ Run once at launch, before any issuance.","    func start() async throws {","        try await wallet.sweepOrphanedKeys(in: keys)","    }","}"]},{"type":"heading","level":3,"text":"Ship the release build","anchor":"Ship-the-release-build"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package links the release build of "},{"code":"Mobile","type":"codeVoice"},{"type":"text","text":". OID4VCgo’s own tests"},{"type":"text","text":" "},{"type":"text","text":"use a test build with an in-process issuer and Verifier that a shipped"},{"type":"text","text":" "},{"type":"text","text":"app must never have; "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","type":"reference","isActive":true},{"type":"text","text":" says which one an app has,"},{"type":"text","text":" "},{"type":"text","text":"so it can refuse to run on the test build."}]},{"type":"heading","level":3,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","isActive":true}],"type":"paragraph"}]}]}]}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"role":"article","roleHeading":"Article","title":"Getting started"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","title":"Going to production","kind":"article","role":"article","abstract":[{"text":"What a wallet needs before real holders use it.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/goingtoproduction","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ReceivingCredentials":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","title":"Receiving credentials","kind":"article","role":"article","abstract":[{"text":"Receive the credentials a Credential Offer offers, with either grant,","type":"text"},{"text":" ","type":"text"},{"text":"and look after them once they’re held.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/receivingcredentials","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","title":"OID4VCWallet","kind":"symbol","role":"collection","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}],"url":"\/documentation\/oid4vcwallet","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/credentialstore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"CredentialStore","kind":"identifier"}],"navigatorTitle":[{"text":"CredentialStore","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The wallet’s credentials, as opaque records kept by ID under the"},{"type":"text","text":" "},{"text":"platform’s data protection. ","type":"text"},{"code":"FileCredentialStore","type":"codeVoice"},{"text":" is the standard one.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","title":"CredentialStore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","navigatorTitle":[{"kind":"identifier","text":"FileCredentialStore"}],"title":"FileCredentialStore","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A credential store of files: one per credential record, in a directory"},{"type":"text","text":" "},{"type":"text","text":"of the app’s (Application Support, by default). Records are written"},{"type":"text","text":" "},{"type":"text","text":"with the given file protection — complete by default: readable only"},{"type":"text","text":" "},{"type":"text","text":"while the device is unlocked — and kept out of backups by default,"},{"type":"text","text":" "},{"type":"text","text":"since a credential is useless without its holder key, which is in"},{"type":"text","text":" "},{"type":"text","text":"this device’s Secure Enclave and can’t be restored elsewhere."}],"url":"\/documentation\/oid4vcwallet\/filecredentialstore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileCredentialStore"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/platform":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/platform","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"platform","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A key store, credential store or Wallet Provider call failed; its"},{"type":"text","text":" "},{"type":"text","text":"message follows."}],"title":"platform","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/platform"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"kind":"symbol","title":"KeychainKeyStore","type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"title":"holderAccessGroup","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inAppGroup","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV","text":"Options","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC","text":"FileCredentialStore","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A store in the app group "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":"’s container"},{"type":"text","text":" "},{"type":"text","text":"(Library\/Application Support\/credentials there), which the app and"},{"type":"text","text":" "},{"type":"text","text":"its extensions listing the group in their"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement share."}],"title":"inAppGroup(_:options:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","navigatorTitle":[{"text":"WalletConfiguration","kind":"identifier"}],"title":"WalletConfiguration","kind":"symbol","role":"symbol","abstract":[{"text":"NewWallet’s configuration.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletConfiguration","kind":"identifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProvider"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WalletProvider"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","title":"WalletProvider","type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingFromALink":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","title":"Presenting from a link","kind":"article","role":"article","abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/presentingfromalink","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/OID4VC/isTestBuild":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/oid4vc\/istestbuild","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isTestBuild","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Whether the linked framework is the test build, carrying an"},{"type":"text","text":" "},{"type":"text","text":"in-process test issuer and Verifier ("},{"type":"codeVoice","code":"-tags mobiletest"},{"type":"text","text":"): an app"},{"type":"text","text":" "},{"type":"text","text":"should refuse to run on it."}],"title":"isTestBuild","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/network":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/network","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"network","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A request couldn’t be made, got no answer, or timed out. Retryable."}],"title":"network","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/network"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore":{"abstract":[{"type":"text","text":"The wallet’s keys: P-256 keys whose private halves never leave the"},{"type":"text","text":" "},{"type":"text","text":"store (the Secure Enclave). "},{"code":"KeychainKeyStore","type":"codeVoice"},{"type":"text","text":" is the standard one."},{"type":"text","text":" "},{"type":"text","text":"A thrown error reaches Go and comes back as a "},{"code":".platform","type":"codeVoice"},{"type":"text","text":" WalletError."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyStore"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KeyStore"}],"kind":"symbol","title":"KeyStore","type":"topic","url":"\/documentation\/oid4vcwallet\/keystore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Wallet"}],"title":"Wallet","kind":"symbol","role":"symbol","abstract":[{"text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,","type":"text"},{"text":" ","type":"text"},{"text":"credential store and Wallet Provider.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/wallet","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Wallet"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"role":"article","type":"topic","url":"\/documentation\/oid4vcwallet\/presentinginperson","kind":"article","abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","title":"Presenting in person"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingToSafari":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","title":"Presenting to Safari","kind":"article","role":"article","abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/presentingtosafari","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"role":"article","type":"topic","url":"\/documentation\/oid4vcwallet\/handlingerrors","kind":"article","abstract":[{"type":"text","text":"Tell the holder what went wrong, retry what may succeed, and log what"},{"text":" ","type":"text"},{"type":"text","text":"helps without personal data."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","title":"Handling errors"}}}