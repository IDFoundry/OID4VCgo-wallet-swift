credential ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)"},{"type":"text","text":") when its"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft"},{"type":"text","text":" reaches zero."}],"type":"paragraph"},{"text":"When delivery is uncertain","level":3,"type":"heading","anchor":"When-delivery-is-uncertain"},{"inlineContent":[{"type":"text","text":"If sending the response fails in a way that leaves it unknown whether"},{"type":"text","text":" "},{"type":"text","text":"the Verifier received it, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown"},{"type":"text","text":" and doesn’t send it again: the"},{"type":"text","text":" "},{"type":"text","text":"holder should check with the Verifier before sharing again."}],"type":"paragraph"}]}],"sections":[],"metadata":{"title":"Presenting from a link","role":"article","roleHeading":"Article","modules":[{"name":"OID4VCWallet"}]},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Pr