n\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inAppGroup","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV","text":"Options","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC","text":"FileCredentialStore","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A store in the app group "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":"’s container"},{"type":"text","text":" "},{"type":"text","text":"(Library\/Application Support\/credentials there), which the app and"},{"type":"text","text":" "},{"type":"text","text":"its extensions listing the group in their"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement share."}],"title":"inAppGroup(_:options:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/reader":{"type":"topic","kind":"symbol","title":"reader","role":"symbol","abstract":[{"type":"text","text":"The subject common name of the reader that signed the request,"},{"type":"text","text":" "},{"type":"text","text":"when its certificate chains to"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletConfiguration.mdocReaderRoots"},{"type":"text","text":"; “” when the holder can"},{"type":"text","text":" "},{"type":"text","text":"only be shown "},{"type":"codeVoice","code":"origin"},{"type":"text","text":"."}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/reader","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"reader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/mdocpresentation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MdocPresentation"}],"navigatorTitle":[{"kind":"identifier","text":"MdocPresentation"}],"kind":"symbol","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request (ISO\/IEC TS 18013-7 Annex C): show"},{"type":"text","text":" "},{"type":"codeVoice","code":"request"},{"type":"text","text":" for the holder’s consent, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" once; to decline,"},{"type":"text","text":" "},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","title":"MdocPresentation"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requireTrustedMdocReader","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Refuses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request no recognized reader signed:"},{"type":"text","text":" "},{"type":"codeVoice","code":"startMdocPresentation"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"untrustedVerifier"},{"type":"text","text":", and nothing is"},{"type":"text","text":" "},{"type":"text","text":"shown to the holder. Needs "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":"."}],"title":"requireTrustedMdocReader","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","title":"mdocReaderRequireEKU","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Recognizes only reader certificates with the ISO\/IEC 18013-5"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage (1.0.18013.5.1.6), so a"},{"type":"text","text":" "},{"type":"text","text":"certificate issued for another role under "},{"code":"mdocReaderRoots","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"isn’t taken for a reader’s."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRequireEKU","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPresentation(requestData:origin:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","title":"startMdocPresentation(requestData:origin:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Parses an "}