","code":"respond(selection:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"decline()"},{"type":"text","text":". The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"WalletError.Code.invalidSelection"},{"type":"text","text":" otherwise)."}],"url":"\/documentation\/oid4vcwallet\/presentation","navigatorTitle":[{"text":"Presentation","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","title":"DeferredCredential","type":"topic","kind":"symbol","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/deferredcredential","abstract":[{"text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s","type":"text"},{"text":" ","type":"text"},{"text":"kept in the credential store until it’s issued, denied or abandoned,","type":"text"},{"text":" ","type":"text"},{"text":"so it survives the app quitting.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"title":"Wallet","kind":"symbol","role":"symbol","abstract":[{"text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,","type":"text"},{"text":" ","type":"text"},{"text":"credential store and Wallet Provider.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","url":"\/documentation\/oid4vcwallet\/wallet","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Wallet","kind":"identifier"}],"navigatorTitle":[{"text":"Wallet","kind":"identifier"}]},"doc://oid4vcwa