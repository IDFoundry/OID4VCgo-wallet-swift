VCWallet/documentation/OID4VCWallet/ProximityReaderSession":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderSession","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityReaderSession","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","title":"ProximityReaderSession","abstract":[{"type":"text","text":"One reader session: follow "},{"type":"codeVoice","code":"states"},{"type":"text","text":" to "},{"type":"codeVoice","code":".verified"},{"type":"text","text":" or another final state."}],"navigatorTitle":[{"text":"ProximityReaderSession","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/proximityreadersession"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/RequestLink":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestLink"}],"role":"symbol","type":"topic","kind":"symbol","title":"RequestLink","abstract":[{"type":"text","text":"An OpenID4VP request link’s parts."}],"navigatorTitle":[{"kind":"identifier","text":"RequestLink"}],"url":"\/documentation\/oid4vcwallet\/requestlink"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocStatus":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus","abstract":[{"type":"text","text":"A verified mdoc’s revocation status, as"},{"type":"text","text":" "},{"code":"ProximityReaderSession.checkStatus()","type":"codeVoice"},{"type":"text","text":" found it."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocStatus","kind":"identifier"}],"title":"MdocStatus","navigatorTitle":[{"text":"MdocStatus","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/mdocstatus","type":"topic"}}}