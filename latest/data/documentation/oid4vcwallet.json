graph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Presenting"}],"type":"strong"},{"type":"text","text":" them in answer to an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" request"},{"type":"text","text":" "},{"type":"text","text":"(OpenID4VP 1.0, HAIP 1.0), to Safari’s Digital Credentials API as an"},{"type":"text","text":" "},{"type":"text","text":"iOS document provider ("},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":", ISO\/IEC TS 18013-7), and in"},{"type":"text","text":" "},{"type":"text","text":"person over Bluetooth (ISO\/IEC 18013-5), where the app can also be the"},{"type":"text","text":" "},{"type":"text","text":"reader."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocols run in OID4VCgo’s Go code, compiled into the "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":" "},{"type":"text","text":"framework this package links: every network request, every protocol"},{"type":"text","text":" "},{"type":"text","text":"message and every check on what comes back. Your app supplies the"},{"type":"text","text":" "},{"type":"text","text":"platform, through three protocols: a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true},{"type":"text","text":" whose keys never leave"},{"type":"text","text":" "},{"type":"text","text":"the Secure Enclave, a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","isActive":true},{"type":"text","text":" under the device’s data"},{"type":"text","text":" "},{"type":"text","text":"protection, and a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","isActive":true},{"type":"text","text":" that attests the wallet. It also"},{"type":"text","text":" "},{"type":"text","text":"owns the UI: every session stops where the holder needs to decide."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OID4VCgo is OpenID Certified for the OpenID4VCI and OpenID4VP wallet"},{"type":"text","text":" "},{"type":"text","text":"roles under HAIP, over links. The Digital Credentials API and in-person"},{"type":"text","text":" "},{"type":"text","text":"presentation aren’t covered by that certification."}]},{"type":"paragraph","inlineContent":[{"text":"Start with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted"},{"type":"text","text":", then the article for each task."}]}]}],"abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Issuance","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","title":"Issuance","abstract":[{"type":"text","text":"Receives one offer’s credentials: show "},{"code":"offer","type":"codeVoice"},{"type":"text","text":"; then"},{"type":"text","text":" "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":", open the URL in ASWebAuthenticationSession and"},{"type":"text","text":" "},{"type":"codeVoice","code":"completeAuthorization(redirect:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"redeemPreAuthorizedCode(pin:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":"; "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" when done."}],"navigatorTitle":[{"text":"Issuance","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/issuance"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","title":"OID4VCWallet","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"text":" ","type":"text"},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"text":" ","type":"text"},{"type":"text","text":"API, and in person over Bluetooth."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","url":"\/documentation\/oid4vcwallet","kind":"symbol","role":"collection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","abstract":[{"type":"text","text":"An error from OID4VCgo: a stable "},{"type":"codeVoice","code":"code"},{"type":"text","text":", the issuer’s, Authorization"},{"type":"text","text":" "},{"type":"text","text":"Server’s or Verifier’s own error code when it gave one"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"protocolError"},{"type":"text","text":"), and a message for logs: it never carries personal"},{"type":"text","text":" "},{"type":"text","text":"data, a remote party’s own description, a URL’s path or query, or"},{"type":"text","text":" "},{"type":"text","text":"control characters. "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"a sentence fit to show the holder; "},{"code":"isRetryable","type":"codeVoice"},{"type":"text","text":" says whether trying"},{"type":"text","text":" "},{"type":"text","text":"the same step again may succeed."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","t