llet\/ProximityBLEMode","url":"\/documentation\/oid4vcwallet\/proximityblemode","kind":"symbol","title":"ProximityBLEMode","abstract":[{"type":"text","text":"The BLE roles a holder offers in its QR code (ISO\/IEC 18013-5"},{"type":"text","text":" "},{"type":"text","text":"§8.3.3.1.1); the reader picks one, central client mode when offered"},{"type":"text","text":" "},{"type":"text","text":"both."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityBLEMode","kind":"identifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyPurpose":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyPurpose","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyPurpose"}],"role":"symbol","type":"topic","kind":"symbol","title":"KeyPurpose","abstract":[{"type":"text","text":"What a key is for."}],"navigatorTitle":[{"kind":"identifier","text":"KeyPurpose"}],"url":"\/documentation\/oid4vcwallet\/keypurpose"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CredentialStore","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","title":"CredentialStore","abstract":[{"type":"text","text":"The wallet’s credentials, as opaque records kept by ID under the"},{"type":"text","text":" "},{"type":"text","text":"platform’s data protection. "},{"type":"codeVoice","code":"FileCredentialStore"},{"type":"text","text":" is the standard one."}],"navigatorTitle":[{"text":"CredentialStore","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/credentialstore"},"https://github.com/IDFoundry/OID4VCgo":{"type":"link","title":"OID4VCgo","titleInlineContent":[{"type":"text","text":"OID4VCgo"}],"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo","url":"https:\/\/github.com\/IDFoundry\/OID4VCgo"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}],"title":"WalletProvider","navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation":{"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"ProximityPresentation","kind":"identifier"}],"title":"ProximityPresentation","abstract":[{"type":"text","text":"The holder’s side of an ISO\/IEC 18013-5 in-person presentation over"},{"type":"text","text":" "},{"type":"text","text":"BLE: show "},{"type":"codeVoice","code":"qrCode"},{"type":"text","text":", and the reader that scans it connects, or"},{"type":"text","text":" "},{"type":"text","text":"advertises for the holder to connect, in one of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"ProximityBLEMode"},{"text":"s the session offers. Follow ","type":"text"},{"type":"codeVoice","code":"states"},{"type":"text","text":": on "},{"type":"codeVoice","code":".requestReceived"},{"type":"text","text":", ask"},{"type":"text","text":" "},{"type":"text","text":"the holder, then "},{"type":"codeVoice","code":"respond"},{"text":" or ","type":"text"},{"code":"decline","type":"codeVoice"},{"type":"text","text":". "},{"type":"codeVoice","code":"cancel"},{"type":"text","text":" ends it at any"},{"type":"text","text":" "},{"type":"text","text":"point. One request per session. The app’s Info.plist needs"},{"type":"text","text":" "},{"type":"text","text":"NSBluetoothAlwaysUsageDescription."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","url":"\/documentation\/oid4vcwallet\/proximitypresentation","kind":"symbol","navigatorTitle":[{"text":"ProximityPresentation","kind":"identifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","url":"\/documentation\/oid4vcwallet\/keychainkeystore","kind":"symbol","title":"KeychainKeyStore","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"code":"Options.tagPrefix","type":"codeVoice"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/StoreError":{"identifier"