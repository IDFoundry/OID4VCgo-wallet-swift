{"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"OID4VCWallet is the wallet side of "},{"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"for iOS 16 and macOS 13 and later. It handles SD-JWT VC and ISO mdoc"},{"type":"text","text":" "},{"type":"text","text":"credentials:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Receiving"}],"type":"strong"},{"type":"text","text":" them from a Credential Offer (OpenID4VCI 1.0, HAIP 1.0),"},{"type":"text","text":" "},{"type":"text","text":"with the authorization code or the pre-authorized code grant, deferred"},{"type":"text","text":" "},{"type":"text","text":"issuance, batches of copies and refresh."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Presenting"}],"type":"strong"},{"type":"text","text":" them in answer to an "},{"code":"openid4vp:\/\/","type":"codeVoice"},{"type":"text","text":" request"},{"type":"text","text":" "},{"type":"text","text":"(OpenID4VP 1.0, HAIP 1.0), to Safari’s Digital Credentials API as an"},{"type":"text","text":" "},{"type":"text","text":"iOS document provider ("},{"code":"org-iso-mdoc","type":"codeVoice"},{"type":"text","text":", ISO\/IEC TS 18013-7), and in"},{"type":"text","text":" "},{"type":"text","text":"person over Bluetooth (ISO\/IEC 