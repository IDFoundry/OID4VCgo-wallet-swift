{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"OID4VCWallet is the wallet side of ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"for iOS 16 and macOS 13 and later. It handles SD-JWT VC and ISO mdoc","type":"text"},{"text":" ","type":"text"},{"text":"credentials:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Receiving","type":"text"}],"type":"strong"},{"text":" them from a Credential Offer (OpenID4VCI 1.0, HAIP 1.0),","type":"text"},{"text":" ","type":"text"},{"text":"with the authorization code or the pre-authorized code grant, deferred","type":"text"},{"text":" ","type":"text"},{"text":"issuance, batches of copies and refresh.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Presenting","type":"text"}],"type":"strong"},{"text":" them in answer to an ","type":"text"},{"type":"codeVoice","code":"openid4vp:\/\/"},{"text":" request","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VP 1.0, HAIP 1.0), to Safari’s Digital Credentials API as an","type":"text"},{"text":" ","type":"text"},{"text":"iOS document provider (","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":", ISO\/IEC TS 18013-7), and in","type":"text"},{"text":" ","type":"text"},{"text":"person over Bluetooth (ISO\/IEC 18013-5), where the app can also be the","type":"text"},{"text":" ","type":"text"},{"text":"reader.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The protocols run in OID4VCgo’s Go code, compiled into the ","type":"text"},{"type":"codeVoice","code":"Mobile"},{"text":" ","type":"text"},{"text":"framework this package links: every network request, every protocol","type":"text"},{"text":" ","type":"text"},{"text":"message and every check on what comes back. Your app supplies the","type":"text"},{"text":" ","type":"text"},{"text":"platform, through three protocols: a ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true},{"text":" whose keys never leave","type":"text"},{"text":" ","type":"text"},{"text":"the Secure Enclave, a ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","isActive":true},{"text":" under the device’s data","type":"text"},{"text":" ","type":"text"},{"text":"protection, and a ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","isActive":true},{"text":" that attests the wallet. It also","type":"text"},{"text":" ","type":"text"},{"text":"owns the UI: every session stops where the holder needs to decide.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"OID4VCgo is OpenID Certified for the OpenID4VCI and OpenID4VP wallet","type":"text"},{"text":" ","type":"text"},{"text":"roles under HAIP, over links. The Digital Credentials API and in-person","type":"text"},{"text":" ","type":"text"},{"text":"presentation aren’t covered by that certification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Start with ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","isActive":true},{"text":", then the article for each task.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet"]}],"metadata":{"role":"collection","title":"OID4VCWallet","roleHeading":"Framework","externalID":"OID4VCWallet","symbolKind":"module","modules":[{"name":"OID4VCWallet"}]},"kind":"symbol","identifier":{"url":"doc:\/\/oid4vcwallet.