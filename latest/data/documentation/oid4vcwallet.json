pe":"text","text":"), and a message for logs: it never carries personal"},{"type":"text","text":" "},{"type":"text","text":"data, a remote party’s own description, a URL’s path or query, or"},{"type":"text","text":" "},{"text":"control characters. ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"a sentence fit to show the holder; "},{"type":"codeVoice","code":"isRetryable"},{"type":"text","text":" says whether trying"},{"type":"text","text":" "},{"type":"text","text":"the same step again may succeed."}],"type":"topic","title":"WalletError","url":"\/documentation\/oid4vcwallet\/walleterror","navigatorTitle":[{"text":"WalletError","kind":"identifier"}],"role":"symbol"},"https://github.com/IDFoundry/OID4VCgo":{"url":"https:\/\/github.com\/IDFoundry\/OID4VCgo","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo","title":"OID4VCgo","titleInlineContent":[{"type":"text","text":"OID4VCgo"}],"type":"link"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation":{"url":"\/documentation\/oid4vcwallet\/presentation","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Presentation","kind":"identifier"}],"navigatorTitle":[{"text":"Presentation","kind":"identifier"}],"title":"Presentation","kind":"symbol","abstract":[{"type":"text","text":"Answers one OpenID4VP request: show "},{"type":"codeVoice","code":"verifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"queries"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"credentialSets"},{"type":"text","text":", choose a "},{"type":"codeVoice","code":"Selection"},{"type":"text","text":" (or start from"},{"type":"text","text":" "},{"type":"codeVoice","code":"defaultSelection()"},{"type":"text","text":"), "},{"type":"codeVoice","code":"preview(selection:)"},{"type":"text","text":" it, then"},{"type":"text","text":" "},{"type":"codeVoice","co