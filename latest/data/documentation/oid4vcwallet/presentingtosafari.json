\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","role":"symbol","kind":"symbol","abstract":[{"text":"The Keychain access group holder keys are made in, when the","type":"text"},{"text":" ","type":"text"},{"text":"app shares them with an extension — a document provider","type":"text"},{"text":" ","type":"text"},{"text":"presenting credentials, say — that lists the group in its","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}],"title":"holderAccessGroup","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderAccessGroup"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/readerCertificate":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readerCertificate","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation4DataV","text":"Data","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/readerCertificate","role":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/readercertificate","type":"topic","abstract":[{"type":"text","text":"That reader’s certificate, DER; nil without one. Compare"},{"type":"text","text":" "},{"type":"text","text":"certificates, not names: two can share a name."}],"title":"readerCertificate"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPres