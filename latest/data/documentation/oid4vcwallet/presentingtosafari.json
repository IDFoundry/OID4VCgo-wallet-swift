{"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","title":"Presenting to Safari","role":"article","modules":[{"name":"OID4VCWallet"}]},"abstract":[{"type":"text","text":"Answer a web page’s request for an mdoc over the Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, as an iOS document provider."}],"sections":[],"seeAlsoSections":[{"title":"Presenting to Safari","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"generated":true,"anchor":"Presenting-to-Safari"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C","type":"text"},{"text":" ","type":"text"},{"text":"Digital Credentials API, using the ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" protocol (ISO\/IEC TS","type":"text"},{"text":" ","type":"text"},{"text":"18013-7 Annex C). iOS offers the apps that registered a matching","type":"text"},{"text":" ","type":"text"},{"text":"document, and shows the chosen app’s document provider extension for","type":"text"},{"text":" ","type":"text"},{"text":"the holder’s consent. The extension answers through","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","isActive":true},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"response goes back through Safari, encrypted to the page, with no","type":"text"},{"text":" ","type":"text"},{"text":"network request from the wallet.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Safari sends only ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":", not OpenID4VP, and on iOS only:","type":"text"},{"text":" ","type":"text"},{"text":"Safari on macOS has no document providers.","type":"text"}]},{"type":"heading","level":3,"text":"Set up the app and its extension","anchor":"Set-up-the-app-and-its-extension"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The extension:","type":"text"}],"type":"strong"},{"type":"text","text":" a target whose Info.plist names the extension"},{"type":"text","text":" "},{"type":"text","text":"point "},{"type":"codeVoice","code":"com.apple.identity-document-services.document-provider-ui"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EXAppExtensionAttributes"},{"type":"text","text":", "},{"type":"codeVoice","code":"EXExtensionPointIdentifier"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The capability:","type":"text"}],"type":"strong"},{"type":"text","text":" Digital Credentials API – Mobile Document"},{"type":"text","text":" "},{"type":"text","text":"Provider, on both the app’s and the extension’s App IDs, with the"},{"type":"text","text":" "},{"type":"text","text":"doctypes the app presents in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types"},{"type":"text","text":" "},{"type":"text","text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL"},{"type":"text","text":" "},{"type":"text","text":"and Photo ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Shared storage:","type":"text"}],"type":"strong"},{"type":"text","text":" the extension is another process, so the app"},{"type":"text","text":" "},{"type":"text","text":"keeps its credentials in an App Group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true,"type":"reference"},{"type":"text","text":"), and its holder keys in"},{"text":" ","type":"text"},{"text":"a Keychain access group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","type":"reference"},{"text":"). Instance and DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keys stay in the app’s own group: the extension presents, but doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"receive. The app saves its configuration where the extension can","type":"text"},{"text":" ","type":"text"},{"text":"read it too.","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"type":"heading","level":3,"text":"Register the documents","anchor":"Register-the-documents"},{"type":"paragraph","inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change, register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"code":"supportedAuthorityKeyIdentifiers","type":"codeVoice"},{"text":" names the reader CAs, by subject key","type":"text"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}]},{"syntax":"swift","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"],"type":"codeListing"},{"type":"heading","level":3,"text":"Answer in the extension","anchor":"Answer-in-the-extension"},{"inlineContent":[{"type":"text","text":"iOS hands the extension the request in two stages. First,"},{"type":"text","text":" "},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.request"},{"type":"text","text":" describes what’s asked,"},{"type":"text","text":" "},{"type":"text","text":"for the consent screen: show it with the website’s origin, and the"},{"type":"text","text":" "},{"type":"text","text":"candidates from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)"},{"type":"text","text":". Only when the"},{"type":"text","text":" "},{"type":"text","text":"holder shares does iOS release the request itself, to"},{"type":"text","text":" "},{"type":"codeVoice","code":"sendResponse"},{"type":"text","text":"‘s closure. Validate it there, parse it, check it’s what"},{"type":"text","text":" "},{"type":"text","text":"the holder was shown, and answer."}],"type":"paragraph"},{"type":"codeListing","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","","    var body: some View {","        Button(\"Share\") { Task { try await share(credentialID: nil) } }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil) for the request's first document.","    func share(credentialID: String?) async throws {","        guard let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let wallet = try SharedWallet.open(provider: nil)","        try await context.sendResponse { raw in","            _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","            let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","            guard let document = presentation.request.documents.first,","                  let chosen = credentialID ?? document.credentials.first?.id else { throw RequestChanged() }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            let response = try await presentation.respond(document: 0, credentialID: chosen, elements: document.elements)","            return ISO18013MobileDocumentResponse(responseData: response.response)","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"A real consent screen compares the released request with what it","type":"text"},{"text":" ","type":"text"},{"text":"showed — the same document, elements and reader — and refuses one that","type":"text"},{"text":" ","type":"text"},{"text":"changed. The demo wallet’s ","type":"text"},{"code":"DocumentProvider","type":"codeVoice"},{"text":" target does this in full.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Name the reader","level":3,"anchor":"Name-the-reader"},{"inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"text":"issued for readers, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Warn of linkable presentations","level":3,"anchor":"Warn-of-linkable-presentations"},{"inlineContent":[{"text":"Each candidate’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"},"kind":"article","references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"title":"mdocCandidates(origin:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocCandidates"},{"kind":"text","text":"("},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary"},{"kind":"text","text":"]"}],"url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","abstract":[{"text":"The held mdocs, each with whether the page at ","type":"text"},{"code":"origin","type":"codeVoice"},{"text":" has been","type":"text"},{"text":" ","type":"text"},{"text":"shown it and whether presenting it there now would be linkable","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"shownToVerifier","type":"codeVoice"},{"text":", ","type":"text"},{"code":"linkableHere","type":"codeVoice"},{"text":"): for a document provider’s","type":"text"},{"text":" ","type":"text"},{"text":"consent screen, shown before iOS releases the request itself.","type":"text"},{"text":" ","type":"text"},{"code":"MdocPresentation.request","type":"codeVoice"},{"text":" says the same once it has.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"type":"topic","role":"symbol","kind":"symbol","title":"requireTrustedMdocReader","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","abstract":[{"type":"text","text":"Refuses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request no recognized reader signed:"},{"type":"text","text":" "},{"type":"codeVoice","code":"startMdocPresentation"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"untrustedVerifier"},{"type":"text","text":", and nothing is"},{"type":"text","text":" "},{"type":"text","text":"shown to the holder. Needs "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":"."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requireTrustedMdocReader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"title":"OID4VCWallet","url":"\/documentation\/oid4vcwallet","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"type":"topic","role":"collection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPresentation(requestData:origin:)":{"title":"startMdocPresentation(requestData:origin:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"startMdocPresentation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"requestData","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":", ","kind":"text"},{"text":"origin","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"