d(document:credentialID:elements:)","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"document","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"credentialID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"elements","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC7ElementV","text":"Element","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","text":"Response","kind":"typeIdentifier"}],"title":"respond(document:credentialID:elements:)","role":"symbol","abstract":[{"text":"Presents the held mdoc ","type":"text"},{"code":"credentialID","type":"codeVoice"},{"text":" for document number","type":"text"},{"text":" ","type":"text"},{"code":"document","type":"codeVoice"},{"text":", disclosing exactly ","type":"text"},{"code":"elements","type":"codeVoice"},{"text":", each one it requested.","type":"text"},{"text":" ","type":"text"},{"text":"The holder key signs now, so a key store requiring user presence","type":"text"},{"text":" ","type":"text"},{"text":"prompts.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/readerCertificate":{"abstract":[{"text":"That reader’s certificate, DER; nil without one. Compare","type":"text"},{"text":" ","type":"text"},{"text":"certificates, not names: two can share a name.","type":"text"}],"role":"symbol","title":"readerCertificate","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"readerCertificate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/readercertificate","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/readerCertificate"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocReaderRoots"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"title":"mdocReaderRoots","role":"symbol","abstract":[{"text":"PEM certificates: the mdoc readers recognized when one signs an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" request (","type":"text"},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"text":"). Empty:","type":"text"},{"text":" ","type":"text"},{"text":"every such request is shown by its origin.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocCandidates"},{"kind":"text","text":"("},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary"},{"kind":"text","text":"]"}],"title":"mdocCandidates(origin:)","role":"symbol","abstract":[{"type":"text","text":"The held mdocs, each with whether the page at "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" has been"},{"type":"text","text":" "},{"type":"text","text":"shown it and whether presenting it there now would be linkable"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"shownToVerifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"linkableHere"},{"type":"text","text":"): for a document provider’s"},{"type":"text","text":" "},{"type":"text","text":"consent screen, shown before iOS releases the request itself."},{"type":"text","text":" "},{"type":"codeVoice","code":"MdocPresentation.request"},{"type":"text","text":" says the same once it has."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPresentation(requestData:origin:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/startmdocpresentation(requestdata:origin:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startMdocPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"requestData"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":", "},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")