 one signs an","type":"text"},{"text":" ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" request (","type":"text"},{"code":"MdocPresentation.Request.reader","type":"codeVoice"},{"text":"). Empty:","type":"text"},{"text":" ","type":"text"},{"text":"every such request is shown by its origin.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkable","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","type":"topic","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/response\/linkable","title":"linkable","abstract":[{"type":"text","text":"Whether a copy presented had been seen by another Verifier: for"},{"type":"text","text":" "},{"type":"text","text":"several documents, whether any was."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","title":"mdocReaderRequireEKU","type":"topic","abstract":[{"type":"text","text":"Recognizes only reader certificates with the ISO\/IEC 18013-5"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage (1.0.18013.5.1.6), so a"},{"type":"text","text":" "},{"type":"text","text":"certificate issued for another role under "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":" "},{"type":"text","text":"isn’t taken for a reader’s."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","t