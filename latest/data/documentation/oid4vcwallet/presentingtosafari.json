{"sections":[],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"title":"Presenting to Safari","anchor":"Presenting-to-Safari"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, using the "},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" protocol (ISO\/IEC TS","type":"text"},{"text":" ","type":"text"},{"text":"18013-7 Annex C). iOS offers the apps that registered a matching","type":"text"},{"text":" ","type":"text"},{"text":"document, and shows the chosen app’s document provider extension for","type":"text"},{"text":" ","type":"text"},{"text":"the holder’s consent. The extension answers through","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","isActive":true},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"response goes back through Safari, encrypted to the page, with no"},{"type":"text","text":" "},{"type":"text","text":"network request from the wallet."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Safari sends only ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":", not OpenID4VP, and on iOS only:","type":"text"},{"text":" ","type":"text"},{"text":"Safari on macOS has no document providers.","type":"text"}]},{"type":"heading","anchor":"Set-up-the-app-and-its-extension","level":3,"text":"Set up the app and its extension"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"The extension:","type":"text"}],"type":"strong"},{"type":"text","text":" a target whose Info.plist names the extension"},{"type":"text","text":" "},{"type":"text","text":"point "},{"code":"com.apple.identity-document-services.document-provider-ui","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"EXAppExtensionAttributes","type":"codeVoice"},{"type":"text","text":", "},{"code":"EXExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"The capability:","type":"text"}],"type":"strong"},{"type":"text","text":" Digital Credentials API – Mobile Document"},{"type":"text","text":" "},{"type":"text","text":"Provider, on both the app’s and the extension’s App IDs, with the"},{"type":"text","text":" "},{"type":"text","text":"doctypes the app presents in the"},{"type":"text","text":" "},{"code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL"},{"type":"text","text":" "},{"type":"text","text":"and Photo ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Shared storage:","type":"text"}],"type":"strong"},{"type":"text","text":" the extension is another process, so the app"},{"type":"text","text":" "},{"type":"text","text":"keeps its credentials in an App Group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},{"type":"text","text":"), and its holder keys in"},{"type":"text","text":" "},{"type":"text","text":"a Keychain access group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup"},{"type":"text","text":"). Instance and DPoP"},{"type":"text","text":" "},{"type":"text","text":"keys stay in the app’s own group: the extension presents, but doesn’t"},{"type":"text","text":" "},{"type":"text","text":"receive. The app saves its configuration where the extension can"},{"type":"text","text":" "},{"type":"text","text":"read it too."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"type":"heading","anchor":"Register-the-documents","level":3,"text":"Register the documents"},{"type":"paragraph","inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change, register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"supportedAuthorityKeyIdentifiers"},{"text":" names the reader CAs, by subject key","type":"text"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"]},{"type":"heading","anchor":"Answer-in-the-extension","level":3,"text":"Answer in the extension"},{"type":"paragraph","inlineContent":[{"text":"iOS hands the extension the request in two stages. First,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.request"},{"text":" describes what’s asked,","type":"text"},{"text":" ","type":"text"},{"text":"for the consent screen: show it with the website’s origin, and the","type":"text"},{"text":" ","type":"text"},{"text":"candidates from ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","isActive":true},{"text":". Only when the","type":"text"},{"text":" ","type":"text"},{"text":"holder shares does iOS release the request itself, to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sendResponse"},{"text":"‘s closure. Validate it there, parse it, check it’s what","type":"text"},{"text":" ","type":"text"},{"text":"the holder was shown, and answer.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","","    var body: some View {","        Button(\"Share\") { Task { try await share(credentialID: nil) } }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil) for the request's first document.","    func share(credentialID: String?) async throws {","        guard let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let wallet = try SharedWallet.open(provider: nil)","        try await context.sendResponse { raw in","            _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","            let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","            guard let document = presentation.request.documents.first,","                  let chosen = credentialID ?? document.credentials.first?.id else { throw RequestChanged() }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            let response = try await presentation.respond(document: 0, credentialID: chosen, elements: document.elements)","            return ISO18013MobileDocumentResponse(responseData: response.response)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A real consent screen compares the released request with what it","type":"text"},{"text":" ","type":"text"},{"text":"showed — the same document, elements and reader — and refuses one that","type":"text"},{"text":" ","type":"text"},{"text":"changed. The demo wallet’s ","type":"text"},{"type":"codeVoice","code":"DocumentProvider"},{"text":" target does this in full.","type":"text"}]},{"type":"heading","anchor":"Name-the-reader","level":3,"text":"Name the reader"},{"type":"paragraph","inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"text":"issued for readers, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}]},{"type":"heading","anchor":"Warn-of-linkable-presentations","level":3,"text":"Warn of linkable presentations"},{"type":"paragraph","inlineContent":[{"text":"Each candidate’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}]}]}],"metadata":{"role":"article","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","title":"Presenting to Safari"},"kind":"article","references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPresentation(requestData:origin:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/startmdocpresentation(requestdata:origin:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startMdocPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"requestData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Data","preciseIdentifier":"s:10Foundation4DataV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"MdocPresentation","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","title":"startMdocPresentation(requestData:origin:)","abstract":[{"type":"text","text":"Parses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request — an mdoc asked for over the"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, as iOS hands one to a document provider"},{"type":"text","text":" "},{"type":"text","text":"extension — and finds the held mdocs that can answer it."},{"type":"text","text":" "},{"type":"codeVoice","code":"requestData"},{"type":"text","text":" is "},{"type":"codeVoice","code":"IdentityDocumentWebPresentmentRawRequest.requestData"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" the requesting page’s origin"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.requestingWebsiteOrigin"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"MdocPresentation.origin(of:)"},{"type":"text","text":" serializes it."}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocCandidates"},{"kind":"text","text":"("},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","title":"mdocCandidates(origin:)","abstract":[{"type":"text","text":"The held mdocs, each with whether the page at "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" has been"},{"type":"text","text":" "},{"type":"text","text":"shown it and whether presenting it there now would be linkable"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"shownToVerifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"linkableHere"},{"type":"text","text":"): for a document provider’s"},{"type":"text","text":" "},{"type":"text","text":"consent screen, shown before iOS releases the request itself."},{"type":"text","text":" "},{"type":"codeVoice","code":"MdocPresentation.request"},{"type":"text","text":" says the same once it has."}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","type":"topic","kind":"symbol","title":"mdocReaderRoots","abstract":[{"type":"text","text":"PEM certificates: the mdoc readers recognized when one signs an"},{"type":"text","text":" "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request ("},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"every such request is shown by its origin."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkable"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"linkable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","abstract":[{"type":"text","text":"Whether the copy presented had been seen by another Verifier."}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/response\/linkable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"url":"\/documentation\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inAppGroup"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Options","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"FileCredentialStore","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","title":"inAppGroup(_:options:)","abstract":[{"text":"A store in the app group ","type":"text"},{"code":"identifier","type":"codeVoice"},{"text":"’s container","type":"text"},{"text":" ","type":"text"},{"text":"(Library\/Application Support\/credentials there), which the app and","type":"text"},{"text":" ","type":"text"},{"text":"its extensions listing the group in their","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.application-groups","type":"codeVoice"},{"text":" entitlement share.","type":"text"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderAccessGroup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"title":"holderAccessGroup","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","abstract":[{"text":"The Keychain access group holder keys are made in, when the","type":"text"},{"text":" ","type":"text"},{"text":"app shares them with an extension — a document provider","type":"text"},{"text":" ","type":"text"},{"text":"presenting credentials, say — that lists the group in its","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"type":"topic","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"title":"MdocPresentation","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request (ISO\/IEC TS 18013-7 Annex C): show"},{"type":"text","text":" "},{"type":"codeVoice","code":"request"},{"type":"text","text":" for the holder’s consent, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" once; to decline,"},{"type":"text","text":" "},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}],"role":"symbol","navigatorTitle":[{"text":"MdocPresentation","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","type":"topic","kind":"symbol","title":"mdocReaderRequireEKU","abstract":[{"type":"text","text":"Recognizes only reader certificates with the ISO\/IEC 18013-5"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extend