{"metadata":{"title":"Presenting to Safari","roleHeading":"Article","modules":[{"name":"OID4VCWallet"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"seeAlsoSections":[{"title":"Presenting to Safari","generated":true,"anchor":"Presenting-to-Safari","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"]}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","interfaceLanguage":"swift"},"abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C","type":"text"},{"text":" ","type":"text"},{"text":"Digital Credentials API, using the ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" protocol (ISO\/IEC TS","type":"text"},{"text":" ","type":"text"},{"text":"18013-7 Annex C). iOS offers the apps that registered a matching","type":"text"},{"text":" ","type":"text"},{"text":"document, and shows the chosen app’s document provider extension for","type":"text"},{"text":" ","type":"text"},{"text":"the holder’s consent. The extension answers through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","type":"reference"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"response goes back through Safari, encrypted to the page, with no","type":"text"},{"text":" ","type":"text"},{"text":"network request from the wallet.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Safari sends only ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":", not OpenID4VP, and on iOS only:","type":"text"},{"text":" ","type":"text"},{"text":"Safari on macOS has no document providers.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Set up the app and its extension","type":"heading","anchor":"Set-up-the-app-and-its-extension"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The extension:"}],"type":"strong"},{"text":" a target whose Info.plist names the extension","type":"text"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"code":"com.apple.identity-document-services.document-provider-ui","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EXAppExtensionAttributes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EXExtensionPointIdentifier","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The capability:"}],"type":"strong"},{"text":" Digital Credentials API – Mobile Document","type":"text"},{"text":" ","type":"text"},{"text":"Provider, on both the app’s and the extension’s App IDs, with the","type":"text"},{"text":" ","type":"text"},{"text":"doctypes the app presents in the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types","type":"codeVoice"},{"text":" ","type":"text"},{"text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL","type":"text"},{"text":" ","type":"text"},{"text":"and Photo ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shared storage:"}],"type":"strong"},{"text":" the extension is another process, so the app","type":"text"},{"text":" ","type":"text"},{"text":"keeps its credentials in an App Group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","type":"reference"},{"text":"), and its holder keys in","type":"text"},{"text":" ","type":"text"},{"text":"a Keychain access group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","type":"reference"},{"text":"). Instance and DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keys stay in the app’s own group: the extension presents, but doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"receive. The app saves its configuration where the extension can","type":"text"},{"text":" ","type":"text"},{"text":"read it too.","type":"text"}]}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"level":3,"text":"Register the documents","type":"heading","anchor":"Register-the-documents"},{"inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change, register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"code":"supportedAuthorityKeyIdentifiers","type":"codeVoice"},{"text":" names the reader CAs, by subject key","type":"text"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"]},{"level":3,"text":"Answer in the extension","type":"heading","anchor":"Answer-in-the-extension"},{"inlineContent":[{"text":"iOS hands the extension the request in two stages. First,","type":"text"},{"text":" ","type":"text"},{"code":"ISO18013MobileDocumentRequestContext.request","type":"codeVoice"},{"text":" describes what’s asked,","type":"text"},{"text":" ","type":"text"},{"text":"for the consent screen: show it with the website’s origin, and the","type":"text"},{"text":" ","type":"text"},{"text":"candidates from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","type":"reference"},{"text":". Only when the","type":"text"},{"text":" ","type":"text"},{"text":"holder shares does iOS release the request itself, to","type":"text"},{"text":" ","type":"text"},{"code":"sendResponse","type":"codeVoice"},{"text":"‘s closure. Validate it there, parse it, check it’s what","type":"text"},{"text":" ","type":"text"},{"text":"the holder was shown, and answer.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","    @State private var problem: String?","","    \/\/\/ The request's first document as iOS parsed it: what the consent","    \/\/\/ screen shows the holder.","    private var shown: (doctype: String, elements: [MdocPresentation.Element])? {","        guard let document = context.request.presentmentRequests.first?.documentRequestSets.first?.requests.first else {","            return nil","        }","        let elements = document.namespaces.flatMap { namespace, elements in","            elements.map { MdocPresentation.Element(namespace: namespace, identifier: $0.key, retain: $0.value.isRetaining) }","        }","        return (document.documentType, elements)","    }","","    var body: some View {","        VStack {","            if let problem { Text(problem) }","            Button(\"Share\") { Task { await share(credentialID: nil) } }","            Button(\"Cancel\") { context.cancel() }","        }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil), for exactly the document and elements the holder was shown.","    func share(credentialID: String?) async {","        guard let shown, let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        do {","            let wallet = try SharedWallet.open(provider: nil)","            try await context.sendResponse { raw in","                _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                    .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","                let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","                \/\/ Answer only what the holder was shown.","                guard let index = presentation.request.documents.firstIndex(where: { $0.doctype == shown.doctype }),","                      Set(presentation.request.documents[index].elements) == Set(shown.elements),","                      let chosen = credentialID ?? presentation.request.documents[index].credentials.first?.id else {","                    throw RequestChanged()","                }","                \/\/ The holder key signs now: Face ID, if the key store asks.","                let response = try await presentation.respond(document: index, credentialID: chosen, elements: shown.elements)","                return ISO18013MobileDocumentResponse(responseData: response.response)","            }","        } catch {","            \/\/ Nothing was shared: say so, and let the holder cancel.","            problem = \"Not shared: \\(error)\"","        }","    }","}"]},{"inlineContent":[{"text":"The response answers the elements the holder was shown, not those the","type":"text"},{"text":" ","type":"text"},{"text":"released request names, and a request that changed in between is","type":"text"},{"text":" ","type":"text"},{"text":"refused. Where the consent screen names the reader (below), compare its","type":"text"},{"text":" ","type":"text"},{"text":"certificate with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/readerCertificate","type":"reference"},{"text":" there","type":"text"},{"text":" ","type":"text"},{"text":"too. The demo wallet’s ","type":"text"},{"type":"codeVoice","code":"DocumentProvider"},{"type":"text","text":" target does all of this, with"},{"type":"text","text":" "},{"type":"text","text":"a choice of credential and a linkability warning."}],"type":"paragraph"},{"level":3,"text":"Name the reader","type":"heading","anchor":"Name-the-reader"},{"inlineContent":[{"type":"text","text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC"},{"type":"text","text":" "},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","type":"reference"},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","type":"reference"},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"text":"issued for readers, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","type":"reference"},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Warn of linkable presentations","type":"heading","anchor":"Warn-of-linkable-presentations"},{"inlineContent":[{"type":"text","text":"Each candidate’s "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","type":"reference","isActive":true},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","type":"reference","isActive":true},{"type":"text","text":" whether it did. The"},{"type":"text","text":" "},{"type":"text","text":"extension doesn’t refresh used-up copies: have the app do it when it"},{"type":"text","text":" "},{"type":"text","text":"next becomes active, after listing its credentials again."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/reader":{"role":"symbol","title":"reader","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/reader","abstract":[{"type":"text","text":"The subject common name of the reader that signed the request,"},{"type":"text","text":" "},{"type":"text","text":"when its certificate chains to"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletConfiguration.mdocReaderRoots"},{"type":"text","text":", without control or"},{"type":"text","text":" "},{"type":"text","text":"invisible format characters; “” when the holder can only be"},{"type":"text","text":" "},{"type":"text","text":"shown "},{"type":"codeVoice","code":"origin"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"role":"symbol","navigatorTitle":[{"text":"MdocPresentation","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","url":"\/documentation\/oid4vcwallet\/mdocpresentation","title":"MdocPresentation","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"abstract":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" request (ISO\/IEC TS 18013-7 Annex C): show","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"request"},{"text":" for the holder’s consent, then ","type":"text"},{"code":"respond","type":"codeVoice"},{"type":"text","text":" once; to decline,"},{"type":"text","text":" "},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPresentation(requestData:origin:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/startmdocpresentation(requestdata:origin:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startMdocPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"requestData"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":", "},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC","kind":"typeIdentifier","text":"MdocPresentation"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","title":"startMdocPresentation(requestData:origin:)","abstract":[{"type":"text","text":"Parses an "},{"code":"org-iso-mdoc","type":"codeVoice"},{"type":"text","text":" request — an mdoc asked for over the"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, as iOS hands one to a document provider"},{"text":" ","type":"text"},{"text":"extension — and finds the held mdocs that can answer it.","type":"text"},{"text":" ","type":"text"},{"code":"requestData","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"IdentityDocumentWebPresentmentRawRequest.requestData","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"origin"},{"text":" the requesting page’s origin","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.requestingWebsiteOrigin"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"type":"codeVoice","code":"MdocPresentation.origin(of:)"},{"text":" serializes it.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/linkableHere":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","url":"\/documentation\/oid4vcwallet\/credentialsummary\/linkablehere","title":"linkableHere","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkableHere"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"abstract":[{"text":"Whether presenting it to the Verifier asking would hand it a copy","type":"text"},{"text":" ","type":"text"},{"text":"another Verifier has seen. Set only on a presentation’s candidates.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRequireEKU","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"mdocReaderRequireEKU","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","abstract":[{"text":"Recognizes only reader certificates with the ISO\/IEC 18013-5","type":"text"},{"text":" ","type":"text"},{"text":"reader authentication extended key usage (1.0.18013.5.1.6), so a","type":"text"},{"text":" ","type":"text"},{"text":"certificate issued for another role under ","type":"text"},{"code":"mdocReaderRoots","type":"codeVoice"},{"text":" ","type":"text"},{"text":"isn’t taken for a reader’s.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocCandidates"},{"kind":"text","text":"("},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier","text":"CredentialSummary"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","title":"mdocCandidates(origin:)","abstract":[{"text":"The held mdocs, each with whether the page at ","type":"text"},{"type":"codeVoice","code":"origin"},{"text":" has been","type":"text"},{"text":" ","type":"text"},{"text":"shown it and whether presenting it there now would be linkable","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"shownToVerifier"},{"text":", ","type":"text"},{"type":"codeVoice","code":"linkableHere"},{"text":"): for a document provider’s","type":"text"},{"text":" ","type":"text"},{"text":"consent screen, shown before iOS releases the request itself.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MdocPresentation.request"},{"text":" says the same once it has.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/readerCertificate":{"role":"symbol","title":"readerCertificate","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readerCertificate","kind"