{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"]}],"seeAlsoSections":[{"generated":true,"title":"Presenting to Safari","anchor":"Presenting-to-Safari","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"article","title":"Presenting to Safari","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C","type":"text"},{"text":" ","type":"text"},{"text":"Digital Credentials API, using the ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" protocol (ISO\/IEC TS","type":"text"},{"text":" ","type":"text"},{"text":"18013-7 Annex C). iOS offers the apps that registered a matching","type":"text"},{"text":" ","type":"text"},{"text":"document, and shows the chosen app’s document provider extension for","type":"text"},{"text":" ","type":"text"},{"text":"the holder’s consent. The extension answers through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","type":"reference"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"response goes back through Safari, encrypted to the page, with no","type":"text"},{"text":" ","type":"text"},{"text":"network request from the wallet.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Safari sends only ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":", not OpenID4VP, and on iOS only:","type":"text"},{"text":" ","type":"text"},{"text":"Safari on macOS has no document providers.","type":"text"}]},{"anchor":"Set-up-the-app-and-its-extension","level":3,"type":"heading","text":"Set up the app and its extension"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The extension:"}]},{"type":"text","text":" a target whose Info.plist names the extension"},{"type":"text","text":" "},{"type":"text","text":"point "},{"type":"codeVoice","code":"com.apple.identity-document-services.document-provider-ui"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EXAppExtensionAttributes"},{"type":"text","text":", "},{"type":"codeVoice","code":"EXExtensionPointIdentifier"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The capability:"}]},{"type":"text","text":" Digital Credentials API – Mobile Document"},{"type":"text","text":" "},{"type":"text","text":"Provider, on both the app’s and the extension’s App IDs, with the"},{"type":"text","text":" "},{"type":"text","text":"doctypes the app presents in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types"},{"type":"text","text":" "},{"type":"text","text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL"},{"type":"text","text":" "},{"type":"text","text":"and Photo ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared storage:"}]},{"type":"text","text":" the extension is another process, so the app"},{"type":"text","text":" "},{"type":"text","text":"keeps its credentials in an App Group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},{"type":"text","text":"), and its holder keys in"},{"type":"text","text":" "},{"type":"text","text":"a Keychain access group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup"},{"type":"text","text":"). Instance and DPoP"},{"type":"text","text":" "},{"type":"text","text":"keys stay in the app’s own group: the extension presents, but doesn’t"},{"type":"text","text":" "},{"type":"text","text":"receive. The app saves its configuration where the extension can"},{"type":"text","text":" "},{"type":"text","text":"read it too."}],"type":"paragraph"}]}]},{"type":"codeListing","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"],"syntax":"swift"},{"anchor":"Register-the-documents","level":3,"type":"heading","text":"Register the documents"},{"type":"paragraph","inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change, register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"code":"supportedAuthorityKeyIdentifiers","type":"codeVoice"},{"text":" names the reader CAs, by subject key","type":"text"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"],"syntax":"swift"},{"anchor":"Answer-in-the-extension","level":3,"type":"heading","text":"Answer in the extension"},{"type":"paragraph","inlineContent":[{"text":"iOS hands the extension the request in two stages. First,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.request"},{"text":" describes what’s asked,","type":"text"},{"text":" ","type":"text"},{"text":"for the consent screen: show it with the website’s origin, and the","type":"text"},{"text":" ","type":"text"},{"text":"candidates from ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)"},{"text":". Only when the","type":"text"},{"text":" ","type":"text"},{"text":"holder shares does iOS release the request itself, to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sendResponse"},{"text":"‘s closure. Validate it there, parse it, check it’s what","type":"text"},{"text":" ","type":"text"},{"text":"the holder was shown, and answer.","type":"text"}]},{"type":"codeListing","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","    @State private var problem: String?","","    \/\/\/ The request's first document as iOS parsed it: what the consent","    \/\/\/ screen shows the holder.","    private var shown: (doctype: String, elements: [MdocPresentation.Element])? {","        guard let document = context.request.presentmentRequests.first?.documentRequestSets.first?.requests.first else {","            return nil","        }","        let elements = document.namespaces.flatMap { namespace, elements in","            elements.map { MdocPresentation.Element(namespace: namespace, identifier: $0.key, retain: $0.value.isRetaining) }","        }","        return (document.documentType, elements)","    }","","    var body: some View {","        VStack {","            if let problem { Text(problem) }","            Button(\"Share\") { Task { await share(credentialID: nil) } }","            Button(\"Cancel\") { context.cancel() }","        }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil), for exactly the document and elements the holder was shown.","    func share(credentialID: String?) async {","        guard let shown, let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        do {","            let wallet = try SharedWallet.open(provider: nil)","            try await context.sendResponse { raw in","                _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                    .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","                let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","                \/\/ Answer only what the holder was shown.","                guard let index = presentation.request.documents.firstIndex(where: { $0.doctype == shown.doctype }),","                      Set(presentation.request.documents[index].elements) == Set(shown.elements),","                      let chosen = credentialID ?? presentation.request.documents[index].credentials.first?.id else {","                    throw RequestChanged()","                }","                \/\/ The holder key signs now: Face ID, if the key store asks.","                let response = try await presentation.respond(document: index, credentialID: chosen, elements: shown.elements)","                return ISO18013MobileDocumentResponse(responseData: response.response)","            }","        } catch {","            \/\/ Nothing was shared: say so, and let the holder cancel.","            problem = \"Not shared: \\(error)\"","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The response answers the elements the holder was shown, not those the"},{"type":"text","text":" "},{"type":"text","text":"released request names, and a request that changed in between is"},{"type":"text","text":" "},{"type":"text","text":"refused. Where the consent screen names the reader (below), compare its"},{"type":"text","text":" "},{"type":"text","text":"certificate with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/readerCertificate"},{"type":"text","text":" there"},{"type":"text","text":" "},{"type":"text","text":"too. The demo wallet’s "},{"type":"codeVoice","code":"DocumentProvider"},{"type":"text","text":" target does all of this, with"},{"type":"text","text":" "},{"type":"text","text":"a choice of credential and a linkability warning."}]},{"anchor":"Name-the-reader","level":3,"type":"heading","text":"Name the reader"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC"},{"type":"text","text":" "},{"type":"text","text":"18013-5 reader authentication). When the certificate chains to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader"},{"type":"text","text":" "},{"type":"text","text":"names it; otherwise show only the website’s origin."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU"},{"type":"text","text":" accepts only certificates"},{"type":"text","text":" "},{"type":"text","text":"issued for readers, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader"},{"type":"text","text":" "},{"type":"text","text":"refuses requests from any other reader before the holder sees them."}]},{"anchor":"Warn-of-linkable-presentations","level":3,"type":"heading","text":"Warn of linkable presentations"},{"type":"paragraph","inlineContent":[{"text":"Each candidate’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable"},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}]}]}],"abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/reader":{"title":"reader","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/reader","kind":"symbol","role":"symbol","abstract":[{"text":"The subject common name of the reader that signed the request,","type":"text"},{"text":" ","type":"text"},{"text":"when its certificate chains to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletConfiguration.mdocReaderRoots"},{"text":", without control or","type":"text"},{"text":" ","type":"text"},{"text":"invisible format characters; “” when the holder can only be","type":"text"},{"text":" ","type":"text"},{"text":"shown ","type":"text"},{"type":"codeVoice","code":"origin"},{"text":".","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocReaderRequireEKU"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","kind":"symbol","abstract":[{"type":"text","text":"Recognizes only reader certificates with the ISO\/IEC 18013-5"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage (1.0.18013.5.1.6), so a"},{"type":"text","text":" "},{"type":"text","text":"certificate issued for another role under "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":" "},{"type":"text","text":"isn’t taken for a reader’s."}],"title":"mdocReaderRequireEKU"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocReaderRoots"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","kind":"symbol","abstract":[{"text":"PEM certificates: the mdoc readers recognized when one signs an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" request (","type":"text"},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"text":"). Empty:","type":"text"},{"text":" ","type":"text"},{"text":"every such request is shown by its origin.","type":"text"}],"title":"mdocReaderRoots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"title":"OID4VCWallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","type":"topic","url":"\/documentation\/oid4vcwallet","kind":"symbol","role":"collection","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"title":"MdocPresentation","url":"\/documentation\/oid4vcwallet\/mdocpresentation","navigatorTitle":[{"text":"MdocPresentation","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","role":"symbol","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request (ISO\/IEC TS 18013-7 Annex C): show"},{"type":"text","text":" "},{"type":"codeVoice","code":"request"},{"type":"text","text":" for the holder’s consent, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" once; to decline,"},{"type":"text","text":" "},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}],"kind":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"title":"mdocCandidates(origin:)","url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocCandidates","kind":"identifier"},{"text":"(","kind":"text"},{"text":"origin","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"CredentialSummary","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","role":"symbol","abstract":[{"type":"text","text":"The held mdocs, each with whether the page at "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" has been"},{"type":"text","text":" "},{"type":"text","text":"shown it and whether presenting it there now would be linkable"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"shownToVerifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"linkableHere"},{"type":"text","text":"): for a document provider’s"},{"type":"text","text":" "},{"type":"text","text":"consent screen, shown before iOS releases the request itself."},{"type":"text","text":" "},{"type":"codeVoice","code":"MdocPresentation.request"},{"type":"text","text":" says the same once it has."}],"kind":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inAppGroup","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Options","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"FileCredentialStore","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC"}],"abstract":[{"text":"A store in the app group ","type":"text"},{"type":"codeVoice","code":"identifier"},{"text":"’s container","type":"text"},{"text":" ","type":"text"},{"text":"(Library\/Application Support\/credentials there), which the app and","type":"text"},{"text":" ","type":"text"},{"text":"its extensions listing the group in their","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"text":" entitlement share.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","url":"\/documentation\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","title":"inAppGroup(_:options:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCW