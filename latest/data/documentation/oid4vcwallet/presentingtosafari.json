{"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"anchor":"Presenting-to-Safari","title":"Presenting to Safari","generated":true}],"sections":[],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"OID4VCWallet"}],"title":"Presenting to Safari"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C","type":"text"},{"text":" ","type":"text"},{"text":"Digital Credentials API, using the ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" protocol (ISO\/IEC TS","type":"text"},{"text":" ","type":"text"},{"text":"18013-7 Annex C). iOS offers the apps that registered a matching","type":"text"},{"text":" ","type":"text"},{"text":"document, and shows the chosen app’s document provider extension for","type":"text"},{"text":" ","type":"text"},{"text":"the holder’s consent. The extension answers through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(shown:readerCertificate:)"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"response goes back through Safari, encrypted to the page, with no","type":"text"},{"text":" ","type":"text"},{"text":"network request from the wallet.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Safari sends only ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":", not OpenID4VP, and on iOS only:","type":"text"},{"text":" ","type":"text"},{"text":"Safari on macOS has no document providers.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Set up the app and its extension","anchor":"Set-up-the-app-and-its-extension","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The extension:"}],"type":"strong"},{"text":" a target whose Info.plist names the extension","type":"text"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"code":"com.apple.identity-document-services.document-provider-ui","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EXAppExtensionAttributes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EXExtensionPointIdentifier","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The capability:"}],"type":"strong"},{"text":" Digital Credentials API – Mobile Document","type":"text"},{"text":" ","type":"text"},{"text":"Provider, on both the app’s and the extension’s App IDs, with the","type":"text"},{"text":" ","type":"text"},{"text":"doctypes the app presents in the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types","type":"codeVoice"},{"text":" ","type":"text"},{"text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL","type":"text"},{"text":" ","type":"text"},{"text":"and Photo ID.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shared storage:"}],"type":"strong"},{"text":" the extension is another process, so the app","type":"text"},{"text":" ","type":"text"},{"text":"keeps its credentials in an App Group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true,"type":"reference"},{"text":"), and its holder keys in","type":"text"},{"text":" ","type":"text"},{"text":"a Keychain access group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true,"type":"reference"},{"text":"). Instance and DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keys, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true,"type":"reference"},{"text":"‘s registration key, stay in the","type":"text"},{"text":" ","type":"text"},{"text":"app’s default group: the extension presents, but doesn’t receive.","type":"text"},{"text":" ","type":"text"},{"text":"The default group is the first in the app’s ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" ","type":"text"},{"text":"entitlement, so list a group only the app has first and the shared","type":"text"},{"text":" ","type":"text"},{"text":"group after it; listed first, the shared group becomes the default,","type":"text"},{"text":" ","type":"text"},{"text":"and those keys land where the extension can use them. The app saves","type":"text"},{"text":" ","type":"text"},{"text":"its configuration where the extension can read it too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A wallet that starts on ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/standard(options:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"and the default ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true,"type":"reference"},{"text":" and adds the extension later","type":"text"},{"text":" ","type":"text"},{"text":"can’t hand the extension what it already holds: its credentials are","type":"text"},{"text":" ","type":"text"},{"text":"bound to holder keys in the app’s own group, and the package has no","type":"text"},{"text":" ","type":"text"},{"text":"call that moves credentials or keys to the shared ones. Its holder","type":"text"},{"text":" ","type":"text"},{"text":"would receive each credential again. If the app may ever present to","type":"text"},{"text":" ","type":"text"},{"text":"Safari, start on the App Group store and the shared holder key group","type":"text"},{"text":" ","type":"text"},{"text":"from its first release.","type":"text"}]},{"type":"codeListing","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.wallet<\/string>        <!-- the app's own: the default -->","    <string>$(AppIdentifierPrefix)com.example.wallet.shared<\/string> <!-- shared with the extension -->","<\/array>"],"syntax":null}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"level":3,"text":"Register the documents","anchor":"Register-the-documents","type":"heading"},{"inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change — and after status checks, which can make one","type":"text"},{"text":" ","type":"text"},{"text":"unpresentable — register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"code":"supportedAuthorityKeyIdentifiers","type":"codeVoice"},{"text":" names the reader CAs, by subject key","type":"text"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    \/\/ Presentable: unexpired, not found revoked or suspended, and its key still here.","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\")","        && credential.presentable && credential.holderKeyPresent != false {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"]},{"level":3,"text":"Answer in the extension","anchor":"Answer-in-the-extension","type":"heading"},{"inlineContent":[{"text":"iOS hands the extension the request in two stages. First,","type":"text"},{"text":" ","type":"text"},{"code":"ISO18013MobileDocumentRequestContext.request","type":"codeVoice"},{"text":" describes what’s asked,","type":"text"},{"text":" ","type":"text"},{"text":"for the consent screen: show it with the website’s origin, and the","type":"text"},{"text":" ","type":"text"},{"text":"candidates from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)"},{"text":". Only when the","type":"text"},{"text":" ","type":"text"},{"text":"holder shares does iOS release the request itself, to","type":"text"},{"text":" ","type":"text"},{"code":"sendResponse","type":"codeVoice"},{"text":"‘s closure. Validate it there, parse it, check it’s what","type":"text"},{"text":" ","type":"text"},{"text":"the holder was shown, and answer.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","    @State private var problem: String?","    \/\/\/ The one wallet this request uses, opened when the screen appears.","    @State private var wallet: Wallet?","    \/\/\/ The candidate shared, from `Wallet.mdocCandidates(origin:)`.","    @State private var chosen: CredentialSummary?","","    \/\/\/ The request's first document as iOS parsed it: what the consent","    \/\/\/ screen shows the holder.","    private var shown: (doctype: String, elements: [MdocPresentation.Element])? {","        guard let document = context.request.presentmentRequests.first?.documentRequestSets.first?.requests.first else {","            return nil","        }","        let elements = document.namespaces.flatMap { namespace, elements in","            elements.map { MdocPresentation.Element(namespace: namespace, identifier: $0.key, retain: $0.value.isRetaining) }","        }","        return (document.documentType, elements)","    }","","    var body: some View {","        VStack {","            if let problem { Text(problem) }","            if chosen?.linkableHere == true { Text(\"This website could link this to another.\") }","            Button(\"Share\") { Task { await share() } }.disabled(chosen == nil)","            Button(\"Cancel\") { context.cancel() }","        }","        .task {","            guard let shown, let originURL = context.requestingWebsiteOrigin,","                  let origin = MdocPresentation.origin(of: originURL) else { return }","            do {","                let opened = try SharedWallet.open(provider: nil)","                wallet = opened","                \/\/ Every held mdoc is a candidate, an expired or revoked","                \/\/ one too: offer only one that can be presented.","                chosen = try await opened.mdocCandidates(origin: origin)","                    .first { $0.doctype == shown.doctype && $0.presentable }","            } catch {","                problem = \"Can't read the wallet: \\(error)\"","            }","        }","    }","","    \/\/\/ Shares the chosen mdoc, for exactly the document and elements the","    \/\/\/ holder was shown.","    func share() async {","        guard let shown, let chosen, let wallet, let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let agreed = MdocPresentation.Shown(doctype: shown.doctype, elements: shown.elements,","                                            credentialID: chosen.id, toldLinkable: chosen.linkableHere == true)","        do {","            try await context.sendResponse { raw in","                _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                    .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","                let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","                \/\/ Answer only what the holder was shown, or throw","                \/\/ RequestChanged. The holder key signs now: Face ID, if","                \/\/ the key store asks.","                let response = try await presentation.respond(shown: [agreed], readerCertificate: nil)","                return ISO18013MobileDocumentResponse(responseData: response.response)","            }","        } catch {","            \/\/ Nothing was shared: say so, and let the holder cancel.","            problem = \"Not shared: \\(error)\"","        }","    }","}"]},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(shown:readerCertificate:)"},{"text":" answers the","type":"text"},{"text":" ","type":"text"},{"text":"elements the holder was shown, not those the released request names,","type":"text"},{"text":" ","type":"text"},{"text":"and refuses, with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/RequestChanged"},{"text":", a request that","type":"text"},{"text":" ","type":"text"},{"text":"changed in between: a shown document no longer asked for, or asked for","type":"text"},{"text":" ","type":"text"},{"text":"with other elements; a chosen credential that no longer answers it; or","type":"text"},{"text":" ","type":"text"},{"text":"one that became linkable here when the holder wasn’t told","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Shown\/toldLinkable"},{"text":"). Where the consent screen","type":"text"},{"text":" ","type":"text"},{"text":"names the reader (below), pass that reader’s certificate as","type":"text"},{"text":" ","type":"text"},{"code":"readerCertificate","type":"codeVoice"},{"text":", and a request signed by any other is refused too.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/answers(for:readerCertificate:)"},{"text":" makes the","type":"text"},{"text":" ","type":"text"},{"text":"same check without answering. The demo wallet’s ","type":"text"},{"code":"DocumentProvider","type":"codeVoice"},{"text":" ","type":"text"},{"text":"target does all of this, with several documents, a choice of","type":"text"},{"text":" ","type":"text"},{"text":"credential and a linkability warning.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Name the reader","anchor":"Name-the-reader","type":"heading"},{"inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader"},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU"},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"text":"issued for readers, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader"},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Warn of linkable presentations","anchor":"Warn-of-linkable-presentations","type":"heading"},{"inlineContent":[{"text":"Each candidate’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable"},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/RequestChanged":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/RequestChanged","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestChanged"}],"role":"symbol","abstract":[{"text":"The released request isn’t what the holder was shown: nothing was","type":"text"},{"text":" ","type":"text"},{"text":"answered.","type":"text"}],"title":"MdocPresentation.RequestChanged","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RequestChanged"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/requestchanged"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/linkableHere":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkableHere"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"role":"symbol","abstract":[{"text":"Whether presenting it to the Verifier asking would hand it a copy","type":"text"},{"text":" ","type":"text"},{"text":"another Verifier has seen. Set only on a presentation’s candidates.","type":"text"}],"title":"linkableHere","kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/linkablehere"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProvider"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/walletprovider","title":"WalletProvider","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"navigatorTitle":[{"kind":"identifier","text":"WalletProvider"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(shown:readerCertificate:)":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(shown:readerCertificate:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"shown"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC5ShownV","kind":"typeIdentifier","text":"Shown"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"readerCertificate"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","kind":"typeIdentifier","text":"Response"}],"role":"symbol","abstract":[{"text":"Answers the request with what the holder was shown","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/answers(for:readerCertificate:)"},{"text":"): ","type":"text"},{"code":"respond(answers:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"once the check passes.","type":"text"}],"title":"respond(shown:readerCertificate:)","kind":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(shown:readercertificate:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocReaderRoots"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"role":"symbol","abstract":[{"text":"PEM certificates: the mdoc readers recognized when one signs an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" request (","type":"text"},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"text":"). Empty:","type":"text"},{"text":" ","type":"text"},{"text":"every such request is shown by its origin.","type":"text"}],"title":"mdocReaderRoots","kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation","type":"topic","abstract":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"org-iso-mdoc"},{"text":" request (ISO\/IEC TS 18013-7 Annex C): show","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"request"},{"text":" for the holder’s consent, then ","type":"text"},{"type":"codeVoice","cod