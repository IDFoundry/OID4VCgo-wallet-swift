{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, using the "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" protocol (ISO\/IEC TS"},{"type":"text","text":" "},{"type":"text","text":"18013-7 Annex C). iOS offers the apps that registered a matching"},{"type":"text","text":" "},{"type":"text","text":"document, and shows the chosen app’s document provider extension for"},{"type":"text","text":" "},{"type":"text","text":"the holder’s consent. The extension answers through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","isActive":true},{"type":"text","text":"; the"},{"type":"text","text":" "},{"type":"text","text":"response goes back through Safari, encrypted to the page, with no"},{"type":"text","text":" "},{"type":"text","text":"network request from the wallet."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Safari sends only "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":", not OpenID4VP, and on iOS only:"},{"type":"text","text":" "},{"type":"text","text":"Safari on macOS has no document providers."}]},{"text":"Set up the app and its extension","type":"heading","level":3,"anchor":"Set-up-the-app-and-its-extension"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The extension:"}]},{"type":"text","text":" a target whose Info.plist names the extension"},{"type":"text","text":" "},{"type":"text","text":"point "},{"type":"codeVoice","code":"com.apple.identity-document-services.document-provider-ui"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EXAppExtensionAttributes"},{"type":"text","text":", "},{"type":"codeVoice","code":"EXExtensionPointIdentifier"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The capability:"}]},{"type":"text","text":" Digital Credentials API – Mobile Document"},{"text":" ","type":"text"},{"type":"text","text":"Provider, on both the app’s and the extension’s App IDs, with the"},{"type":"text","text":" "},{"type":"text","text":"doctypes the app presents in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types"},{"text":" ","type":"text"},{"text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL","type":"text"},{"text":" ","type":"text"},{"text":"and Photo ID.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared storage:"}]},{"text":" the extension is another process, so the app","type":"text"},{"text":" ","type":"text"},{"text":"keeps its credentials in an App Group both list","type":"text"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true},{"type":"text","text":"), and its holder keys in"},{"type":"text","text":" "},{"type":"text","text":"a Keychain access group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true},{"text":"). Instance and DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keys stay in the app’s own group: the extension presents, but doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"receive. The app saves its configuration where the extension can","type":"text"},{"text":" ","type":"text"},{"text":"read it too.","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"text":"Register the documents","type":"heading","level":3,"anchor":"Register-the-documents"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS offers the app only for documents it registered. Whenever the"},{"type":"text","text":" "},{"type":"text","text":"credentials change, register each presentable mdoc and remove the rest."},{"type":"text","text":" "},{"type":"codeVoice","code":"supportedAuthorityKeyIdentifiers"},{"type":"text","text":" names the reader CAs, by subject key"},{"type":"text","text":" "},{"type":"text","text":"identifier, whose requests the document answers."}]},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"]},{"text":"Answer in the extension","type":"heading","level":3,"anchor":"Answer-in-the-extension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS hands the extension the request in two stages. First,"},{"type":"text","text":" "},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.request"},{"type":"text","text":" describes what’s asked,"},{"type":"text","text":" "},{"type":"text","text":"for the consent screen: show it with the website’s origin, and the"},{"type":"text","text":" "},{"type":"text","text":"candidates from "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","isActive":true},{"type":"text","text":". Only when the"},{"type":"text","text":" "},{"type":"text","text":"holder shares does iOS release the request itself, to"},{"type":"text","text":" "},{"type":"codeVoice","code":"sendResponse"},{"type":"text","text":"‘s closure. Validate it there, parse it, check it’s what"},{"type":"text","text":" "},{"type":"text","text":"the holder was shown, and answer."}]},{"syntax":"swift","type":"codeListing","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","    @State private var problem: String?","","    \/\/\/ The request's first document as iOS parsed it: what the consent","    \/\/\/ screen shows the holder.","    private var shown: (doctype: String, elements: [MdocPresentation.Element])? {","        guard let document = context.request.presentmentRequests.first?.documentRequestSets.first?.requests.first else {","            return nil","        }","        let elements = document.namespaces.flatMap { namespace, elements in","            elements.map { MdocPresentation.Element(namespace: namespace, identifier: $0.key, retain: $0.value.isRetaining) }","        }","        return (document.documentType, elements)","    }","","    var body: some View {","        VStack {","            if let problem { Text(problem) }","            Button(\"Share\") { Task { await share(credentialID: nil) } }","            Button(\"Cancel\") { context.cancel() }","        }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil), for exactly the document and elements the holder was shown.","    func share(credentialID: String?) async {","        guard let shown, let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        do {","            let wallet = try SharedWallet.open(provider: nil)","            try await context.sendResponse { raw in","                _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                    .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","                let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","                \/\/ Answer only what the holder was shown.","                guard let index = presentation.request.documents.firstIndex(where: { $0.doctype == shown.doctype }),","                      Set(presentation.request.documents[index].elements) == Set(shown.elements),","                      let chosen = credentialID ?? presentation.request.documents[index].credentials.first?.id else {","                    throw RequestChanged()","                }","                \/\/ The holder key signs now: Face ID, if the key store asks.","                let response = try await presentation.respond(document: index, credentialID: chosen, elements: shown.elements)","                return ISO18013MobileDocumentResponse(responseData: response.response)","            }","        } catch {","            \/\/ Nothing was shared: say so, and let the holder cancel.","            problem = \"Not shared: \\(error)\"","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The response answers the elements the holder was shown, not those the"},{"type":"text","text":" "},{"type":"text","text":"released request names, and a request that changed in between is"},{"type":"text","text":" "},{"type":"text","text":"refused. Where the consent screen names the reader (below), compare its"},{"type":"text","text":" "},{"type":"text","text":"certificate with "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/readerCertificate","isActive":true},{"type":"text","text":" there"},{"type":"text","text":" "},{"type":"text","text":"too. The demo wallet’s "},{"type":"codeVoice","code":"DocumentProvider"},{"type":"text","text":" target does all of this, with"},{"type":"text","text":" "},{"type":"text","text":"a choice of credential and a linkability warning."}]},{"text":"Name the reader","type":"heading","level":3,"anchor":"Name-the-reader"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC"},{"type":"text","text":" "},{"type":"text","text":"18013-5 reader authentication). When the certificate chains to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true},{"type":"text","text":" "},{"type":"text","text":"names it; otherwise show only the website’s origin."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true},{"type":"text","text":" accepts only certificates"},{"type":"text","text":" "},{"type":"text","text":"issued for readers, and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true},{"type":"text","text":" "},{"type":"text","text":"refuses requests from any other reader before the holder sees them."}]},{"text":"Warn of linkable presentations","type":"heading","level":3,"anchor":"Warn-of-linkable-presentations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each candidate’s "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"type":"text","text":" says whether"},{"type":"text","text":" "},{"type":"text","text":"presenting it would hand this website a copy another website has seen,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true},{"type":"text","text":" whether it did. The"},{"type":"text","text":" "},{"type":"text","text":"extension doesn’t refresh used-up copies: have the app do it when it"},{"type":"text","text":" "},{"type":"text","text":"next becomes active, after listing its credentials again."}]}],"kind":"content"}],"kind":"article","abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","title":"Presenting to Safari","role":"article"},"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"anchor":"Presenting-to-Safari","title":"Presenting to Safari","generated":true}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"abstract":[{"type":"text","text":"Whether the copy presented had been seen by another Verifier."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","title":"linkable","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/response\/linkable","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkable","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"abstract":[{"type":"text","text":"A store in the app group "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":"’s container"},{"type":"text","text":" "},{"type":"text","text":"(Library\/Application Support\/credentials there), which the app and"},{"type":"text","text":" "},{"type":"text","text":"its extensions listing the group in their"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement share."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","title":"inAppGroup(_:options:)","url":"\/documentation\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inAppGroup"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Options","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"FileCredentialStore","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/linkableHere":{"abstract":[{"text":"Whether presenting it to the Verifier asking would hand it a copy","type":"text"},{"text":" ","type":"text"},{"text":"another Verifier has seen. Set only on a presentation’s candidates.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","title":"linkableHere","url":"\/documentation\/oid4vcwallet\/credentialsummary\/linkablehere","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkableHere","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"title":"OID4VCWallet","role":"collection","kind":"symbol","url":"\/documentation\/oid4vcwallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/reader":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The subject common name of the reader that signed the request,"},{"type":"text","text":" "},{"type":"text","text":"when its certificate chains to"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletConfiguration.mdocReaderRoots"},{"type":"text","text":", without control or"},{"type":"text","text":" "},{"type":"text","text":"invisible format characters; “” when the holder can only be"},{"type":"text","text":" "},{"type":"text","text":"shown "},{"type":"codeVoice","code":"origin"},{"type":"text","text":"."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","title":"reader","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/reader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request (ISO\/IEC TS 18013-7 Annex C): show"},{"text":" ","type":"text"},{"type":"codeVoice","code":"request"},{"type":"text","text":" for the holder’s consent, then "},{"code":"respond","type":"codeVoice"},{"type":"text","text":" once; to decline,"},{"text":" ","type":"text"},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","title":"MdocPresentation","role":"symbol","navigatorTitle":[{"text":"MdocPresentation","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPresentation(requestData:origin:)":{"abstract":[{"type":"text","text":"Parses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request — an mdoc asked for over the"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, as iOS hands one to a document provider"},{"type":"text","text":" "},{"type":"text","text":"extension — and finds the held mdocs that can answer it."},{"type":"text","text":" "},{"type":"codeVoice","code":"requestData"},{"type":"text","text":" is "},{"type":"codeVoice","code":"IdentityDocumentWebPresentmentRawRequest.requestData"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" the requesting page’s origin"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.requestingWebsiteOrigin"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"MdocPresentation.origin(of:)","type":"codeVoice"},{"type":"text","text":" serializes it."}],"type":"topic","title":"startMdocPresentation(requestData:origin:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"startMdocPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"requestData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":", "},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC","text":"MdocPresentation"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/startmdocpresentation(requestdata:origin:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"role":"symbol","abstract":[{"type":"text","text":"Recognizes only reade