:" -> [","kind":"text"},{"text":"CredentialSummary","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The held mdocs, each with whether the page at "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" has been"},{"type":"text","text":" "},{"type":"text","text":"shown it and whether presenting it there now would be linkable"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"shownToVerifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"linkableHere"},{"type":"text","text":"): for a document provider’s"},{"type":"text","text":" "},{"type":"text","text":"consent screen, shown before iOS releases the request itself."},{"type":"text","text":" "},{"type":"codeVoice","code":"MdocPresentation.request"},{"type":"text","text":" says the same once it has."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","type":"topic","title":"mdocCandidates(origin:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(document:credentialID:elements:)":{"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(document:credentialid:elements:)","abstract":[{"text":"Presents the held mdoc ","type":"text"},{"code":"credentialID","type":"codeVoice"},{"text":" for document number","type":"text"},{"text":" ","type":"text"},{"code":"document","type":"codeVoice"},{"text":", disclosing exactly ","type":"text"},{"code":"elements","type":"codeVoice"},{"text":", each one it requested.","type":"text"},{"text":" ","type":"text"},{"text":"The holder key signs now, so a key store requiring user presence","type":"text"},{"text":" ","type":"text"},{"text":"prompts.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"document","kind":"extern