oice"},{"text":"). On a","type":"text"},{"text":" ","type":"text"},{"code":"WalletError","type":"codeVoice"},{"text":" — the prompt cancelled, say — nothing was sent and","type":"text"},{"text":" ","type":"text"},{"text":"the request stands: try again, or ","type":"text"},{"code":"decline","type":"codeVoice"},{"text":".","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Options","kind":"identifier"}],"role":"symbol","abstract":[{"text":"How the store makes and keeps keys.","type":"text"}],"title":"KeychainKeyStore.Options","kind":"symbol","navigatorTitle":[{"text":"Options","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/registrationKeyTagPrefix":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registrationKeyTagPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/registrationkeytagprefix","abstract":[{"type":"text","text":"The Keychain tag prefix of "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","isActive":true},{"type":"text","text":"‘s keys. The"},{"type":"text","text":" "},{"type":"text","text":"wallet’s own "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true},{"type":"text","text":" mustn’t cover it, as its default"},{"type":"text","text":" "},{"type":"text","text":"prefix doesn’t: "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","isActive":true},{"type":"text","text":" refuses a"},{"type":"text","text":" "},{"type":"text","text":"store whose prefix covers or falls under it, rather than delete"},{"type":"text","text":" "},{"type":"text","text":"the registration key."}],"title":"registrationKeyTagPrefix","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyTagPrefix","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","title":"KeychainKeyStore","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","title":"Swift.Sendable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","role":"collection","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"title":"OID4VCWallet","kind":"symbol","url":"\/documentation\/oid4vcwallet"},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/sweepOrphanedKeys(in:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sweepOrphanedKeys","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KeychainKeyStore","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16KeychainKeyStoreC"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/oid4vcwallet\/wallet\/sweeporphanedkeys(in:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Deletes every key in "},{"type":"codeVoice","code":"keyStore"},{"type":"text","text":" that none of the wallet’s"},{"type":"text","text":" "},{"type":"text","text":"credentials is bound to — left by an issuance the app quit or"},{"type":"text","text":" "},{"type":"text","text":"crashed in the middle of — and returns how many. Call it at launch,"},{"type":"text","text":" "},{"type":"text","text":"before any issuance or refresh: one in progress holds keys of its"},{"type":"text","text":" "},{"type":"text","text":"own."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","title":"sweepOrphanedKeys(in:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderUserPresence","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation, and"},{"type":"text","text":" "},{"type":"text","text":"again if the issuer refuses the nonce — and a refresh can’t"},{"type":"text","text":" "},{"type":"text","text":"run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LAContext.evaluatePolicy"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead. A presentation answering several documents"},{"type":"text","text":" "},{"type":"text","text":"at once ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","isActive":true},{"type":"text","text":") asks once: its holder"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}],"title":"holderUserPresence","kind":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence"}}}