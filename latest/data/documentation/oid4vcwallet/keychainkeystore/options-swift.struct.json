:{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/secureenclave","abstract":[{"type":"text","text":"Generate keys in the Secure Enclave. Off, keys are software"},{"type":"text","text":" "},{"type":"text","text":"keys — for development, and where there’s no enclave."}],"title":"secureEnclave","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"secureEnclave"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/secureEnclave","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct","abstract":[{"type":"text","text":"How the store makes and keeps keys."}],"navigatorTitle":[{"kind":"identifier","text":"Options"}],"title":"KeychainKeyStore.Options","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Options"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","abstract":[{"type":"text","text":"How many copies of each credential to request when an issuer"},{"type":"text","text":" "},{"type":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"type":"text","text":"it’s capped at the issuer’s batch size."}],"title":"batchSize","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/tagPrefix":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/tagprefix","abstract":[{"type":"text","text":"Prefixes every key’s Keychain application tag. Keys under"},{"type":"text","text":" "},{"type":"text","text":"another prefix are never touched, by a sweep or anything else."}],"title":"tagPrefix","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"tagPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/tagPrefix","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"navigatorTitle":[{"kind":"identifier","text":"KeychainKeyStore"}],"title":"KeychainKeyStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"title":"holderAccessGroup","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","type":"reference","isActive":true},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation — and a"},{"type":"text","text":" "},{"type":"text","text":"refresh can’t run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LAContext.evaluatePolicy"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead."}],"title":"holderUserPresence","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"holderUserPresence","kind":"identifier"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","type":"topic","role":"symbol"}}}