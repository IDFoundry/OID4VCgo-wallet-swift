ocuments","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"at once ("},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","isActive":true,"type":"reference"},{"text":") asks once: its holder","type":"text"},{"text":" ","type":"text"},{"text":"keys share one authentication context for that call only.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","kind":"symbol","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"title":"KeychainKeyStore","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","url":"\/documentation\/oid4vcwallet\/keychainkeystore","type":"topic","role":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"code":"Options.tagPrefix","type":"codeVoice"},{"text":"), and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/respond(answers:)":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"answers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"MdocPresentation","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC"},{"text":".","kind":"text"},{"text":"Answer","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Responded","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC9RespondedV"}],"abstract":[{"text":"Presents several of the request’s documents in one response, each","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"answers"},{"text":" as ","type":"text"},{"type":"codeVoice","code":"respond(document:credentialID:elements:)"},{"text":" presents","type":"text"},{"text":" ","type":"text"},{"text":"one, and sends it, which ends the session. A document left out","type":"text"},{"text":" ","type":"text"},{"text":"isn’t in the response: the reader may ask for more than the holder","type":"text"},{"text":" ","type":"text"},{"text":"shares. No document may be answered twice, nor one credential","type":"text"},{"text":" ","type":"t