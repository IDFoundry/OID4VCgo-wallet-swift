-swift.struct\/secureenclave","abstract":[{"type":"text","text":"Generate keys in the Secure Enclave. Off, keys are software"},{"type":"text","text":" "},{"type":"text","text":"keys — for development, and where there’s no enclave."}],"title":"secureEnclave","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"secureEnclave","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/secureEnclave","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore","abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"code":"Options.tagPrefix","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"title":"KeychainKeyStore","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"KeychainKeyStore","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}]}}}