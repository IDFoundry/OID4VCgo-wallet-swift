":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"The Keychain access group holder keys are made in, when the","type":"text"},{"text":" ","type":"text"},{"text":"app shares them with an extension — a document provider","type":"text"},{"text":" ","type":"text"},{"text":"presenting credentials, say — that lists the group in its","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","kind":"symbol","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","title":"Swift.Sendable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/secureEnclave":{"title":"secureEnclave","kind":"symbol","abstract":[{"type":"text","text":"Generate keys in the Secure Enclave. Off, keys are software"},{"text":" ","type":"text"},{"text":"keys — for development, and where there’s no enclave.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"secureEnclave"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/secureenclave","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/secureEnclave"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"abstract":[{"text":"How many copies of each credential to request when an issuer","type":"text"},{"text":" ","type":"text"},{"text":"offers batches, each bound to its own key, so each presentation","type":"text"},{"text":" ","type":"text"},{"text":"can use one no Verifier has seen. 0 means the SDK’s default (5);","type":"text"},{"text":" ","type":"text"},{"text":"it’s capped at the issuer’s batch size.","type":"text"}],"title":"batchSize","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/persistent":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"persistent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"type":"topic","title":"persistent","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/persistent","role":"symbol","abstract":[{"text":"Keep keys in the Keychain, across launches. Off, they live","type":"text"},{"text":" ","type":"text"},{"text":"only as long as this store (for tests: the Keychain needs a","type":"text"},{"text":" ","type":"text"},{"text":"signed host app on iOS).","type":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/persistent","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"title":"holderUserPresence","fragments":