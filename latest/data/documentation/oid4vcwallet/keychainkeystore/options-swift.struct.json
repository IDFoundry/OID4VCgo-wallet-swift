re\/Options-swift.struct\/tagPrefix","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tagPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"type":"topic","title":"tagPrefix","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/tagprefix","abstract":[{"type":"text","text":"Prefixes every key’s Keychain application tag. Keys under"},{"type":"text","text":" "},{"type":"text","text":"another prefix are never touched, by a sweep or anything else."}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/respond(answers:)":{"title":"respond(answers:)","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/respond(answers:)","abstract":[{"type":"text","text":"Presents several of the request’s documents in one response, each"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"answers","type":"codeVoice"},{"type":"text","text":" as "},{"code":"respond(document:credentialID:elements:)","type":"codeVoice"},{"type":"text","text":" presents"},{"type":"text","text":" "},{"type":"text","text":"one, and sends it, which ends the session. A document left out"},{"type":"text","text":" "},{"type":"text","text":"isn’t in the response: the reader may ask for more than the holder"},{"type":"text","text":" "},{"type":"text","text":"shares. No document may be answered twice, nor one credential"},{"type":"text","text":" "},{"type":"text","text":"answer two. Each holder key signs now, in the request’s order; a"},{"type":"text","text":" "},{"code":"KeychainKeyStore","type":"codeVoice"},{"type":"text","text":" requiring user presence asks the holder once for"},{"type":"text","text":" "},{"type":"text","text":"them all ("},{"code":"KeychainKeyStore.Options.holderUserPresence","type":"codeVoice"},{"type":"text","text":"). On a"},{"type":"text","text":" "},{"code":"WalletError","type":"codeVoice"},{"type":"text","text":" — the prompt cancelled, say — nothing was sent and"},{"type":"text","text":" "},{"type":"text","text":"the request stands: try again, or "},{"code":"decline","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"MdocPresentation","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Answer","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Responded","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC9RespondedV"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(answers:)":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","title":"respond(answers:)","abstract":[{"text":"Presents several of the request’s documents in one","type":"text"},{"text":" ","type":"text"},{"text":"EncryptedResponse, each of ","type":"text"},{"code":"answers","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"respond(document:credentialID:elements:)","type":"codeVoice"},{"text":" presents one. A document","type":"text"},{"text":" ","type":"text"},{"text":"left out isn’t in the response. No document may be answered twice,","type":"text"},{"text":" ","type":"text"},{"text":"nor one credential answer two. Each holder key signs now, in the","type":"text"},{"text":" ","type":"text"},{"text":"request’s order; a ","type":"text"},{"code":"KeychainKeyStore","type":"codeVoice"},{"text":" requiring user presence asks","type":"text"},{"text":" ","type":"text"},{"text":"the holder once for them all. On a ","type":"text"},{"code":"WalletError","type":"codeVoice"},{"text":" — the prompt","type":"text"},{"text":" ","type":"text"},{"text":"cancelled, say — nothing is returned, and the request can be","type":"text"},{"text":" ","type":"text"},{"text":"answered again.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(answers:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"answers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Answer","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","kind":"typeIdentifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","title":"batchSize","abstract":[{"type":"text","text":"How many copies of each credential to request when an issuer"},{"type":"text","text":" "},{"type":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"type":"text","text":"it’s capped at the issuer’s batch size."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","abstract":[{"text":"The Keychain access group holder keys are made in, when the","type":"text"},{"text":" ","type":"text"},{"text":"app shares them with an extension — a document provider","type":"text"},{"text":" ","type":"text"},{"text":"presenting credentials, say — that lists the group in its","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}],"title":"holderAccessGroup","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","title":"holderUserPresence","kind":"symbol","abstract":[{"text":"Require user presence (Face ID, Touch ID or the passcode) for","type":"text"},{"text":" ","type":"text"},{"text":"every signature with a holder key: to present a credential,","type":"text"},{"text":" ","type":"text"},{"text":"and to sign the Credential Request’s jwt proofs, so receiving","type":"text"},{"text":" ","type":"text"},{"text":"and refreshing credentials ask too — once per copy","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"text":"), or once per Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request when its jwt proof carries a key attestation, and","type":"text"},{"text":" ","type":"text"},{"text":"again if the issuer refuses the nonce — and a refresh can’t","type":"text"},{"text":" ","type":"text"},{"text":"run without the holder. The Secure Enclave","type":"text"},{"text":" ","type":"text"},{"text":"enforces it. Off, the app asks for it itself (with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LAContext.evaluatePolicy"},{"text":") before every presentation — in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead. A presentation answering several documents"},{"type":"text","text":" "},{"type":"text","text":"at once ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)"},{"type":"text","text":") asks once: its holder"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Options","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Options","kind":"identifier"}],"title":"KeychainKeyStore.Options","kind":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct","abstract":[{"type":"text","text":"How the store makes and keeps keys."}]}}}