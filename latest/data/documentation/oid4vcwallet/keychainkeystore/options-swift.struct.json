:"s:SS"},{"text":"?","kind":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","title":"holderAccessGroup","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"kind":"symbol","url":"\/documentation\/oid4vcwallet","title":"OID4VCWallet","role":"collection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}],"type":"topic"}}}