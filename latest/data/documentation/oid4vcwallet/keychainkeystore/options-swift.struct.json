n tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)","role":"symbol","abstract":[{"type":"text","text":"Options: by default, Secure Enclave keys kept in the Keychain, and"},{"type":"text","text":" "},{"type":"text","text":"holder keys asking for user presence."}],"title":"init(secureEnclave:persistent:holderUserPresence:tagPrefix:holderAccessGroup:)","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/init(secureenclave:persistent:holderuserpresence:tagprefix:holderaccessgroup:)","type":"topic","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"secureEnclave","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"persistent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"holderUserPresence","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"tagPrefix","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"holderAccessGroup","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?)","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","type":"unresolvable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/tagPrefix":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/tagPrefix","role":"symbol","abstract":[{"type":"text","text":"Prefixes every key’s Keychain application tag. Keys under"},{"type":"text","text":" "},{"type":"text","text":"another prefix are never touched, by a sweep or anything else."}],"title":"tagPrefix","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/tagprefix","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tagPrefix","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","role":"symbol","abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"title":"holderAccessGroup","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderAccessGroup","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","role":"symbol","abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation, and"},{"type":"text","text":" "},{"type":"text","text":"again if the issuer refuses the nonce — and a refresh can’t"},{"type":"text","text":" "},{"type":"text","text":"run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LAContext.evaluatePolicy"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead. A presentation answering several documents"},{"type":"text","text":" "},{"type":"text","text":"at once ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)"},{"type":"text","text":") asks once: its holder"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}],"title":"holderUserPresence","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderUserPresence","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/secureEnclave":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/secureEnclave","role":"symbol","abstract":[{"text":"Generate keys in the Secure Enclave. Off, keys are software","type":"text"},{"text":" ","type":"text"},{"text":"keys — for development, and where there’s no enclave.","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/secureenclave","type":"topic","title":"secureEnclave","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"secureEnclave","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","role":"symbol","abstract":[{"type":"text","text":"How many copies of each credential to request when an issuer"},{"type":"text","text":" "},{"type":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"type":"text","text":"it’s capped at the issuer’s batch size."}],"title":"batchSize","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(answers:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","role":"symbol","abstract":[{"text":"Presents several of the request’s documents in one","type":"text"},{"text":" ","type":"text"},{"text":"EncryptedResponse, each of ","type":"text"},{"type":"codeVoice","code":"answers"},{"text":" as","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"respond(document:credentialID:elements:)"},{"text":" presents one. A document","type":"text"},{"text":" ","type":"text"},{"text":"left out isn’t in the response. No document may be answered twice,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"nor one credential answer two. Each holder key signs now, in the"},{"text":" ","type":"text"},{"type":"text","text":"request’s order; a "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" requiring user presence asks"},{"type":"text","text":" "},{"type":"text","text":"the holder once for them all. On a "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" — the prompt"},{"type":"text","text":" "},{"type":"text","text":"cancelled, say — nothing is returned, and the request can be"},{"type":"text","text":" "},{"type":"text","text":"answered again."}],"title":"respond(answers:)","type":"topic","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(answers:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","text":"Answer"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","text":"Response"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","role":"collection","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"title":"OID4VCWallet","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/persistent":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/persistent","role":"symbol","abstract":[{"type":"text","text":"Keep keys in the Keychain, across launches. Off, they live"},{"type":"text","text":" "},{"type":"text","text":"only as long as this store (for tests: the Keychain needs a"},{"type":"text","text":" "},{"type":"text","text":"signed host app on iOS)."}],"title":"persistent","type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/persistent","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"persistent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/respond(answers:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)","role":"symbol","abstract":[{"type":"text","text":"Presents several of the request’s documents in one response, each"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"answers"},{"type":"text","text":" as "},{"type":"codeVoice","code":"respond(document:credentialID:elements:)"},{"type":"text","text":" presents"},{"type":"text","text":" "},{"type":"text","text":"one, and sends it, which ends the session. A document left out"},{"type":"text","text":" "},{"type":"text","text":"isn’t in the response: the reader may ask for more than the holder"},{"type":"text","text":" "},{"type":"text","text":"shares. No document may be answered twice, nor one credential"},{"type":"text","text":" "},{"type":"text","text":"answer two. Each holder key signs now, in the request’s order; a"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" requiring user presence asks the holder once for"},{"type":"text","text":" "},{"type":"text","text":"them all ("},{"type":"codeVoice","code":"KeychainKeyStore.Options.holderUserPresence"},{"type":"text","text":"). On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" — the prompt cancelled, say — nothing was sent and"},{"type":"text","text":" "},{"type":"text","text":"the request stands: try again, or "},{"type":"codeVoice","code":"decline"},{"type":"text","text":"."}],"title":"respond(answers:)","type":"topic","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/respond(answers:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"answers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC","text":"MdocPresentation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","text":"Answer"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC9RespondedV","text":"Responded"}]}}}