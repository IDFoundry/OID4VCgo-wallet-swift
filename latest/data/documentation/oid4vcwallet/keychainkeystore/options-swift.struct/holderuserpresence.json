{"sections":[],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct"]]},"metadata":{"title":"holderUserPresence","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"roleHeading":"Instance Property","symbolKind":"property","externalID":"s:12OID4VCWallet16KeychainKeyStoreC7OptionsV18holderUserPresenceSbvp","modules":[{"name":"OID4VCWallet"}],"role":"symbol"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence"]}],"abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation, and"},{"type":"text","text":" "},{"type":"text","text":"again if the issuer refuses the nonce — and a refresh can’t"},{"type":"text","text":" "},{"type":"text","text":"run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LAContext.evaluatePolicy"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead. A presentation answering several documents"},{"type":"text","text":" "},{"type":"text","text":"at once ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/respond(answers:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)"},{"type":"text","text":") asks once: its holder"},{"type":"text","text":" "},{"type":"text","text":"keys share one authentication context for that call only."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"],"kind":"mentions"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.O