" "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" requiring user presence asks the holder once for"},{"type":"text","text":" "},{"type":"text","text":"them all ("},{"type":"codeVoice","code":"KeychainKeyStore.Options.holderUserPresence"},{"type":"text","text":"). On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" — the prompt cancelled, say — nothing was sent and"},{"type":"text","text":" "},{"type":"text","text":"the request stands: try again, or "},{"type":"codeVoice","code":"decline"},{"type":"text","text":"."}],"title":"respond(answers:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"type":"topic","title":"Going to production","role":"article","kind":"article","abstract":[{"type":"text","text":"What a wallet needs before real holders use it."}],"url":"\/documentation\/oid4vcwallet\/goingtoproduction","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyStore"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"d