ype":"text","text":" "},{"type":"text","text":"verification, never replace it: pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},{"type":"text","text":"doesn’t break the app, and keep a backup pin. They cover the"},{"type":"text","text":" "},{"type":"text","text":"requests the SDK makes (issuers, Authorization Servers,"},{"type":"text","text":" "},{"type":"text","text":"Verifiers, status lists), not the app’s own, such as to its"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider: pin that client yourself."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/Network-swift.struct\/tlsPins"},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/Network-swift.struct/init(tlsPins:allowedPrivateHosts:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"tlsPins"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" : ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]], "},{"kind":"externalParam","text":"allowedPrivateHosts"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"])"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/Network-swift.struct\/init(tlsPins:allowedPrivateHosts:)","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/network-swift.struct\/init(tlspins:allowedprivatehosts:)","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Network options: every field has a default."}],"title":"init(tlsPins:allowedPrivateHosts:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWa