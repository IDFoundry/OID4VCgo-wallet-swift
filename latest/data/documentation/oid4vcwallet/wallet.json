t","text":"receiving credentials needs; presenting doesn’t). Creating it"},{"type":"text","text":" "},{"type":"text","text":"makes no network calls."}],"url":"\/documentation\/oid4vcwallet\/wallet\/init(configuration:keystore:credentialstore:provider:)","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","title":"refreshCredential(id:)","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","abstract":[{"text":"Replaces a ","type":"text"},{"type":"codeVoice","code":"refreshable"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new holder key, without the holder signing in","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VCI 1.0 §13.5). The new holder keys sign the Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request’s proof, so with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyStore.Options.holderUserPresence"},{"text":" ","type":"text"},{"text":"on it asks the holder. Use it when ","type":"text"},{"type":"codeVoice","code":"copiesLeft"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"kind":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","role":"article","url":"\/documentation\/oid4vcwallet\/gettingstarted","type":"topic","abstract":[{"text":"Add the package, give the wallet its keys, its storage and a Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Provider, and create it at launch.","type":"text"}],"title":"Getting started"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, and an mdoc’s"},{"type":"text","text":" "},{"type":"text","text":"identifier list, checks their signatures, and returns the"},{"type":"text","text":" "},{"type":"text","text":"credential with its revocation status recorded. Each list covers"},{"type":"text","text":" "},{"type":"text","text":"many credentials, so fetching it doesn’t tell the issuer which"},{"type":"text","text":" "},{"type":"text","text":"one is checked. A credential without a status or identifier list"},{"type":"text","text":" "},{"type":"text","text":"is returned as it is. Revocation is final: a credential found"},{"type":"text","text":" "},{"type":"text","text":"revoked stays so, its lists not fetched again, until the revoked"},{"type":"text","text":" "},{"type":"text","text":"copy expires or the credential is refreshed."}],"role":"symbol","title":"checkStatus(id:)","type":"topic","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkStatus"},{"