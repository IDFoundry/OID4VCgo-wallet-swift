":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/setCRLs(_:)":{"title":"setCRLs(_:)","abstract":[{"text":"Replaces the Certificate Revocation Lists the configuration’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"revocation"},{"text":" roles are checked against with ","type":"text"},{"type":"codeVoice","code":"pem"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"X509 CRL"},{"text":" ","type":"text"},{"text":"blocks, for every check from now on. CRLs expire at their","type":"text"},{"text":" ","type":"text"},{"text":"nextUpdate: fetch fresh ones and call this before then. Text","type":"text"},{"text":" ","type":"text"},{"text":"holding anything else, or a list that doesn’t parse, throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"invalidInput"},{"text":" and keeps the lists as they were; empty text removes","type":"text"},{"text":" ","type":"text"},{"text":"them all, and a role checked then fails closed. Makes no network","type":"text"},{"text":" ","type":"text"},{"text":"calls.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/wallet\/setcrls(_:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/setCRLs(_:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setCRLs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identif