Wallet\/startMdocPresentation(requestData:origin:)","title":"startMdocPresentation(requestData:origin:)","abstract":[{"type":"text","text":"Parses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request — an mdoc asked for over the"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, as iOS hands one to a document provider"},{"type":"text","text":" "},{"type":"text","text":"extension — and finds the held mdocs that can answer it."},{"type":"text","text":" "},{"type":"codeVoice","code":"requestData"},{"type":"text","text":" is "},{"type":"codeVoice","code":"IdentityDocumentWebPresentmentRawRequest.requestData"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" the requesting page’s origin"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.requestingWebsiteOrigin"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"MdocPresentation.origin(of:)"},{"type":"text","text":" serializes it."}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refreshCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","title":"refreshCredential(id:)","abstract":[{"text":"Replaces a ","type":"text"},{"type":"codeVoice","code":"refreshable"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new attested key, without the holder (OpenID4VCI","type":"text"},{"text":" ","type":"text"},{"text":"1.0 §13.5). Use it when ","type":"text"},{"type":"codeVoice","code":"copiesLeft"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkStatus"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","title":"checkStatus(id:)","abstract":[{"text":"Fetches the issuer’s status list for a credential, checks its","type":"text"},{"text":" ","type":"text"},{"text":"signature, and returns the credential with its revocation status","type":"text"},{"text":" ","type":"text"},{"text":"recorded. The list covers many credentials, so fetching it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t tell the issuer which one is checked. A credential without","type":"text"},{"text":" ","type":"text"},{"text":"a status list is returned as it is.","type":"text"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","url":"\/documentation\/oid4vcwallet\/walletprovider","type":"topic","kind":"symbol","title":"WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}],"navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/Refreshed":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshed","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Refreshed"}],"navigatorTitle":[{"kind":"identifier","text":"Refreshed"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/Refreshed","title":"Wallet.Refreshed","abstract":[{"type":"text","text":"What "},{"type":"codeVoice","code":"refreshCredential(id:)"},{"type":"text","text":" obtained."}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"type":"topic","kind":"article","title":"Handling errors","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","abstract":[{"text":"Tell the holder what went wrong, retry what may succeed, 