xt","text":"Replaces a "},{"type":"codeVoice","code":"refreshable"},{"type":"text","text":" credential’s copies with a fresh batch,"},{"type":"text","text":" "},{"type":"text","text":"each bound to a new holder key, without the holder signing in"},{"type":"text","text":" "},{"type":"text","text":"(OpenID4VCI 1.0 §13.5). The new holder keys sign the Credential"},{"type":"text","text":" "},{"type":"text","text":"Request’s proof, so with "},{"code":"KeychainKeyStore.Options.holderUserPresence","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"on it asks the holder. Use it when "},{"code":"copiesLeft","type":"codeVoice"},{"type":"text","text":" runs low. Throws"},{"type":"text","text":" "},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"type":"text","text":" when it can’t be refreshed:"},{"type":"text","text":" "},{"type":"text","text":"receive it again from a new offer."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"title":"checkStatus(id:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkStatus","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CredentialSummary","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"}],"type":"topic","abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, and an mdoc’s"},{"type":"text","text":" "},{"type":"text","text":"identifier list, checks their signatures, and returns the"},{"type":"text","text":" "},{"type":"text","text":"credential with its revocation status recorded. Each list covers"},{"type":"text","text":" "},{"type":"text","text":"many credentials, so fetching it doesn’t tell the issuer which"},{"text":" ","type":"text"},{"type":"text","text":"one is checked. A credential without a status or identifier list"},{"text":" ","type":"text"},{"type":"text","text":"is returned as it is. Revocation is final: a credential found"},{"type":"text","text":" "},{"type":"text","text":"revoked stays so, its lists not fetched again, until the revoked"},{"type":"text","text":" "},{"type":"text","text":"copy expires or the credential is refreshed."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"title":"Going to production","type":"topic","abstract":[{"type":"text","text":"What a wallet needs before real holders use it."}],"kind":"article","url":"\/documentation\/oid4vcwallet\/goingtoproduction","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/resumeIssuance(redirect:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resumeIssuance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"redirect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet8IssuanceC","text":"Issuance"}],"title":"resumeIssuance(redirect:)","abstract":[{"type":"text","text":"Completes an authorization begun before the app was suspended or"},{"type":"text","text":" "},{"type":"text","text":"relaunched: "},{"type":"codeVoice","code":"redirect"},{"type":"text","text":" is the issuer’s redirect back to the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI, delivered to the app ("},{"code":"onOpenURL","type":"codeVoice"},{"type":"text","text":"). Returns the"},{"type":"text","text":" "},{"type":"text","text":"issuance ready for "},{"code":"requestCredentials()","type":"codeVoice"},{"type":"text","text":". A redirect matching no"},{"type":"text","text":" "},{"type":"text","text":"authorization in progress — not this wallet’s, already completed,"},{"type":"text","text":" "},{"type":"text","text":"or expired — throws "},{"code":".notFound","type":"codeVoice"},{"type":"text","text":"."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"WalletConfiguration","kind":"identifier"}],"abstract":[{"type":"text","text":"NewWallet’s configuration."}],"kind":"symbol","type":"topic","title":"WalletConfiguration","navigatorTitle":[{"text":"WalletConfiguration","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration"}}}