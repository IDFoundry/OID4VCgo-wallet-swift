deVoice","code":"nextRefresh"},{"type":"text","text":" (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Throws "},{"type":"codeVoice","code":"invalidInput"},{"type":"text","text":" ("},{"type":"codeVoice","code":"not_configured"},{"type":"text","text":") with no distribution"},{"type":"text","text":" "},{"type":"text","text":"points configured, and "},{"type":"codeVoice","code":"cancelled"},{"type":"text","text":" when its task is cancelled."}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startProximityPresentation(timeouts:modes:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"startProximityPresentation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeouts","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet17ProximityTimeoutsV","text":"ProximityTimeouts","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"modes","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet16ProximityBLEModeO","text":"ProximityBLEMode","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC","text":"ProximityPresentation","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","title":"startProximityPresentation(timeouts:modes:)","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/startproximitypresentation(timeouts:modes:)","abstract":[{"type":"text","text":"Starts an ISO\/IEC 18013-5 in-person presentation ove