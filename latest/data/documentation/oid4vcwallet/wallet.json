ext":" "},{"type":"text","text":"mode) until a reader connects either way; a reader offered both"},{"type":"text","text":" "},{"type":"text","text":"should choose central client mode. Bluetooth failures end it as"},{"type":"text","text":" "},{"code":".failed","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"ProximityError","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/startproximitypresentation(timeouts:modes:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/Refreshed":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/Refreshed","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refreshed","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Refreshed","kind":"identifier"}],"title":"Wallet.Refreshed","abstract":[{"type":"text","text":"What "},{"type":"codeVoice","code":"refreshCredential(id:)"},{"type":"text","text":" obtained."}],"url":"\/documentation\/oid4vcwallet\/wallet\/refreshed","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/abandonDeferred(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"abandonDeferred"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"type":"topic","title":"abandonDeferred(id:)","abstract":[{"type":"text","text":"Gives up on a deferred credential — its access token has expired,"},{"type":"text","text":" "},{"type":"text","text":"say, or the holder no longer wants it — deleting it and its keys."}],"url":"\/documentation\/oid4vcwallet\/wallet\/abandondeferred(id:)","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","title":"OID4VCWallet","role":"collection","type":"topic","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"API, and in person over Bluetooth."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credentials()":{"title":"credentials()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary"},{"kind":"text","text":"]"}],"type":"topic","abstract":[{"type":"text","text":"Every credential the wallet holds."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/credentials()","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","title":"Swift.Sendable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/pollDeferred(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/polldeferred(id:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "