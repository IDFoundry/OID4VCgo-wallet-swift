{"abstract":[{"type":"text","text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,"},{"type":"text","text":" "},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentinginperson"]}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","role":"article","title":"Presenting in person"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"In person, the holder shows a QR code and the reader scans it: the","type":"text"},{"text":" ","type":"text"},{"text":"code carries the holder’s ephemeral key and how to reach it over","type":"text"},{"text":" ","type":"text"},{"text":"Bluetooth LE. The two devices then exchange encrypted messages over","type":"text"},{"text":" ","type":"text"},{"text":"GATT. The package carries the Bluetooth side itself: your app shows or","type":"text"},{"text":" ","type":"text"},{"text":"scans the QR code, follows the session’s states, and asks the holder.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Engagement is by QR code only. NFC engagement (a tap instead of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"code) is in OID4VCgo’s Kotlin library, not this package: an iOS holder"},{"type":"text","text":" "},{"type":"text","text":"can’t answer a reader’s tap, and an iOS reader can’t tap a holder. An"},{"type":"text","text":" "},{"type":"text","text":"Android reader or holder that offers both still works with this"},{"type":"text","text":" "},{"type":"text","text":"package over the QR code."}]},{"inlineContent":[{"text":"Both sides need ","type":"text"},{"code":"NSBluetoothAlwaysUsageDescription","type":"codeVoice"},{"text":" in the app’s","type":"text"},{"text":" ","type":"text"},{"text":"Info.plist. Keep the app in the foreground during a session: neither","type":"text"},{"text":" ","type":"text"},{"text":"side keeps one going while the app is suspended. A session answers one","type":"text"},{"text":" ","type":"text"},{"text":"request. Bluetooth failures are ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError","isActive":true,"type":"reference"},{"text":"s; protocol failures","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","isActive":true,"type":"reference"},{"text":"s.","type":"text"}],"type":"paragraph"},{"text":"Share as the holder","level":3,"type":"heading","anchor":"Share-as-the-holder"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","type":"reference"},{"type":"text","text":" returns a"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","type":"reference"},{"type":"text","text":" whose "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode","type":"reference"},{"type":"text","text":" you"},{"type":"text","text":" "},{"text":"show. It offers both ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityBLEMode","isActive":true,"type":"reference"},{"type":"text","text":"s by default: it advertises"},{"type":"text","text":" "},{"type":"text","text":"for the reader and scans for it at once, until a reader connects"},{"type":"text","text":" "},{"type":"text","text":"either way (a reader offered both should connect in central client"},{"type":"text","text":" "},{"type":"text","text":"mode). Pass "},{"type":"codeVoice","code":"modes"},{"type":"text","text":" to offer one. It then reports"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)","isActive":true,"type":"reference"},{"type":"text","text":" with who is asking"},{"type":"text","text":" "},{"type":"text","text":"and what: ask the holder, then respond or decline."}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ What the holder agreed to share: a requested document, the held","\/\/\/ mdoc to answer it with, and the elements to disclose.","struct InPersonAnswer {","    let document: Int","    let credentialID: String","    let elements: [MdocPresentation.Element]","}","","\/\/\/ Shares an mdoc in person. `showQRCode` displays the code; `consent`","\/\/\/ shows the reader's request and returns the holder's answer, or nil","\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"type":"codeListing"},{"inlineContent":[{"text":"Show ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader","type":"reference"},{"text":" on the consent screen. A","type":"text"},{"text":" ","type":"text"},{"text":"reader that signs its request (reader authentication) is named, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity\/Status-swift.enum\/trusted","type":"reference"},{"text":" when its certificate chains","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","type":"reference"},{"text":". An unsigned request could","type":"text"},{"text":" ","type":"text"},{"text":"come from anyone who scanned the code. As over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","type":"reference"},{"text":" ends a session","type":"text"},{"text":" ","type":"text"},{"text":"from any other reader before the holder sees it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/cancel()","type":"reference","isActive":true},{"type":"text","text":" ends a session at any point, as the"},{"type":"text","text":" "},{"type":"text","text":"holder leaves the screen, say. "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","type":"reference","isActive":true},{"type":"text","text":" sets how long it"},{"type":"text","text":" "},{"type":"text","text":"waits: by default 60 seconds for a reader to connect, 30 for its"},{"type":"text","text":" "},{"type":"text","text":"request, and 300 for the holder to decide."}],"type":"paragraph"},{"anchor":"Read-as-the-verifier","text":"Read as the verifier","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","isActive":true,"type":"reference"},{"type":"text","text":" needs no "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true,"type":"reference"},{"type":"text","text":": give it the IACAs whose"},{"type":"text","text":" "},{"type":"text","text":"mdocs it accepts, and, to sign its requests so holders see who is"},{"type":"text","text":" "},{"type":"text","text":"asking, a key in a "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true,"type":"reference"},{"type":"text","text":" and its certificate chain, with the"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration","isActive":true,"type":"reference"},{"type":"text","text":"). "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader\/start(qrCode:docType:elements:timeouts:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"takes the holder’s QR code and what to ask for."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/\/ Reads an mDL's name and portrait from the holder whose QR code was","\/\/\/ scanned. Returns the verified mdoc, or nil if the holder declined or","\/\/\/ the mdoc isn't known to be unrevoked.","func readInPerson(qrCode: String, issuerRoots: String) async throws -> VerifiedMdoc? {","    let reader = try ProximityReader(configuration: ProximityReaderConfiguration(issuerRoots: issuerRoots))","    let session = try reader.start(qrCode: qrCode, docType: \"org.iso.18013.5.1.mDL\",","                                   elements: [\"org.iso.18013.5.1\": [\"given_name\", \"family_name\", \"portrait\"]])","    for await state in session.states {","        switch state {","        case .verified(let mdoc):","            let status = try await session.checkStatus()","            return status == .valid || status == .noStatus ? mdoc : nil","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc","type":"reference","isActive":true},{"text":" carries the disclosed elements, the document signer","type":"text"},{"text":" ","type":"text"},{"text":"and the IACA it chains to, and its validity. Decide which issuers to","type":"text"},{"text":" ","type":"text"},{"text":"accept on ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuerChain","isActive":true},{"text":", the verified certificate path:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuer","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/trustAnchor","isActive":true},{"text":" are names any","type":"text"},{"text":" ","type":"text"},{"text":"document signer under a trusted IACA can choose, for display.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The session doesn’t check revocation itself:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderSession\/checkStatus()","isActive":true,"type":"reference"},{"text":" does, once the session is","type":"text"},{"text":" ","type":"text"},{"code":".verified","type":"codeVoice"},{"text":". It fetches the issuer’s status list over the network, so","type":"text"},{"text":" ","type":"text"},{"text":"the reader needs a connection then, and verifies the list is signed","type":"text"},{"text":" ","type":"text"},{"text":"under the certificate the document names or the CA that signed the","type":"text"},{"text":" ","type":"text"},{"text":"document signer (ISO\/IEC 18013-5 §12.3.6). Rely on the document only","type":"text"},{"text":" ","type":"text"},{"text":"when it’s ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/valid","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/noStatus","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"anchor":"Presenting-in-person","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"],"title":"Presenting in person","generated":true}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"abstract":[{"type":"text","text":"PEM certificates: the mdoc readers recognized when one signs an"},{"type":"text","text":" "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request ("},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"every such request is shown by its origin."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","title":"mdocReaderRoots","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError":{"title":"WalletError","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletError","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walleterror","role":"symbol","navigatorTitle":[{"text":"WalletError","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","type":"topic","abstract":[{"type":"text","text":"An error from OID4VCgo: a stable "},{"type":"codeVoice","code":"code"},{"type":"text","text":", the issuer’s, Authorization"},{"type":"text","text":" "},{"type":"text","text":"Server’s or Verifier’s own error code when it gave one"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"protocolError"},{"type":"text","text":"), and a message for logs: it never carries personal"},{"type":"text","text":" "},{"type":"text","text":"data, a remote party’s own description, a URL’s path or query, or"},{"type":"text","text":" "},{"type":"text","text":"control characters. "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"a sentence fit to show the holder; "},{"type":"codeVoice","code":"isRetryable"},{"type":"text","text":" says whether trying"},{"type":"text","text":" "},{"type":"text","text":"the same step again may succeed."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/VerifiedMdoc/issuer":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuer","title":"issuer","abstract":[{"type":"text","text":"The document signer certificate’s subject common name, for display:"},{"type":"text","text":" "},{"type":"text","text":"any document signer under a trusted IACA can choose it, so decide"},{"type":"text","text":" "},{"type":"text","text":"on "},{"type":"codeVoice","code":"issuerChain"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/verifiedmdoc\/issuer","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"issuer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderSession/checkStatus()":{"url":"\/documentation\/oid4vcwallet\/proximityreadersession\/checkstatus()","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderSession\/checkStatus()","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Checks the revocation status of the mdoc the session verified:"},{"type":"text","text":" "},{"type":"text","text":"fetches the Token Status List its MSO names, over https from a"},{"type":"text","text":" "},{"type":"text","text":"public address, and verifies it’s signed under the certificate the"},{"type":"text","text":" "},{"type":"text","text":"MSO names or else under the CA that signed the document signer"},{"type":"text","text":" "},{"type":"text","text":"(ISO\/IEC 18013-5 §12.3.6). Rely on the document only when this is"},{"type":"text","text":" "},{"type":"codeVoice","code":".valid"},{"type":"text","text":" or "},{"type":"codeVoice","code":".noStatus"},{"type":"text","text":". Call it once the session is "},{"type":"codeVoice","code":".verified"},{"type":"text","text":", after"},{"type":"text","text":" "},{"type":"text","text":"the Bluetooth connection has closed; before, it throws "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" "},{"type":"codeVoice","code":".wrongStep"},{"type":"text","text":". A failed fetch is "},{"type":"codeVoice","code":".network"},{"type":"text","text":", a list that doesn’t"},{"type":"text","text":" "},{"text":"verify ","type":"text"},{"code":".protocol","type":"codeVoice"},{"text":"; cancelling the calling Task cancels it. The list","type":"text"},{"text":" ","type":"text"},{"text":"covers many documents, so fetching it doesn’t tell its publisher","type":"text"},{"text":" ","type":"text"},{"text":"which one was presented.","type":"text"}],"title":"checkStatus()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkStatus","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet10MdocStatusO","text":"MdocStatus","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","type":"topic","role":"collection","kind":"symbol","title":"OID4VCWallet","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore":{"url":"\/documentation\/oid4vcwallet\/keystore","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The wallet’s keys: P-256 keys whose private halves never leave the"},{"type":"text","text":" "},{"type":"text","text":"store (the Secure Enclave). "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" is the standard one."},{"type":"text","text":" "},{"type":"text","text":"A thrown error reaches Go and comes back as a "},{"type":"codeVoice","code":".platform"},{"type":"text","text":" WalletError."}],"title":"KeyStore","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyStore","kind":"identifier"}],"navigatorTitle":[{"text":"KeyStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/VerifiedMdoc":{"url":"\/documentation\/oid4vcwallet\/verifiedmdoc","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A verified mdoc, as a "},{"type":"codeVoice","code":"ProximityReaderSession"},{"type":"text","text":" received it."}],"title":"VerifiedMdoc","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VerifiedMdoc","kind":"identifier"}],"navigatorTitle":[{"text":"VerifiedMdoc","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderIdentity":{"type":"topic","kind":"symbol","title":"ProximityReaderIdentity","url":"\/documentation\/oid4vcwallet\/proximityreaderidentity","abstract":[{"text":"Who sent a request, as the holder sees it.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"ProximityReaderIdentity","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityReaderIdentity","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"abstract":[{"text":"Refuses an ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" request no recognized reader signed:","type":"text"},{"text":" ","type":"text"},{"code":"startMdocPresentation","type":"codeVoice"},{"text":" throws ","type":"text"},{"code":"untrustedVerifier","type":"codeVoice"},{"text":", and nothing is","type":"text"},{"text":" ","type":"text"},{"text":"shown to the holder. Needs ","type":"text"},{"code":"mdocReaderRoots","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","title":"requireTrustedMdocReader","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requireTrustedMdocReader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocStatus/noStatus":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noStatus","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/mdocstatus\/nostatus","title":"MdocStatus.noStatus","abstract":[{"text":"The MSO names no revocation list.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/noStatus","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityBLEMode":{"type":"topic","kind":"symbol","title":"ProximityBLEMode","url":"\/documentation\/oid4vcwallet\/proximityblemode","abst