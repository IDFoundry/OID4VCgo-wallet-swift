document only"},{"type":"text","text":" "},{"type":"text","text":"when it’s "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/valid","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/noStatus","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","role":"article","title":"Presenting in person"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentinginperson"]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocStatus/noStatus":{"url":"\/documentation\/oid4vcwallet\/mdocstatus\/nostatus","abstract":[{"text":"The MSO names no revocation list.","type":"text"}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noStatus","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/noStatus","role":"symbol","type":"topic","title":"MdocStatus.noStatus"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityError":{"navigatorTitle":[{"text":"ProximityError","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityError","kind":"identifier"}],"abstract":[{"text":"An in-person session failed over Bluetooth, rather than in the","type":"text"},{"text":" ","type":"text"},{"te