{"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,"},{"type":"text","text":" "},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"seeAlsoSections":[{"anchor":"Presenting-in-person","generated":true,"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"],"title":"Presenting in person"}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"role":"article","roleHeading":"Article","title":"Presenting in person"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentinginperson"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"In person, the holder shows a QR code and the reader scans it: the","type":"text"},{"text":" ","type":"text"},{"text":"code carries the holder’s ephemeral key and how to reach it over","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Bluetooth LE. The two devices then exchange encrypted messages over"},{"type":"text","text":" "},{"type":"text","text":"GATT. The package carries the Bluetooth side itself: your app shows or"},{"type":"text","text":" "},{"type":"text","text":"scans the QR code, follows the session’s states, and asks the holder."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Engagement is by QR code only. NFC engagement (a tap instead of the"},{"type":"text","text":" "},{"type":"text","text":"code) is in OID4VCgo’s Kotlin library, not this package: an iOS holder"},{"type":"text","text":" "},{"text":"can’t answer a reader’s tap, and an iOS reader can’t tap a holder. An","type":"text"},{"text":" ","type":"text"},{"text":"Android reader or holder that offers both still works with this","type":"text"},{"text":" ","type":"text"},{"text":"package over the QR code.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both sides need "},{"type":"codeVoice","code":"NSBluetoothAlwaysUsageDescription"},{"type":"text","text":" in the app’s"},{"type":"text","text":" "},{"type":"text","text":"Info.plist. Keep the app in the foreground during a session: neither"},{"type":"text","text":" "},{"type":"text","text":"side keeps one going while the app is suspended. A session answers one"},{"type":"text","text":" "},{"type":"text","text":"request. Bluetooth failures are "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"},{"type":"text","text":"s; protocol failures"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError"},{"text":"s.","type":"text"}]},{"text":"Share as the holder","type":"heading","anchor":"Share-as-the-holder","level":3},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)"},{"type":"text","text":" returns a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation"},{"type":"text","text":" whose "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode"},{"type":"text","text":" you"},{"type":"text","text":" "},{"type":"text","text":"show. It offers both "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityBLEMode"},{"type":"text","text":"s by default: it advertises"},{"type":"text","text":" "},{"type":"text","text":"for the reader and scans for it at once, until a reader connects"},{"type":"text","text":" "},{"type":"text","text":"either way (a reader offered both should connect in central client"},{"text":" ","type":"text"},{"text":"mode). Pass ","type":"text"},{"type":"codeVoice","code":"modes"},{"text":" to offer one. It then reports","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)"},{"text":" with who is asking","type":"text"},{"text":" ","type":"text"},{"text":"and what: ask the holder, then respond or decline.","type":"text"}]},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ What the holder agreed to share: a requested document, the held","\/\/\/ mdoc to answer it with, and the elements to disclose.","struct InPersonAnswer {","    let document: Int","    let credentialID: String","    let elements: [MdocPresentation.Element]","}","","\/\/\/ Shares an mdoc in person. `showQRCode` displays the code; `consent`","\/\/\/ shows the reader's request and returns the holder's answer, or nil","\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"type":"codeListing"},{"inlineContent":[{"text":"Show ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader"},{"text":" on the consent screen. A","type":"text"},{"text":" ","type":"text"},{"text":"reader that signs its request (reader authentication) is named, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity\/Status-swift.enum\/trusted"},{"text":" when its certificate chains","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots"},{"text":". An unsigned request could","type":"text"},{"text":" ","type":"text"},{"text":"come from anyone who scanned the code. As over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader"},{"text":" ends a session","type":"text"},{"text":" ","type":"text"},{"text":"from any other reader before the holder sees it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/cancel()","isActive":true,"type":"reference"},{"text":" ends a session at any point, as the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"holder leaves the screen, say. "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","type":"reference","isActive":true},{"type":"text","text":" sets how long it"},{"type":"text","text":" "},{"type":"text","text":"waits: by default 60 seconds for a reader to connect, 30 for its"},{"type":"text","text":" "},{"type":"text","text":"request, and 300 for the holder to decide."}],"type":"paragraph"},{"anchor":"Read-as-the-verifier","type":"heading","level":3,"text":"Read as the verifier"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","isActive":true,"type":"reference"},{"text":" needs no ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true,"type":"reference"},{"text":": give it the IACAs whose","type":"text"},{"text":" ","type":"text"},{"text":"mdocs it accepts, and, to sign its requests so holders see who is","type":"text"},{"text":" ","type":"text"},{"text":"asking, a key in a ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true,"type":"reference"},{"text":" and its certificate chain, with the","type":"text"},{"text":" ","type":"text"},{"text":"reader authentication extended key usage","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration","isActive":true,"type":"reference"},{"text":"). ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader\/start(qrCode:docType:elements:timeouts:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"takes the holder’s QR code and what to ask for.","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ Reads an mDL's name and portrait from the holder whose QR code was","\/\/\/ scanned. Returns the verified mdoc, or nil if the holder declined or","\/\/\/ the mdoc isn't known to be unrevoked.","func readInPerson(qrCode: String, issuerRoots: String) async throws -> VerifiedMdoc? {","    let reader = try ProximityReader(configuration: ProximityReaderConfiguration(issuerRoots: issuerRoots))","    let session = try reader.start(qrCode: qrCode, docType: \"org.iso.18013.5.1.mDL\",","                                   elements: [\"org.iso.18013.5.1\": [\"given_name\", \"family_name\", \"portrait\"]])","    for await state in session.states {","        switch state {","        case .verified(let mdoc):","            let status = try await session.checkStatus()","            return status == .valid || status == .noStatus ? mdoc : nil","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc","isActive":true},{"type":"text","text":" carries the disclosed elements, the document signer"},{"type":"text","text":" "},{"type":"text","text":"and the IACA it chains to, and its validity. Decide which issuers to"},{"type":"text","text":" "},{"type":"text","text":"accept on "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuerChain","type":"reference","isAct