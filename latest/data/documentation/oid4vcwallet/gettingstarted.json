,{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","title":"holderAccessGroup"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CredentialStore","kind":"identifier"}],"abstract":[{"text":"The wallet’s credentials, as opaque records kept by ID under the","type":"text"},{"text":" ","type":"text"},{"text":"platform’s data protection. ","type":"text"},{"type":"codeVoice","code":"FileCredentialStore"},{"text":" is the standard one.","type":"text"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","navigatorTitle":[{"text":"CredentialStore","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialstore","title":"CredentialStore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyStore","kind":"identifier"}],"abstract":[{"text":"The wallet’s keys: P-256 keys whose private halves never leave the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"store (the Secure Enclave). "},{"type":"