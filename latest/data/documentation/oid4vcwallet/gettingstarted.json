},{"type":"text","text":" "},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"type":"codeVoice","code":"Options.tagPrefix"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"can, with nothing asked of it at creation."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"abstract":[{"type":"text","text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,"},{"type":"text","text":" "},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"role":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","type":"topic","kind":"article","url":"\/documentation\/oid4vcwallet\/presentinginperson","title":"Presenting in person"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/network":{"kind":"symbol","title":"network","type":"topic","abstract":[{"text":"A request couldn’t be made, got no answer, or timed out. Retryable.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"network"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError"