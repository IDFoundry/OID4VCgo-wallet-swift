":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"platform"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code"}],"title":"platform","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/platform","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"kind":"symbol","title":"OID4VCWallet","type":"topic","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}],"url":"\/documentation\/oid4vcwallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","role":"collection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/OID4VC/isTestBuild":{"url":"\/documentation\/oid4vcwallet\/oid4vc\/istestbuild","abstract":[{"type":"text","text":"Whether the linked framework is the test build, carrying an"},{"type":"text","text":" "},{"type":"text","text":"in-process test issuer and Verifier ("},{"code":"-tags mobiletest","type":"codeVoice"},{"type":"text","text":"): an app"},{"type":"text","text":" "},{"type":"text","text":"should refuse to run on it."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isTestBuild","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isTestBuild","kind":"symbol","type":"topic","identifi