in access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderAccessGroup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"title":"Presenting in person","url":"\/documentation\/oid4vcwallet\/presentinginperson","abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,","type":"text"},{"text":" ","type":"text"},{"text":"with ISO\/IEC 18013-5 device retrieval.","type":"text"}],"type":"topic","role":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","kind":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore":{"type":"topic","role":"symbol","kind":"symbol","title":"CredentialStore","navigatorTitle":[{"kind":"identifier","text":"CredentialStore"}],"url":"\/documentation\/oid4vcwallet\/credentialstore","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","abstract":[{"type":"text","text":"The wallet’s credentials, as opaque records kept by ID under the"},{"type":"text","text":" "},{"type":"text","text":"platform’s data protection. "},{"type":"codeVoice","code":"FileCredentialStore"},{"type":"text","text":" i