ALink","abstract":[{"type":"text","text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,"},{"type":"text","text":" "},{"type":"text","text":"let the holder choose, and present exactly that."}],"kind":"article","url":"\/documentation\/oid4vcwallet\/presentingfromalink"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"url":"\/documentation\/oid4vcwallet\/presentinginperson","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","title":"Presenting in person","abstract":[{"type":"text","text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,"},{"type":"text","text":" "},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"type":"topic","role":"article","kind":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"role":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","url":"\/documentation\/oid4vcwallet\/keychainkeystore","title":"KeychainKeyStore","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"code":"Options.tagPrefix","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingToSafari":{"role":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","url":"\/documentation\/oid4vcwallet\/presentingtosafari","title":"Presenting to Safari","kind":"article","type":"topic","abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"type":"text","text":" "},{"text":"API, as an iOS document provider.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KeyStore"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","url":"\/documentation\/oid4vcwallet\/keystore","title":"KeyStore","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyStore"}],"abstract":[{"type":"text","text":"The wallet’s keys: P-256 keys whose private halves never leave the"},{"type":"text","text":" "},{"type":"text","text":"store (the Secure Enclave). "},{"code":"KeychainKeyStore","type":"codeVoice"},{"type":"text","text":" is the standard one."},{"type":"text","text":" "},{"type":"text","text":"A thrown error reaches Go and comes back as a "},{"code":".platform","type":"codeVoice"},{"type":"text","text":" WalletError."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ReceivingCredentials":{"role":"article","title":"Receiving credentials","url":"\/documentation\/oid4vcwallet\/receivingcredentials","abstract":[{"text":"Receive the credentials a Credential Offer offers, with either grant,","type":"text"},{"text":" ","type":"text"},{"text":"and look after them once they’re held.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"},"doc://oid