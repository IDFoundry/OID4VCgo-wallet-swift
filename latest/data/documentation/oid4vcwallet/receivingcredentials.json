{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"sections":[],"abstract":[{"text":"Receive the credentials a Credential Offer offers, with either grant,","type":"text"},{"text":" ","type":"text"},{"text":"and look after them once they’re held.","type":"text"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"code":"openid-credential-offer:\/\/","type":"codeVoice"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"code":"openid-credential-offer","type":"codeVoice"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance"},{"text":" whose ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer"},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The offer names one of two grants:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Authorization code:"}],"type":"strong"},{"text":" the holder signs in at the issuer’s pages, in","type":"text"},{"text":" ","type":"text"},{"text":"a browser, which redirects back to the wallet’s redirect URI.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Pre-authorized code:","type":"text"}]},{"type":"text","text":" the issuer has already authenticated the"},{"type":"text","text":" "},{"text":"holder, and may ask for a PIN it sent them separately","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Either way, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","type":"reference","isActive":true},{"type":"text","text":" then requests, checks and"},{"type":"text","text":" "},{"type":"text","text":"stores the credentials, and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","type":"reference","isActive":true},{"type":"text","text":" ends the issuance."}],"type":"paragraph"},{"type":"heading","anchor":"Receive-an-offer","level":3,"text":"Receive an offer"},{"type":"codeListing","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `confirm` shows the","\/\/\/ holder who is offering what, and returns whether they want it;","\/\/\/ `askPIN` asks for the PIN the issuer sent, or returns nil if they","\/\/\/ cancel; `signIn` opens the issuer's page and returns the redirect","\/\/\/ back.","func receive(offerLink: String, wallet: Wallet,","             confirm: (Offer) async -> Bool,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    do {","        guard await confirm(issuance.offer) else {","            try await issuance.close()","            return nil","        }","        switch issuance.offer.grant {","        case .preAuthorizedCode:","            while true {","                guard let pin = await askPIN(issuance.offer.txCode) else {","                    try await issuance.close()","                    return nil","                }","                do {","                    try await issuance.redeemPreAuthorizedCode(pin: pin)","                    break","                } catch let error as WalletError where error.isRetryable {","                    continue \/\/ A wrong PIN (invalid_grant): ask again.","                }","            }","        case .authorizationCode:","            let url = try await issuance.beginAuthorization()","            let redirect = try await signIn(url)","            try await issuance.completeAuthorization(redirect: redirect)","        }","        let result = try await issuance.requestCredentials()","        try await issuance.close()","        return result","    } catch {","        \/\/ End the issuance whatever failed, deleting its keys.","        try? await issuance.close()","        throw error","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Show the offer before anything is redeemed: the issuer’s name and the"},{"type":"text","text":" "},{"type":"text","text":"credentials it offers, so the holder can turn down an offer they didn’t"},{"type":"text","text":" "},{"type":"text","text":"expect. Close the issuance on every path, as here: its keys are"},{"type":"text","text":" "},{"type":"text","text":"deleted then, but for those a deferred credential still needs."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","type":"reference"},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Open-the-issuers-page","text":"Open the issuer’s page"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open the authorization URL in an "},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"type":"text","text":", with the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI’s scheme as its callback scheme. An ephemeral session"},{"type":"text","text":" "},{"type":"text","text":"keeps the issuer’s cookies out of Safari’s."}]},{"code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()"},{"text":" can begin again. A redirect is used","type":"text"},{"text":" ","type":"text"},{"text":"up by ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)"},{"text":" whatever happens,","type":"text"},{"text":" ","type":"text"},{"text":"so after a failure there, begin again rather than retrying it.","type":"text"}],"type":"paragraph"},{"text":"Resume after the app is killed","type":"heading","anchor":"Resume-after-the-app-is-killed","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS can terminate the app while the holder is at the issuer’s pages."},{"type":"text","text":" "},{"type":"text","text":"The authorization in progress is kept in the credential store, so when"},{"type":"text","text":" "},{"type":"text","text":"the redirect arrives at a relaunched app, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"completes it and returns an issuance ready for","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"type":"text","text":". Handle every redirect this way: in"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI, from "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":". Outside development, resuming needs a"},{"text":" ","type":"text"},{"code":"redirectURI","type":"codeVoice"},{"text":" with the app’s own URI scheme, such as","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/callback","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses an https Universal","type":"text"},{"text":" ","type":"text"},{"text":"Link there. In development too, the scheme must be a domain name in","type":"text"},{"text":" ","type":"text"},{"text":"reverse order followed by a single slash, ","type":"text"},{"code":"reverse.domain:\/path","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(RFC 8252 §7.1): ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses ","type":"text"},{"code":"myapp:\/callback","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/\/callback","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"com.example.wallet:callback","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"invalidInput","type":"codeVoice"},{"type":"text","text":", and any redirect URI with a fragment or credentials."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A redirect that matches no authorization in progress throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"Wait-for-a-deferred-credential","text":"Wait for a deferred credential"},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in the credential store until it’s issued, denied or abandoned, so it"},{"type":"text","text":" "},{"type":"text","text":"survives the app quitting. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","isActive":true},{"type":"text","text":" lists them"},{"type":"text","text":" "},{"type":"text","text":"without network requests; poll each at the interval the issuer asks for."}]},{"type":"codeListing","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","type":"reference"},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"level":3,"text":"Look after held credentials","type":"heading","anchor":"Look-after-held-credentials"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","isActive":true},{"type":"text","text":" lists them, and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns one with its claims, for display. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","isActive":true},{"type":"text","text":" "},{"type":"text","text":"carries the issuer’s names, logos and colours, in the holder’s"},{"type":"text","text":" "},{"type":"text","text":"language ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","isActive":true},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","isActive":true},{"type":"text","text":" checks revocation against the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"status list, which covers many credentials, so the issuer can’t tell"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Each credential arrives as a batch of copies, each bound to its own"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":"), so presentations can’t be"},{"type":"text","text":" "},{"type":"text","text":"linked by the credential. When "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft"},{"type":"text","text":" "},{"type":"text","text":"reaches zero, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)"},{"type":"text","text":" replaces them, if the"},{"type":"text","text":" "},{"type":"text","text":"issuance kept a refresh token ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Otherwise it throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired"},{"type":"text","text":": receive the"},{"type":"text","text":" "},{"type":"text","text":"credential again. A refresh needs no sign-in, but the new copies’"},{"type":"text","text":" "},{"type":"text","text":"holder keys sign the Credential Request’s proof, so with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence"},{"type":"text","text":" on it"},{"type":"text","text":" "},{"type":"text","text":"asks the holder too."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","isActive":true},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}],"type":"paragraph"}]}]}],"kind":"content"}],"metadata":{"title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","role":"article"},"seeAlsoSections":[{"generated":true,"title":"Receiving credentials","anchor":"Receiving-credentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/resumeIssuance(redirect:)":{"title":"resumeIssuance(redirect:)","abstract":[{"type":"text","text":"Completes an authorization begun before the app was suspended or"},{"type":"text","text":" "},{"type":"text","text":"relaunched: "},{"type":"codeVoice","code":"redirect"},{"type":"text","text":" is the issuer’s redirect back to the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI, delivered to the app ("},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":"). Returns the"},{"type":"text","text":" "},{"type":"text","text":"issuance ready for "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":". A redirect matching no"},{"type":"text","text":" "},{"type":"text","text":"authorization in progress — not this wallet’s, already completed,"},{"type":"text","text":" "},{"type":"text","text":"or expired — throws "},{"type":"codeVoice","code":".notFound"},{"type":"text","text":"."}],"url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resumeIssuance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet8IssuanceC","kind":"typeIdentifier","text":"Issuance"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Offer","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","role":"symbol","navigatorTitle":[{"text":"Offer","kind":"identifier"}],"abstract":[{"type":"text","text":"What a Credential Offer offers."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/offer","title":"Offer"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/copiesLeft":{"abstract":[{"type":"text","text":"How many copies no Verifier has seen."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","url":"\/documentation\/oid4vcwallet\/credentialsummary\/copiesleft","title":"copiesLeft","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"copiesLeft","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/close()":{"abstract":[{"text":"Ends the issuance, deleting its keys but those its deferred","type":"text"},{"text":" ","type":"text"},{"text":"credentials still poll with.","type":"text"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","url":"\/documentation\/oid4vcwallet\/issuance\/close()","title":"close()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"abstract":[{"text":"How many copies of each credential to request when an issuer","type":"text"},{"text":" ","type":"text"},{"text":"offers batches, each bound to its own key, so each presentation","type":"text"},{"text":" ","type":"text"},{"text":"can use one no Verifier has seen. 0 means the SDK’s default (5);","type":"text"},{"text":" ","type":"text"},{"text":"it’s capped at the issuer’s batch size.","type":"text"}],"type":"topic","title":"batchSize","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"batchSize","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential/accessTokenExpiresAt":{"abstract":[{"text":"When the access token it’s polled with expires, if the issuer","type":"text"},{"text":" ","type":"text"},{"text":"said: after it, polls fail and it can only be abandoned.","type":"text"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/deferredcredential\/accesstokenexpiresat","title":"accessTokenExpiresAt","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenExpiresAt","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV"},{"text":"?","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/Result":{"title":"Issuance.Result","url":"\/documentation\/oid4vcwallet\/issuance\/result","abstract":[{"type":"text","text":"What "},{"code":"requestCredentials()","type":"codeVoice"},{"type":"text","text":" obtained."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Result"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/reissueRequired":{"abstract":[{"type":"text","text":"A credential can’t be refreshed: no refresh token was kept, or"},{"type":"text","text":" "},{"type":"text","text":"the Authorization Server no longer accepts it. Receive it again"},{"type":"text","text":" "},{"type":"text","text":"from a new offer."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/reissuerequired","title":"reissueRequired","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reissueRequired","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Code","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","kind":"typeIdentifier"}],"type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deferredCredentials()":{"abstract":[{"text":"The credentials issuers have deferred and not yet settled, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first — including ones from before the app last quit. Makes no","type":"text"},{"text":" ","type":"text"},{"text":"network calls: poll each at its interval.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/wallet\/deferredcredentials()","title":"deferredCredentials()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deferredCredentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"DeferredCredential","preciseIdentifier":"s:12OID4VCWallet18DeferredCredentialV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/requestCredentials()":{"title":"requestCredentials()","url":"\/documentation\/oid4vcwallet\/issuance\/requestcredentials()","abstract":[{"type":"text","text":"Requests, checks and stores every offered credential."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestCredentials"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result","preciseIdentifier":"s:12OID4VCWallet8IssuanceC6ResultV"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deleteCredential(id:)":{"abstract":[{"text":"Deletes a credential and its holder keys, and its refresh grant","type":"text"},{"text":" ","type":"text"},{"text":"once no other credential uses it, first revoking the refresh token","type":"text"},{"text":" ","type":"text"},{"text":"at the Authorization Server, best effort.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/wallet\/deletecredential(id:)","title":"deleteCredential(id:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deleteCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/offer":{"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"offer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Offer","preciseIdentifier":"s:12OID4VCWallet5OfferV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","role":"symbol","abstract":[{"type":"text","text":"What’s offered: show it before going on."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/issuance\/offer","title":"offer"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credentials()":{"abstract":[{"type":"text","text":"Every credential the wallet holds."}],"type":"topic","title":"credentials()","url":"\/documentation\/oid4vcwallet\/wallet\/credentials()","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"credentials"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credential(id:)":{"abstract":[{"text":"One credential with its claims.","type":"text"}],"type":"topic","title":"credential(id:)","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/credential(id:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"credential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16CredentialDetailV","text":"CredentialDetail"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"url":"\/documentation\/oid4vcwallet","kind":"symbol","title":"OID4VCWallet","role":"collection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/display":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet17CredentialDisplayV","text":"CredentialDisplay","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","role":"symbol","abstract":[{"type":"text","text":"How to show it, from the issuer’s metadata when it was received."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/display","title":"display"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"title":"holderUserPresence","abstract":[{"text":"Require user presence (Face ID, Touch ID or the passcode) for","type":"text"},{"text":" ","type":"text"},{"text":"every signature with a holder key: to present a credential,","type":"text"},{"text":" ","type":"text"},{"text":"and to sign the Credential Request’s jwt proofs, so receiving","type":"text"},{"text":" ","type":"text"},{"text":"and refreshing credentials ask too — once per copy","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true},{"text":"), or once per Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request when its jwt proof carries a key attestation, and","type":"text"},{"text":" ","type":"text"},{"text":"again if the issuer refuses the nonce — and a refresh can’t","type":"text"},{"text":" ","type":"text"},{"text":"run without the holder. The Secure Enclave","type":"text"},{"text":" ","type":"text"},{"text":"enforces it. Off, the app asks for it itself (with","type":"text"},{"text":" ","type":"text"},{"code":"LAContext.evaluatePolicy","type":"codeVoice"},{"text":") before every presentation — in","type":"text"},{"text":" ","type":"text"},{"text":"the app, from a link, through a document provider extension,","type":"text"},{"text":" ","type":"text"},{"text":"and in person — a check the app’s own code keeps, not the","type":"text"},{"text":" ","type":"text"},{"text":"key. For Face ID, the app’s Info.plist must have an","type":"text"},{"text":" ","type":"text"},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"text":"; without one, iOS asks for the","type":"text"},{"text":" ","type":"text"},{"text":"passcode instead.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startIssuance(offer:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startIssuance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"offer"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet8IssuanceC","kind":"typeIdentifier","text":"Issuance"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","role":"symbol","abstract":[{"type":"text","text":"Resolves a Credential Offer (openid-credential-offer:\/\/…) and the"},{"type":"text","text":" "},{"type":"text","text":"issuer’s metadata."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/startissuance(offer:)","title":"startIssuance(offer:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/completeAuthorization(redirect:)":{"abstract":[{"type":"text","text":"Completes the authorization with the issuer’s redirect back. The"},{"type":"text","text":" "},{"type":"text","text":"redirect is used up whatever happens: if this fails — the token"},{"type":"text","text":" "},{"type":"text","text":"request didn’t get through, say — call "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":" "},{"type":"text","text":"again, rather than retrying this."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","url":"\/documentation\/oid4vcwallet\/issuance\/completeauthorization(redirect:)","title":"completeAuthorization(redirect:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"completeAuthorization"},{"kind":"text","text":"("},{"kind":"externalParam","text":"redirect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredStatus":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredStatus","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus","role":"symbol","navigatorTitle":[{"text":"DeferredStatus","kind":"identifier"}],"abstract":[{"type":"text","text":"A deferred credential’s state, from "},{"code":"Wallet.pollDeferred(id:)","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/deferredstatus","title":"DeferredStatus"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer/txCode-swift.property":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"txCode","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet5OfferV6TxCodeV","text":"TxCode","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","role":"symbol","abstract":[{"type":"text","text":"The PIN to ask the holder for, for a pre-authorized code offer."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/offer\/txcode-swift.property","title":"txCode"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"abstract":[{"text":"Replaces a ","type":"text"},{"code":"refreshable","type":"codeVoice"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new holder key, without the holder signing in","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VCI 1.0 §13.5). The new holder keys sign the Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request’s proof, so with ","type":"text"},{"code":"KeychainKeyStore.Options.holderUserPresence","type":"codeVoice"},{"text":" ","type":"text"},{"text":"on it asks the holder. Use it when ","type":"text"},{"code":"copiesLeft","type":"codeVoice"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","title":"refreshCredential(id:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"role":"symbol","title":"Issuance","navigatorTitle":[{"kind":"identifier","text":"Issuance"}],"abstract":[{"type":"text","text":"Receives one offer’s credentials: show "},{"type":"codeVoice","code":"offer"},{"type":"text","text":"; then"},{"type":"text","text":" "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":", open the URL in ASWebAuthenticationSession and"},{"type":"text","text":" "},{"type":"codeVoice","code":"completeAuthorization(redirect:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"redeemPreAuthorizedCode(pin:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":"; "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" when done."}],"url":"\/documentation\/oid4vcwallet\/issuance","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issuance"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkStatus"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","role":"symbol","abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, and an mdoc’s"},{"type":"text","text":" "},{"type":"text","text":"identifier list, checks their signatures, and returns the"},{"type":"text","text":" "},{"type":"text","text":"credential with its revocation status recorded. Each list covers"},{"type":"text","text":" "},{"type":"text","text":"many credentials, so fetching it doesn’t tell the issuer which"},{"type":"text","text":" "},{"type":"text","text":"one is checked. A credential without a status or identifier list"},{"type":"text","text":" "},{"type":"text","text":"is returned as it is. Revocation is final: a credential found"},{"type":"text","text":" "},{"type":"text","text":"revoked stays so, its lists not fetched again, until the revoked"},{"type":"text","text":" "},{"type":"text","text":"copy expires or the credential is refreshed."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","title":"checkStatus(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/beginAuthorization()":{"abstract":[{"text":"Begins the authorization code grant, returning the issuer’s","type":"text"},{"text":" ","type":"text"},{"text":"authorization URL to open in an ","type":"text"},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"text":". Calling it","type":"text"},{"text":" ","type":"text"},{"text":"again begins again: after the holder closed the page, say.","type":"text"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/issuance\/beginauthorization()","title":"beginAuthorization()","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"beginAuthorization","kind":"identifier"},{"text":"() ","kind":"text"},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requestRefresh":{"title":"requestRefresh","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh","abstract":[{"type":"text","text":"Asks Authorization Servers for a refresh token, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"Wallet.refreshCredential(id:)"},{"type":"text","text":" can later replace a credential’s"},{"type":"text","text":" "},{"type":"text","text":"copies without the holder signing in. The server must allow the"},{"type":"text","text":" "},{"type":"text","text":"wallet the "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" scope, or the authorization fails."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestRefresh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/locales":{"abstract":[{"type":"text","text":"The holder’s preferred languages (BCP 47, most preferred first),"},{"type":"text","text":" "},{"type":"text","text":"for issuers’ display metadata. "},{"type":"codeVoice","code":"Locale.preferredLanguages"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"usual choice."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/locales","title":"locales","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"locales","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"abstract":[{"type":"text","text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s"},{"type":"text","text":" "},{"type":"text","text":"kept in the credential store until it’s issued, denied or abandoned,"},{"type":"text","text":" "},{"type":"text","text":"so it survives the app quitting."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","url":"\/documentation\/oid4vcwallet\/deferredcredential","title":"DeferredCredential","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/abandonDeferred(id:)":{"title":"abandonDeferred(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/abandondeferred(id:)","abstract":[{"text":"Gives up on a deferred credential — its access token has expired,","type":"text"},{"text":" ","type":"text"},{"text":"say, or the holder no longer wants it — deleting it and its keys.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"abandonDeferred","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/notFound":{"title":"notFound","abstract":[{"text":"No key, credential, deferred credential or authorization in progress","type":"text"},{"text":" ","type":"text"},{"text":"with that ID.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/notfound","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notFound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"text":"Code","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"kind":"symbol"}}}