{"metadata":{"title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}],"role":"article","roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"title":"Receiving credentials","generated":true,"anchor":"Receiving-credentials"}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"code":"openid-credential-offer:\/\/","type":"codeVoice"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"code":"openid-credential-offer","type":"codeVoice"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","type":"reference","isActive":true},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","type":"reference","isActive":true},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","type":"reference","isActive":true},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The offer names one of two grants:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authorization code:","type":"text"}],"type":"strong"},{"text":" the holder signs in at the issuer’s pages, in","type":"text"},{"text":" ","type":"text"},{"text":"a browser, which redirects back to the wallet’s redirect URI.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Pre-authorized code:","type":"text"}],"type":"strong"},{"text":" the issuer has already authenticated the","type":"text"},{"text":" ","type":"text"},{"text":"holder, and may ask for a PIN it sent them separately","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","isActive":true,"type":"reference"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Either way, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","type":"reference","isActive":true},{"text":" then requests, checks and","type":"text"},{"text":" ","type":"text"},{"text":"stores the credentials, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","type":"reference","isActive":true},{"text":" ends the issuance.","type":"text"}]},{"anchor":"Receive-an-offer","text":"Receive an offer","type":"heading","level":3},{"code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `confirm` shows the","\/\/\/ holder who is offering what, and returns whether they want it;","\/\/\/ `askPIN` asks for the PIN the issuer sent, or returns nil if they","\/\/\/ cancel; `signIn` opens the issuer's page and returns the redirect","\/\/\/ back.","func receive(offerLink: String, wallet: Wallet,","             confirm: (Offer) async -> Bool,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    do {","        guard await confirm(issuance.offer) else {","            try await issuance.close()","            return nil","        }","        switch issuance.offer.grant {","        case .preAuthorizedCode:","            while true {","                guard let pin = await askPIN(issuance.offer.txCode) else {","                    try await issuance.close()","                    return nil","                }","                do {","                    try await issuance.redeemPreAuthorizedCode(pin: pin)","                    break","                } catch let error as WalletError where error.isRetryable {","                    continue \/\/ A wrong PIN (invalid_grant): ask again.","                }","            }","        case .authorizationCode:","            let url = try await issuance.beginAuthorization()","            let redirect = try await signIn(url)","            try await issuance.completeAuthorization(redirect: redirect)","        }","        let result = try await issuance.requestCredentials()","        try await issuance.close()","        return result","    } catch {","        \/\/ End the issuance whatever failed, deleting its keys.","        try? await issuance.close()","        throw error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Show the offer before anything is redeemed: the issuer’s name and the","type":"text"},{"text":" ","type":"text"},{"text":"credentials it offers, so the holder can turn down an offer they didn’t","type":"text"},{"text":" ","type":"text"},{"text":"expect. Close the issuance on every path, as here: its keys are","type":"text"},{"text":" ","type":"text"},{"text":"deleted then, but for those a deferred credential still needs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","type":"reference","isActive":true},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}]},{"anchor":"Open-the-issuers-page","text":"Open the issuer’s page","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}]},{"code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","type":"reference","isActive":true},{"text":" can begin again. A redirect is used","type":"text"},{"text":" ","type":"text"},{"text":"up by ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","type":"reference","isActive":true},{"text":" whatever happens,","type":"text"},{"text":" ","type":"text"},{"text":"so after a failure there, begin again rather than retrying it.","type":"text"}]},{"anchor":"Resume-after-the-app-is-killed","text":"Resume after the app is killed","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"iOS can terminate the app while the holder is at the issuer’s pages.","type":"text"},{"text":" ","type":"text"},{"text":"The authorization in progress is kept in the credential store, so when","type":"text"},{"text":" ","type":"text"},{"text":"the redirect arrives at a relaunched app, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"completes it and returns an issuance ready for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","type":"reference","isActive":true},{"text":". Handle every redirect this way: in","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI, from ","type":"text"},{"code":"onOpenURL","type":"codeVoice"},{"text":". Outside development, resuming needs a","type":"text"},{"text":" ","type":"text"},{"code":"redirectURI","type":"codeVoice"},{"text":" with the app’s own URI scheme, such as","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/callback","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses an https Universal","type":"text"},{"text":" ","type":"text"},{"text":"Link there. In development too, the scheme must be a domain name in","type":"text"},{"text":" ","type":"text"},{"text":"reverse order followed by a single slash, ","type":"text"},{"code":"reverse.domain:\/path","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(RFC 8252 §7.1): ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses ","type":"text"},{"code":"myapp:\/callback","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/\/callback","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"com.example.wallet:callback","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"invalidInput","type":"codeVoice"},{"text":", and any redirect URI with a fragment or credentials.","type":"text"}]},{"code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","type":"reference","isActive":true},{"text":".","type":"text"}]},{"anchor":"Wait-for-a-deferred-credential","text":"Wait for a deferred credential","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","type":"reference","isActive":true},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","type":"reference","isActive":true},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","type":"reference","isActive":true},{"text":").","type":"text"}]},{"anchor":"Look-after-held-credentials","text":"Look after held credentials","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","isActive":true,"type":"reference"},{"text":" lists them, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"returns one with its claims, for display. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"carries the issuer’s names, logos and colours, in the holder’s","type":"text"},{"text":" ","type":"text"},{"text":"language (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","isActive":true,"type":"reference"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","isActive":true,"type":"reference"},{"text":" checks revocation against the issuer’s","type":"text"},{"text":" ","type":"text"},{"text":"status list, which covers many credentials, so the issuer can’t tell","type":"text"},{"text":" ","type":"text"},{"text":"which one is checked.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each credential arrives as a batch of copies, each bound to its own","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true,"type":"reference"},{"text":"), so presentations can’t be","type":"text"},{"text":" ","type":"text"},{"text":"linked by the credential. When ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"reaches zero, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true,"type":"reference"},{"text":" replaces them without","type":"text"},{"text":" ","type":"text"},{"text":"the holder, if the issuance kept a refresh token","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","isActive":true,"type":"reference"},{"text":"). Otherwise it throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","isActive":true,"type":"reference"},{"text":": receive the credential again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","isActive":true,"type":"reference"},{"text":" deletes a credential and its keys,","type":"text"},{"text":" ","type":"text"},{"text":"revoking its refresh token at the issuer.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","interfaceLanguage":"swift"},"abstract":[{"text":"Receive the credentials a Credential Offer offers, with either grant,","type":"text"},{"text":" ","type":"text"},{"text":"and look after them once they’re held.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/Result":{"navigatorTitle":[{"kind":"identifier","text":"Result"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Result"}],"title":"Issuance.Result","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","type":"topic","url":"\/documentation\/oid4vcwallet\/issuance\/result","kind":"symbol","abstract":[{"type":"text","text":"What "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":" obtained."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requestRefresh":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestRefresh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"requestRefresh","role":"symbol","abstract":[{"text":"Asks Authorization Servers for a refresh token, so","type":"text"},{"text":" ","type":"text"},{"code":"Wallet.refreshCredential(id:)","type":"codeVoice"},{"text":" can later replace a credential’s","type":"text"},{"text":" ","type":"text"},{"text":"copies without the holder. The server must allow the wallet the","type":"text"},{"text":" ","type":"text"},{"code":"offline_access","type":"codeVoice"},{"text":" scope, or the authorization fails.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/resumeIssuance(redirect:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resumeIssuance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"redirect"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet8IssuanceC","kind":"typeIdentifier","text":"Issuance"}],"title":"resumeIssuance(redirect:)","role":"symbol","abstract":[{"text":"Completes an authorization begun before the app was suspended or","type":"text"},{"text":" ","type":"text"},{"text":"relaunched: ","type":"text"},{"code":"redirect","type":"codeVoice"},{"text":" is the issuer’s redirect back to the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI, delivered to the app (","type":"text"},{"code":"onOpenURL","type":"codeVoice"},{"text":"). Returns the","type":"text"},{"text":" ","type":"text"},{"text":"issuance ready for ","type":"text"},{"code":"requestCredentials()","type":"codeVoice"},{"text":". A redirect matching no","type":"text"},{"text":" ","type":"text"},{"text":"authorization in progress — not this wallet’s, already completed,","type":"text"},{"text":" ","type":"text"},{"text":"or expired — throws ","type":"text"},{"code":".notFound","type":"codeVoice"},{"text":".","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refreshCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed"}],"title":"refreshCredential(id:)","role":"symbol","abstract":[{"text":"Replaces a ","type":"text"},{"code":"refreshable","type":"codeVoice"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new attested key, without the holder (OpenID4VCI","type":"text"},{"text":" ","type":"text"},{"text":"1.0 §13.5). Use it when ","type":"text"},{"code":"copiesLeft","type":"codeVoice"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/reissueRequired":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reissueRequired","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"text":"Code","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"title":"reissueRequired","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","abstract":[{"type":"text","text":"A credential can’t be refreshed: no refresh token was kept, or"},{"type":"text","text":" "},{"type":"text","text":"the 