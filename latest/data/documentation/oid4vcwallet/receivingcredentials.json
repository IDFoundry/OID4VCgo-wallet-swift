{"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"title":"Receiving credentials","generated":true,"anchor":"Receiving-credentials"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"code":"openid-credential-offer:\/\/","type":"codeVoice"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"code":"openid-credential-offer","type":"codeVoice"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance"},{"text":" whose ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer"},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The offer names one of two grants:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authorization code:"}]},{"type":"text","text":" the holder signs in at the issuer’s pages, in"},{"type":"text","text":" "},{"type":"text","text":"a browser, which redirects back to the wallet’s redirect URI."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Pre-authorized code:"}]},{"type":"text","text":" the issuer has already authenticated the"},{"type":"text","text":" "},{"type":"text","text":"holder, and may ask for a PIN it sent them separately"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Either way, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"text":" then requests, checks and","type":"text"},{"text":" ","type":"text"},{"text":"stores the credentials, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()"},{"text":" ends the issuance.","type":"text"}]},{"level":3,"type":"heading","anchor":"Receive-an-offer","text":"Receive an offer"},{"code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `confirm` shows the","\/\/\/ holder who is offering what, and returns whether they want it;","\/\/\/ `askPIN` asks for the PIN the issuer sent, or returns nil if they","\/\/\/ cancel; `signIn` opens the issuer's page and returns the redirect","\/\/\/ back.","func receive(offerLink: String, wallet: Wallet,","             confirm: (Offer) async -> Bool,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    do {","        guard await confirm(issuance.offer) else {","            try await issuance.close()","            return nil","        }","        switch issuance.offer.grant {","        case .preAuthorizedCode:","            while true {","                guard let pin = await askPIN(issuance.offer.txCode) else {","                    try await issuance.close()","                    return nil","                }","                do {","                    try await issuance.redeemPreAuthorizedCode(pin: pin)","                    break","                } catch let error as WalletError where error.isRetryable {","                    continue \/\/ A wrong PIN (invalid_grant): ask again.","                }","            }","        case .authorizationCode:","            let url = try await issuance.beginAuthorization()","            let redirect = try await signIn(url)","            try await issuance.completeAuthorization(redirect: redirect)","        }","        let result = try await issuance.requestCredentials()","        try await issuance.close()","        return result","    } catch {","        \/\/ End the issuance whatever failed, deleting its keys.","        try? await issuance.close()","        throw error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Show the offer before anything is redeemed: the issuer’s name and the","type":"text"},{"text":" ","type":"text"},{"text":"credentials it offers, so the holder can turn down an offer they didn’t","type":"text"},{"text":" ","type":"text"},{"text":"expect. Close the issuance on every path, as here: its keys are","type":"text"},{"text":" ","type":"text"},{"text":"deleted then, but for those a deferred credential still needs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result"},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}]},{"level":3,"type":"heading","anchor":"Open-the-issuers-page","text":"Open the issuer’s page"},{"type":"paragraph","inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}]},{"code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()"},{"text":" can begin again. A redirect is used","type":"text"},{"text":" ","type":"text"},{"text":"up by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)"},{"text":" whatever happens,","type":"text"},{"text":" ","type":"text"},{"text":"so after a failure there, begin again rather than retrying it.","type":"text"}]},{"level":3,"type":"heading","anchor":"Resume-after-the-app-is-killed","text":"Resume after the app is killed"},{"type":"paragraph","inlineContent":[{"text":"iOS can terminate the app while the holder is at the issuer’s pages.","type":"text"},{"text":" ","type":"text"},{"text":"The authorization in progress is kept in the credential store, so when","type":"text"},{"text":" ","type":"text"},{"text":"the redirect arrives at a relaunched app, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)"},{"text":" ","type":"text"},{"text":"completes it and returns an issuance ready for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"text":". Handle every redirect this way: in","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI, from ","type":"text"},{"code":"onOpenURL","type":"codeVoice"},{"text":". Outside development, resuming needs a","type":"text"},{"text":" ","type":"text"},{"code":"redirectURI","type":"codeVoice"},{"text":" with the app’s own URI scheme, such as","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/callback","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses an https Universal","type":"text"},{"text":" ","type":"text"},{"text":"Link there. In development too, the scheme must be a domain name in","type":"text"},{"text":" ","type":"text"},{"text":"reverse order followed by a single slash, ","type":"text"},{"code":"reverse.domain:\/path","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(RFC 8252 §7.1): ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses ","type":"text"},{"code":"myapp:\/callback","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/\/callback","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"com.example.wallet:callback","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"invalidInput","type":"codeVoice"},{"text":", and any redirect URI with a fragment or credentials.","type":"text"}]},{"code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound"},{"text":".","type":"text"}]},{"level":3,"type":"heading","anchor":"Wait-for-a-deferred-credential","text":"Wait for a deferred credential"},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)"},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt"},{"text":").","type":"text"}]},{"level":3,"type":"heading","anchor":"Look-after-held-credentials","text":"Look after held credentials"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()"},{"type":"text","text":" lists them, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)"},{"type":"text","text":" "},{"type":"text","text":"returns one with its claims, for display. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display"},{"type":"text","text":" "},{"type":"text","text":"carries the issuer’s names, logos and colours, in the holder’s"},{"type":"text","text":" "},{"type":"text","text":"language ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)"},{"type":"text","text":" checks revocation against the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"status list, which covers many credentials, so the issuer can’t tell"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each credential arrives as a batch of copies, each bound to its own"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":"), so presentations can’t be"},{"type":"text","text":" "},{"type":"text","text":"linked by the credential. When "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft"},{"text":" ","type":"text"},{"text":"reaches zero, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)"},{"text":" replaces them, if the","type":"text"},{"text":" ","type":"text"},{"text":"issuance kept a refresh token (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh"},{"text":").","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Otherwise it throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired"},{"type":"text","text":": receive the"},{"text":" ","type":"text"},{"text":"credential again. A refresh needs no sign-in, but the new copies’","type":"text"},{"text":" ","type":"text"},{"text":"holder keys sign the Credential Request’s proof, so with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence"},{"text":" on it","type":"text"},{"text":" ","type":"text"},{"text":"asks the holder too.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)"},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","role":"article","title":"Receiving credentials"},"kind":"article","identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","interfaceLanguage":"swift"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deferredCredentials()":{"abstract":[{"text":"The credentials issuers have deferred and not yet settled, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first — including ones from before the app last quit. Makes no","type":"text"},{"text":" ","type":"text"},{"text":"network calls: poll each at its interval.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deferredCredentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet18DeferredCredentialV","text":"DeferredCredential","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","url":"\/documentation\/oid4vcwallet\/wallet\/deferredcredentials()","role":"symbol","title":"deferredCredentials()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/locales":{"abstract":[{"type":"text","text":"The holder’s preferred languages (BCP 47, most preferred first),"},{"type":"text","text":" "},{"type":"text","text":"for issuers’ display metadata. "},{"type":"codeVoice","code":"Locale.preferredLanguages"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"usual choice."}],"kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"locales","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/locales","role":"symbol","title":"locales"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/Result":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/issuance\/result","navigatorTitle":[{"text":"Result","kind":"identifier"}],"abstract":[{"type":"text","text":"What "},{"code":"requestCredentials()","type":"codeVoice"},{"type":"text","text":" obtained."}],"title":"Issuance.Result","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","kind":"symbol","role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/notFound":{"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"notFound"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"No key, credential, deferred credential or authorization in progress"},{"type":"text","text":" "},{"type":"text","text":"with that ID."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/notfound","title":"notFound"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Offer","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/offer","navigatorTitle":[{"text":"Offer","kind":"identifier"}],"kind":"symbol","title":"Offer","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","abstract":[{"type":"text","text":"What a Credential Offer offers."}],"role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"abstract":[{"type":"text","text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s"},{"type":"text","text":" "},{"type":"text","text":"kept in the credential store until it’s issued, denied or abandoned,"},{"type":"text","text":" "},{"type":"text","text":"so it survives the app quitting."}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","url":"\/documentation\/oid4vcwallet\/deferredcredential","role":"symbol","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"title":"DeferredCredential"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredStatus":{"abstract":[{"text":"A deferred credential’s state, from ","type":"text"},{"code":"Wallet.pollDeferred(id:)","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredStatus","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus","url":"\/documentation\/oid4vcwa