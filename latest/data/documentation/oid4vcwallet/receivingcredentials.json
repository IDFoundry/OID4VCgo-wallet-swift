{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"seeAlsoSections":[{"anchor":"Receiving-credentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"title":"Receiving credentials","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"]}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"An issuer offers credentials with an "},{"type":"codeVoice","code":"openid-credential-offer:\/\/"},{"type":"text","text":" link,"},{"type":"text","text":" "},{"type":"text","text":"as a QR code or a link the holder opens. Register the"},{"type":"text","text":" "},{"type":"codeVoice","code":"openid-credential-offer"},{"type":"text","text":" URL scheme in the app’s Info.plist so links"},{"type":"text","text":" "},{"type":"text","text":"open the app, and hand the link to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)"},{"type":"text","text":". It"},{"type":"text","text":" "},{"type":"text","text":"resolves the offer and the issuer’s metadata, and returns an"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","isActive":true,"type":"reference"},{"type":"text","text":" whose "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","isActive":true,"type":"reference"},{"type":"text","text":" you show the holder: who is"},{"type":"text","text":" "},{"type":"text","text":"offering what."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The offer names one of two grants:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authorization code:","type":"text"}],"type":"strong"},{"text":" the holder signs in at the issuer’s pages, in","type":"text"},{"text":" ","type":"text"},{"text":"a browser, which redirects back to the wallet’s redirect URI.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Pre-authorized code:"}]},{"type":"text","text":" the issuer has already authenticated the"},{"type":"text","text":" "},{"type":"text","text":"holder, and may ask for a PIN it sent them separately"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","isActive":true},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Either way, "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true},{"type":"text","text":" then requests, checks and"},{"type":"text","text":" "},{"type":"text","text":"stores the credentials, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()"},{"type":"text","text":" ends the issuance."}]},{"anchor":"Receive-an-offer","text":"Receive an offer","type":"heading","level":3},{"syntax":"swift","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result"},{"type":"text","text":" lists what arrived, what the issuer deferred, and"},{"type":"text","text":" "},{"type":"text","text":"what failed: one credential the issuer refused doesn’t hold up the"},{"type":"text","text":" "},{"type":"text","text":"rest."}],"type":"paragraph"},{"anchor":"Open-the-issuers-page","text":"Open the issuer’s page","type":"heading","level":3},{"inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"type":"codeVoice","code":"ASWebAuthenticationSession"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the holder closes the page, the offer stays open:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","isActive":true},{"type":"text","text":" can begin again. A redirect is used"},{"type":"text","text":" "},{"type":"text","text":"up by "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","isActive":true},{"type":"text","text":" whatever happens,"},{"type":"text","text":" "},{"type":"text","text":"so after a failure there, begin again rather than retrying it."}],"type":"paragraph"},{"anchor":"Resume-after-the-app-is-killed","text":"Resume after the app is killed","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"iOS can terminate the app while the holder is at the issuer’s pages."},{"type":"text","text":" "},{"type":"text","text":"The authorization in progress is kept in the credential store, so when"},{"type":"text","text":" "},{"type":"text","text":"the redirect arrives at a relaunched app, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"completes it and returns an issuance ready for"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true,"type":"reference"},{"type":"text","text":". Handle every redirect this way: in"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI, from "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":". Outside development, resuming needs a"},{"type":"text","text":" "},{"type":"codeVoice","code":"redirectURI"},{"type":"text","text":" with the app’s own URI scheme, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.example.wallet:\/callback"},{"type":"text","text":": it fails for an https Universal Link."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A redirect that matches no authorization in progress throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","isActive":true},{"type":"text","text":"."}]},{"anchor":"Wait-for-a-deferred-credential","type":"heading","level":3,"text":"Wait for a deferred credential"},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","type":"reference"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)"},{"type":"text","text":" gives one up, deleting its keys: once"},{"type":"text","text":" "},{"type":"text","text":"its access token has expired, say ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt"},{"type":"text","text":")."}]},{"text":"Look after held credentials","anchor":"Look-after-held-credentials","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()"},{"text":" lists them, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)"},{"text":" ","type":"text"},{"text":"returns one with its claims, for display. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display"},{"text":" ","type":"text"},{"text":"carries the issuer’s names, logos and colours, in the holder’s","type":"text"},{"text":" ","type":"text"},{"text":"language (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)"},{"type":"text","text":" checks revocation against the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"status list, which covers many credentials, so the issuer can’t tell"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each credential arrives as a batch of copies, each bound to its own"},{"type":"text","text":" "},{"text":"key (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true,"type":"reference"},{"type":"text","text":"), so presentations can’t be"},{"type":"text","text":" "},{"type":"text","text":"linked by the credential. When "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reaches zero, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"reference","isActive":true},{"type":"text","text":" replaces them without"},{"text":" ","type":"text"},{"text":"the holder, if the issuance kept a refresh token","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","type":"reference","isActive":true},{"text":"). Otherwise it throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","type":"reference","isActive":true},{"text":": receive the credential again.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)"},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"text":"revoking its refresh token at the issuer.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"metadata":{"role":"article","title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/abandonDeferred(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","title":"abandonDeferred(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/abandondeferred(id:)","type":"topic","abstract":[{"type":"text","text":"Gives up on a deferred credential — its access token has expired,"},{"type":"text","text":" "},{"type":"text","text":"say, or the holder no longer wants it — deleting it and its keys."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"abandonDeferred"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/Result":{"abstract":[{"type":"text","text":"What "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":" obtained."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","title":"Issuance.Result","navigatorTitle":[{"kind":"identifier","text":"Result"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Result"}],"url":"\/documentation\/oid4vcwallet\/issuance\/result"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deleteCredential(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","title":"deleteCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/deletecredential(id:)","type":"topic","abstract":[{"type":"text","text":"Deletes a credential and its holder keys, and its refresh grant"},{"type":"text","text":" "},{"type":"text","text":"once no other credential uses it, first revoking the refresh token"},{"type":"text","text":" "},{"type":"text","text":"at the Authorization Server, best effort."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deleteCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"type":"topic","kind":"symbol","title":"refreshCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","abstract":[{"type":"text","text":"Replaces a "},{"type":"codeVoice","code":"refreshable"},{"type":"text","text":" credential’s copies with a fresh batch,"},{"type":"text","text":" "},{"type":"text","text":"each bound to a new attested key, without the holder (OpenID4VCI"},{"type":"text","text":" "},{"type":"text","text":"1.0 §13.5). Use it when "},{"type":"codeVoice","code":"copiesLeft"},{"type":"text","text":" runs low. Throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"type":"text","text":" when it can’t be refreshed:"},{"type":"text","text":" "},{"type":"text","text":"receive it again from a new offer."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requestRefresh":{"type":"topic","kind":"symbol","title":"requestRefresh","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh","abstract":[{"type":"text","text":"Asks Authorization Servers for a refresh token, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"Wallet.refreshCredential(id:)"},{"type":"text","text":" can later replace a credential’s"},{"type":"text","text":" "},{"type":"text","text":"copies without the holder. The server must allow the wallet the"},{"type":"text","text":" "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" scope, or the authorization fails."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestRefresh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/close()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","title":"close()","type":"topic","role":"symbol","url":"\/documentation\/oid4vcwallet\/issuance\/close()","abstract":[{"type":"text","text":"Ends the issuance, deleting its keys but those its deferred"},{"type":"text","text":" "},{"type":"text","text":"credentials still poll with."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credentials()":{"abstract":[{"type":"text","text":"Every credential the wallet holds."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","title":"credentials()","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","text":"CredentialSummary","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/oid4vcwallet\/wallet\/credentials()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/notFound":{"kind":"symbol","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/notfound","abstract":[{"text":"No key, credential, deferred credential or authorization in progress","type":"text"},{"text":" ","type":"text"},{"text":"with that ID.","type":"text"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notFound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"text":"Code","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"type":"topic","title":"notFound"},"doc://oid4vcwallet.OI