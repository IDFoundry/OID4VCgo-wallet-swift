n\/oid4vcwallet\/credentialsummary\/display","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialDisplayV","text":"CredentialDisplay"},{"kind":"text","text":"?"}],"title":"display","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/beginAuthorization()":{"title":"beginAuthorization()","url":"\/documentation\/oid4vcwallet\/issuance\/beginauthorization()","abstract":[{"type":"text","text":"Begins the authorization code grant, returning the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"authorization URL to open in an "},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"type":"text","text":". Calling it"},{"type":"text","text":" "},{"type":"text","text":"again begins again: after the holder closed the page, say."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"beginAuthorization"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier","text":"URL"}],"type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/notFound":{"abstract":[{"text":"No key, credential, deferred credential or authorization in progress","type":"text"},{"text":" ","type":"text"},{"text":"with that ID.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"notFound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WalletError","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Code","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"title":"notFound","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/notfound","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/completeAuthorization(redirect:)":{"abstract":[{"type":"text","text":"Completes the authorization with the issuer’s redirect back. The"},{"type":"text","text":" "},{"type":"text","text":"redirect is used up whatever happens: if this fails — the token"},{"type":"text","text":" "},{"type":"text","text":"request didn’t get through, say — call "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":" "},{"type":"text","text":"again, rather than retrying this."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"completeAuthorization","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"completeAuthorization(redirect:)","url":"\/documentation\/oid4vcwallet\/issuance\/completeauthorization(redirect:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"title":"holderUserPresence","role":"symbol","abstract":[{"text":"Require user presence (Face ID, Touch ID or the passcode) for","type":"text"},{"text":" ","type":"text"},{"text":"every signature with a holder key: to present a credential,","type":"text"},{"text":" ","type":"text"},{"text":"and to sign the Credential Request’s jwt proofs, so receiving","type":"text"},{"text":" ","type":"text"},{"text":"and refreshing credentials ask too — once per copy","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"text":"), or once per Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request when its jwt proof carries a key attestation, and","type":"text"},{"text":" ","type":"text"},{"text":"again if the issuer refuses the nonce — and a refresh can’t","type":"text"},{"text":" ","type":"text"},{"text":"run without the holder. The Secure Enclave","type":"text"},{"text":" ","type":"text"},{"text":"enforces it. Off, the app asks for it itself (with","type":"text"},{"text":" ","type":"text"},{"code":"LAContext.evaluatePolicy","type":"codeVoice"},{"text":") before every presentation — in","type":"text"},{"text":" ","type":"text"},{"text":"the app, from a link, through a document provider extension,","type":"text"},{"text":" ","type":"text"},{"text":"and in person — a check the app’s own code keeps, not the","type":"text"},{"text":" ","type":"text"},{"text":"key. For Face ID, the app’s Info.plist must have an","type":"text"},{"text":" ","type":"text"},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"text":"; without one, iOS asks for the","type":"text"},{"text":" ","type":"text"},{"text":"passcode instead.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","kind":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderUserPresence","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkStatus","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","abstract":[{"text":"Fetches the issuer’s status list for a credential, and an mdoc’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier list, checks their signatures, and returns the","type":"text"},{"text":" ","type":"text"},{"text":"credential with its revocation status recorded. Each list covers","type":"text"},{"text":" ","type":"text"},{"text":"many credentials, so fetching it doesn’t tell the issuer which","type":"text"},{"text":" ","type":"text"},{"text":"one is checked. A credential without a status or identifier list","type":"text"},{"text":" ","type":"text"},{"text":"is returned as it is. Revocation is final: a credential found","type":"text"},{"text":" ","type":"text"},{"text":"revoked stays so, its lists not fetched again, until the revoked","type":"text"},{"text":" ","type":"text"},{"text":"copy expires or the credential is refreshed.","type":"text"}],"type":"topic","title":"checkStatus(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer/txCode-