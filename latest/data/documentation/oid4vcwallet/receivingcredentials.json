{"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"type":"codeVoice","code":"openid-credential-offer:\/\/"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"openid-credential-offer"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","isActive":true,"type":"reference"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","isActive":true,"type":"reference"},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","isActive":true,"type":"reference"},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The offer names one of two grants:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Authorization code:"}],"type":"strong"},{"type":"text","text":" the holder signs in at the issuer’s pages, in"},{"type":"text","text":" "},{"type":"text","text":"a browser, which redirects back to the wallet’s redirect URI."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Pre-authorized code:","type":"text"}]},{"type":"text","text":" the issuer has already authenticated the"},{"type":"text","text":" "},{"text":"holder, and may ask for a PIN it sent them separately","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property"},{"text":").","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Either way, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true,"type":"reference"},{"text":" then requests, checks and","type":"text"},{"text":" ","type":"text"},{"text":"stores the credentials, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","isActive":true,"type":"reference"},{"text":" ends the issuance.","type":"text"}]},{"anchor":"Receive-an-offer","text":"Receive an offer","level":3,"type":"heading"},{"type":"codeListing","syntax":"swift","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `confirm` shows the","\/\/\/ holder who is offering what, and returns whether they want it;","\/\/\/ `askPIN` asks for the PIN the issuer sent, or returns nil if they","\/\/\/ cancel; `signIn` opens the issuer's page and returns the redirect","\/\/\/ back.","func receive(offerLink: String, wallet: Wallet,","             confirm: (Offer) async -> Bool,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    do {","        guard await confirm(issuance.offer) else {","            try await issuance.close()","            return nil","        }","        switch issuance.offer.grant {","        case .preAuthorizedCode:","            while true {","                guard let pin = await askPIN(issuance.offer.txCode) else {","                    try await issuance.close()","                    return nil","                }","                do {","                    try await issuance.redeemPreAuthorizedCode(pin: pin)","                    break","                } catch let error as WalletError where error.isRetryable {","                    continue \/\/ A wrong PIN (invalid_grant): ask again.","                }","            }","        case .authorizationCode:","            let url = try await issuance.beginAuthorization()","            let redirect = try await signIn(url)","            try await issuance.completeAuthorization(redirect: redirect)","        }","        let result = try await issuance.requestCredentials()","        try await issuance.close()","        return result","    } catch {","        \/\/ End the issuance whatever failed, deleting its keys.","        try? await issuance.close()","        throw error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show the offer before anything is redeemed: the issuer’s name and the"},{"type":"text","text":" "},{"type":"text","text":"credentials it offers, so the holder can turn down an offer they didn’t"},{"type":"text","text":" "},{"type":"text","text":"expect. Close the issuance on every path, as here: its keys are"},{"type":"text","text":" "},{"type":"text","text":"deleted then, but for those a deferred credential still needs."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","isActive":true},{"type":"text","text":" lists what arrived, what the issuer deferred, and"},{"type":"text","text":" "},{"type":"text","text":"what failed: one credential the issuer refused doesn’t hold up the"},{"type":"text","text":" "},{"type":"text","text":"rest."}]},{"anchor":"Open-the-issuers-page","text":"Open the issuer’s page","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the holder closes the page, the offer stays open:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","isActive":true},{"type":"text","text":" can begin again. A redirect is used"},{"type":"text","text":" "},{"type":"text","text":"up by "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","isActive":true},{"type":"text","text":" whatever happens,"},{"type":"text","text":" "},{"type":"text","text":"so after a failure there, begin again rather than retrying it."}]},{"type":"heading","level":3,"anchor":"Resume-after-the-app-is-killed","text":"Resume after the app is killed"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS can terminate the app while the holder is at the issuer’s pages."},{"type":"text","text":" "},{"type":"text","text":"The authorization in progress is kept in the credential store, so when"},{"type":"text","text":" "},{"type":"text","text":"the redirect arrives at a relaunched app, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"completes it and returns an issuance ready for"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","type":"reference","isActive":true},{"type":"text","text":". Handle every redirect this way: in"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI, from "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":". Outside development, resuming needs a"},{"text":" ","type":"text"},{"code":"redirectURI","type":"codeVoice"},{"text":" with the app’s own URI scheme, such as","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/callback","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses an https Universal","type":"text"},{"text":" ","type":"text"},{"text":"Link there. In development too, the scheme must be a domain name in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"reverse order followed by a single slash, "},{"code":"reverse.domain:\/path","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(RFC 8252 §7.1): ","type":"text"},{"code":"Wallet","type":"codeVoice"},{"text":" refuses ","type":"text"},{"code":"myapp:\/callback","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"com.example.wallet:\/\/callback","type":"codeVoice"},{"type":"text","text":" and "},{"code":"com.example.wallet:callback","type":"codeVoice"},{"type":"text","text":" as"},{"type":"text","text":" "},{"code":"invalidInput","type":"codeVoice"},{"type":"text","text":", and any redirect URI with a fragment or credentials."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A redirect that matches no authorization in progress throws"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Wait for a deferred credential","anchor":"Wait-for-a-deferred-credential"},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in the credential store until it’s issued, denied or abandoned, so it"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"syntax":"swift","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","type":"reference","isActive":true},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt"},{"text":").","type":"text"}],"type":"paragraph"},{"level":3,"text":"Look after held credentials","anchor":"Look-after-held-credentials","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","type":"reference"},{"text":" lists them, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","type":"reference"},{"text":" ","type":"text"},{"text":"returns one with its claims, for display. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","type":"reference"},{"text":" ","type":"text"},{"text":"carries the issuer’s names, logos and colours, in the holder’s","type":"text"},{"text":" ","type":"text"},{"text":"language (","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","isActive":true},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","isActive":true,"type":"reference"},{"text":" checks revocation against the issuer’s","type":"text"},{"text":" ","type":"text"},{"text":"status list, which covers many credentials, so the issuer can’t tell","type":"text"},{"text":" ","type":"text"},{"text":"which one is checked.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Each credential arrives as a batch of copies, each bound to its own","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","type":"reference"},{"text":"), so presentations can’t be","type":"text"},{"text":" ","type":"text"},{"text":"linked by the credential. When ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","type":"reference"},{"text":" ","type":"text"},{"text":"reaches zero, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"reference"},{"text":" replaces them, if the","type":"text"},{"text":" ","type":"text"},{"text":"issuance kept a refresh token (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","isActive":true,"type":"reference"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Otherwise it throws "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","isActive":true,"type":"reference"},{"text":": receive the","type":"text"},{"text":" ","type":"text"},{"text":"credential again. A refresh needs no sign-in, but the new copies’","type":"text"},{"text":" ","type":"text"},{"text":"holder keys sign the Credential Request’s proof, so with","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence","isActive":true},{"type":"text","text":" on it"},{"type":"text","text":" "},{"type":"text","text":"asks the holder too."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","isActive":true},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}]}]}]}],"kind":"content"}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"role":"article","title":"Receiving credentials","roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Receiving-credentials","title":"Receiving credentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"generated":true}],"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"},"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","abstract":[{"text":"Replaces a ","type":"text"},{"code":"refreshable","type":"codeVoice"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new holder key, without the holder signing in","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VCI 1.0 §13.5). The new holder keys sign the Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request’s proof, so with ","type":"text"},{"code":"KeychainKeyStore.Options.holderUserPresence","type":"codeVoice"},{"text":" ","type":"text"},{"text":"on it asks the holder. Use it when ","type":"text"},{"code":"copiesLeft","type":"codeVoice"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"type":"topic","title":"refreshCredential(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","abstract":[{"text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s","type":"text"},{"text":" ","type":"text"},{"text":"kept in the credential store until it’s issued, denied or abandoned,","type":"text"},{"text":" ","type":"text"},{"text":"so it survives the app quitting.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/deferredcredential","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"title":"DeferredCredential","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/locales":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","abstract":[{"text":"The holder’s preferred languages (BCP 47, most preferred first),","type":"text"},{"text":" ","type":"text"},{"text":"for issuers’ display metadata. ","type":"text"},{"code":"Locale.preferredLanguages","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"usual choice.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/locales","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"locales"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]"}],"title":"locales","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/close()":{"title":"close()","url":"\/documentation\/oid4vcwallet\/issuance\/close()","abstract":[{"text":"Ends the issuance, deleting its keys but those its deferred","type":"text"},{"text":" ","type":"text"},{"text":"credentials still poll with.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"close"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"kind":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/abandonDeferred(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/abandondeferred(id:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"abandonDeferred"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","abstract":[{"type":"text","text":"Gives up on a deferred credential — its access token has expired,"},{"type":"text","text":" "},{"type":"text","text":"say, or the holder no longer wants it — deleting it and its keys."}],"type":"topic","title":"abandonDeferred(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credential(id:)":{"title":"credential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/credential(id:)","abstract":[{"type":"text","text":"One credential with its claims."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"credential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet16CredentialDetailV","kind":"typeIdentifier","text":"CredentialDetail"}],"type":"topic","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issuance"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Receives one offer’s credentials: show "},{"type":"codeVoice","code":"offer"},{"type":"text","text":"; then"},{"type":"text","text":" "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":", open the URL in ASWebAuthenticationSession and"},{"type":"text","text":" "},{"type":"codeVoice","code":"completeAuthorization(redirect:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"redeemPreAuthorizedCode(pin:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":"; "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" when done."}],"navigatorTitle":[{"kind":"identifier","text":"Issuance"}],"url":"\/documentation\/oid4vcwallet\/issuance","title":"Issuance"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credentials()":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","abstract":[{"type":"text","text":"Every credential the wallet holds."}],"url":"\/documentation\/oid4vcwallet\/wallet\/credentials()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"credentials"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier","text":"CredentialSummary"},{"kind":"text","text":"]"}],"type":"topic","title":"credentials()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Offer","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","role":"symbol","type":"topic","abstract":[{"type":"text","text":"What a Credential Offer offers."}],"navigatorTitle":[{"kind":"identifier","text":"Offer"}],"url":"\/documentation\/oid4vcwallet\/offer","title":"Offer"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/reissueRequired":{"title":"reissueRequired","abstract":[{"text":"A credential can’t be refreshed: no refresh token was kept, or","type":"text"},{"text":" ","type":"text"},{"text":"the Authorization Server no longer accepts it. Receive it again","type":"text"},{"text":" ","type":"text"},{"text":"from a new offer.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/reissuerequired","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword"