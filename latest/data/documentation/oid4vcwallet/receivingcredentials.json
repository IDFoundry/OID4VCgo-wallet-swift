ss","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Issuance","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/issuance","navigatorTitle":[{"text":"Issuance","kind":"identifier"}],"kind":"symbol","title":"Issuance","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","abstract":[{"type":"text","text":"Receives one offer’s credentials: show "},{"code":"offer","type":"codeVoice"},{"type":"text","text":"; then"},{"type":"text","text":" "},{"code":"beginAuthorization()","type":"codeVoice"},{"type":"text","text":", open the URL in ASWebAuthenticationSession and"},{"type":"text","text":" "},{"code":"completeAuthorization(redirect:)","type":"codeVoice"},{"type":"text","text":", or "},{"code":"redeemPreAuthorizedCode(pin:)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"code":"requestCredentials()","type":"codeVoice"},{"type":"text","text":"; "},{"code":"close()","type":"codeVoice"},{"type":"text","text":" when done."}],"role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/offer":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"offer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Offer","preciseIdentifier":"s:12OID4VCWallet5OfferV"}],"url":"\/documentation\/oid4vcwallet\/issuance\/offer","kind":"symbol","title":"offer","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","abstract":[{"text":"What’s offered: show it before going on.","type":"text"}],"role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startIssuance(offer:)":{"abstract":[{"text":"Resolves a Credential Offer (openid-credential-offer:\/\/…) and the","type":"text"},{"text":" ","type":"text"},{"text":"issuer’s metadata.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"