{"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"anchor":"Receiving-credentials","generated":true,"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"title":"Receiving credentials"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An issuer offers credentials with an "},{"type":"codeVoice","code":"openid-credential-offer:\/\/"},{"type":"text","text":" link,"},{"type":"text","text":" "},{"type":"text","text":"as a QR code or a link the holder opens. Register the"},{"type":"text","text":" "},{"type":"codeVoice","code":"openid-credential-offer"},{"type":"text","text":" URL scheme in the app’s Info.plist so links"},{"type":"text","text":" "},{"type":"text","text":"open the app, and hand the link to "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","isActive":true},{"type":"text","text":". It"},{"type":"text","text":" "},{"type":"text","text":"resolves the offer and the issuer’s metadata, and returns an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","isActive":true},{"type":"text","text":" whose "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","isActive":true},{"type":"text","text":" you show the holder: who is"},{"type":"text","text":" "},{"type":"text","text":"offering what."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The offer names one of two grants:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authorization code:"}]},{"type":"text","text":" the holder signs in at the issuer’s pages, in"},{"type":"text","text":" "},{"type":"text","text":"a browser, which redirects back to the wallet’s redirect URI."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Pre-authorized code:"}],"type":"strong"},{"text":" the issuer has already authenticated the","type":"text"},{"text":" ","type":"text"},{"text":"holder, and may ask for a PIN it sent them separately","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Either way, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"type":"text","text":" then requests, checks and"},{"type":"text","text":" "},{"type":"text","text":"stores the credentials, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()"},{"type":"text","text":" ends the issuance."}]},{"type":"heading","level":3,"text":"Receive an offer","anchor":"Receive-an-offer"},{"type":"codeListing","syntax":"swift","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result"},{"type":"text","text":" lists what arrived, what the issuer deferred, and"},{"type":"text","text":" "},{"type":"text","text":"what failed: one credential the issuer refused doesn’t hold up the"},{"type":"text","text":" "},{"type":"text","text":"rest."}]},{"type":"heading","level":3,"text":"Open the issuer’s page","anchor":"Open-the-issuers-page"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open the authorization URL in an "},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"type":"text","text":", with the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI’s scheme as its callback scheme. An ephemeral session"},{"type":"text","text":" "},{"type":"text","text":"keeps the issuer’s cookies out of Safari’s."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the holder closes the page, the offer stays open:"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()"},{"type":"text","text":" can begin again. A redirect is used"},{"type":"text","text":" "},{"type":"text","text":"up by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)"},{"type":"text","text":" whatever happens,"},{"type":"text","text":" "},{"type":"text","text":"so after a failure there, begin again rather than retrying it."}]},{"type":"heading","level":3,"text":"Resume after the app is killed","anchor":"Resume-after-the-app-is-killed"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS can terminate the app while the holder is at the issuer’s pages."},{"type":"text","text":" "},{"type":"text","text":"The authorization in progress is kept in the credential store, so when"},{"type":"text","text":" "},{"type":"text","text":"the redirect arrives at a relaunched app, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)"},{"type":"text","text":" "},{"type":"text","text":"completes it and returns an issuance ready for"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},{"type":"text","text":". Handle every redirect this way: in"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI, from "},{"code":"onOpenURL","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A redirect that matches no authorization in progress throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Wait for a deferred credential","anchor":"Wait-for-a-deferred-credential"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An issuer may issue a credential later, after a review, say. It’s kept"},{"type":"text","text":" "},{"type":"text","text":"in the credential store until it’s issued, denied or abandoned, so it"},{"type":"text","text":" "},{"type":"text","text":"survives the app quitting. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()"},{"type":"text","text":" lists them"},{"type":"text","text":" "},{"type":"text","text":"without network requests; poll each at the interval the issuer asks for."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)"},{"type":"text","text":" gives one up, deleting its keys: once"},{"type":"text","text":" "},{"type":"text","text":"its access token has expired, say ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt"},{"type":"text","text":")."}]},{"type":"heading","level":3,"text":"Look after held credentials","anchor":"Look-after-held-credentials"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","isActive":true},{"type":"text","text":" lists them, and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns one with its claims, for display. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","isActive":true},{"type":"text","text":" "},{"type":"text","text":"carries the issuer’s names, logos and colours, in the holder’s"},{"type":"text","text":" "},{"type":"text","text":"language ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","isActive":true},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","isActive":true},{"type":"text","text":" checks revocation against the issuer’s"},{"text":" ","type":"text"},{"text":"status list, which covers many credentials, so the issuer can’t tell","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each credential arrives as a batch of copies, each bound to its own"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":"), so presentations can’t be"},{"type":"text","text":" "},{"type":"text","text":"linked by the credential. When "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft"},{"type":"text","text":" "},{"type":"text","text":"reaches zero, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)"},{"type":"text","text":" replaces them without"},{"type":"text","text":" "},{"type":"text","text":"the holder, if the issuance kept a refresh token"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","type":"reference"},{"type":"text","text":"). Otherwise it throws"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired"},{"text":": receive the credential again.","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","type":"reference","isActive":true},{"text":" deletes a credential and its keys,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}]},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential/accessTokenExpiresAt":{"url":"\/documentation\/oid4vcwallet\/deferredcredential\/accesstokenexpiresat","abstract":[{"type":"text","text":"When the access token it’s polled with expires, if the issuer"},{"type":"text","text":" "},{"type":"text","text":"said: after it, polls fail and it can only be abandoned."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenExpiresAt","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Date","preciseIdentifier":"s:10Foundation4DateV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","kind":"symbol","title":"accessTokenExpiresAt"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/beginAuthorization()":{"url":"\/documentation\/oid4vcwallet\/issuance\/beginauthorization()","abstract":[{"type":"text","text":"Begins the authorization code grant, returning the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"authorization URL to open in an "},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"type":"text","text":". Calling it"},{"type":"text","text":" "},{"type":"text","text":"again begins again: after the holder closed the page, say."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"beginAuthorization"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","kind":"symbol","title":"beginAuthorization()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credentials()":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","url":"\/documentation\/oid4vcwallet\/wallet\/credentials()","title":"credentials()","abstract":[{"type":"text","text":"Every credential the wallet holds."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deleteCredential(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/deletecredential(id:)","title":"deleteCredential(id:)","abstract":[{"type":"text","text":"Deletes a credential and its holder keys, and its refresh grant"},{"type":"text","text":" "},{"type":"text","text":"once no other credential uses it, first revoking the refresh token"},{"type":"text","text":" "},{"type":"text","text":"at the Authorization Server, best effort."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deleteCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/abandonDeferred(id:)":{"abstract":[{"type":"text","text":"Gives up on a deferred credential — its access token has expired,"},{"type":"text","text":" "},{"type":"text","text":"say, or the holder no longer wants it — deleting it and its keys."}],"title":"abandonDeferred(id:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"abandonDeferred","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/abandondeferred(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"abstract":[{"type":"text","text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s"},{"type":"text","text":" "},{"type":"text","text":"kept in the credential store until it’s issued, denied or abandoned,"},{"type":"text","text":" "},{"type":"text","text":"so it survives the app quitting."}],"title":"DeferredCredential","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/deferredcredential"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"abstract":[{"type":"text","text":"Receives one offer’s credentials: show "},{"type":"codeVoice","code":"offer"},{"type":"text","text":"; then"},{"type":"text","text":" "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":", open the URL in ASWebAuthenticationSession and"},{"type":"text","text":" "},{"type":"codeVoice","code":"completeAuthorization(redirect:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"redeemPreAuthorizedCode(pin:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":"; "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" when done."}],"title":"Issuance","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Issuance","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","navigatorTitle":[{"text":"Issuance","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/issuance"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/resumeIssuance(redirect:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)","title":"resumeIssuance(redirect:)","abstract":[{"type":"text","text":"Completes an authorization begun before the app was suspended or"},{"type":"text","text":" "},{"type":"text","text":"relaunched: "},{"type":"codeVoice","code":"redirect"},{"type":"text","text":" is the issuer’s redirect back to the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI, delivered to the app ("},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":"). Returns the"},{"type":"text","text":" "},{"type":"text","text":"issuance ready for "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":". A redirect matching no"},{"type":"text","text":" "},{"type":"text","text":"authorization in progress — not this wallet’s, already completed,"},{"type":"text","text":" "},{"type":"text","text":"or expired — throws "},{"type":"codeVoice","code":".notFound"},{"type":"text","text":"."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resumeIssuance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Issuance","preciseIdentifier":"s:12OID4VCWallet8IssuanceC","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","title":"checkStatus(id:)","abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, checks its"},{"type":"text","text":" "},{"type":"text","text":"signature, and returns the credential with its revocation status"},{"type":"text","text":" "},{"type":"text","text":"recorded. The list covers many credentials, so fetching it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t tell the issuer which one is checked. A credential without"},{"type":"text","text":" "},{"type":"text","text":"a status list is returned as it is."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkStatus","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/close()":{"url":"\/documentation\/oid4vcwallet\/issuance\/c