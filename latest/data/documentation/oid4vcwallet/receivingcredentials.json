text"},{"text":" ","type":"text"},{"text":"authorization in progress — not this wallet’s, already completed,","type":"text"},{"text":" ","type":"text"},{"text":"or expired — throws ","type":"text"},{"code":".notFound","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resumeIssuance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet8IssuanceC","text":"Issuance","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)","role":"symbol","title":"resumeIssuance(redirect:)"}}}