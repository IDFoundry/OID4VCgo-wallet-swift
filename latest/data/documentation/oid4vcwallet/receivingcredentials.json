{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"type":"codeVoice","code":"openid-credential-offer:\/\/"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"code":"openid-credential-offer","type":"codeVoice"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","isActive":true,"type":"reference"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","isActive":true,"type":"reference"},{"type":"text","text":" whose "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","isActive":true},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The offer names one of two grants:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authorization code:","type":"text"}],"type":"strong"},{"text":" the holder signs in at the issuer’s pages, in","type":"text"},{"text":" ","type":"text"},{"text":"a browser, which redirects back to the wallet’s redirect URI.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Pre-authorized code:","type":"text"}],"type":"strong"},{"text":" the issuer has already authenticated the","type":"text"},{"text":" ","type":"text"},{"text":"holder, and may ask for a PIN it sent them separately","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","isActive":true,"type":"reference"},{"text":").","type":"text"}]}]}]},{"inlineContent":[{"text":"Either way, ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true},{"text":" then requests, checks and","type":"text"},{"text":" ","type":"text"},{"text":"stores the credentials, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","isActive":true},{"text":" ends the issuance.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Receive an offer","anchor":"Receive-an-offer"},{"code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","isActive":true},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Open the issuer’s page","anchor":"Open-the-issuers-page"},{"inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"type":"codeVoice","code":"ASWebAuthenticationSession"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","isActive":true},{"text":" can begin again. A redirect is used","type":"text"},{"text":" ","type":"text"},{"text":"up by ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","isActive":true},{"text":" whatever happens,","type":"text"},{"text":" ","type":"text"},{"text":"so after a failure there, begin again rather than retrying it.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Resume after the app is killed","anchor":"Resume-after-the-app-is-killed"},{"inlineContent":[{"text":"iOS can terminate the app while the holder is at the issuer’s pages.","type":"text"},{"text":" ","type":"text"},{"text":"The authorization in progress is kept in the credential store, so when","type":"text"},{"text":" ","type":"text"},{"text":"the redirect arrives at a relaunched app, ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","isActive":true},{"text":" ","type":"text"},{"text":"completes it and returns an issuance ready for","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true},{"text":". Handle every redirect this way: in","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI, from ","type":"text"},{"type":"codeVoice","code":"onOpenURL"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Wait for a deferred credential","anchor":"Wait-for-a-deferred-credential"},{"inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","isActive":true},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","isActive":true},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Look after held credentials","anchor":"Look-after-held-credentials"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","isActive":true,"type":"reference"},{"text":" lists them, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"returns one with its claims, for display. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"carries the issuer’s names, logos and colours, in the holder’s","type":"text"},{"text":" ","type":"text"},{"text":"language (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","isActive":true,"type":"reference"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","isActive":true,"type":"reference"},{"text":" checks revocation against the issuer’s","type":"text"},{"text":" ","type":"text"},{"text":"status list, which covers many credentials, so the issuer can’t tell","type":"text"},{"text":" ","type":"text"},{"text":"which one is checked.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each credential arrives as a batch of copies, each bound to its own","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true,"type":"reference"},{"text":"), so presentations can’t be","type":"text"},{"text":" ","type":"text"},{"text":"linked by the credential. When ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"reaches zero, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true,"type":"reference"},{"text":" replaces them without","type":"text"},{"text":" ","type":"text"},{"text":"the holder, if the issuance kept a refresh token","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","isActive":true,"type":"reference"},{"text":"). Otherwise it throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","isActive":true,"type":"reference"},{"text":": receive the credential again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","isActive":true,"type":"reference"},{"text":" deletes a credential and its keys,","type":"text"},{"text":" ","type":"text"},{"text":"revoking its refresh token at the issuer.","type":"text"}]}]}]}]}],"kind":"article","sections":[],"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"metadata":{"role":"article","title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"variants":[{"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Receiving credentials","generated":true,"anchor":"Receiving-credentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/abandonDeferred(id:)":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/abandondeferred(id:)","type":"topic","title":"abandonDeferred(id:)","kind":"symbol","abstract":[{"type":"text","text":"Gives up on a deferred credential — its access token has expired,"},{"type":"text","text":" "},{"type":"text","text":"say, or the holder no longer wants it — deleting it and its keys."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"abandonDeferred"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/resumeIssuance(redirect:)":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resumeIssuance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Issuance","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet8IssuanceC"}],"title":"resumeIssuance(redirect:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","abstract":[{"type":"text","text":"Completes an authorization begun before the app was suspended or"},{"type":"text","text":" "},{"type":"text","text":"relaunched: "},{"type":"codeVoice","code":"redirect"},{"type":"text","text":" is the issuer’s redirect back to the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI, delivered to the app ("},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":"). Returns the"},{"type":"text","text":" "},{"type":"text","text":"issuance ready for "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":". A redirect matching no"},{"type":"text","text":" "},{"type":"text","text":"authorization in progress — not this wallet’s, already completed,"},{"type":"text","text":" "},{"type":"text","text":"or expired — throws "},{"type":"codeVoice","code":".notFound"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/resumeissuance(redirect:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","kind":"symbol","title":"OID4VCWallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}],"role":"collection","url":"\/documentation\/oid4vcwallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredCredential","kind":"identifier"}],"title":"DeferredCredential","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","abstract":[{"type":"text","text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s"},{"type":"text","text":" "},{"type":"text","text":"kept in the credential store until it’s issued, denied or abandoned,"},{"type":"text","text":" "},{"type":"text","text":"so it survives the app quitting."}],"role":"symbol","navigatorTitle":[{"text":"DeferredCredential","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/deferredcredential"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/beginAuthorization()":{"url":"\/documentation\/oid4vcwallet\/issuance\/beginauthorization()","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"beginAuthorization"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","title":"beginAuthorization()","abstract":[{"type":"text","text":"Begins the authorization code grant, returning the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"authorization URL to open in an "},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"type":"text","text":". Calling it"},{"type":"text","text":" "},{"type":"text","text":"again begins again: after the holder closed the page, say."}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential/accessTokenExpiresAt":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","url":"\/documentation\/oid4vcwallet\/deferredcredential\/accesstokenexpiresat","type":"topic","title":"accessTokenExpiresAt","kind":"symbol","abstract":[{"type":"text","text":"When the access token it’s polled with expires, if the issuer"},{"type":"text","text":" "},{"type":"text","text":"said: after it, polls fail and it can only be abandoned."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessTokenExpiresAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/copiesLeft":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","url":"\/documentation\/oid4vcwallet\/credentialsummary\/copiesleft","type":"topic","title":"copiesLeft","kind":"symbol","abstract":[{"type":"text","text":"How many copies no Verifier has seen."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"copiesLeft"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/completeAuthorization(redirect:)":{"url":"\/documentation\/oid4vcwallet\/issuance\/completeauthorization(redirect:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"completeAuthorization"},{"kind":"text","text":"("},{"text":"redirect","kind":"externalParam"},{"kind":"text","text":": "},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"text":"throws","kind":"keyword"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","title":"completeAuthorization(redirect:)","abstract":[{"text":"Completes the authorization with the issuer’s redirect back. The","type":"text"},{"text":" ","type":"text"},{"text":"redirect is used up whatever happens: if this fails — the token","type":"text"},{"text":" ","type":"text"},{"text":"request didn’t get through, say — call ","type":"text"},{"type":"codeVoice","code":"beginAuthorization()"},{"text":" ","type":"text"},{"text":"again, rather than retrying this.","type":"text"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credentials()":{"identifier":"doc:\/\/o