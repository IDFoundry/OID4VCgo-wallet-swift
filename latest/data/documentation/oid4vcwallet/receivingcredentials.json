accesstokenexpiresat","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenExpiresAt","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation4DateV","text":"Date","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"When the access token it’s polled with expires, if the issuer"},{"type":"text","text":" "},{"type":"text","text":"said: after it, polls fail and it can only be abandoned."}],"title":"accessTokenExpiresAt","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","kind":"symbol","title":"batchSize","type":"topic","abstract":[{"text":"How many copies of each credential to request when an issuer","type":"text"},{"text":" ","type":"text"},{"text":"offers batches, each bound to its own key, so each presentation","type":"text"},{"text":" ","type":"text"},{"text":"can use one no Verifier has seen. 0 means the SDK’s default (5);","type":"text"},{"text":" ","type":"text"},{"text":"it’s capped at the issuer’s batch size.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchSize","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/requestCredentials()":{"abstract":[{"type":"text","text":"Requests, checks and stores every offered credential."}],"url":"\/documentation\/oid4vcwallet\/issuance\/requestcredentials()","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requestCredentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet8IssuanceC6ResultV","text":"Result","kind":"typeIdentifier"}],"role":"symbol","title":"requestCredentials()","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/beginAuthorization()":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","role":"symbol","kind":"symbol","title":"beginAuthorization()","type":"topic","url":"\/documentation\/oid4vcwallet\/issuance\/beginauthorization()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"beginAuthorization","kind":"identifier"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier","text":"URL"}],"abstract":[{"type":"text","text":"Begins the authorization code grant, returning the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"authorization URL to open in an "},{"type":"codeVoice","code":"ASWebAuthenticationSession"},{"type":"text","text":". Calling it"},{"type":"text","text":" "},{"type":"text","text":"again begins again: after the holder closed the page, say."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/display":{"kind":"symbol","title":"display","url":"\/documentation\/oid4vcwallet\/credentialsummary\/display","abstract":[{"type":"text","text":"How to show it, from the issuer’s metadata when it was received."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"display","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CredentialDisplay","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialDisplayV"},{"text":"?","kind":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"abstract":[{"text":"Replaces a ","type":"text"},{"code":"refreshable","type":"codeVoice"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new holder key, without the holder signing in","type":"text"},{"text":" ","type":"text"},{"text":"(OpenID4VCI 1.0 §13.5). The new holder keys sign the Credential","type":"text"},{"text":" ","type":"text"},{"text":"Request’s proof, so with ","type":"text"},{"code":"KeychainKeyStore.Options.holderUserPresence","type":"codeVoice"},{"text":" ","type":"text"},{"text":"on it asks the holder. Use it when ","type":"text"},{"code":"copiesLeft","type":"codeVoice"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","role":"symbol","title":"refreshCredential(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requestRefresh":{"kind":"symbol","title":"requestRefresh","abstract":[{"text":"Asks Authorization Servers for a refresh token, so","type":"text"},{"text":" ","type":"text"},{"code":"Wallet.refreshCredential(id:)","type":"codeVoice"},{"text":" can later replace a credential’s","type":"text"},{"text":" ","type":"text"},{"text":"copies without the holder signing in. The server must allow the","type":"text"},{"text":" ","type":"text"},{"text":"wallet the ","type":"text"},{"code":"offline_access","type":"codeVoice"},{"text":" scope, or the authorization fails.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestRefresh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderUserPresence":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderuserpresence","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderUserPresence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Require user presence (Face ID, Touch ID or the passcode) for"},{"type":"text","text":" "},{"type":"text","text":"every signature with a holder key: to present a credential,"},{"type":"text","text":" "},{"type":"text","text":"and to sign the Credential Request’s jwt proofs, so receiving"},{"type":"text","text":" "},{"type":"text","text":"and refreshing credentials ask too — once per copy"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true,"type":"reference"},{"type":"text","text":"), or once per Credential"},{"type":"text","text":" "},{"type":"text","text":"Request when its jwt proof carries a key attestation, and"},{"type":"text","text":" "},{"type":"text","text":"again if the issuer refuses the nonce — and a refresh can’t"},{"type":"text","text":" "},{"type":"text","text":"run without the holder. The Secure Enclave"},{"type":"text","text":" "},{"type":"text","text":"enforces it. Off, the app asks for it itself (with"},{"type":"text","text":" "},{"code":"LAContext.evaluatePolicy","type":"codeVoice"},{"type":"text","text":") before every presentation — in"},{"type":"text","text":" "},{"type":"text","text":"the app, from a link, through a document provider extension,"},{"type":"text","text":" "},{"type":"text","text":"and in person — a check the app’s own code keeps, not the"},{"type":"text","text":" "},{"type":"text","text":"key. For Face ID, the app’s Info.plist must have an"},{"type":"text","text":" "},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"type":"text","text":"; without one, iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead."}],"title":"holderUserPresence","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderUserPresence"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","role":"collection","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","title":"OID4VCWallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deleteCredential(id:)":{"abstract":[{"text":"Deletes a credential and its holder keys, and its refresh grant","type":"text"},{"text":" ","type":"text"},{"text":"once no other credential uses it, first revoking the refresh token","type":"text"},{"text":" ","type":"text"},{"text":"at the Authorization Server, best effort.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deleteCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/deletecredential(id:)","role":"symbol","title":"deleteCredential(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/close()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"close","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/oid4vcwallet\/issuance\/close()","kind":"symbol","title":"close()","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","abstract":[{"type":"text","text":"Ends the issuance, deleting its keys but those its deferred"},{"type":"text","text":" "},{"type":"text","text":"credentials still poll with."}],"role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/completeAuthorization(redirect:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"completeAuthorization","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":") ","kind":"text"},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[{"type":"text","text":"Completes the authorization with the issuer’s redirect back. The"},{"type":"text","text":" "},{"type":"text","text":"redirect is used up whatever happens: if this fails — the token"},{"type":"text","text":" "},{"type":"text","text":"request didn’t get through, say — call "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":" "},{"type":"text","text":"again, rather than retrying this."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","url":"\/documentation\/oid4vcwallet\/issuance\/completeauthorization(redirect:)","title":"completeAuthorization(redirect:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"abstract":[{"text":"Fetches the issuer’s status list for a credential, and an mdoc’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier list, checks their signatures, and returns the","type":"text"},{"text":" ","type":"text"},{"text":"credential with its revocation status recorded. Each list covers","type":"text"},{"text":" ","type":"text"},{"text":"many credentials, so fetching it doesn’t tell the issuer which","type":"text"},{"text":" ","type":"text"},{"text":"one is checked. A credential without a status or identifier list","type":"text"},{"text":" ","type":"text"},{"text":"is returned as it is. Revocation is final: a credential found","type":"text"},{"text":" ","type":"text"},{"text":"revoked stays so, its lists not fetched again, until the revoked","type":"text"},{"text":" ","type":"text"},{"text":"copy expires or the credential is refreshed.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkStatus"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"CredentialSummary","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","role":"symbol","title":"checkStatus(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/copiesLeft":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","url":"\/documentation\/oid4vcwallet\/credentialsummary\/copiesleft","kind":"symbol","title":"copiesLeft","type":"topic","abstract":[{"text":"How many copies no Verifier has seen.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"copiesLeft"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer/txCode-swift.property":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","role":"symbol","kind":"symbol","title":"txCode","type":"topic","url":"\/documentation\/oid4vcwallet\/offer\/txcode-swift.property",