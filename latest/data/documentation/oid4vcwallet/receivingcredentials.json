{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"An issuer offers credentials with an "},{"code":"openid-credential-offer:\/\/","type":"codeVoice"},{"type":"text","text":" link,"},{"type":"text","text":" "},{"type":"text","text":"as a QR code or a link the holder opens. Register the"},{"type":"text","text":" "},{"code":"openid-credential-offer","type":"codeVoice"},{"type":"text","text":" URL scheme in the app’s Info.plist so links"},{"type":"text","text":" "},{"type":"text","text":"open the app, and hand the link to "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","type":"reference","isActive":true},{"type":"text","text":". It"},{"type":"text","text":" "},{"type":"text","text":"resolves the offer and the issuer’s metadata, and returns an"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","type":"reference","isActive":true},{"type":"text","text":" whose "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","type":"reference","isActive":true},{"type":"text","text":" you show the holder: who is"},{"type":"text","text":" "},{"type":"text","text":"offering what."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The offer names one of two grants:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authorization code:"}]},{"text":" the holder signs in at the issuer’s pages, in","type":"text"},{"text":" ","type":"text"},{"text":"a browser, which redirects back to the wallet’s redirect URI.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Pre-authorized code:"}]},{"text":" the issuer has already authenticated the","type":"text"},{"text":" ","type":"text"},{"text":"holder, and may ask for a PIN it sent them separately","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Either way, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","type":"reference","isActive":true},{"type":"text","text":" then requests, checks and"},{"type":"text","text":" "},{"type":"text","text":"stores the credentials, and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","type":"reference","isActive":true},{"type":"text","text":" ends the issuance."}],"type":"paragraph"},{"anchor":"Receive-an-offer","type":"heading","level":3,"text":"Receive an offer"},{"syntax":"swift","type":"codeListing","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","type":"reference","isActive":true},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Open-the-issuers-page","text":"Open the issuer’s page","type":"heading"},{"inlineContent":[{"type":"text","text":"Open the authorization URL in an "},{"type":"codeVoice","code":"ASWebAuthenticationSession"},{"type":"text","text":", with the"},{"type":"text","text":" "},{"type":"text","text":"redirect URI’s scheme as its callback scheme. An ephemeral session"},{"type":"text","text":" "},{"type":"text","text":"keeps the issuer’s cookies out of Safari’s."}],"type":"paragraph"},{"code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the holder closes the page, the offer stays open:"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","isActive":true,"type":"reference"},{"type":"text","text":" can begin again. A redirect is used"},{"type":"text","text":" "},{"type":"text","text":"up by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)"},{"type":"text","text":" whatever happens,"},{"type":"text","text":" "},{"type":"text","text":"so after a failure there, begin again rather than retrying it."}]},{"type":"heading","anchor":"Resume-after-the-app-is-killed","text":"Resume after the app is killed","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS can terminate the app while the holder is at the issuer’s pages."},{"type":"text","text":" "},{"type":"text","text":"The authorization in progress is kept in the credential store, so when"},{"type":"text","text":" "},{"type":"text","text":"the redirect arrives at a relaunched app, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)"},{"type":"text","text":" "},{"text":"completes it and returns an issuance ready for","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true,"type":"reference"},{"type":"text","text":". Handle every redirect this way: in"},{"text":" ","type":"text"},{"type":"text","text":"SwiftUI, from "},{"code":"onOpenURL","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Wait-for-a-deferred-credential","text":"Wait for a deferred credential","level":3},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","isActive":true,"type":"reference"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","isActive":true,"type":"reference"},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"heading","anchor":"Look-after-held-credentials","text":"Look after held credentials","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","type":"reference","isActive":true},{"type":"text","text":" lists them, and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns one with its claims, for display. "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"carries the issuer’s names, logos and colours, in the holder’s"},{"type":"text","text":" "},{"type":"text","text":"language ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","type":"reference","isActive":true},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","type":"reference","isActive":true},{"type":"text","text":" checks revocation against the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"status list, which covers many credentials, so the issuer can’t tell"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Each credential arrives as a batch of copies, each bound to its own"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","type":"reference","isActive":true},{"type":"text","text":"), so presentations can’t be"},{"type":"text","text":" "},{"type":"text","text":"linked by the credential. When "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reaches zero, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"reference","isActive":true},{"type":"text","text":" replaces them without"},{"type":"text","text":" "},{"type":"text","text":"the holder, if the issuance kept a refresh token"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","type":"reference","isActive":true},{"type":"text","text":"). Otherwise it throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","type":"reference","isActive":true},{"type":"text","text":": receive the credential again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","type":"reference","isActive":true},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}],"type":"paragraph"}]}]}]}],"kind":"article","variants":[{"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"metadata":{"role":"article","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","title":"Receiving credentials"},"seeAlsoSections":[{"title":"Receiving credentials","generated":true,"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"anchor":"Receiving-credentials"}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","interfaceLanguage":"swift"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential/accessTokenExpiresAt":{"title":"accessTokenExpiresAt","url":"\/documentation\/oid4vcwallet\/deferredcredential\/accesstokenexpiresat","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","type":"topic","abstract":[{"type":"text","text":"When the access token it’s polled with expires, if the issuer"},{"type":"text","text":" "},{"type":"text","text":"said: after it, polls fail and it can only be abandoned."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenExpiresAt","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV"},{"text":"?","kind":"text"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Issuance","kind":"identifier"}],"kind":"symbol","title":"Issuance","url":"\/documentation\/oid4vcwallet\/issuance","navigatorTitle":[{"text":"Issuance","kind":"identifier"}],"abstract":[{"text":"Receives one offer’s credentials: show ","type":"text"},{"code":"offer","type":"codeVoice"},{"text":"; then","type":"text"},{"text":" ","type":"text"},{"code":"beginAuthorization()","type":"codeVoice"},{"text":", open the URL in ASWebAuthenticationSession and","type":"text"},{"text":" ","type":"text"},{"code":"completeAuthorization(redirect:)","type":"codeVoice"},{"type":"text","text":", or "},{"code":"redeemPreAuthorizedCode(pin:)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"code":"requestCredentials()","type":"codeVoice"},{"type":"text","text":"; "},{"code":"close()","type":"codeVoice"},{"type":"text","text":" when done."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startIssuance(offer:)":{"title":"startIssuance(offer:)","url":"\/documentation\/oid4vcwallet\/wallet\/startissuance(offer:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","type":"topic","abstract":[{"type":"text","text":"Resolves a Credential Offer (openid-credential-offer:\/\/…) and the"},{"type":"text","text":" "},{"type":"text","text":"issuer’s metadata."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"startIssuance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"offer","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Issuance","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet8IssuanceC"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credentials()":{"title":"credentials()","url":"\/documentation\/oid4vcwallet\/wallet\/credentials()","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","type":"topic","abstract":[{"type":"text","text":"Every credential the wallet holds."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"CredentialSummary","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"title":"Offer","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","type":"topic","abstract":[{"text":"What a Credential Offer offers.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Offer"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/offer","navigatorTitle":[{"kind":"identifier","text":"Offer"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credential(id:)":{"title":"credential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/credential(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","type":"topic","abstract":[{"type":"text","text":"One credential with its claims."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CredentialDetail","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16CredentialDetailV"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/checkStatus(id:)":{"title":"checkStatus(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/checkstatus(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","type":"topic","abstract":[{"type":"text","text":"Fetches the issuer’s status list for a credential, checks its"},{"type":"text","text":" "},{"type":"text","text":"signature, and returns the credential with its revocation status"},{"type":"text","text":" "},{"type":"text","text":"recorded. The list covers many credentials, so fetching it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t tell the issuer which one is checked. A credential without"},{"type":"text","text":" "},{"type":"text","text":"a status list is returned as it is."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkStatus","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CredentialSummary","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/completeAuthorization(redirect:)":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"completeAuthorization","kind":"identifier"},{"text":"(","kind":"text"},{"text":"redirect","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","title":"completeAuthorization(redirect:)","url":"\/documentation\/oid4vcwallet\/issuance\/completeauthorization(redirect:)","abstract":[{"type":"text","text":"Completes the authorization with the issuer’s redirect back. The"},{"type":"text","text":" "},{"type":"text","text":"redirect is used up whatever happens: if this fails — the token"},{"type":"text","text":" "},{"text":"request didn’t get through, say — call ","type":"text"},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":" "},{"type":"text","text":"again, rather than retrying this."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer/txCode-swift.property":{"fragments":