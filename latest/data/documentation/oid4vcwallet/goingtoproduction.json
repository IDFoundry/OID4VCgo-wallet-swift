ntifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Asks Authorization Servers for a refresh token, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"Wallet.refreshCredential(id:)"},{"type":"text","text":" can later replace a credential’s"},{"type":"text","text":" "},{"type":"text","text":"copies without the holder. The server must allow the wallet the"},{"type":"text","text":" "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" scope, or the authorization fails."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","title":"KeychainKeyStore","type":"topic","kind":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"type":"codeVoice","code":"Options.tagPrefix"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration","abstract":[{"type":"te