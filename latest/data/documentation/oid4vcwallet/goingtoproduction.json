ineContent":[{"type":"text","text":"To pin your services’ certificates, set"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins"},{"type":"text","text":": host → base64 SHA-256 digests of a"},{"type":"text","text":" "},{"type":"text","text":"certificate’s SubjectPublicKeyInfo. Pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},{"type":"text","text":"doesn’t break the app, and keep a backup pin: a wrong set locks the"},{"type":"text","text":" "},{"type":"text","text":"wallet out of that host until an update. Pins cover the SDK’s own"},{"type":"text","text":" "},{"type":"text","text":"requests, which "},{"type":"codeVoice","code":"NSPinnedDomains"},{"type":"text","text":" doesn’t reach, not your app’s, such"},{"type":"text","text":" "},{"type":"text","text":"as to your Wallet Provider: pin that "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" yourself."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Privacy","anchor":"Privacy"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Request batches of copies ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":") and"},{"type":"text","text":" "},{"type":"text","text":"refresh them as they’re used up ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"so presentations stay unlinkable; warn the holder when one wouldn’t"},{"type":"text","text":" "},{"type":"text","text":"be ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Log "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/message"},{"type":"text","text":", never claims or credentials."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"The build","anchor":"The-build"},{"type":"paragraph","inlineContent":[{"text":"Ship the release build of ","type":"text"},{"type":"codeVoice","code":"Mobile"},{"text":", which the package links by default.","type":"text"},{"text":" ","type":"text"},{"text":"Refuse to run on the test build, which carries an in-process issuer and","type":"text"},{"text":" ","type":"text"},{"text":"Verifier: check ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","type":"reference","isActive":true},{"text":" at launch.","type":"text"}]},{"type":"heading","level":3,"text":"A document provider extension","anchor":"A-document-provider-extension"},{"type":"paragraph","inlineContent":[{"text":"The app and its extension each update a credential’s record — marking","type":"text"},{"text":" ","type":"text"},{"text":"a copy presented, replacing copies on refresh — with a lock that spans","type":"text"},{"text":" ","type":"text"},{"text":"only their own process. Refresh credentials when the app becomes","type":"text"},{"text":" ","type":"text"},{"text":"active, not while it’s in the background, so the two don’t write the","type":"text"},{"text":" ","type":"text"},{"text":"same record at once.","type":"text"}]}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Article","title":"Going to production","role":"article","modules":[{"name":"OID4VCWallet"}]},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/message":{"title":"message","kind":"symbol","role":"symbol","abstract":[{"text":"Detail for logs: at most 300 characters, with no persona