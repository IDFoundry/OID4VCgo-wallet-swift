etConfiguration/mdocReaderRoots":{"kind":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","abstract":[{"text":"PEM certificates: the mdoc readers recognized when one signs an","type":"text"},{"text":" ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" request (","type":"text"},{"code":"MdocPresentation.Request.reader","type":"codeVoice"},{"text":"). Empty:","type":"text"},{"text":" ","type":"text"},{"text":"every such request is shown by its origin.","type":"text"}],"title":"mdocReaderRoots","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocReaderRoots"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/sweepOrphanedKeys(in:)":{"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/sweeporphanedkeys(in:)","title":"sweepOrphanedKeys(in:)","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sweepOrphanedKeys"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KeychainKeyStore","preciseIdentifier":"s:12OID4VCWallet16KeychainKeyStoreC"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"abstract":[{"type":"text","text":"Deletes every key in "},{"type":"codeVoice","code":"keyStore"},{"type":"text","text":" that none of the wallet’s"},{"type":"text","text":" "},{"type":"