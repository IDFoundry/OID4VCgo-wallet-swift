{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/oid4vcwallet\/goingtoproduction"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Going to production","role":"article","modules":[{"name":"OID4VCWallet"}]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A wallet holding real credentials is only as trustworthy as the","type":"text"},{"text":" ","type":"text"},{"text":"platform it runs on. The package enforces some of this itself: without","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","type":"reference"},{"text":", receiving credentials needs a key","type":"text"},{"text":" ","type":"text"},{"text":"store and a credential store that both say they’re durable","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore\/isDurable","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/isDurable","type":"reference"},{"text":"), and services on","type":"text"},{"text":" ","type":"text"},{"text":"loopback addresses are refused. The rest is the app’s.","type":"text"}]},{"type":"heading","level":3,"text":"Keys and storage","anchor":"Keys-and-storage"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true,"type":"reference"},{"text":"’s defaults: keys in the Secure Enclave,","type":"text"},{"text":" ","type":"text"},{"text":"persistent, and holder keys asking for Face ID, Touch ID or the","type":"text"},{"text":" ","type":"text"},{"text":"passcode before each presentation. Add ","type":"text"},{"code":"NSFaceIDUsageDescription","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"the Info.plist.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","isActive":true,"type":"reference"},{"text":": complete data protection, out of backups.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryCredentialStore","isActive":true,"type":"reference"},{"text":" is for tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","isActive":true,"type":"reference"},{"text":" at launch, before any issuance,","type":"text"},{"text":" ","type":"text"},{"text":"so keys an interrupted issuance left don’t accumulate.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make one ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true,"type":"reference"},{"text":" per key store and credential store, and share it","type":"text"},{"text":" ","type":"text"},{"text":"for the app’s life. Two over the same stores don’t coordinate: both","type":"text"},{"text":" ","type":"text"},{"text":"could present the same copy of a credential, so Verifiers could link","type":"text"},{"text":" ","type":"text"},{"text":"the presentations, or redeem the same refresh token, so the","type":"text"},{"text":" ","type":"text"},{"text":"authorization server revokes the grant.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A device restored from a backup has no holder keys: its credentials","type":"text"},{"text":" ","type":"text"},{"text":"show ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/holderKeyPresent","isActive":true,"type":"reference"},{"text":" as false and can’t be","type":"text"},{"text":" ","type":"text"},{"text":"presented. Delete them, and receive them again.","type":"text"}]}]}]},{"type":"heading","level":3,"text":"The Wallet Provider","anchor":"The-Wallet-Provider"},{"type":"paragraph","inlineContent":[{"text":"Issuers trust the wallet because its Wallet Provider attests it. A","type":"text"},{"text":" ","type":"text"},{"text":"production Wallet Provider should attest a wallet and its keys only","type":"text"},{"text":" ","type":"text"},{"text":"after checking App Attest evidence that it’s talking to your genuine","type":"text"},{"text":" ","type":"text"},{"text":"app on a genuine device, and should keep its own signing key in an","type":"text"},{"text":" ","type":"text"},{"text":"HSM. The demo wallet’s provider attests anything, and is for","type":"text"},{"text":" ","type":"text"},{"text":"development only.","type":"text"}]},{"type":"heading","level":3,"text":"Trust","anchor":"Trust"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Configure only your ecosystem’s roots: ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/issuerRoots","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"for credentials, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","isActive":true,"type":"reference"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"Verifiers the wallet answers, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"only for registrars, never for Verifiers or issuers, which could then","type":"text"},{"text":" ","type":"text"},{"text":"register themselves.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For readers, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true,"type":"reference"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true,"type":"reference"},{"text":" where every reader","type":"text"},{"text":" ","type":"text"},{"text":"must be a known one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Never ship with ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","isActive":true,"type":"reference"},{"text":" set.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"To pin your services’ certificates, set","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","isActive":true,"type":"reference"},{"text":": host → base64 SHA-256 digests of a","type":"text"},{"text":" ","type":"text"},{"text":"certificate’s SubjectPublicKeyInfo. Pin a CA’s key, so a leaf renewal","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t break the app, and keep a backup pin: a wrong set locks the","type":"text"},{"text":" ","type":"text"},{"text":"wallet out of that host until an update. Pins cover the SDK’s own","type":"text"},{"text":" ","type":"text"},{"text":"requests, which ","type":"text"},{"code":"NSPinnedDomains","type":"codeVoice"},{"text":" doesn’t reach, not your app’s, such","type":"text"},{"text":" ","type":"text"},{"text":"as to your Wallet Provider: pin that ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" yourself.","type":"text"}]}]}]},{"type":"heading","level":3,"text":"Privacy","anchor":"Privacy"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Request batches of copies (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","isActive":true,"type":"reference"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"text":"refresh them as they’re used up (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","isActive":true,"type":"reference"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"so presentations stay unlinkable; warn the holder when one wouldn’t","type":"text"},{"text":" ","type":"text"},{"text":"be (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true,"type":"reference"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Log ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/message","isActive":true,"type":"reference"},{"text":", never claims or credentials.","type":"text"}]}]}]},{"type":"heading","level":3,"text":"The build","anchor":"The-build"},{"type":"paragraph","inlineContent":[{"text":"Ship the release build of ","type":"text"},{"code":"Mobile","type":"codeVoice"},{"text":", which the package links by default.","type":"text"},{"text":" ","type":"text"},{"text":"Refuse to run on the test build, which carries an in-process issuer and","type":"text"},{"text":" ","type":"text"},{"text":"Verifier: check ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","type":"reference"},{"text":" at launch.","type":"text"}]},{"type":"heading","level":3,"text":"A document provider extension","anchor":"A-document-provider-extension"},{"type":"paragraph","inlineContent":[{"text":"The app and its extension each update a credential’s record — marking","type":"text"},{"text":" ","type":"text"},{"text":"a copy presented, replacing copies on refresh — with a lock that spans","type":"text"},{"text":" ","type":"text"},{"text":"only their own process. Refresh credentials when the app becomes","type":"text"},{"text":" ","type":"text"},{"text":"active, not while it’s in the background, so the two don’t write the","type":"text"},{"text":" ","type":"text"},{"text":"same record at once.","type":"text"}]}]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"abstract":[{"type":"text","text":"What a wallet needs before real holders use it."}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"type":"topic","role":"symbol","kind":"symbol","title":"mdocReaderRoots","url":"\/documentation\/oid4vcwallet\/