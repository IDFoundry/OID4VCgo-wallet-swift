symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/message","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"message"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"abstract":[{"type":"text","text":"Detail for logs: at most 300 characters, with no personal data, no"},{"type":"text","text":" "},{"type":"text","text":"remote party’s own description, and no URL’s path or query."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/development":{"abstract":[{"text":"Relaxes what production requires, for a wallet talking to services","type":"text"},{"text":" ","type":"text"},{"text":"on a development machine. Never ship an app with it set. It lets","type":"text"},{"text":" ","type":"text"},{"text":"issuers, Authorization Servers, Verifiers and status lists be on","type":"text"},{"text":" ","type":"text"},{"text":"loopback addresses, over http there too, and skips the production","type":"text"},{"text":" ","type":"text"},{"text":"checks on receiving credentials: durable stores and keys, and the","type":"text"},{"text":" ","type":"text"},{"text":"random source.","type":"text"}],"title":"development","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"development"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/development"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore","abstract":[{"text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys","type":"text"},{"text":" ","type":"text"},{"text":"whose private halves never leave the Security framework. Each key’s","type":"text"},{"text":" ","type":"text"},{"text":"ID is its Keychain application tag (after ","type":"text"},{"code":"Options.tagPrefix","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"text":"its label names its purpose. Holder keys also agree keys (ECDH), for","type":"text"},{"text":" ","type":"text"},{"text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can, with nothing asked of it at creation.","type":"text"}],"title":"KeychainKeyStore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/tlsPins":{"kind":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/tlspins","abstract":[{"type":"text","text":"Pins hosts’ certificates for the wallet’s own HTTPS requests:"},{"type":"text","text":" "},{"type":"text","text":"host → base64 SHA-256 digests of a certificate’s"},{"type":"text","text":" "},{"type":"text","text":"SubjectPublicKeyInfo, one of which a certificate in the verified"},{"text":" ","type":"text"},{"type":"text","text":"chain must have, or the request fails as "},{"code":"tlsPin","type":"codeVoice"},{"type":"text","text":" before anything"},{"type":"text","text":" "},{"type":"text","text":"is sent. A host is a name, or "},{"code":"*.","type":"codeVoice"},{"type":"text","text":" and one, matching any name a"},{"text":" ","type":"text"},{"type":"text","text":"label below it; not an IP address. Pins add to certificate"},{"text":" ","type":"text"},{"type":"text","text":"verification, never replace it: pin a CA’s key, so a leaf renewal"},{"text":" ","type":"text"},{"text":"doesn’t break the app, and keep a backup pin. They cover the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"requests the SDK makes (issuers, Authorization Servers,"},{"text":" ","type":"text"},{"type":"text","text":"Verifiers, status lists), not the app’s own, such as to its"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider: pin that client yourself."}],"title":"tlsPins","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"tlsPins"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]]"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Wallet","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/wallet","abstract":[{"text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,","type":"text"},{"text":" ","type":"text"},{"text":"credential store and Wallet Provider.","type":"text"}],"title":"Wallet","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Wallet","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore/isDurable":{"url":"\/documentation\/oid4vcwallet\/keystore\/isdurable","kind":"symbol","title":"isDurable","type":"topic","required":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore\/isDurable","role":"symbol","defaultImplementations":1,"fragments":[{"kind":"keyword","text":"var"},{"kind":"text