nce","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"with Apple App Attest ("},{"type":"codeVoice","code":"apple-app-attest"},{"type":"text","text":") as its evidence:"}],"title":"HttpWalletProvider","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"navigatorTitle":[{"text":"HttpWalletProvider","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryInstanceRegistry":{"url":"\/documentation\/oid4vcwallet\/inmemoryinstanceregistry","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","kind":"symbol","type":"topic","title":"InMemoryInstanceRegistry","abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry"},{"text":" in memory, lost when the app quits: for tests.","type":"text"},{"type":"text","text":" "},{"text":"Every ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true},{"type":"text","text":" over the same registry shares its locks."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"InMemoryInstanceRegistry"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InstanceRegistry":{"url":"\/documentation\/oid4vcwallet\/instanceregistry","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","kind":"symbol","type":"topic","title":"InstanceRegistry","abstract":[{"type":"text","text":"Where "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" keeps the wallet’s registration, so the"},{"type":"text","text":" "},{"type":"text","text":"installation registers once, across launches. An instance ID isn’t a"},{"type":"text","text":" "},{"type":"text","text":"secret — every request naming it is signed with the registration key"},{"type":"text","text":" "},{"type":"text","text":"— but losing it loses the instance: the wallet then registers again,"},{"type":"text","text":" "},{"type":"text","text":"with a new registration key and App Attest key, and the instance keys"},{"type":"text","text":" "},{"type":"text","text":"the lost instance recorded can’t be attested again."},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" keeps it in a file;"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" is for tests. Over either, every"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" in the process registering or asserting for"},{"type":"text","text":" "},{"type":"text","text":"the same registration takes turns; over a registry of another type,"},{"type":"text","text":" "},{"type":"text","text":"a provider takes turns only with itself: keep one provider for it."}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"InstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"InstanceRegistry"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InstanceRegistry/instance()":{"required":true,"role":"symbol","url":"\/docu