cess, shares its locks, so it"},{"type":"text","text":" "},{"type":"text","text":"registers once and makes its assertions in order however many"},{"type":"text","text":" "},{"type":"text","text":"providers the app makes."}],"type":"topic","title":"FileInstanceRegistry","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileInstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"FileInstanceRegistry"}]}}}