,"text":" "},{"type":"text","text":"the same registration takes turns; over a registry of another type,"},{"type":"text","text":" "},{"type":"text","text":"a provider takes turns only with itself: keep one provider for it."}],"title":"InstanceRegistry","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"InstanceRegistry"}],"navigatorTitle":[{"kind":"identifier","text":"InstanceRegistry"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","url":"\/documentation\/oid4vcwallet\/instanceregistry"}}}