 ","kind":"text"},{"text":"InstanceRegistry","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/instanceregistry","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Where "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" keeps the wallet’s registration, so the"},{"type":"text","text":" "},{"type":"text","text":"installation registers once, across launches. An instance ID isn’t a"},{"type":"text","text":" "},{"type":"text","text":"secret — every request naming it is signed with the registration key"},{"type":"text","text":" "},{"type":"text","text":"— but losing it loses the instance: the wallet then registers again,"},{"type":"text","text":" "},{"type":"text","text":"with a new registration key and App Attest key, and the instance keys"},{"type":"text","text":" "},{"type":"text","text":"the lost instance recorded can’t be attested again."},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" keeps it in a file;"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" is for tests. Over either, every"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" in the process registering or asserting for"},{"type":"text","text":" "},{"type":"text","text":"the same registration takes turns; over a registry of another type,"},{"type":"text","text":" "},{"type":"text","text":"a provider takes turns only with itself: keep one provider for it."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","title"