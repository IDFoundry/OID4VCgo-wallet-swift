et Provider HTTP protocol, version"},{"type":"text","text":" "},{"type":"text","text":"1, that OID4VCgo’s "},{"type":"codeVoice","code":"walletprovider.Provider.Handler"},{"type":"text","text":" serves"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"reference","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"with Apple App Attest ("},{"type":"codeVoice","code":"apple-app-attest"},{"type":"text","text":") as its evidence:"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","title":"HttpWalletProvider","navigatorTitle":[{"text":"HttpWalletProvider","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InstanceRegistry":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InstanceRegistry","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/instanceregistry","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Where "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" keeps the wallet’s registration, so the"},{"type":"text","text":" "},{"type":"text","text":"installation registers once, across launches. An instance ID isn’t a"},{"type":"text","text":" "},{"type":"text","text":"secret — every request naming it is signed with the registration key"},{"type":"text","text":" "},{"type":"text","text":"— but losing it loses the instance: the wallet then registers again,"},{"type":"text","text":" "},{"type":"text","text":"with a new registration key and App Attest key, and the instance keys"},{"type":"text","text":" "},{"type":"text","text":"the lost instance recorded can’t be attested again."},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" keeps it in a file;"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" is for tests. Over either, every"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" in the process registering or asserting for"},{"type":"text","text":" "},{"type":"text","text":"the same registration takes turns; over a registry of another type,"},{"type":"text","text":" "},{"type":"text","text":"a provider takes turns only with itself: keep one provider for it."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","title":"InstanceRegistry","navigatorTitle":[{"text":"InstanceRegistry","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","role":"collection","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"title":"OID4VCWallet","kind":"symbol","url":"\/documentation\/oid4vcwallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileInstanceRegistry":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileInstanceRegistry","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/fileinstanceregistry","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" in a JSON file ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry\/url","type":"reference","isActive":true},{"type":"text","text":"), written whole and"},{"type":"text","text":" "},{"type":"text","text":"atomically, so a reader never sees part of it, and kept out of"},{"type":"text","text":" "},{"type":"text","text":"backups: a restored instance ID is useless without its registration"},{"type":"text","text":" "},{"type":"text","text":"key and App Attest key, which never leave this device. Keep one"},{"type":"text","text":" "},{"type":"text","text":"wallet process writing it. Every "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" over a"},{"type":"text","text":" "},{"type":"text","text":"registry in the same file, in this process, shares its locks, so it"},{"type":"text","text":" "},{"type":"text","text":"registers once and makes its assertions in order however many"},{"type":"text","text":" "},{"type":"text","text":"providers the app makes."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","title":"FileInstanceRegistry","navigatorTitle":[{"text":"FileInstanceRegistry","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileInstanceRegistry/url":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry\/url","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"url","kind":"identifier"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"}],"role":"symbol","abstract":[{"type":"text","text":"The file the registration is kept in; its directory is made if"},{"type":"text","text":" "},{"type":"text","text":"missing."}],"title":"url","kind":"symbol","url":"\/documentation\/oid4vcwallet\/fileinstanceregistry\/url"}}}