{"kind":"symbol","abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"reference","isActive":true},{"text":" over the Wallet Provider HTTP protocol, version","type":"text"},{"text":" ","type":"text"},{"text":"1, that OID4VCgo’s ","type":"text"},{"code":"walletprovider.Provider.Handler","type":"codeVoice"},{"text":" serves","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"reference","isActive":true},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"with Apple App Attest (","type":"text"},{"code":"apple-app-attest","type":"codeVoice"},{"text":") as its evidence:","type":"text"}],"sections":[],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/init(baseURL:instances:registrationKeys:appAttest:timeout:)"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/sweepOrphanedRegistrationKeys()","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/defaultTimeout","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyTagPrefix"]},{"generated":true,"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()"]}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The installation registers once, at its first Wallet Attestation:"},{"type":"text","text":" "},{"type":"text","text":"over a "},{"type":"codeVoice","code":"registration"},{"type":"text","text":" challenge, it makes a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"registration key"}]},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"key store of its own ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","type":"reference","isActive":true},{"type":"text","text":") and an App Attest"},{"type":"text","text":" "},{"type":"text","text":"key, has Apple attest the App Attest key over the client data"},{"type":"text","text":" "},{"type":"text","text":"naming the registration key, registers both ("},{"type":"codeVoice","code":"POST \/v1\/instances"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and keeps the instance ID and the two keys’ IDs in its"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","type":"reference","isActive":true},{"type":"text","text":". The registration key signs every later"},{"type":"text","text":" "},{"type":"text","text":"request ("},{"type":"codeVoice","code":"Wallet-Provider-Request"},{"type":"text","text":"); no attestation names it. If"},{"type":"text","text":" "},{"type":"text","text":"the registration, its key or the App Attest key is lost, the next"},{"type":"text","text":" "},{"type":"text","text":"Wallet Attestation registers again, with new keys. An App Attest"},{"text":" ","type":"text"},{"text":"key a registration made but couldn’t register — App Attest’s","type":"text"},{"text":" ","type":"text"},{"text":"server or the provider unavailable, or no connection — is kept, in","type":"text"},{"text":" ","type":"text"},{"text":"this process, and tried again by the next registration, as Apple","type":"text"},{"text":" ","type":"text"},{"text":"asks; it’s dropped when the provider or App Attest refuses it.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)","type":"reference"},{"type":"text","text":" asks for a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the instance key ("},{"type":"codeVoice","code":"instance_key"},{"type":"text","text":"). The first time,"},{"type":"text","text":" "},{"type":"text","text":"it sends an App Attest assertion over a fresh "},{"type":"codeVoice","code":"instance"},{"type":"text","text":" challenge"},{"type":"text","text":" "},{"type":"text","text":"and the key, which the provider records the key with; once it has,"},{"type":"text","text":" "},{"type":"text","text":"the key alone — and the assertion again if the provider no longer"},{"type":"text","text":" "},{"type":"text","text":"has its record ("},{"type":"codeVoice","code":"evidence_required"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","isActive":true,"type":"reference"},{"type":"text","text":" asks for a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation over the holder keys, with one assertion over a"},{"type":"text","text":" "},{"type":"codeVoice","code":"holder"},{"type":"text","text":" challenge and all of them, for the issuance of its"},{"type":"text","text":" "},{"type":"text","text":"instance key, which a Wallet Attestation recorded."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"App Attest attests the app, not the wallet’s keys: the provider"},{"type":"text","text":" "},{"text":"learns that a genuine copy of the app on a genuine Apple device asked","type":"text"},{"text":" ","type":"text"},{"text":"for them, not where they are. Make them in the Secure Enclave all the","type":"text"},{"text":" ","type":"text"},{"text":"same (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true,"type":"reference"},{"text":"‘s default). Where App Attest isn’t","type":"text"},{"text":" ","type":"text"},{"text":"supported — the Simulator, some older devices — the wallet can’t","type":"text"},{"text":" ","type":"text"},{"text":"register, and every attestation fails as ","type":"text"},{"code":".platform","type":"codeVoice"},{"text":": there’s no","type":"text"},{"text":" ","type":"text"},{"text":"unattested path, in development either. A development build (the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.developer.devicecheck.appattest-environment","type":"codeVoice"},{"text":" entitlement","type":"text"},{"text":" ","type":"text"},{"text":"set to ","type":"text"},{"code":"development","type":"codeVoice"},{"text":") makes development-environment keys, which only","type":"text"},{"text":" ","type":"text"},{"text":"a provider configured for them accepts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Assertions are made one at a time, each sent before the next is made,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as the provider accepts only an assertion whose counter exceeds the"},{"type":"text","text":" "},{"text":"last it took, and the installation registers once. Every","type":"text"},{"text":" ","type":"text"},{"code":"HttpWalletProvider","type":"codeVoice"},{"text":" over the same ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference","isActive":true},{"text":" file (or","type":"text"},{"text":" ","type":"text"},{"text":"the same ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference","isActive":true},{"text":") in the process shares that","type":"text"},{"text":" ","type":"text"},{"text":"order, so a wallet rebuilt mid-issuance with a new provider is still","type":"text"},{"text":" ","type":"text"},{"text":"serialised with the old one. Over a registry of its own type, a","type":"text"},{"text":" ","type":"text"},{"text":"provider serialises only its own calls: keep one provider for it.","type":"text"}]},{"inlineContent":[{"text":"It sends nothing but to its base URL, over https, following no","type":"text"},{"text":" ","type":"text"},{"text":"redirect, with its timeout for each request, and reads at most","type":"text"},{"text":" ","type":"text"},{"text":"256 KiB of an answer. It checks a Wallet Attestation is for the","type":"text"},{"text":" ","type":"text"},{"text":"client and the instance key, and a Key Attestation is over the nonce","type":"text"},{"text":" ","type":"text"},{"text":"sent and attests only keys sent; their signatures are the issuer’s to","type":"text"},{"text":" ","type":"text"},{"text":"verify.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Failures reach the wallet as ","type":"text"},{"type":"codeVoice","code":"WalletError"},{"text":"s: one the network or the","type":"text"},{"text":" ","type":"text"},{"text":"provider’s availability caused (no connection, a timeout, HTTP 5xx or","type":"text"},{"text":" ","type":"text"},{"text":"429, a challenge that expired before it was used, App Attest’s server","type":"text"},{"text":" ","type":"text"},{"text":"unavailable) as ","type":"text"},{"code":".network","type":"codeVoice"},{"text":", which may be retried","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","isActive":true,"type":"reference"},{"text":"); a refusal","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError","isActive":true,"type":"reference"},{"text":") as ","type":"text"},{"code":".platform","type":"codeVoice"},{"text":", its ","type":"text"},{"code":"protocolError","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the protocol’s error code (","type":"text"},{"type":"codeVoice","code":"instance_not_active"},{"type":"text","text":", "},{"type":"codeVoice","code":"instance_revoked"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_signed_request"},{"type":"text","text":", …), which "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" explains to"},{"type":"text","text":" "},{"type":"text","text":"the holder. On "},{"type":"codeVoice","code":"instance_revoked"},{"type":"text","text":", it forgets the"},{"type":"text","text":" "},{"type":"text","text":"registration and deletes its registration key: the next Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation registers the installation again. The revoked instance’s"},{"type":"text","text":" "},{"type":"text","text":"instance keys stay its own ("},{"type":"codeVoice","code":"instance_key_registered"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"credential whose refresh needs one must be received again. On"},{"text":" ","type":"text"},{"code":"instance_not_active","type":"codeVoice"},{"text":" (suspended) it keeps the registration: tell the","type":"text"},{"text":" ","type":"text"},{"text":"holder, as the provider may resume it. A signed request refused as","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_signed_request"},{"type":"text","text":" isn’t retried: check the device’s clock, and"},{"type":"text","text":" "},{"type":"text","text":"that the provider still knows the instance."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/httpwalletprovider"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","interfaceLanguage":"swift"},"metadata":{"symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"HttpWalletProvider"}],"modules":[{"name":"OID4VCWallet"}],"role":"symbol","roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HttpWalletProvider"}],"externalID":"s:12OID4VCWallet18HttpWalletProviderC","title":"HttpWalletProvider"},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"kind":"article","abstract":[{"text":"What a wallet needs before real holders use it.","type":"text"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/goingtoproduction","role":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","title":"Going to production"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/keyAttestation(instanceKey:keys:nonce:)":{"role":"symbol","type":"topic","title":"keyAttestation(instanceKey:keys:nonce:)","abstract":[{"text":"A Key At