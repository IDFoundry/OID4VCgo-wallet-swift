equest for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"title":"Presenting to Safari","kind":"article","url":"\/documentation\/oid4vcwallet\/presentingtosafari"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/defaultTimeout":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/defaultTimeout","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"defaultTimeout"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier","text":"TimeInterval"}],"role":"symbol","abstract":[{"text":"The default timeout of each request, as the Go client’s.","type":"text"}],"title":"defaultTimeout","kind":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/defaulttimeout"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/keyAttestation(instanceKey:keys:nonce:)":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyAttestation","kind":"identifier"},{"kind":"text","text":"("},{"text":"instanceKey","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":", ","kind":"text"},{"text":"keys","kind":"externalParam"},{"kind":"text","text":": ["},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":"], ","kind":"text"},{"text":"nonce","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"type":"text","text":"A Key Attestation over "},{"code":"keys","type":"codeVoice"},{"type":"text","text":", for the issuance of "},{"code":"instanceKey","type":"codeVoice"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"with one assertion over a "},{"code":"holder","type":"codeVoice"},{"type":"text","text":" challenge and every key, signed"},{"text":" ","type":"text"},{"type":"text","text":"with the registration key."}],"title":"keyAttestation(instanceKey:keys:nonce:)","kind":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/keyattestation(instancekey:keys:nonce:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InstanceRegistry":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InstanceRegistry","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/instanceregistry","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Where "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" keeps the wallet’s registration, so the"},{"type":"text","text":" "},{"type":"text","text":"installation registers once, across launches. An instance ID isn’t a"},{"type":"text","text":" "},{"type":"text","text":"secret — every request naming it is signed with the registration key"},{"type":"text","text":" "},{"type":"text","text":"— but losing it loses the instance: the wallet then registers again,"},{"type":"text","text":" "},{"type":"text","text":"with a new registration key and App Attest key, and the instance keys"},{"type":"text","text":" "},{"type":"text","text":"the lost instance recorded can’t be attested again."},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" keeps it in a file;"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" is for tests. Over either, every"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" in the process registering or asserting for"},{"type":"text","text":" "},{"type":"text","text":"the same registration takes turns; over a registry of another type,"},{"type":"text","text":" "},{"type":"text","text":"a provider takes turns only with itself: keep one provider for it."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","title":"InstanceRegistry","navigatorTitle":[{"text":"InstanceRegistry","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderUnavailableError":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProviderUnavailableError","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletproviderunavailableerror","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The Wallet Provider couldn’t answer — HTTP 5xx or 429 — or the"},{"type":"text","text":" "},{"type":"text","text":"challenge a request named expired or was used before it arrived"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"invalid_challenge"},{"type":"text","text":"), or App Attest’s server is unavailable. It"},{"type":"text","text":" "},{"type":"text","text":"reaches the wallet as "},{"type":"codeVoice","code":".network"},{"type":"text","text":": try again, which gets new"},{"type":"text","text":" "},{"type":"text","text":"challenges."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError","title":"WalletProviderUnavailableError","navigatorTitle":[{"text":"WalletProviderUnavailableError","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileInstanceRegistry":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileInstanceRegistry","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/fileinstanceregistry","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" in a JSON file ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry\/url","type":"reference","isActive":true},{"type":"text","text":"), written whole and"},{"type":"text","text":" "},{"type":"text","text":"atomically, so a reader never sees part of it, and kept out of"},{"type":"text","text":" "},{"type":"text","text":"backups: a restored instance ID is useless without its registration"},{"type":"text","text":" "},{"type":"text","text":"key and App Attest key, which never leave this device. Keep one"},{"type":"text","text":" "},{"type":"text","text":"wallet process writing it. Every "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" over a"},{"type":"text","text":" "},{"type":"text","text":"registry in the same file, in this process, shares its locks, so it"},{"type":"text","text":" "},{"type":"text","text":"registers once and makes its assertions in order however many"},{"type":"text","text":" "},{"type":"text","text":"providers the app makes."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","title":"FileInstanceRegistry","navigatorTitle":[{"text":"FileInstanceRegistry","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/sweepOrphanedRegistrationKeys()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sweepOrphanedRegistrationKeys","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/sweeporphanedregistrationkeys()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Deletes every key in the registration key store but the kept"},{"type":"text","text":" "},{"type":"text","text":"registration’s, and returns how many it deleted: the keys of"},{"type":"text","text":" "},{"type":"text","text":"registrations that never finished — the app ended in the middle"},{"type":"text","text":" "},{"type":"text","text":"of one, or was deleted and installed again, which keeps its"},{"type":"text","text":" "},{"type":"text","text":"Keychain items but not its registry — which nothing else"},{"type":"text","text":" "},{"type":"text","text":"deletes. Call it at launch. It takes its turn with registrations"},{"type":"text","text":" "},{"type":"text","text":"over the same registry, so it never deletes the key of one in"},{"type":"text","text":" "},{"type":"text","text":"progress."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/sweepOrphanedRegistrationKeys()","title":"sweepOrphanedRegistrationKeys()"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderRefusedError":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProviderRefusedError"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/walletproviderrefusederror","title":"WalletProviderRefusedError","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError","abstract":[{"type":"text","text":"The Wallet Provider refused a request with one of the protocol’s"},{"type":"text","text":" "},{"type":"text","text":"errors, or answered other than the protocol documents (a redirect, a"},{"type":"text","text":" "},{"type":"text","text":"path it doesn’t serve). It reaches the wallet as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", its"},{"type":"text","text":" "},{"type":"codeVoice","code":"protocolError"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError\/error","isActive":true},{"type":"text","text":" when there is one. An app’s own"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","isActive":true},{"type":"text","text":" may throw it too, for the same."}],"navigatorTitle":[{"kind":"identifier","text":"WalletProviderRefusedError"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/httpwalletprovider","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"reference","isActive":true},{"type":"text","text":" over the Wallet Provider HTTP protocol, version"},{"type":"text","text":" "},{"type":"text","text":"1, that OID4VCgo’s "},{"type":"codeVoice","code":"walletprovider.Provider.Handler"},{"type":"text","text":" serves"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"reference","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"with Apple App Attest ("},{"type":"codeVoice","code":"apple-app-attest"},{"type":"text","text":") as its evidence:"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","title":"HttpWalletProvider","navigatorTitle":[{"text":"HttpWalletProvider","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/keychainkeystore","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"type":"codeVoice","code":"Options.tagPrefix"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","title":"KeychainKeyStore","navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Wallet"}],"role":"symbol","abstract":[{"text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,","type":"text"},{"text":" ","type":"text"},{"text":"credential store and Wallet Provider.","type":"text"}],"title":"Wallet","kind":"symbol","navigatorTitle":[{"text":"Wallet","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/wallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderRefusedError/error":{"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"error"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/walletproviderrefusederror\/error","title":"error","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError\/error","abstract":[{"type":"text","text":"The protocol’s error code ("},{"type":"codeVoice","code":"evidence_rejected"},{"type":"text","text":", "},{"type":"codeVoice","code":"instance_revoked"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"unknown_instance_key"},{"type":"text","text":", …), or nil when the answer had none."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/sweepOrphanedKeys(in:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sweepOrphanedKeys","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KeychainKeyStore","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16KeychainKeyStoreC"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/oid4vcwallet\/wallet\/sweeporphanedkeys(in:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Deletes every key in "},{"type":"codeVoice","code":"keyStore"},{"type":"text","text":" that none of the wallet’s"},{"type":"text","text":" "},{"type":"text","text":"credentials is bound to — left by an issuance the app quit or"},{"type":"text","text":" "},{"type":"text","text":"crashed in the middle of — and returns how many. Call it at launch,"},{"type":"text","text":" "},{"type":"text","text":"before any issuance or refresh: one in progress holds keys of its"},{"type":"text","text":" "},{"type":"text","text":"own."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","title":"sweepOrphanedKeys(in:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProvider"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/walletprovider","title":"WalletProvider","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"navigatorTitle":[{"kind":"identifier","text":"WalletProvider"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletConfiguration"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration","abstract":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},{"text":"’s configuration.","type":"text"}],"title":"WalletConfiguration","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WalletConfiguration"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/walletAttestation(clientID:instanceKey:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"walletAttestation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"clientID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"instanceKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/walletattestation(clientid:instancekey:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A Wallet Attestation for "},{"type":"codeVoice","code":"clientID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"instanceKey"},{"type":"text","text":", registering"},{"type":"text","text":" "},{"type":"text","text":"the installation first if it isn’t yet, with an assertion for the"},{"type":"text","text":" "},{"type":"text","text":"key unless the provider recorded it already."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)","title":"walletAttestation(clientID:in