tProvider\/registrationKeyStore()"],"anchor":"Type-Methods"}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"sections":[],"abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"reference","isActive":true},{"text":" over the Wallet Provider HTTP protocol, version","type":"text"},{"text":" ","type":"text"},{"text":"1, that OID4VCgo’s ","type":"text"},{"code":"walletprovider.Provider.Handler","type":"codeVoice"},{"text":" serves","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"reference","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"with Apple App Attest ("},{"type":"codeVoice","code":"apple-app-attest"},{"type":"text","text":") as its evidence:"}],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"],"anchor":"Essentials"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The installation registers once, at its first Wallet Attestation:"},{"type":"text","text":" "},{"type":"text","text":"over a "},{"code":"registration","type":"codeVoice"},{"type":"text","text":" challenge, it makes a "},{"inlineContent":[{"text":"registration key","type":"text"}],"type":"emphasis"},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"key store of its own ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()"},{"type":"text","text":") and an App Attest"},{"type":"text","text":" "},{"type":"text","text":"key, has Apple attest the App Attest key over the client data"},{"type":"text","text":" "},{"type":"text","text":"naming the registration key, registers both ("},{"code":"POST \/v1\/instances","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and keeps the instance ID and the two keys’ IDs in its"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry"},{"type":"text","text":". The registration key signs every later"},{"type":"text","text":" "},{"type":"text","text":"request ("},{"code":"Wallet-Provider-Request","type":"codeVoice"},{"type":"text","text":"); no attestation names it. If"},{"type":"text","text":" "},{"type":"text","text":"the registration, its key or the App Attest key is lost, the next"},{"type":"text","text":" "},{"type":"text","text":"Wallet Attestation registers again, with new keys. An App Attest"},{"type":"text","text":" "},{"type":"text","text":"key a registration made but couldn’t register — App Attest’s"},{"type":"text","text":" "},{"type":"text","text":"server or the provider unavailable, or no connection — is kept, in"},{"type":"text","text":" "},{"type":"text","text":"this process, and tried again by the next registration, as Apple"},{"type":"text","text":" "},{"type":"text","text":"asks; it’s dropped when the provider or App Attest refuses it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)"},{"type":"text","text":" asks for a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the instance key ("},{"code":"instance_key","type":"codeVoice"},{"type":"text","text":"). The first time,"},{"type":"text","text":" "},{"type":"text","text":"it sends an App Attest assertion over a fresh "},{"code":"instance","type":"codeVoice"},{"type":"text","text":" challenge"},{"type":"text","text":" "},{"type":"text","text":"and the key, which the provider records the key with; once it has,"},{"type":"text","text":" "},{"type":"text","text":"the key alone — and the assertion again if the provider no longer"},{"type":"text","text":" "},{"type":"text","text":"has its record ("},{"code":"evidence_required","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","isActive":true},{"text":" asks for a Key","type":"text"},{"text":" ","type":"text"},{"text":"Attestation over the holder keys, with one assertion over a","type":"text"},{"text":" ","type":"text"},{"code":"holder","type":"codeVoice"},{"type":"text","text":" challenge and all of them, for the issuance of its"},{"type":"text","text":" "},{"type":"text","text":"instance key, which a Wallet Attestation recorded."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"App Attest attests the app, not the wallet’s keys: the provider"},{"type":"text","text":" "},{"type":"text","text":"learns that a genuine copy of the app on a genuine Apple device asked"},{"type":"text","text":" "},{"type":"text","text":"for them, not where they are. Make them in the Secure Enclave all the"},{"type":"text","text":" "},{"type":"text","text":"same ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true,"type":"reference"},{"type":"text","text":"‘s default). Where App Attest isn’t"},{"type":"text","text":" "},{"type":"text","text":"supported — the Simulator, some older devices — the wallet can’t"},{"type":"text","text":" "},{"type":"text","text":"register, and every attestation fails as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":": there’s no"},{"type":"text","text":" "},{"type":"text","text":"unattested path, in development either. A development build (the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"type":"text","text":" entitlement"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"type":"codeVoice","code":"development"},{"type":"text","text":") makes development-environment keys, which only"},{"type":"text","text":" "},{"type":"text","text":"a provider configured for them accepts."}]},{"type":"paragraph","inlineContent":[{"text":"Assertions are made one at a time, each sent before the next is made,","type":"text"},{"text":" ","type":"text"},{"text":"as the provider accepts only an assertion whose counter exceeds the","type":"text"},{"text":" ","type":"text"},{"text":"last it took, and the installation registers once. Every","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HttpWalletProvider"},{"text":" over the same ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference"},{"text":" file (or","type":"text"},{"text":" ","type":"text"},{"text":"the same ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference"},{"text":") in the process shares that","type":"text"},{"text":" ","type":"text"},{"text":"order, so a wallet rebuilt mid-issuance with a new provider is still","type":"text"},{"text":" ","type":"text"},{"text":"serialised with the old one. Over a registry of its own type, a","type":"text"},{"text":" ","type":"text"},{"text":"provider serialises only its own calls: keep one provider for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It sends nothing but to its base URL, over https, following no"},{"type":"text","text":" "},{"type":"text","text":"redirect, with its timeout for each request, and reads at most"},{"type":"text","text":" "},{"type":"text","text":"256 KiB of an answer. It checks a Wallet Attestation is for the"},{"type":"text","text":" "},{"type":"text","text":"client and the instance key, and a Key Attestation is over the nonce"},{"type":"text","text":" "},{"type":"text","text":"sent and attests only keys sent; their signatures are the issuer’s to"},{"type":"text","text":" "},{"type":"text","text":"verify."}]},{"type":"paragraph","inlineContent":[{"text":"Failures reach the wallet as ","type":"text"},{"code":"WalletError","type":"codeVoice"},{"text":"s: one the network or the","type":"text"},{"text":" ","type":"text"},{"text":"provider’s availability caused (no connection, a timeout, HTTP 5xx or","type":"text"},{"text":" ","type":"text"},{"text":"429, a challenge that expired before it was used, App Attest’s server","type":"text"},{"text":" ","type":"text"},{"text":"unavailable) as ","type":"text"},{"code":".network","type":"codeVoice"},{"text":", which may be retried","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError"},{"text":"); a refusal","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"},{"text":") as ","type":"text"},{"code":".platform","type":"codeVoice"},{"text":", its message naming the","type":"text"},{"text":" ","type":"text"},{"text":"protocol’s error code. On ","type":"text"},{"code":"instance_revoked","type":"codeVoice"},{"text":", it forgets the","type":"text"},{"text":" ","type":"text"},{"text":"registration and deletes its registration key: the next Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Attestation registers the installation again. The revoked instance’s","type":"text"},{"text":" ","type":"text"},{"text":"instance keys stay its own (","type":"text"},{"code":"instance_key_registered","type":"codeVoice"},{"text":"), so a","type":"text"},{"text":" ","type":"text"},{"text":"credential whose refresh needs one must be received again. On","type":"text"},{"text":" ","type":"text"},{"code":"instance_not_active","type":"codeVoice"},{"text":" (suspended) it keeps the registration: tell the","type":"text"},{"text":" ","type":"text"},{"text":"holder, as the provider may resume it. A signed request refused as","type":"text"},{"text":" ","type":"text"},{"code":"invalid_signed_request","type":"codeVoice"},{"text":" isn’t retried: check the device’s clock, and","type":"text"},{"text":" ","type":"text"},{"text":"that the provider still knows the instance.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/keyAttestation(instanceKey:keys:nonce:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyAttestation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"instanceKey"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":", "},{"kind":"externalParam","text":"keys"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"nonce"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/keyattestation(instancekey:keys:nonce:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","title":"keyAttestation(instanceKey:keys:nonce:)","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A Key Attestation over "},{"code":"keys","type":"codeVoice"},{"type":"text","text":", for the issuance of "},{"code":"instanceKey","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"with one assertion over a "},{"code":"holder","type":"codeVoice"},{"type":"text","text":" challenge and every key, signed"},{"type":"text","text":" "},{"type":"text","text":"with the registration key."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryInstanceRegistry":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryInstanceRegistry","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","url":"\/documentation\/oid4vcwallet\/inmemoryinstanceregistry","type":"topic","title":"InMemoryInstanceRegistry","abstract":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry"},{"type":"text","text":" in memory, lost when the app quits: for tests."},{"type":"text","text":" "},{"type":"text","text":"Every "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true,"type":"reference"},{"type":"text","text":" over the same registry shares its locks."}],"navigatorTitle":[{"text":"InMemoryInstanceRegistry","kind":"identifier"}]},"https://github.com/IDFoundry/OID4VCgo/blob/main/mobile/WALLET_PROVIDER.md":{"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","title":"WALLET_PROVIDER.md","url":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","titleInlineContent":[{"type":"text","text":"WALLET_PROVIDER.md"}],"type":"link"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderRefusedError/error":{"identifier":