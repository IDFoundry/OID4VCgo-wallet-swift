umentation\/oid4vcwallet\/httpwalletprovider"]}],"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"]}],"abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"},{"type":"text","text":" over the Wallet Provider HTTP protocol, version"},{"type":"text","text":" "},{"type":"text","text":"1, that OID4VCgo’s "},{"type":"codeVoice","code":"walletprovider.Provider.Handler"},{"type":"text","text":" serves"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"with Apple App Attest ("},{"type":"codeVoice","code":"apple-app-attest"},{"type":"text","text":") as its evidence:"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HttpWalletProvider"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The installation registers once, at its first Wallet Attestation:"},{"type":"text","text":" "},{"type":"text","text":"over a "},{"code":"registration","type":"codeVoice"},{"type":"text","text":" challenge, it makes a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"registration key"}]},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"key store of its own ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","isActive":true},{"type":"text","text":") and an App Attest"},{"type":"text","text":" "},{"type":"text","text":"key, has Apple attest the App Attest key over the client data"},{"type":"text","text":" "},{"type":"text","text":"naming the registration key, registers both ("},{"code":"POST \/v1\/instances","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and keeps the instance ID and the two keys’ IDs in its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","isActive":true},{"type":"text","text":". The registration key signs every later"},{"type":"text","text":" "},{"type":"text","text":"request ("},{"code":"Wallet-Provider-Request","type":"codeVoice"},{"type":"text","text":"); no attestation names it. If"},{"type":"text","text":" "},{"type":"text","text":"the registration, its key or the App Attest key is lost, the next"},{"type":"text","text":" "},{"type":"text","text":"Wallet Attestation registers again, with new keys."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)","isActive":true},{"type":"text","text":" asks for a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the instance key ("},{"code":"instance_key","type":"codeVoice"},{"type":"text","text":"). The first time,"},{"type":"text","text":" "},{"type":"text","text":"it sends an App Attest assertion over a fresh "},{"code":"instance","type":"codeVoice"},{"type":"text","text":" challenge"},{"type":"text","text":" "},{"type":"text","text":"and the key, which the provider records the key with; once it has,"},{"type":"text","text":" "},{"type":"text","text":"the key alone — and the assertion again if the provider no longer"},{"type":"text","text":" "},{"type":"text","text":"has its record ("},{"code":"evidence_required","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","isActive":true},{"type":"text","text":" asks for a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation over the holder keys, with one assertion over a"},{"type":"text","text":" "},{"code":"holder","type":"codeVoice"},{"type":"text","text":" challenge and all of them, for the issuance of its"},{"type":"text","text":" "},{"type":"text","text":"instance key, which a Wallet Attestation recorded."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"App Attest attests the app, not the wallet’s keys: the provider"},{"type":"text","text":" "},{"type":"text","text":"learns that a genuine copy of the app on a genuine Apple device asked"},{"type":"text","text":" "},{"type":"text","text":"for them, not where they are. Make them in the Secure Enclave all the"},{"type":"text","text":" "},{"type":"text","text":"same ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore"},{"type":"text","text":"‘s default). Where App Attest isn’t"},{"type":"text","text":" "},{"type":"text","text":"supported — the Simulator, some older devices — the wallet can’t"},{"type":"text","text":" "},{"type":"text","text":"register, and every attestation fails as "},{"code":".platform","type":"codeVoice"},{"type":"text","text":": there’s no"},{"type":"text","text":" "},{"type":"text","text":"unattested path, in development either. A development build (the"},{"type":"text","text":" "},{"code":"com.apple.developer.devicecheck.appattest-environment","type":"codeVoice"},{"type":"text","text":" entitlement"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"code":"development","type":"codeVoice"},{"type":"text","text":") makes development-environment keys, which only"},{"type":"text","text":" "},{"type":"text","text":"a provider configured for them accepts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Assertions are made one at a time, each sent before the next is made,"},{"type":"text","text":" "},{"type":"text","text":"as the provider accepts only an assertion whose counter exceeds the"},{"type":"text","text":" "},{"type":"text","text":"last it took."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It sends nothing but to its base URL, over https, following no"},{"type":"text","text":" "},{"type":"text","text":"redirect, with its timeout for each request, and reads at most"},{"type":"text","text":" "},{"type":"text","text":"256 KiB of an answer. It checks a Wallet Attestation is for the"},{"type":"text","text":" "},{"type":"text","text":"client and the instance key, and a Key Attestation is over the nonce"},{"type":"text","text":" "},{"type":"text","text":"sent and attests only keys sent; their signatures are the issuer’s to"},{"type":"text","text":" "},{"type":"text","text":"verify."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Failures reach the wallet as "},{"code":"WalletError","type":"codeVoice"},{"type":"text","text":"s: one the network or the"},{"type":"text","text":" "},{"type":"text","text":"provider’s availability caused (no connection, a timeout, HTTP 5xx or"},{"type":"text","text":" "},{"type":"text","text":"429, a challenge that expired before it was used, App Attest’s server"},{"type":"text","text":" "},{"type":"text","text":"unavailable) as "},{"code":".network","type":"codeVoice"},{"type":"text","text":", which may be retried"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError"},{"type":"text","text":"); a refusal"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"},{"type":"text","text":") as "},{"code":".platform","type":"codeVoice"},{"type":"text","text":", its message naming the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s error code. On "},{"code":"instance_revoked","type":"codeVoice"},{"type":"text","text":", it forgets the"},{"type":"text","text":" "},{"type":"text","text":"registration and deletes its registration key: the next Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation registers the installation again. The revoked instance’s"},{"type":"text","text":" "},{"type":"text","text":"instance keys stay its own ("},{"code":"instance_key_registered","type":"codeVoice"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"credential whose refresh needs one must be received again. On"},{"type":"text","text":" "},{"code":"instance_not_active","type":"codeVoice"},{"type":"text","text":" (suspended) it keeps the registration: tell the"},{"type":"text","text":" "},{"type":"text","text":"holder, as the provider may resume it. A signed request refused as"},{"type":"text","text":" "},{"code":"invalid_signed_request","type":"codeVoice"},{"type":"text","text":" isn’t retried: check the device’s clock, and"},{"type":"text","text":" "},{"type":"text","text":"that the provider still knows the instance."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/sweepOrphanedKeys(in:)":{"role":"symbol","title":"sweepOrphanedKeys(in:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sweepOrphanedKeys"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16KeychainKeyStoreC","text":"KeychainKeyStore"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","url":"\/documentation\/oid4vcwallet\/wallet\/sweeporphanedkeys(in:)","kind":"symbol","abstract":[{"text":"Deletes every key in ","type":"text"},{"type":"codeVoice","code":"keyStore"},{"text":" that none of the wallet’s","type":"text"},{"text":" ","type":"text"},{"text":"credentials is bound to — left by an issuance the app quit or","type":"text"},{"text":" ","type":"text"},{"text":"crashed in the middle of — and returns how many. Call it at launch,","type":"text"},{"text":" ","type":"text"},{"text":"before any issuance or refresh: one in progress holds keys of its","type":"text"},{"text":" ","type":"text"},{"text":"own.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InstanceRegistry":{"role":"symbol","title":"InstanceRegistry","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InstanceRegistry","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","url":"\/documentation\/oid4vcwallet\/instanceregistry","kind":"symbol","navigatorTitle":[{"text":"InstanceRegistry","kind":"identifier"}],"abstract":[{"text":"Where ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference"},{"text":" keeps the wallet’s registration, so the","type":"text"},{"text":" ","type":"text"},{"text":"installation registers once, across launches. An instance ID isn’t a","type":"text"},{"text":" ","type":"text"},{"text":"secret — every request naming it is signed with the registration key","type":"text"},{"text":" ","type":"text"},{"text":"— but losing it loses the instance: the wallet then registers again,","type":"text"},{"text":" ","type":"text"},{"text":"with a new registration key and App Attest key, and the instance keys","type":"text"},{"text":" ","type":"text"},{"text":"the lost instance recorded can’t be attested again.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference"},{"text":" keeps it in a file;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference"},{"text":" is for tests.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","type":"unresolvable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProvider"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/walletprovider","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"navigatorTitle":[{"kind":"identifier","text":"WalletProvider"}],"title":"WalletProvider","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/AppAttestService":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppAttestService"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/appattestservice","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","abstract":[{"type":"text","text":"Apple App Attest, as "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","isActive":true},{"type":"text","text":" uses it: the app’s App"},{"type":"text","text":" "},{"type":"text","text":"Attest key, made once at registration, attested by Apple, and"},{"type":"text","text":" "},{"type":"text","text":"asserting over the client data of each later request."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"DCAppAttestService"},{"type":"text","text":"; a test supplies"},{"type":"text","text":" "},{"type":"text","text":"its own."}],"navigatorTitle":[{"kind":"identifier","text":"AppAttestService"}],"title":"AppAttestService","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"type":"topic","title":"Going to production","role":"article","kind":"article","abstract":[{"type":"text","text":"What a wallet needs before real holders use it."}],"url":"\/documentation\/oid4vcwallet\/goingtoproduction","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderRefusedError/error":{"role":"symbol","type":"topic","title":"error","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"error","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError\/error","url":"\/documentation\/oid4vcwallet\/walletproviderrefusederror\/error","kind":"symbol","abstract":[{"text":"The protocol’s error code (","type":"text"},{"code":"evidence_rejected","type":"codeVoice"},{"text":", ","type":"text"},{"code":"instance_revoked","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"unknown_instance_key","type":"codeVoice"},{"text":", …), or nil when the answer had none.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/IntegrationChecklist":{"type":"topic","title":"Integration checklist","role":"article","kind":"article","abstract":[{"type":"text","text":"Every step and rule for integrating OID4VCWallet, in order, each with"},{"type":"text","text":" "},{"type":"text","text":"how to check it."}],"url":"\/documentation\/oid4vcwallet\/integrationchecklist","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"url":"\/documentation\/oid4vcwallet\/gettingstarted","kind":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","type":"topic","abstract":[{"type":"text","text":"Add the package, give the wallet its keys, its storage and a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Provider, and create it at launch."}],"title":"Getting started","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/registrationKeyTagPrefix":{"role":"symbol","type":"topic","title":"registrationKeyTagPrefix","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"registrationKeyTagPrefix"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyTagPrefix","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/registrationkeytagprefix","kind":"symbol","abstract":[{"type":"text","text":"The Keychain tag prefix of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()"},{"type":"text","text":"‘s keys. The"},{"type":"text","text":" "},{"type":"text","text":"wallet’s own "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore"},{"type":"text","text":" mustn’t cover it, as its default"},{"type":"text","text":" "},{"type":"text","text":"prefix doesn’t: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)"},{"type":"text","text":" would"},{"type":"text","text":" "},{"type":"text","text":"delete the registration key."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryInstanceRegistry":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/inmemoryinstanceregistry","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","abstract":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","isActive":true},{"type":"text","text":" in memory, lost when the app quits: for tests."}],"navigatorTitle":[{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"title":"InMemoryInstanceRegistry","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderUnavailableError":{"type":"topic","title":"WalletProviderUnavailableError","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProviderUnavailableError"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"WalletProviderUnavailableError"}],"abstract":[{"type":"text","text":"The Wallet Provider couldn’t answer — HTTP 5xx or 429 — or the"},{"type":"text","text":" "},{"type":"text","text":"challenge a