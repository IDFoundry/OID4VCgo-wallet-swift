},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppAttestService","preciseIdentifier":"s:12OID4VCWallet16AppAttestServiceP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/init(baseurl:instances:registrationkeys:appattest:timeout:)","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/init(baseURL:instances:registrationKeys:appAttest:timeout:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/walletAttestation(clientID:instanceKey:)":{"title":"walletAttestation(clientID:instanceKey:)","role":"symbol","abstract":[{"type":"text","text":"A Wallet Attestation for "},{"code":"clientID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"instanceKey","type":"codeVoice"},{"type":"text","text":", registering"},{"type":"text","text":" "},{"type":"text","text":"the installation first if it isn’t yet, with an assertion for the"},{"type":"text","text":" "},{"type":"text","text":"key unless the provider recorded it already."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"walletAttestation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"clientID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"instanceKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","pr