ryInstanceRegistry","type":"reference"},{"text":" is for tests. Over either, every","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference"},{"text":" in the process registering or asserting for","type":"text"},{"text":" ","type":"text"},{"text":"the same registration takes turns; over a registry of another type,","type":"text"},{"text":" ","type":"text"},{"text":"a provider takes turns only with itself: keep one provider for it.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"title":"Wallet","url":"\/documentation\/oid4vcwallet\/wallet","navigatorTitle":[{"text":"Wallet","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Wallet","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","abstract":[{"type":"text","text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,"},{"type":"text","text":" "},{"type":"text","text":"credential store and Wallet Provider."}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/defaultTimeout":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/defaultTimeout","type":"topic","abstract":[{"text":"The default timeout of each request, as the Go client’s.","type":"text"}],"title":"defaultTimeout","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval"}],"kind":"symbol","role":"symbol","url":"\/d