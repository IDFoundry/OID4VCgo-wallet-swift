{"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"],"generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The installation registers once, at its first Wallet Attestation:"},{"type":"text","text":" "},{"type":"text","text":"over a "},{"type":"codeVoice","code":"registration"},{"type":"text","text":" challenge, it makes a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"registration key"}]},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"key store of its own ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()"},{"type":"text","text":") and an App Attest"},{"type":"text","text":" "},{"type":"text","text":"key, has Apple attest the App Attest key over the client data"},{"type":"text","text":" "},{"type":"text","text":"naming the registration key, registers both ("},{"type":"codeVoice","code":"POST \/v1\/instances"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and keeps the instance ID and the two keys’ IDs in its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry"},{"type":"text","text":". The registration key signs every later"},{"type":"text","text":" "},{"type":"text","text":"request ("},{"type":"codeVoice","code":"Wallet-Provider-Request"},{"type":"text","text":"); no attestation names it. If"},{"type":"text","text":" "},{"type":"text","text":"the registration, its key or the App Attest key is lost, the next"},{"type":"text","text":" "},{"type":"text","text":"Wallet Attestation registers again, with new keys. An App Attest"},{"type":"text","text":" "},{"type":"text","text":"key a registration made but couldn’t register — App Attest’s"},{"type":"text","text":" "},{"type":"text","text":"server or the provider unavailable, or no connection — is kept, in"},{"type":"text","text":" "},{"type":"text","text":"this process, and tried again by the next registration, as Apple"},{"type":"text","text":" "},{"type":"text","text":"asks; it’s dropped when the provider or App Attest refuses it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)"},{"type":"text","text":" asks for a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the instance key ("},{"type":"codeVoice","code":"instance_key"},{"type":"text","text":"). The first time,"},{"type":"text","text":" "},{"type":"text","text":"it sends an App Attest assertion over a fresh "},{"type":"codeVoice","code":"instance"},{"type":"text","text":" challenge"},{"type":"text","text":" "},{"type":"text","text":"and the key, which the provider records the key with; once it has,"},{"type":"text","text":" "},{"type":"text","text":"the key alone — and the assertion again if the provider no longer"},{"type":"text","text":" "},{"type":"text","text":"has its record ("},{"type":"codeVoice","code":"evidence_required"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)"},{"type":"text","text":" asks for a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation over the holder keys, with one assertion over a"},{"type":"text","text":" "},{"type":"codeVoice","code":"holder"},{"type":"text","text":" challenge and all of them, for the issuance of its"},{"type":"text","text":" "},{"type":"text","text":"instance key, which a Wallet Attestation recorded."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"App Attest attests the app, not the wallet’s keys: the provider"},{"type":"text","text":" "},{"type":"text","text":"learns that a genuine copy of the app on a genuine Apple device asked"},{"type":"text","text":" "},{"type":"text","text":"for them, not where they are. Make them in the Secure Enclave all the"},{"type":"text","text":" "},{"type":"text","text":"same ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore"},{"type":"text","text":"‘s default). Where App Attest isn’t"},{"type":"text","text":" "},{"type":"text","text":"supported — the Simulator, some older devices — the wallet can’t"},{"type":"text","text":" "},{"type":"text","text":"register, and every attestation fails as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":": there’s no"},{"type":"text","text":" "},{"type":"text","text":"unattested path, in development either. A development build (the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"type":"text","text":" entitlement"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"type":"codeVoice","code":"development"},{"type":"text","text":") makes development-environment keys, which only"},{"type":"text","text":" "},{"type":"text","text":"a provider configured for them accepts."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Assertions are made one at a time, each sent before the next is made,"},{"type":"text","text":" "},{"type":"text","text":"as the provider accepts only an assertion whose counter exceeds the"},{"type":"text","text":" "},{"type":"text","text":"last it took, and the installation registers once. Every"},{"type":"text","text":" "},{"type":"codeVoice","code":"HttpWalletProvider"},{"type":"text","text":" over the same "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry"},{"type":"text","text":" file (or"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry"},{"type":"text","text":") in the process shares that"},{"type":"text","text":" "},{"type":"text","text":"order, so a wallet rebuilt mid-issuance with a new provider is still"},{"type":"text","text":" "},{"type":"text","text":"serialised with the old one. Over a registry of its own type, a"},{"type":"text","text":" "},{"type":"text","text":"provider serialises only its own calls: keep one provider for it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It sends nothing but to its base URL, over https, following no"},{"type":"text","text":" "},{"type":"text","text":"redirect, with its timeout for each request, and reads at most"},{"type":"text","text":" "},{"type":"text","text":"256 KiB of an answer. It checks a Wallet Attestation is for the"},{"type":"text","text":" "},{"type":"text","text":"client and the instance key, and a Key Attestation is over the nonce"},{"type":"text","text":" "},{"type":"text","text":"sent and attests only keys sent; their signatures are the issuer’s to"},{"type":"text","text":" "},{"type":"text","text":"verify."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Failures reach the wallet as "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":"s: one the network or the"},{"type":"text","text":" "},{"type":"text","text":"provider’s availability caused (no connection, a timeout, HTTP 5xx or"},{"type":"text","text":" "},{"type":"text","text":"429, a challenge that expired before it was used, App Attest’s server"},{"type":"text","text":" "},{"type":"text","text":"unavailable) as "},{"type":"codeVoice","code":".network"},{"type":"text","text":", which may be retried"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError"},{"type":"text","text":"); a refusal"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"},{"type":"text","text":") as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", its message naming the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s error code. On "},{"type":"codeVoice","code":"instance_revoked"},{"type":"text","text":", it forgets the"},{"type":"text","text":" "},{"type":"text","text":"registration and deletes its registration key: the next Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation registers the installation again. The revoked instance’s"},{"type":"text","text":" "},{"type":"text","text":"instance keys stay its own ("},{"type":"codeVoice","code":"instance_key_registered"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"credential whose refresh needs one must be received again. On"},{"type":"text","text":" "},{"type":"codeVoice","code":"instance_not_active"},{"type":"text","text":" (suspended) it keeps the registration: tell the"},{"type":"text","text":" "},{"type":"text","text":"holder, as the provider may resume it. A signed request refused as"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_signed_request"},{"type":"text","text":" isn’t retried: check the device’s clock, and"},{"type":"text","text":" "},{"type":"text","text":"that the provider still knows the instance."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Class","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HttpWalletProvider","kind":"identifier"}],"symbolKind":"class","title":"HttpWalletProvider","navigatorTitle":[{"text":"HttpWalletProvider","kind":"identifier"}],"modules":[{"name":"OID4VCWallet"}],"externalID":"s:12OID4VCWallet18HttpWalletProviderC"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/init(baseURL:instances:registrationKeys:appAttest:timeout:)"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/sweepOrphanedRegistrationKeys()","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/defaultTimeout","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyTagPrefix"],"generated":true},{"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()"],"generated":true}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"kind":"relationships","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/httpwalletprovider"]}],"abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","type":"reference","isActive":true},{"text":" over the Wallet Provider HTTP protocol, version","type":"text"},{"text":" ","type":"text"},{"text":"1, that OID4VCgo’s ","type":"text"},{"type":"codeVoice","code":"walletprovider.Provider.Handler"},{"text":" serves","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"reference","isActive":true},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"with Apple App Attest (","type":"text"},{"type":"codeVoice","code":"apple-app-attest"},{"text":") as its evidence:","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"title":"Getting started","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","type":"topic","kind":"article","url":"\/documentation\/oid4vcwallet\/gettingstarted","role":"article","abstract":[{"type":"text","text":"Add the package, give the wallet its keys, its storage and a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Provider, and create it at launch."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/keyAttestation(instanceKey:keys:nonce:)":{"url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/keyattestation(instancekey:keys:nonce:)","title":"keyAttestation(instanceKey:keys:nonce:)","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyAttestation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"instanceKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":", ","kind":"text"},{"text":"keys","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":"], ","kind":"text"},{"text":"nonce","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"abstract":[{"text":"A Key Attestation over ","type":"text"},{"code":"keys","type":"codeVoice"},{"text":", for the issuance of ","type":"text"},{"code":"instanceKey","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"with one assertion over a ","type":"text"},{"code":"holder","type":"codeVoice"},{"text":" challenge and every key, signed","type":"text"},{"text":" ","type":"text"},{"text":"with the registration key.","type":"text"}],"kind":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/AppAttestKeyLostError":{"title":"AppAttestKeyLostError","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppAttestKeyLostError"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/appattestkeylosterror","role":"symbol","abstract":[{"type":"text","text":"The App Attest key the registration names is gone — the app was"},{"type":"text","text":" "},{"type":"text","text":"restored from a backup, or reinstalled — so it can’t assert: the"},{"type":"text","text":" "},{"type":"text","text":"installation must register again."}],"navigatorTitle":[{"kind":"identifier","text":"AppAttestKeyLostError"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryInstanceRegistry":{"title":"InMemoryInstanceRegistry","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryInstanceRegistry"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/inmemoryinstanceregistry","role":"symbol","abstract":[{"type":"text","text":"An "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","type":"reference","isActive":true},{"type":"text","text":" in memory, lost when the app quits: for tests."},{"type":"text","text":" "},{"type":"text","text":"Every "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference","isActive":true},{"type":"text","text":" over the same registry shares its locks."}],"navigatorTitle":[{"kind":"identifier","text":"InMemoryInstanceRegistry"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"title":"Going to production","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","type":"topic","kind":"article","url":"\/documentation\/oid4vcwallet\/goingtoproduction","role":"article","abstract":[{"text":"What a wallet needs before real holders use it.","type":"text"}]},"https://github.com/IDFoundry/OID4VCgo/blob/main/mobile/WALLET_PROVIDER.md":{"title":"WALLET_PROVIDER.md","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","url":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"link","titleInlineContent":[{"text":"WALLET_PROVIDER.md","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"title":"WalletProvider","url":"\/documentation\/oid4vcwallet\/walletprovider","navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProvider"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","role":"symbol","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"kind":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/sweepOrphanedKeys(in:)":{"title":"sweepOrphanedKeys(in:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sweepOrphanedKeys","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet16KeychainKeyStoreC","text":"KeychainKeyStore","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/sweeporphanedkeys(in:)","role":"symbol","abstract":[{"type":"text","text":"Deletes every key in "},{"code":"keyStore","type":"codeVoice"},{"type":"text","text":" that none of the wallet’s"},{"type":"text","text":" "},{"type":"text","text":"credentials is bound to — left by an issuance the app quit or"},{"type":"text","text":" "},{"type":"text","text":"crashed in the middle of — and returns how many. Call it at launch,"},{"type":"text","text":" "},{"type":"text","text":"before any issuance or refresh: one in progress holds keys of its"},{"type":"text","text":" "},{"type":"text","text":"own."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderRefusedError":{"title":"WalletProviderRefusedError","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletProviderRefusedError"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletproviderrefusederror","role":"symbol","abstract":[{"text":"The Wallet Provider refused a request with one of the protocol’s","type":"text"},{"text":" ","type":"text"},{"text":"errors, or answered other than the protocol documents (a redirect, a","type":"text"},{"text":" ","type":"text"},{"text":"path it doesn’t serve). It reaches the wallet as ","type":"text"},{"type":"codeVoice","code":".platform"},{"text":", its","type":"text"},{"text":" ","type":"text"},{"text":"message naming ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError\/error","isActive":true,"type":"reference"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"WalletProviderRefusedError","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileInstanceRegistry/url":{"title":"url","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry\/url","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"url"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/fileinstanceregistry\/url","role":"symbol","abstract":[{"text":"The file the registration is kept in; its directory is made if","type":"text"},{"text":" ","type":"text"},{"text":"missing.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"t