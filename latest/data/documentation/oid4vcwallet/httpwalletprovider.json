llet\/HttpWalletProvider\/init(baseURL:instances:registrationKeys:appAttest:timeout:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/sweepOrphanedRegistrationKeys()","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/defaultTimeout","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyTagPrefix"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"},{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()"],"generated":true,"anchor":"Type-Methods","title":"Type Methods"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/httpwalletprovider"]}],"relationshipsSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/s8SendableP","doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider"},"kind":"symbol","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","isActive":true},{"type":"text","text":" over the Wallet Provider HTTP protocol, version"},{"type":"text","text":" "},{"type":"text","text":"1, that OID4VCgo’s "},{"type":"codeVoice","code":"walletprovider.Provider.Handler"},{"type":"text","text":" serves"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"with Apple App Attest ("},{"type":"codeVoice","code":"apple-app-attest"},{"type":"text","text":") as its evidence:"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HttpWalletProvider"}]}]},{"kind":"mentions","mentions":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The installation registers once, at its first Wallet Attestation:","type":"text"},{"text":" ","type":"text"},{"text":"over a ","type":"text"},{"type":"codeVoice","code":"registration"},{"text":" challenge, it makes a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"registration key","type":"text"}]},{"text":" in a","type":"text"},{"text":" ","type":"text"},{"text":"key store of its own (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/registrationKeyStore()","type":"reference","isActive":true},{"text":") and an App Attest","type":"text"},{"text":" ","type":"text"},{"text":"key, has Apple attest the App Attest key over the client data","type":"text"},{"text":" ","type":"text"},{"text":"naming the registration key, registers both (","type":"text"},{"type":"codeVoice","code":"POST \/v1\/instances"},{"type":"text","text":"),"},{"text":" ","type":"text"},{"type":"text","text":"and keeps the instance ID and the two keys’ IDs in its"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry"},{"text":". The registration key signs every later","type":"text"},{"type":"text","text":" "},{"type":"text","text":"request ("},{"type":"codeVoice","code":"Wallet-Provider-Request"},{"type":"text","text":"); no attestation names it. If"},{"type":"text","text":" "},{"type":"text","text":"the registration, its key or the App Attest key is lost, the next"},{"text":" ","type":"text"},{"text":"Wallet Attestation registers again, with new keys. An App Attest","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"key a registration made but couldn’t register — App Attest’s"},{"type":"text","text":" "},{"type":"text","text":"server or the provider unavailable, or no connection — is kept, in"},{"type":"text","text":" "},{"type":"text","text":"this process, and tried again by the next registration, as Apple"},{"text":" ","type":"text"},{"type":"text","text":"asks; it’s dropped when the provider or App Attest refuses it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/walletAttestation(clientID:instanceKey:)","isActive":true},{"type":"text","text":" asks for a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the instance key ("},{"type":"codeVoice","code":"instance_key"},{"type":"text","text":"). The first time,"},{"type":"text","text":" "},{"type":"text","text":"it sends an App Attest assertion over a fresh "},{"type":"codeVoice","code":"instance"},{"type":"text","text":" challenge"},{"type":"text","text":" "},{"type":"text","text":"and the key, which the provider records the key with; once it has,"},{"type":"text","text":" "},{"type":"text","text":"the key alone — and the assertion again if the provider no longer"},{"type":"text","text":" "},{"type":"text","text":"has its record ("},{"type":"codeVoice","code":"evidence_required"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)"},{"type":"text","text":" asks for a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation over the holder keys, with one assertion over a"},{"type":"text","text":" "},{"type":"codeVoice","code":"holder"},{"type":"text","text":" challenge and all of them, for the issuance of its"},{"type":"text","text":" "},{"type":"text","text":"instance key, which a Wallet Attestation recorded."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"App Attest attests the app, not the wallet’s keys: the provider"},{"type":"text","text":" "},{"type":"text","text":"learns that a genuine copy of the app on a genuine Apple device asked"},{"type":"text","text":" "},{"type":"text","text":"for them, not where they are. Make them in the Secure Enclave all the"},{"type":"text","text":" "},{"type":"text","text":"same ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","type":"reference","isActive":true},{"type":"text","text":"‘s default). Where App Attest isn’t"},{"type":"text","text":" "},{"type":"text","text":"supported — the Simulator, some older devices — the wallet can’t"},{"type":"text","text":" "},{"type":"text","text":"register, and every attestation fails as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":": there’s no"},{"type":"text","text":" "},{"type":"text","text":"unattested path, in development either. A development build (the"},{"type":"text","text":" "},{"code":"com.apple.developer.devicecheck.appattest-environment","type":"codeVoice"},{"type":"text","text":" entitlement"},{"type":"text","text":" "},{"type":"text","text":"set to "},{"code":"development","type":"codeVoice"},{"type":"text","text":") makes development-environment keys, which only"},{"type":"text","text":" "},{"type":"text","text":"a provider configured for them accepts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Assertions are made one at a time, each sent before the next is made,"},{"type":"text","text":" "},{"type":"text","text":"as the provider accepts only an assertion whose counter exceeds the"},{"type":"text","text":" "},{"type":"text","text":"last it took, and the installation registers once. Every"},{"type":"text","text":" "},{"type":"codeVoice","code":"HttpWalletProvider"},{"type":"text","text":" over the same "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry"},{"type":"text","text":" file (or"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry"},{"type":"text","text":") in the process shares that"},{"type":"text","text":" "},{"type":"text","text":"order, so a wallet rebuilt mid-issuance with a new provider is still"},{"type":"text","text":" "},{"type":"text","text":"serialised with the old one. Over a registry of its own type, a"},{"type":"text","text":" "},{"type":"text","text":"provider serialises only its own calls: keep one provider for it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It sends nothing but to its base URL, over https, following no"},{"type":"text","text":" "},{"type":"text","text":"redirect, with its timeout for each request, and reads at most"},{"type":"text","text":" "},{"type":"text","text":"256 KiB of an answer. It checks a Wallet Attestation is for the"},{"type":"text","text":" "},{"type":"text","text":"client and the instance key, and a Key Attestation is over the nonce"},{"type":"text","text":" "},{"type":"text","text":"sent and attests only keys sent; their signatures are the issuer’s to"},{"type":"text","text":" "},{"type":"text","text":"verify."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Failures reach the wallet as "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":"s: one the network or the"},{"type":"text","text":" "},{"type":"text","text":"provider’s availability caused (no connection, a timeout, HTTP 5xx or"},{"type":"text","text":" "},{"type":"text","text":"429, a challenge that expired before it was used, App Attest’s server"},{"type":"text","text":" "},{"type":"text","text":"unavailable) as "},{"type":"codeVoice","code":".network"},{"type":"text","text":", which may be retried"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderUnavailableError"},{"type":"text","text":"); a refusal"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"},{"type":"text","text":") as "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", its message naming the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s error code. On "},{"type":"codeVoice","code":"instance_revoked"},{"type":"text","text":", it forgets the"},{"type":"text","text":" "},{"type":"text","text":"registration and deletes its registration key: the next Wallet"},{"type":"text","text":" "},{"type":"text","text":"Attestation registers the installation again. The revoked instance’s"},{"type":"text","text":" "},{"type":"text","text":"instance keys stay its own ("},{"type":"codeVoice","code":"instance_key_registered"},{"type":"text","text":"), so a"},{"type":"text","text":" "},{"type":"text","text":"credential whose refresh needs one must be received again. On"},{"type":"text","text":" "},{"type":"codeVoice","code":"instance_not_active"},{"type":"text","text":" (suspended) it keeps the registration: tell the"},{"type":"text","text":" "},{"type":"text","text":"holder, as the provider may resume it. A signed request refused as"},{"type":"text","text":" "},{"type":"codeVoice","code":"invalid_signed_request"},{"type":"text","text":" isn’t retried: check the device’s clock, and"},{"type":"text","text":" "},{"type":"text","text":"that the provider still knows the instance."}]}],"kind":"content"}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/defaultTimeout":{"title":"defaultTimeout","role":"symbol","abstract":[{"type":"text","text":"The default timeout of each request, as the Go client’s."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultTimeout","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/defaulttimeout","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/defaultTimeout"},"https://github.com/IDFoundry/OID4VCgo/blob/main/mobile/WALLET_PROVIDER.md":{"url":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md","type":"link","title":"WALLET_PROVIDER.md","titleInlineContent":[{"type":"text","text":"WALLET_PROVIDER.md"}],"identifier":"https:\/\/github.com\/IDFoundry\/OID4VCgo\/blob\/main\/mobile\/WALLET_PROVIDER.md"},"doc://oid4vcwallet.OID4VCWallet/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/s16SendableMetatypeP"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/IntegrationChecklist":{"type":"topic","url":"\/documentation\/oid4vcwallet\/integrationchecklist","title":"Integration checklist","kind":"article","abstract":[{"type":"text","text":"Every step and rule for integrating OID4VCWallet, in order, each with"},{"type":"text","text":" "},{"type":"text","text":"how to check it."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GoingToProduction":{"type":"topic","url":"\/documentation\/oid4vcwallet\/goingtoproduction","title":"Going to production","kind":"article","abstract":[{"text":"What a wallet needs before real holders use it.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/keyAttestation(instanceKey:keys:nonce:)":{"title":"keyAttestation(instanceKey:keys:nonce:)","role":"symbol","abstract":[{"type":"text","text":"A Key Attestation over "},{"code":"keys","type":"codeVoice"},{"type":"text","text":", for the issuance of "},{"code":"instanceKey","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"with one assertion over a "},{"code":"holder","type":"codeVoice"},{"type":"text","text":" challenge and every key, signed"},{"type":"text","text":" "},{"type":"text","text":"with the registration key."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyAttestation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"instanceKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"keys","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"nonce","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/httpwalletprovider\/keyattestation(instancekey:keys:nonce:)","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider\/keyAttestation(instanceKey:keys:nonce:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HttpWalletProvider/sweepOrphanedRegistrationKeys()":{"title":"sweepOrphanedRegistrationKeys()","role":"symbol","abstract":[{"type":"text","text":"Deletes every key in the registration key store but the kept"},{"type":"text","text":" "},{"type":"text","text":"registration’s, and returns how many it deleted: the keys of"},{"type":"text","text":" "},{"type":"text","text":"registrations that never finished — the app ended in the middle"},{"type":"text","text":" "},{"type":"text","text":"of one, or was deleted and installed again, which keeps its"},{"type":"text","text":" "},{"type":"text","text":"Keychain items but not its registry — which nothing else"},{"type":"text","text":" "},{"type":"text","text":"deletes. Call it at launch. It takes its turn with registrations"},{"type":"text","text":" "},{"type":"text","text":"over the same registry, so it never deletes the key of one in"},{"type":"text","text":" "},{"type":"text","text":"progress."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sweepOrphanedRegistrationKeys","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Int","preciseI