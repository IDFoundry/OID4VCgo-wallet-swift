:" "},{"type":"text","text":"credentials that can answer it, and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the request’s alternatives.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Present","type":"heading","text":"Present","level":3},{"code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation = try await wallet.startPresentation(request: requestLink)","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection = try await presentation.defaultSelection()","    let disclosures = try await presentation.preview(selection: selection)","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()"},{"type":"text","text":" picks the first credential that"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"each query’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials"},{"type":"text","text":" instead: a query that"},{"type":"text","text":" "},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection"},{"type":"text","text":" otherwise), and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)"},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"text":"agrees.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI"},{"text":", when the Verifier sends","type":"text"},{"text":" ","type":"text"},{"text":"one, in the browser the request came from: it’s how a same-device","type":"text"},{"text":" ","type":"text"},{"text":"flow returns to the Verifier’s page.","type":"text"}]},{"level":3,"anchor":"Show-whats-being-asked-beyond-a-registration","text":"Show what’s being asked beyond a registration","type":"heading"},{"inlineContent":[{"text":"For a Verifier with a verified registration, each query’s"