{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"kind":"article","abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"seeAlsoSections":[{"title":"Presenting from a link","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"],"generated":true,"anchor":"Presenting-from-a-link"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A Verifier asks with an ","type":"text"},{"type":"codeVoice","code":"openid4vp:\/\/"},{"text":" link, as a QR code or a link on","type":"text"},{"text":" ","type":"text"},{"text":"its page. Register the ","type":"text"},{"type":"codeVoice","code":"openid4vp"},{"text":" URL scheme in the app’s Info.plist so","type":"text"},{"text":" ","type":"text"},{"text":"links open the app, and hand the link to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","type":"reference","isActive":true},{"text":". It fetches the Verifier’s","type":"text"},{"text":" ","type":"text"},{"text":"signed request, checks its certificate against","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","type":"reference","isActive":true},{"text":", and finds the credentials that","type":"text"},{"text":" ","type":"text"},{"text":"can answer it. A request from a Verifier the wallet doesn’t trust","type":"text"},{"text":" ","type":"text"},{"text":"throws ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","type":"reference","isActive":true},{"text":" before anything is shown.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","type":"reference","isActive":true},{"text":" it returns says:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"who is asking: "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","type":"reference","isActive":true},{"type":"text","text":", its name, and its"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","type":"reference","isActive":true},{"type":"text","text":" when a registrar the"},{"type":"text","text":" "},{"type":"text","text":"wallet trusts ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","type":"reference","isActive":true},{"type":"text","text":") registered it,"},{"type":"text","text":" "},{"type":"text","text":"with its purpose and the claims it’s registered to ask for;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"what it asks for: "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries","type":"reference","isActive":true},{"type":"text","text":", each with the held"},{"type":"text","text":" "},{"type":"text","text":"credentials that can answer it, and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the request’s alternatives."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Present","anchor":"Present","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation = try await wallet.startPresentation(request: requestLink)","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection = try await presentation.defaultSelection()","    let disclosures = try await presentation.preview(selection: selection)","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","type":"reference","isActive":true},{"text":" picks the first credential that","type":"text"},{"text":" ","type":"text"},{"text":"answers each query, and the first answerable option of each credential","type":"text"},{"text":" ","type":"text"},{"text":"set. To let the holder choose, build a ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","type":"reference","isActive":true},{"text":" from","type":"text"},{"text":" ","type":"text"},{"text":"each query’s ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","type":"reference","isActive":true},{"text":" instead: a query that","type":"text"},{"text":" ","type":"text"},{"text":"takes one credential gets exactly one. The wallet presents exactly the","type":"text"},{"text":" ","type":"text"},{"text":"selection, after checking it answers the request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","type":"reference","isActive":true},{"text":" otherwise), and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","type":"reference","isActive":true},{"text":" says what it would disclose","type":"text"},{"text":" ","type":"text"},{"text":"without signing or sending anything: show that before the holder","type":"text"},{"text":" ","type":"text"},{"text":"agrees.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Open ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","type":"reference","isActive":true},{"text":", when the Verifier sends","type":"text"},{"text":" ","type":"text"},{"text":"one, in the browser the request came from: it’s how a same-device","type":"text"},{"text":" ","type":"text"},{"text":"flow returns to the Verifier’s page.","type":"text"}]},{"text":"Show what’s being asked beyond a registration","anchor":"Show-whats-being-asked-beyond-a-registration","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"For a Verifier with a verified registration, each query’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","type":"reference","isActive":true},{"text":" lists the claims it asks for beyond","type":"text"},{"text":" ","type":"text"},{"text":"what it’s registered to request, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll","type":"reference","isActive":true},{"text":" whether it asks for every claim.","type":"text"},{"text":" ","type":"text"},{"text":"Nothing is refused for them: show them, and let the holder decide.","type":"text"}]},{"text":"Keep presentations unlinkable","anchor":"Keep-presentations-unlinkable","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Each presentation uses a copy of the credential, bound to its own key,","type":"text"},{"text":" ","type":"text"},{"text":"so two Verifiers can’t link the holder’s presentations by the","type":"text"},{"text":" ","type":"text"},{"text":"credential. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","type":"reference","isActive":true},{"text":" chooses which copy:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation","type":"reference","isActive":true},{"type":"text","text":", the default: a"},{"type":"text","text":" "},{"type":"text","text":"copy no Verifier has seen, every time."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","type":"reference","isActive":true},{"type":"text","text":": the copy a Verifier"},{"type":"text","text":" "},{"type":"text","text":"has seen before, so it can recognize a returning holder, and an unused"},{"type":"text","text":" "},{"type":"text","text":"one for a new Verifier."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Once every copy is used, one is reused. A candidate’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","type":"reference","isActive":true},{"text":" says whether presenting it now would","type":"text"},{"text":" ","type":"text"},{"text":"hand this Verifier a copy another has seen: warn the holder, and","type":"text"},{"text":" ","type":"text"},{"text":"refresh the credential (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"reference","isActive":true},{"text":") when its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","type":"reference","isActive":true},{"text":" reaches zero.","type":"text"}]},{"text":"When delivery is uncertain","anchor":"When-delivery-is-uncertain","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"If sending the response fails in a way that leaves it unknown whether","type":"text"},{"text":" ","type":"text"},{"text":"the Verifier received it, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","type":"reference","isActive":true},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","type":"reference","isActive":true},{"text":" and doesn’t send it again: the","type":"text"},{"text":" ","type":"text"},{"text":"holder should check with the Verifier before sharing again.","type":"text"}]}]}],"sections":[],"metadata":{"modules":[{"name":"OID4VCWallet"}],"role":"article","roleHeadi