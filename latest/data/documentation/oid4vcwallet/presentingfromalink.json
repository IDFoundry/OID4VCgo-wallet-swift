{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A Verifier asks with an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" link, as a QR code or a link on"},{"type":"text","text":" "},{"type":"text","text":"its page. Register the "},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":" URL scheme in the app’s Info.plist so"},{"type":"text","text":" "},{"type":"text","text":"links open the app, and hand the link to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","isActive":true},{"type":"text","text":". It fetches the Verifier’s"},{"type":"text","text":" "},{"type":"text","text":"signed request, checks its certificate against"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","isActive":true},{"type":"text","text":", and finds the credentials that"},{"type":"text","text":" "},{"type":"text","text":"can answer it. A request from a Verifier the wallet doesn’t trust"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","isActive":true},{"type":"text","text":" before anything is shown."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","isActive":true},{"type":"text","text":" it returns says:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"who is asking: ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","isActive":true},{"text":", its name, and its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","isActive":true},{"text":" when a registrar the","type":"text"},{"text":" ","type":"text"},{"text":"wallet trusts (","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","isActive":true},{"text":") registered it,","type":"text"},{"text":" ","type":"text"},{"text":"with its purpose and the claims it’s registered to ask for;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"what it asks for: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries"},{"text":", each with the held","type":"text"},{"text":" ","type":"text"},{"text":"credentials that can answer it, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the request’s alternatives.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Present","anchor":"Present","type":"heading","level":3},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation: Presentation","    do {","        presentation = try await wallet.startPresentation(request: requestLink)","    } catch let error as WalletError where error.code == .requestRefused {","        \/\/ A refused request: the Verifier was told, and may say where to","        \/\/ take the holder next (OpenID4VP §8.2).","        return wallet.takeRefusalRedirect()","    }","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection: Presentation.Selection","    let disclosures: [Presentation.Disclosure]","    do {","        selection = try await presentation.defaultSelection()","        disclosures = try await presentation.preview(selection: selection)","    } catch {","        \/\/ Nothing can be shown: decline, so the Verifier isn't left waiting.","        _ = try? await presentation.decline()","        throw error","    }","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","isActive":true},{"type":"text","text":" picks the first credential that"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","isActive":true,"type":"reference"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"text":"each query’s ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","isActive":true,"type":"reference"},{"text":" instead: a query that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","isActive":true,"type":"reference"},{"text":" otherwise), and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","isActive":true},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"type":"text","text":"agrees."}],"type":"paragraph"},{"inlineContent":[{"text":"Open ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","isActive":true,"type":"reference"},{"text":", when the Verifier sends","type":"text"},{"text":" ","type":"text"},{"text":"one, in the browser the request came from: it’s how a same-device","type":"text"},{"text":" ","type":"text"},{"text":"flow returns to the Verifier’s page. The library refuses http and","type":"text"},{"text":" ","type":"text"},{"text":"schemes that run code or read local data, but lets through a scheme the","type":"text"},{"text":" ","type":"text"},{"text":"Verifier’s own app may have registered: open an https URL in the","type":"text"},{"text":" ","type":"text"},{"text":"browser, any other only through ","type":"text"},{"code":"UIApplication.open","type":"codeVoice"},{"text":", never in a web","type":"text"},{"text":" ","type":"text"},{"text":"view, and never one in the wallet’s own schemes (","type":"text"},{"code":"openid4vp","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"openid-credential-offer"},{"type":"text","text":", its redirect URI’s), which would start"},{"type":"text","text":" "},{"type":"text","text":"another flow in the wallet."}],"type":"paragraph"},{"text":"When the wallet refuses a request","anchor":"When-the-wallet-refuses-a-request","type":"heading","level":3},{"inlineContent":[{"text":"A request the wallet must not answer — one with ","type":"text"},{"code":"transaction_data","type":"codeVoice"},{"text":" it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t support, or a parameter OpenID4VP forbids — makes","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","isActive":true,"type":"reference"},{"text":" throw","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/requestRefused","isActive":true,"type":"reference"},{"text":", its ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/protocolError","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"the error code the wallet sent the Verifier, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"invalid_transaction_data"},{"text":". Nothing is shown to the holder, and nothing","type":"text"},{"text":" ","type":"text"},{"text":"is presented. The Verifier may answer the refusal with a redirect:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/takeRefusalRedirect()","isActive":true},{"text":" returns it, once, and you open it in","type":"text"},{"text":" ","type":"text"},{"text":"the browser the request came from, as a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","isActive":true},{"text":", so the holder isn’t left","type":"text"},{"text":" ","type":"text"},{"text":"stranded. Tell the holder the request wasn’t answered.","type":"text"}],"type":"paragraph"},{"text":"Show what’s being asked beyond a registration","anchor":"Show-whats-being-asked-beyond-a-registration","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"For a Verifier with a verified registration, each query’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","isActive":true},{"type":"text","text":" lists the claims it asks for beyond"},{"type":"text","text":" "},{"type":"text","text":"what it’s registered to request, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll"},{"type":"text","text":" whether it names no claims at"},{"type":"text","text":" "},{"type":"text","text":"all. The library flags such a query in full, though OpenID4VP 1.0"},{"type":"text","text":" "},{"type":"text","text":"§6.4.1 reads it as asking for no selectively disclosable claims, so a"},{"type":"text","text":" "},{"type":"text","text":"presentation for it discloses only what the credential always shows."},{"type":"text","text":" "},{"type":"text","text":"Nothing is refused for them: show them, and let the holder decide."}],"type":"paragraph"},{"text":"Keep presentations unlinkable","anchor":"Keep-presentations-unlinkable","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each presentation uses a copy of the credential, bound to its own key,"},{"type":"text","text":" "},{"type":"text","text":"so two Verifiers can’t link the holder’s presentations by the"},{"type":"text","text":" "},{"type":"text","text":"credential. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","isActive":true},{"type":"text","text":" chooses which copy:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation","type":"reference","isActive":true},{"type":"text","text":", the default: a"},{"type":"text","text":" "},{"type":"text","text":"copy no Verifier has seen, every time."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","type":"reference"},{"type":"text","text":": the copy a Verifier"},{"type":"text","text":" "},{"type":"text","text":"has seen before, so it can recognize a returning holder, and an unused"},{"type":"text","text":" "},{"type":"text","text":"one for a new Verifier."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once every copy is used, one is reused. A candidate’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"text":" says whether presenting it now would","type":"text"},{"text":" ","type":"text"},{"text":"hand this Verifier a copy another has seen: warn the holder, and","type":"text"},{"text":" ","type":"text"},{"text":"refresh the credential (","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true},{"text":") when its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true},{"text":" reaches zero.","type":"text"}]},{"anchor":"When-delivery-is-uncertain","type":"heading","level":3,"text":"When delivery is uncertain"},{"type":"paragraph","inlineContent":[{"text":"If sending the response fails in a way that leaves it unknown whether","type":"text"},{"text":" ","type":"text"},{"text":"the Verifier received it, ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","type":"reference"},{"type":"text","text":" and doesn’t send it again: the"},{"type":"text","text":" "},{"type":"text","text":"holder should check with the Verifier before sharing again."}]}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"OID4VCWallet"}],"title":"Presenting from a link"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink"},"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"abstract":[{"type":"text","text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,"},{"type":"text","text":" "},{"type":"text","text":"let the holder choose, and present exactly that."}],"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"],"generated":true,"anchor":"Presenting-from-a-link","title":"Presenting from a link"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/unregistered":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","url":"\/documentation\/oid4vcwallet\/presentation\/query\/unregistered","role":"symbol","kind":"symbol","abstract":[{"text":"For a Verifier with a verified registration: the claims paths","type":"text"},{"text":" ","type":"text"},{"text":"this query asks for beyond it, then those its credentials would","type":"text"},{"text":" ","type":"text"},{"text":"disclose along with them beyond it (the rest of an array","type":"text"},{"text":" ","type":"text"},{"text":"disclosed as one, say). Nothing is refused for them: the holder decides.","type":"text"}],"title":"unregistered","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"unregistered"},{"kind":"text","text":": [["},{"preciseIdentifier":"s:12OID4VCWallet12PresentationC11PathElementO","kind":"typeIdentifier","text":"PathElement"},{"kind":"text","text":"]]"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/credentialSets":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credentialSets","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet12PresentationC13CredentialSetV","text":"CredentialSet","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","title":"credentialSets","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/presentation\/credentialsets","abstract":[{"text":"The request’s sets of alternatives; none means every query must","type":"text"},{"text":" ","type":"text"},{"text":"be answered.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/untrustedVerifier":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"untrustedVerifier","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","title":"untrustedVerifier","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/untrustedverifier","abstract":[{"text":"The Verifier’s request is signed with a certificate that","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t chain to ","type":"text"},{"type":"codeVoice","code":"verifierRoots"},{"text":": it’s refused unread.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Registration":{"url":"\/documentation\/oid4vcwallet\/presentation\/registration","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","type":"topic","role":"symbol","kind":"symbol","title":"Presentation.Registration","abstract":[{"type":"text","text":"A Verifier’s registration with a registrar: who it is and what it"},{"type":"text","text":" "},{"type":"text","text":"may request, as the registrar attests."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Registration","kind":"identifier"}],"navigatorTitle":[{"text":"Registration","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/credentials":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","url":"\/documentation\/oid4vcwallet\/presentation\/query\/credentials","role":"symbol","kind":"symbol","abstract":[{"text":"The held credentials that can answer it.","type":"text"}],"title":"credentials","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"credentials"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV","kind":"typeIdentifier","text":"CredentialSummary"},{"kind":"text","text":"]"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","role":"collection","type":"topic","url":"\/documentation\/oid4vcwallet","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}],"title":"OID4VCWallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/CopyPolicy-swift.enum/perVerifier":{"abstract":[{"text":"A Verifier is shown the copy it has seen before, and only a new","type":"text"},{"text":" ","type":"text"},{"text":"Verifier an unused one: Verifiers can’t link presentations to","type":"text"},{"text":" ","type":"text"},{"text":"each other, but one can recognise a returning holder.","type":"text"}],"role":"symbol","title":"WalletConfiguration.CopyPolicy.perVerifier","type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.enum\/perverifier","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"perVerifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Selection":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Selection","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","role":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/presentation\/selection","abstract":[{"type":"text","text":"What to present: for each query ID, the IDs of the credentials"},{"type":"text","text":" "},{"type":"text","text":"chosen to answer it."}],"navigatorTitle":[{"text":"Selection","kind":"identifier"}],"title":"Presentation.Selection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/deliveryUnknown":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliveryUnknown","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","title":"deliveryUnknown","kind":"symbol","role":"symbol","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/deliveryunknown","abstract":[{"text":"Sending a presentation failed in a way that leaves it unknown","type":"text"},{"text":" ","type":"text"},{"text":"whether the Verifier received it: it’s not sent again.","type":"text"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/verifierRoots":{"abstract":[{"text":"PEM certificates: the trust anchors for Verifiers’ requests. A request","type":"text"},{"text":" ","type":"text"},{"text":"signed by a certificate that doesn’t chain to them is refused unread.","type":"text"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/verifierroots","type":"topic","title":"verifierRoots","fragments":[{"text":"var","kind":"keyword"},{"text":