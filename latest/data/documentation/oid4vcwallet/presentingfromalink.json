{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A Verifier asks with an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" link, as a QR code or a link on"},{"type":"text","text":" "},{"type":"text","text":"its page. Register the "},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":" URL scheme in the app’s Info.plist so"},{"type":"text","text":" "},{"type":"text","text":"links open the app, and hand the link to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","isActive":true},{"type":"text","text":". It fetches the Verifier’s"},{"type":"text","text":" "},{"type":"text","text":"signed request, checks its certificate against"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","isActive":true},{"type":"text","text":", and finds the credentials that"},{"type":"text","text":" "},{"type":"text","text":"can answer it. A request from a Verifier the wallet doesn’t trust"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","isActive":true},{"type":"text","text":" before anything is shown."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","isActive":true},{"type":"text","text":" it returns says:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"who is asking: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property"},{"type":"text","text":", its name, and its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration"},{"type":"text","text":" when a registrar the"},{"type":"text","text":" "},{"type":"text","text":"wallet trusts ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots"},{"type":"text","text":") registered it,"},{"type":"text","text":" "},{"type":"text","text":"with its purpose and the claims it’s registered to ask for;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"what it asks for: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries"},{"type":"text","text":", each with the held"},{"type":"text","text":" "},{"type":"text","text":"credentials that can answer it, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the request’s alternatives."}]}]}],"type":"unorderedList"},{"level":3,"type":"heading","anchor":"Present","text":"Present"},{"code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation = try await wallet.startPresentation(request: requestLink)","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection = try await presentation.defaultSelection()","    let disclosures = try await presentation.preview(selection: selection)","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","isActive":true},{"type":"text","text":" picks the first credential that"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"each query’s "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","isActive":true},{"type":"text","text":" instead: a query that"},{"type":"text","text":" "},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","isActive":true},{"type":"text","text":" otherwise), and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","isActive":true},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"type":"text","text":"agrees."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Open "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","isActive":true},{"type":"text","text":", when the Verifier sends"},{"type":"text","text":" "},{"type":"text","text":"one, in the browser the request came from: it’s how a same-device"},{"type":"text","text":" "},{"type":"text","text":"flow returns to the Verifier’s page."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Show-whats-being-asked-beyond-a-registration","text":"Show what’s being asked beyond a registration"},{"inlineContent":[{"type":"text","text":"For a Verifier with a verified registration, each query’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","isActive":true},{"type":"text","text":" lists the claims it asks for beyond"},{"type":"text","text":" "},{"type":"text","text":"what it’s registered to request, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll","isActive":true},{"type":"text","text":" whether it asks for every claim."},{"type":"text","text":" "},{"type":"text","text":"Nothing is refused for them: show them, and let the holder decide."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Keep-presentations-unlinkable","text":"Keep presentations unlinkable"},{"inlineContent":[{"type":"text","text":"Each presentation uses a copy of the credential, bound to its own key,"},{"type":"text","text":" "},{"type":"text","text":"so two Verifiers can’t link the holder’s presentations by the"},{"type":"text","text":" "},{"type":"text","text":"credential. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","isActive":true},{"type":"text","text":" chooses which copy:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation","type":"reference","isActive":true},{"type":"text","text":", the default: a"},{"type":"text","text":" "},{"type":"text","text":"copy no Verifier has seen, every time."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","type":"reference","isActive":true},{"type":"text","text":": the copy a Verifier"},{"type":"text","text":" "},{"type":"text","text":"has seen before, so it can recognize a returning holder, and an unused"},{"type":"text","text":" "},{"type":"text","text":"one for a new Verifier."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Once every copy is used, one is reused. A candidate’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"type":"text","text":" says whether presenting it now would"},{"type":"text","text":" "},{"type":"text","text":"hand this Verifier a copy another has seen: warn the holder, and"},{"type":"text","text":" "},{"type":"text","text":"refresh the credential ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true},{"type":"text","text":") when its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true},{"type":"text","text":" reaches zero."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"When-delivery-is-uncertain","text":"When delivery is uncertain"},{"inlineContent":[{"type":"text","text":"If sending the response fails in a way that leaves it unknown whether"},{"type":"text","text":" "},{"type":"text","text":"the Verifier received it, "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","isActive":true},{"type":"text","text":" and doesn’t send it again: the"},{"type":"text","text":" "},{"type":"text","text":"holder should check with the Verifier before sharing again."}],"type":"paragraph"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"],"title":"Presenting from a link","generated":true,"anchor":"Presenting-from-a-link"}],"abstract":[{"type":"text","text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,"},{"type":"text","text":" "},{"type":"text","text":"let the holder choose, and present exactly that."}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","interfaceLanguage":"swift"},"metadata":{"title":"Presenting from a link","modules":[{"name":"OID4VCWallet"}],"role":"article","roleHeading":"Article"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/CopyPolicy-swift.enum/perVerifier":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.enum\/perverifier","abstract":[{"type":"text","text":"A Verifier is shown the copy it has seen before, and only a new"},{"type":"text","text":" "},{"type":"text","text":"Verifier an unused one: Verifiers can’t link presentations to"},{"type":"text","text":" "},{"type":"text","text":"each other, but one can recognise a returning holder."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perVerifier","kind":"identifier"}],"title":"WalletConfiguration.CopyPolicy.perVerifier","kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","abstract":[{"type":"text","text":"Replaces a "},{"type":"codeVoice","code":"refreshable"},{"type":"text","text":" credential’s copies with a fresh batch,"},{"type":"text","text":" "},{"type":"text","text":"each bound to a new attested key, without the holder (OpenID4VCI"},{"type":"text","text":" "},{"type":"text","text":"1.0 §13.5). Use it when "},{"type":"codeVoice","code":"copiesLeft"},{"type":"text","text":" runs low. Throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"type":"text","text":" when it can’t be refreshed:"},{"type":"text","text":" "},{"type":"text","text":"receive it again from a new offer."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV"}],"title":"refreshCredential(id:)","kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/unregistered":{"url":"\/documentation\/oid4vcwallet\/presentation\/query\/unregistered","abstract":[{"type":"text","text":"For a Verifier with a verified registration: the claims paths"},{"type":"text","text":" "},{"type":"text","text":"this query asks for beyond it, and whether it asks for every"},{"type":"text","text":" "},{"type":"text","text":"claim. Nothing is refused for them: the holder decides."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unregistered","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"PathElement","preciseIdentifier":"s:12OID4VCWallet12PresentationC11PathElementO","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"title":"unregistered","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","type":"topic","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/unregisteredAll":{"url":"\/documentation\/oid4vcwallet\/presentation\/query\/unregisteredall","abstract":[{"text":"Whether it asks for every claim, beyond a verified registration.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unregisteredAll","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"unregisteredAll","kind":"symb