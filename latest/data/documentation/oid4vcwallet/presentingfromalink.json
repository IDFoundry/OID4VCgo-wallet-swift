:"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveryUnknown"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"text":"Code","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/defaultSelection()":{"url":"\/documentation\/oid4vcwallet\/presentation\/defaultselection()","role":"symbol","title":"defaultSelection()","abstract":[{"type":"text","text":"The selection the wallet would make itself, for an app with no"},{"type":"text","text":" "},{"type":"text","text":"policy of its own, or to start from: the first answerable option"},{"type":"text","text":" "},{"type":"text","text":"of each credential set, and each query’s first credential (all of"},{"type":"text","text":" "},{"type":"text","text":"them when it takes several). Throws "},{"type":"codeVoice","code":"noMatchingCredential"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the request can’t be answered."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSelection","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Selection","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC9Selectiona"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Presentation","kind":"identifier"}],"type":"topic","identifie