ons are ignored."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/registrarroots","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startPresentation(request:)":{"abstract":[{"type":"text","text":"Fetches and verifies an OpenID4VP request (openid4vp:\/\/…), and"},{"type":"text","text":" "},{"type":"text","text":"finds the credentials that can answer it."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Presentation","preciseIdentifier":"s:12OID4VCWallet12PresentationC","kind":"typeIdentifier"}],"title":"startPresentation(request:)","url":"\/documentation\/oid4vcwallet\/wallet\/startpresentation(request:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/CopyPolicy-swift.enum/perPresentation":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.enum\/perpresentation","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"perPresentation"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation","abstract":[{"type":"text","text":"Every presentation uses a copy no Verifier has seen: not even"},{"type":"text","text":" "},{"type":"text","text":"one Verifier can link two presentations. The default."}],"type":"topic","title":"WalletConfigurat