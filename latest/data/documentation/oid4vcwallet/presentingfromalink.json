text"},{"text":"unregistered","kind":"identifier"},{"text":": [[","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet12PresentationC11PathElementO","text":"PathElement","kind":"typeIdentifier"},{"text":"]]","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/copiesLeft":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"copiesLeft","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/copiesleft","title":"copiesLeft","abstract":[{"type":"text","text":"How many copies no Verifier has seen."}],"type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/respond(selection:)":{"title":"respond(selection:)","url":"\/documentation\/oid4vcwallet\/presentation\/respond(selection:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","type":"topic","abstract":[{"type":"text","text":"Presents exactly "},{"type":"codeVoice","code":"selection"},{"type":"text","text":": holder keys sign now, so a key"},{"type":"text","text":" "},{"type":"text","text":"store requiring user presence prompts."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"selection","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Selection","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC9Selectiona"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Presented","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12Presen