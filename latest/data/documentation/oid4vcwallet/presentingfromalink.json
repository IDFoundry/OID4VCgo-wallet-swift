{"abstract":[{"type":"text","text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,"},{"type":"text","text":" "},{"type":"text","text":"let the holder choose, and present exactly that."}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A Verifier asks with an "},{"code":"openid4vp:\/\/","type":"codeVoice"},{"type":"text","text":" link, as a QR code or a link on"},{"type":"text","text":" "},{"type":"text","text":"its page. Register the "},{"code":"openid4vp","type":"codeVoice"},{"type":"text","text":" URL scheme in the app’s Info.plist so"},{"type":"text","text":" "},{"type":"text","text":"links open the app, and hand the link to"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","type":"reference","isActive":true},{"type":"text","text":". It fetches the Verifier’s"},{"type":"text","text":" "},{"type":"text","text":"signed request, checks its certificate against"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","type":"reference","isActive":true},{"type":"text","text":", and finds the credentials that"},{"type":"text","text":" "},{"type":"text","text":"can answer it. A request from a Verifier the wallet doesn’t trust"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","type":"reference","isActive":true},{"type":"text","text":" before anything is shown."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","type":"reference","isActive":true},{"type":"text","text":" it returns says:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"who is asking: "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","isActive":true},{"type":"text","text":", its name, and its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","isActive":true},{"type":"text","text":" when a registrar the"},{"type":"text","text":" "},{"text":"wallet trusts (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","type":"reference","isActive":true},{"text":") registered it,","type":"text"},{"text":" ","type":"text"},{"text":"with its purpose and the claims it’s registered to ask for;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"what it asks for: ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries","type":"reference","isActive":true},{"text":", each with the held","type":"text"},{"text":" ","type":"text"},{"text":"credentials that can answer it, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the request’s alternatives.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"Present","anchor":"Present"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation: Presentation","    do {","        presentation = try await wallet.startPresentation(request: requestLink)","    } catch let error as WalletError where error.code == .requestRefused {","        \/\/ A refused request: the Verifier was told, and may say where to","        \/\/ take the holder next (OpenID4VP §8.2).","        return wallet.takeRefusalRedirect()","    }","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection: Presentation.Selection","    let disclosures: [Presentation.Disclosure]","    do {","        selection = try await presentation.defaultSelection()","        disclosures = try await presentation.preview(selection: selection)","    } catch {","        \/\/ Nothing can be shown: decline, so the Verifier isn't left waiting.","        _ = try? await presentation.decline()","        throw error","    }","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"]},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","type":"reference","isActive":true},{"type":"text","text":" picks the first credential that"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","type":"reference","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"each query’s "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","type":"reference","isActive":true},{"type":"text","text":" instead: a query that"},{"type":"text","text":" "},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","type":"reference","isActive":true},{"type":"text","text":" otherwise), and"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","type":"reference","isActive":true},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"type":"text","text":"agrees."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Open "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","type":"reference","isActive":true},{"type":"text","text":", when the Verifier sends"},{"type":"text","text":" "},{"type":"text","text":"one, in the browser the request came from: it’s how a same-device"},{"type":"text","text":" "},{"type":"text","text":"flow returns to the Verifier’s page. The library refuses http and"},{"type":"text","text":" "},{"type":"text","text":"schemes that run code or read local data, but lets through a scheme the"},{"type":"text","text":" "},{"type":"text","text":"Verifier’s own app may have registered: open an https URL in the"},{"type":"text","text":" "},{"type":"text","text":"browser, any other only through "},{"code":"UIApplication.open","type":"codeVoice"},{"type":"text","text":", never in a web"},{"type":"text","text":" "},{"type":"text","text":"view, and never one in the wallet’s own schemes ("},{"code":"openid4vp","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"openid-credential-offer","type":"codeVoice"},{"type":"text","text":", its redirect URI’s), which would start"},{"type":"text","text":" "},{"type":"text","text":"another flow in the wallet."}],"type":"paragraph"},{"type":"heading","level":3,"text":"When the wallet refuses a request","anchor":"When-the-wallet-refuses-a-request"},{"inlineContent":[{"type":"text","text":"A request the wallet must not answer — one with "},{"code":"transaction_data","type":"codeVoice"},{"type":"text","text":" it"},{"type":"text","text":" "},{"text":"doesn’t support, or a parameter OpenID4VP forbids — makes","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)"},{"text":" throw","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/requestRefused"},{"text":", its ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/protocolError"},{"text":" ","type":"text"},{"text":"the error code the wallet sent the Verifier, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"invalid_transaction_data"},{"text":". Nothing is shown to the holder, and nothing","type":"text"},{"text":" ","type":"text"},{"text":"is presented. The Verifier may answer the refusal with a redirect:","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/takeRefusalRedirect()"},{"text":" returns it, once, and you open it in","type":"text"},{"text":" ","type":"text"},{"text":"the browser the request came from, as a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI"},{"type":"text","text":", so the holder isn’t left"},{"text":" ","type":"text"},{"text":"stranded. Tell the holder the request wasn’t answered.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Show what’s being asked beyond a registration","anchor":"Show-whats-being-asked-beyond-a-registration"},{"inlineContent":[{"text":"For a Verifier with a verified registration, each query’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","type":"reference","isActive":true},{"text":" lists the claims it asks for beyond","type":"text"},{"text":" ","type":"text"},{"text":"what it’s registered to request, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll"},{"text":" whether it names no claims at","type":"text"},{"text":" ","type":"text"},{"text":"all. The library flags such a query in full, though OpenID4VP 1.0","type":"text"},{"text":" ","type":"text"},{"text":"§6.4.1 reads it as asking for no selectively disclosable claims, so a","type":"text"},{"text":" ","type":"text"},{"text":"presentation for it discloses only what the credential always shows.","type":"text"},{"text":" ","type":"text"},{"text":"Nothing is refused for them: show them, and let the holder decide.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Keep presentations unlinkable","anchor":"Keep-presentations-unlinkable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each presentation uses a copy of the credential, bound to its own key,"},{"type":"text","text":" "},{"type":"text","text":"so two Verifiers can’t link the holder’s presentations by the"},{"type":"text","text":" "},{"type":"text","text":"credential. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","isActive":true},{"type":"text","text":" chooses which copy:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation","type":"reference","isActive":true},{"text":", the default: a","type":"text"},{"text":" ","type":"text"},{"text":"copy no Verifier has seen, every time.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","type":"reference","isActive":true},{"text":": the copy a Verifier","type":"text"},{"text":" ","type":"text"},{"text":"has seen before, so it can recognize a returning holder, and an unused","type":"text"},{"text":" ","type":"text"},{"text":"one for a new Verifier.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once every copy is used, one is reused. A candidate’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"type":"text","text":" says whether presenting it now would"},{"type":"text","text":" "},{"type":"text","text":"hand this Verifier a copy another has seen: warn the holder, and"},{"type":"text","text":" "},{"type":"text","text":"refresh the credential ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true},{"type":"text","text":") when its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true},{"type":"text","text":" reaches zero."}]},{"text":"When delivery is uncertain","type":"heading","level":3,"anchor":"When-delivery-is-uncertain"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If sending the response fails in a way that leaves it unknown whether"},{"type":"text","text":" "},{"type":"text","text":"the Verifier received it, "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","isActive":true},{"type":"text","text":" and doesn’t send it again: the"},{"type":"text","text":" "},{"type":"text","text":"holder should check with the Verifier before sharing again."}]}]}],"metadata":{"roleHeading":"Article","title":"Presenting from a link","modules":[{"name":"OID4VCWallet"}],"role":"article"},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Presenting-from-a-link","title":"Presenting from a link","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"kind":"article","references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/RequestLink":{"type":"topic","title":"RequestLink","abstract":[{"type":"text","text":"An OpenID4VP request link’s parts."}],"navigatorTitle":[{"kind":"identifier","text":"RequestLink"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestLink"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/requestlink","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"role":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"topic","abstract":[{"type":"text","text":"Replaces a "},{"type":"codeVoice","code":"refreshable"},{"type":"text","text":" credential’s copies with a fresh batch,"},{"type":"text","text":" "},{"text":"each bound to a new attested key, without the holder (OpenID4VCI","type":"text"},{"type":"text","text":" "},{"type":"text","text":"1.0 §13.5). Use it when "},{"type":"codeVoice","code":"copiesLeft"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"type":"text","text":" when it can’t be refreshed:"},{"type":"text","text":" "},{"type":"text","text":"receive it again from a new offer."}],"title":"refreshCredential(id:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/defaultSelection()":{"role":"symbol","url":"\/documentation\/oid4vcwallet\/presentation\/defaultselection()","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()","type":"topic","abstract":[{"type":"text","text":"The selection the wallet would make itself, for an app with no"},{"type":"text","text":" "},{"type":"text","text":"policy of its own, or to start from: the first answerable option"},{"type":"text","text":" "},{"type":"text","text":"of each credential set, and each query’s first credential, even"},{"type":"text","text":" "},{"type":"text","text":"when it takes several: the holder adds the others. Throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"noMatchingCredential"},{"type":"text","text":" when the request can’t be answered."}],"title":"defaultSelection()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultSelection"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC9Selectiona","text":"Selection"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Presented/redirectURI":{"role":"symbol","abstract":[{"type":"text","text":"Where to send the browser, when the Verifier asks."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","title":"redirectURI","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"redirectURI"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":"?"}],"url":"\/documentation\/oid4vcwallet\/presentation\/presented\/redirecturi","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/verifierRoots":{"role":"symbol","abstract":[{"text":"PEM certificates: the trust anchors for Verifiers’ requests. A request","type":"text"},{"text":" ","type":"text"},{"text":"signed by a certificate that doesn’t chain to them is refused unread.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","title":"verifierRoots","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifierRoots","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/verifierroots","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/CopyPolicy-swift.enum/perVerifier":{"abstract":[{"text":"A Verifier is shown the copy it has seen before, and only a new","type":"text"},{"text":" ","type":"text"},{"text":"Verifier an unused one: Verifiers can’t link presentations to","type":"text"},{"text":" ","type":"text"},{"text":"each other, but one can recognise a returning holder.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","title":"WalletConfiguration.CopyPolicy.perVerifier","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.enum\/perverifier","role":"symbol","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perVerifier","kind":"identifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/registrarRoots":{"role":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/registrarroots","abstract":[{"type":"text","text":"PEM certificates: the registrars whose registrations of Verifiers"},{"type":"text","text":" "},{"type":"text","text":"the wallet checks ("},{"type":"codeVoice","code":"Presentation.Verifier.registration"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"registrations are ignored."}],"title":"registrarRoots","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registrarRoots","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/protocolError":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"protocolError"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The remote party’s OAuth error code, such as "},{"type":"codeVoice","code":"invalid_grant"},{"type":"text","text":" (a"},{"type":"text","text":" "},{"type":"text","text":"wrong PIN) or "},{"type":"codeVoice","code":"access_denied"},{"type":"text","text":", when it gave one. For"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidInput","type":"reference","isActive":true},{"type":"text","text":" it’s "},{"type":"codeVoice","code":"not_configured"},{"type":"text","text":" ("},{"type":"codeVoice","code":"MobileDetailNotConfigured"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"when the wallet’s configuration lacks what the call needs — such"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"issuerRoots"},{"type":"text","text":" or "},{"type":"codeVoice","code":"redirectURI"},{"type":"