ifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/registrarRoots":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/registrarroots","title":"registrarRoots","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"registrarRoots"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"abstract":[{"type":"text","text":"PEM certificates: the registrars whose registrations of Verifiers"},{"type":"text","text":" "},{"type":"text","text":"the wallet checks ("},{"type":"codeVoice","code":"Presentation.Verifier.registration"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"registrations are ignored."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/verifierRoots":{"type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/verifierroots","abstract":[{"type":"text","text":"PEM certificates: the trust anchors for Verifiers’ requests. A request"},{"type":"text","text":" "},{"type":"text","text":"signed by a certificate that doesn’t chain to them is refused unread."}],"title":"verifierRoots","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifierRoots"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/unregisteredAll":{"title":"unregisteredAll","kind":"symbol","url"