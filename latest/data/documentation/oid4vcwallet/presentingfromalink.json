lder, and an unused"},{"type":"text","text":" "},{"type":"text","text":"one for a new Verifier."}]}]}]},{"inlineContent":[{"type":"text","text":"Once every copy is used, one is reused. A candidate’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere"},{"type":"text","text":" says whether presenting it now would"},{"type":"text","text":" "},{"type":"text","text":"hand this Verifier a copy another has seen: warn the holder, and"},{"type":"text","text":" "},{"type":"text","text":"refresh the credential ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)"},{"type":"text","text":") when its"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft"},{"type":"text","text":" reaches zero."}],"type":"paragraph"},{"level":3,"text":"When delivery is uncertain","anchor":"When-delivery-is-uncertain","type":"heading"},{"inlineContent":[{"text":"If sending the response fails in a way that leaves it unknown whether","type":"text"},{"text":" ","type":"text"},{"text":"the Verifier received it, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)","type":"reference"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","type":"reference"},{"text":" and doesn’t send it again: the","type":"text"},{"text":" ","type":"text"},{"text":"holder should check with the Verifier before sharing again.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcw