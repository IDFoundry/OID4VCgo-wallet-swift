{"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"anchor":"Presenting-to-Safari","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"generated":true,"title":"Presenting to Safari"}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Answer a web page’s request for an mdoc over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, as an iOS document provider.","type":"text"}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"title":"Presenting to Safari","role":"article","roleHeading":"Article"},"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, using the "},{"code":"org-iso-mdoc","type":"codeVoice"},{"type":"text","text":" protocol (ISO\/IEC TS"},{"type":"text","text":" "},{"type":"text","text":"18013-7 Annex C). iOS offers the apps that registered a matching"},{"type":"text","text":" "},{"type":"text","text":"document, and shows the chosen app’s document provider extension for"},{"type":"text","text":" "},{"type":"text","text":"the holder’s consent. The extension answers through"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","isActive":true},{"type":"text","text":"; the"},{"type":"text","text":" "},{"type":"text","text":"response goes back through Safari, encrypted to the page, with no"},{"type":"text","text":" "},{"type":"text","text":"network request from the wallet."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Safari sends only "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":", not OpenID4VP, and on iOS only:"},{"type":"text","text":" "},{"type":"text","text":"Safari on macOS has no document providers."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Set up the app and its extension","anchor":"Set-up-the-app-and-its-extension"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The extension:","type":"text"}]},{"type":"text","text":" a target whose Info.plist names the extension"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"type":"codeVoice","code":"com.apple.identity-document-services.document-provider-ui"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"EXAppExtensionAttributes"},{"type":"text","text":", "},{"type":"codeVoice","code":"EXExtensionPointIdentifier"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"The capability:","type":"text"}],"type":"strong"},{"type":"text","text":" Digital Credentials API – Mobile Document"},{"type":"text","text":" "},{"type":"text","text":"Provider, on both the app’s and the extension’s App IDs, with the"},{"type":"text","text":" "},{"type":"text","text":"doctypes the app presents in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types"},{"type":"text","text":" "},{"type":"text","text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL"},{"type":"text","text":" "},{"type":"text","text":"and Photo ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared storage:"}]},{"text":" the extension is another process, so the app","type":"text"},{"text":" ","type":"text"},{"text":"keeps its credentials in an App Group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},{"text":"), and its holder keys in","type":"text"},{"text":" ","type":"text"},{"text":"a Keychain access group both list","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true},{"type":"text","text":"). Instance and DPoP"},{"type":"text","text":" "},{"type":"text","text":"keys stay in the app’s own group: the extension presents, but doesn’t"},{"type":"text","text":" "},{"type":"text","text":"receive. The app saves its configuration where the extension can"},{"type":"text","text":" "},{"type":"text","text":"read it too."}],"type":"paragraph"}]}]},{"type":"codeListing","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"Register the documents","anchor":"Register-the-documents"},{"type":"paragraph","inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change, register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"supportedAuthorityKeyIdentifiers"},{"text":" names the reader CAs, by subject key","type":"text"},{"text":" ","type":"text"},{"text":"identifier, whose requests the document answers.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"Answer in the extension","anchor":"Answer-in-the-extension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS hands the extension the request in two stages. First,"},{"type":"text","text":" "},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.request"},{"type":"text","text":" describes what’s asked,"},{"type":"text","text":" "},{"type":"text","text":"for the consent screen: show it with the website’s origin, and the"},{"type":"text","text":" "},{"type":"text","text":"candidates from "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","isActive":true},{"type":"text","text":". Only when the"},{"type":"text","text":" "},{"type":"text","text":"holder shares does iOS release the request itself, to"},{"type":"text","text":" "},{"type":"codeVoice","code":"sendResponse"},{"type":"text","text":"‘s closure. Validate it there, parse it, check it’s what"},{"type":"text","text":" "},{"type":"text","text":"the holder was shown, and answer."}]},{"type":"codeListing","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","","    var body: some View {","        Button(\"Share\") { Task { try await share(credentialID: nil) } }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil) for the request's first document.","    func share(credentialID: String?) async throws {","        guard let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let wallet = try SharedWallet.open(provider: nil)","        try await context.sendResponse { raw in","            _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","            let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","            guard let document = presentation.request.documents.first,","                  let chosen = credentialID ?? document.credentials.first?.id else { throw RequestChanged() }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            let response = try await presentation.respond(document: 0, credentialID: chosen, elements: document.elements)","            return ISO18013MobileDocumentResponse(responseData: response.response)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A real consent screen compares the released request with what it","type":"text"},{"text":" ","type":"text"},{"text":"showed — the same document, elements and reader — and refuses one that","type":"text"},{"text":" ","type":"text"},{"text":"changed. The demo wallet’s ","type":"text"},{"type":"codeVoice","code":"DocumentProvider"},{"text":" target does this in full.","type":"text"}]},{"level":3,"type":"heading","text":"Name the reader","anchor":"Name-the-reader"},{"type":"paragraph","inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"18013-5 reader authentication). When the certificate chains to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true},{"type":"text","text":" "},{"type":"text","text":"names it; otherwise show only the website’s origin."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true},{"type":"text","text":" accepts only certificates"},{"type":"text","text":" "},{"text":"issued for readers, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader"},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}]},{"level":3,"type":"heading","text":"Warn of linkable presentations","anchor":"Warn-of-linkable-presentations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each candidate’s "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true},{"type":"text","text":" says whether"},{"type":"text","text":" "},{"type":"text","text":"presenting it would hand this website a copy another website has seen,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true},{"type":"text","text":" whether it did. The"},{"type":"text","text":" "},{"type":"text","text":"extension doesn’t refresh used-up copies: have the app do it when it"},{"type":"text","text":" "},{"type":"text","text":"next becomes active, after listing its credentials again."}]}]}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"abstract":[{"type":"text","text":"Whether the copy presented had been seen by another Verifier."}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","kind":"symbol","title":"linkable","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkable","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/response\/linkable"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"abstract":[{"type":"text","text":"Refuses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request no recognized reader signed:"},{"type":"text","text":" "},{"type":"codeVoice","code":"startMdocPresentation"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"untrustedVerifier"},{"type":"text","text":", and nothing is"},{"type":"text","text":" "},{"type":"text","text":"shown to the holder. Needs "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","kind":"symbol","title":"requireTrustedMdocReader","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requireTrustedMdocReader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation","title":"MdocPresentation","role":"symbol","abstract":[{"text":"An ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" request (ISO\/IEC TS 18013-7 Annex C): show","type":"text"},{"text":" ","type":"text"},{"code":"request","type":"codeVoice"},{"text":" for the holder’s consent, then ","type":"text"},{"code":"respond","type":"codeVoice"},{"text":" once; to decline,","type":"text"},{"text":" ","type":"text"},{"text":"cancel the platform’s request — nothing is sent to the reader.","type":"text"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MdocPresentation","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation","navigatorTitle":[{"text":"MdocPresentation","kind":"identifier"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(document:credentialID:elements:)":{"url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(document:credentialid:elements:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","title":"respond(document:credentialID:elements:)","abstract":[{"text":"Presents the held mdoc ","type":"text"},{"type":"codeVoice","code":"credentialID"},{"text":" for document number","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"document"},{"text":", disclosing exactly ","type":"text"},{"type":"codeVoice","code":"elements"},{"text":", each one it requested.","type":"text"},{"text":" ","type":"text"},{"text":"The holder key signs now, so a key store requiring user presence","type":"text"},{"text":" ","type":"text"},{"text":"prompts.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"document"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"credentialID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elements"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC7ElementV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Response","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/mdocCandidates(origin:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/mdoccandidates(origin:)","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","kind":"symbol","title":"mdocCandidates(origin:)","abstract":[{"text":"The held mdocs, each with whether the page at ","type":"text"},{"type":"codeVoice","code":"origin"},{"text":" has been","type":"text"},{"text":" ","type":"text"},{"text":"shown it and whether presenting it there now would be linkable","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"shownToVerifier"},{"text":", ","type":"text"},{"type":"codeVoice","code":"linkableHere"},{"text":"): for a document provider’s","type":"text"},{"text":" ","type":"text"},{"text":"consent screen, shown before iOS releases the request itself.","type":"text"},{"text":" ","type":"text"},{"code":"MdocPresentation.request","type":"codeVoice"},{"text":" says the same once it has.","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocCandidates","kind":"identifier"},{"text":"(","kind":"text"},{"text":"origin","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"CredentialSummary","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialSummaryV"},{"text":"]","kind":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","role":"collection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"title":"OID4VCWallet","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","title":"mdocReaderRoots","role":"symbol","abstract":[{"type":"text","text":"PEM certificates: the mdoc readers recognized when one signs an"},{"type":"text","text":" "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request ("},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"every such request is shown by its origin."}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"url":"\/documentation\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","title":"inAppGroup(_:options:)","abstract":[{"text":"A store in the app group ","type":"text"},{"type":"codeVoice","code":"identifier"},{"text":"’s container","type":"text"},{"text":" ","type":"text"},{"text":"(Library\/Application Support\/credentials there), which the app and","type":"text"},{"text":" ","type":"text"},{"text":"its extensions listing the group in their","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"text":" entitlement share.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inAppGroup"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Options","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"FileCredentialStore","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","title":"holderAccessGroup","abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderAccessGroup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","kind":"symbol","abstract":[{"type":"text","text":"Recognizes only reader certificates with the ISO\/IEC 18013-5"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage (1.0.18013.5.1.6), so a"},{"type":"text","text":" "},{"type":"text","text":"certificate issued for another role under "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":" "},{"type":"text","text":"isn’t taken for a reader’s."}],"title":"mdocReaderRequireEKU","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRequireEKU","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct