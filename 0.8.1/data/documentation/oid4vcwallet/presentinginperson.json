{"metadata":{"roleHeading":"Article","modules":[{"name":"OID4VCWallet"}],"title":"Presenting in person","role":"article"},"abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,","type":"text"},{"text":" ","type":"text"},{"text":"with ISO\/IEC 18013-5 device retrieval.","type":"text"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentinginperson"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"],"generated":true,"title":"Presenting in person","anchor":"Presenting-in-person"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In person, the holder shows a QR code and the reader scans it: the"},{"type":"text","text":" "},{"type":"text","text":"code carries the holder’s ephemeral key and how to reach it over"},{"type":"text","text":" "},{"type":"text","text":"Bluetooth LE. The two devices then exchange encrypted messages over"},{"type":"text","text":" "},{"type":"text","text":"GATT. The package carries the Bluetooth side itself: your app shows or"},{"type":"text","text":" "},{"type":"text","text":"scans the QR code, follows the session’s states, and asks the holder."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both sides need "},{"type":"codeVoice","code":"NSBluetoothAlwaysUsageDescription"},{"type":"text","text":" in the app’s"},{"type":"text","text":" "},{"type":"text","text":"Info.plist. Keep the app in the foreground during a session: neither"},{"type":"text","text":" "},{"type":"text","text":"side keeps one going while the app is suspended. A session answers one"},{"type":"text","text":" "},{"type":"text","text":"request. Bluetooth failures are "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"},{"type":"text","text":"s; protocol failures"},{"type":"text","text":" "},{"type":"text","text":"are "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError"},{"type":"text","text":"s."}],"type":"paragraph"},{"anchor":"Share-as-the-holder","text":"Share as the holder","level":3,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:)"},{"text":" returns a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation"},{"text":" whose ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode"},{"text":" you","type":"text"},{"text":" ","type":"text"},{"text":"show. It advertises until a reader connects, then reports","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)"},{"text":" with who is asking","type":"text"},{"text":" ","type":"text"},{"text":"and what: ask the holder, then respond or decline.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ What the holder agreed to share: a requested document, the held","\/\/\/ mdoc to answer it with, and the elements to disclose.","struct InPersonAnswer {","    let document: Int","    let credentialID: String","    let elements: [MdocPresentation.Element]","}","","\/\/\/ Shares an mdoc in person. `showQRCode` displays the code; `consent`","\/\/\/ shows the reader's request and returns the holder's answer, or nil","\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"type":"codeListing"},{"inlineContent":[{"text":"Show ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader"},{"text":" on the consent screen. A","type":"text"},{"text":" ","type":"text"},{"text":"reader that signs its request (reader authentica