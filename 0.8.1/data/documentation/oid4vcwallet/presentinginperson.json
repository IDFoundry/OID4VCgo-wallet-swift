umentation\/OID4VCWallet\/ProximityReader"},{"text":" needs no ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},{"text":": give it the IACAs whose","type":"text"},{"text":" ","type":"text"},{"text":"mdocs it accepts, and, to sign its requests so holders see who is","type":"text"},{"text":" ","type":"text"},{"text":"asking, a key in a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore"},{"text":" and its certificate chain, with the","type":"text"},{"text":" ","type":"text"},{"text":"reader authentication extended key usage","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration"},{"text":"). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader\/start(qrCode:docType:elements:timeouts:)"},{"text":" ","type":"text"},{"text":"takes the holder’s QR code and what to ask for.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/\/ Reads an mDL's name and portrait from the holder whose QR code was","\/\/\/ scanned. Returns the verified mdoc, or nil if the holder declined.","func readInPerson(qrCode: String, issuerRoots: String) async throws -> VerifiedMdoc? {","    let reader = try ProximityReader(configuration: ProximityReaderConfiguration(issuerRoots: issuerRoots))","    let session = try reader.start(qrCode: qrCode, docType: \"org.iso.18013.5.1.mDL\",","                                   elements: [\"org.iso.18013.5.1\": [\"given_name\", \"family_name\", \"portrait\"]])","    for await state in session.states {","        switch state {","        case .verified(let mdoc):","            return mdoc","        case .failed(let error):"," 