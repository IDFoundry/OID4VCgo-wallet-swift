"},{"type":"text","text":" "},{"type":"text","text":"since a credential is useless without its holder key, which is in"},{"type":"text","text":" "},{"type":"text","text":"this device’s Secure Enclave and can’t be restored elsewhere."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"FileCredentialStore"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileCredentialStore","kind":"identifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore":{"url":"\/documentation\/oid4vcwallet\/credentialstore","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","title":"CredentialStore","abstract":[{"type":"text","text":"The wallet’s credentials, as opaque records kept by ID under the"},{"type":"text","text":" "},{"type":"text","text":"platform’s data protection. "},{"code":"FileCredentialStore","type":"codeVoice"},{"type":"text","text":" is the standard one."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"CredentialStore"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CredentialStore"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"url":"\/documentation\/oid4vcwallet","role":"collection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","kind":"symbol","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"title":"OID4VCWallet","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"url":"\/documentation\/oid4vcwallet\/presentinginperson","role":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/docu