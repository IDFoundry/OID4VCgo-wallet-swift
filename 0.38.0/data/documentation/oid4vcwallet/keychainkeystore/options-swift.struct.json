":" as","type":"text"},{"text":" ","type":"text"},{"code":"respond(document:credentialID:elements:)","type":"codeVoice"},{"type":"text","text":" presents one. A document"},{"type":"text","text":" "},{"type":"text","text":"left out isn’t in the response. No document may be answered twice,"},{"type":"text","text":" "},{"type":"text","text":"nor one credential answer two. Each holder key signs now, in the"},{"type":"text","text":" "},{"type":"text","text":"request’s order; a "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" requiring user presence asks"},{"type":"text","text":" "},{"type":"text","text":"the holder once for them all. On a "},{"code":"WalletError","type":"codeVoice"},{"text":" — the prompt","type":"text"},{"text":" ","type":"text"},{"text":"cancelled, say — nothing is returned, and the request can be","type":"text"},{"text":" ","type":"text"},{"text":"answered again.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"respond","kind":"identifier"},{"text":"(","kind":"text"},{"text":"answers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Answer","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC6AnswerV","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","kind":"typeIdentifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(answers:)","kind":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(answers:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/respond(answers:)":{"role":"symbol","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/respond(answers:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text"