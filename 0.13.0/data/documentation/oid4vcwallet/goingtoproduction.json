{"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/oid4vcwallet\/goingtoproduction"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"abstract":[{"text":"What a wallet needs before real holders use it.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A wallet holding real credentials is only as trustworthy as the"},{"type":"text","text":" "},{"type":"text","text":"platform it runs on. The package enforces some of this itself: without"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","isActive":true,"type":"reference"},{"type":"text","text":", receiving credentials needs a key"},{"type":"text","text":" "},{"type":"text","text":"store and a credential store that both say they’re durable"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore\/isDurable","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/isDurable","isActive":true,"type":"reference"},{"type":"text","text":"), and services on"},{"type":"text","text":" "},{"type":"text","text":"loopback addresses are refused. The rest is the app’s."}],"type":"paragraph"},{"anchor":"Keys-and-storage","level":3,"text":"Keys and storage","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Keep "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true},{"type":"text","text":"’s defaults: keys in the Secure Enclave,"},{"type":"text","text":" "},{"type":"text","text":"persistent, and holder keys asking for Face ID, Touch ID or the"},{"type":"text","text":" "},{"type":"text","text":"passcode before each presentation. Add "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"the Info.plist."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","isActive":true,"type":"reference"},{"text":": complete data protection, out of backups.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryCredentialStore","isActive":true,"type":"reference"},{"text":" is for tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/sweepOrphanedKeys(in:)"},{"text":" at launch, before any issuance,","type":"text"},{"text":" ","type":"text"},{"text":"so keys an interrupted issuance left don’t accumulate.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make one ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},{"text":" per key store and credential store, and share it","type":"text"},{"text":" ","type":"text"},{"text":"for the app’s life. Two over the same stores don’t coordinate: both","type":"text"},{"text":" ","type":"text"},{"text":"could present the same copy of a credential, so Verifiers could link","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the presentations, or redeem the same refresh token, so the"},{"type":"text","text":" "},{"text":"authorization server revokes the grant.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A device restored from a backup has no holder keys: its credentials","type":"text"},{"text":" ","type":"text"},{"text":"show ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/holderKeyPresent"},{"text":" as false and can’t be","type":"text"},{"text":" ","type":"text"},{"text":"presented. Delete them, and receive them again.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"The-Wallet-Provider","type":"heading","level":3,"text":"The Wallet Provider"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Issuers trust the wallet because its Wallet Provider attests it. A"},{"type":"text","text":" "},{"type":"text","text":"production Wallet Provider should attest a wallet and its keys only"},{"type":"text","text":" "},{"type":"text","text":"after checking App Attest evidence that it’s talking to your genuine"},{"type":"text","text":" "},{"type":"text","text":"app on a genuine device, and should keep its own signing key in an"},{"type":"text","text":" "},{"type":"text","text":"HSM. The demo wallet’s provider attests anything, and is for"},{"type":"text","text":" "},{"type":"text","text":"development only."}]},{"anchor":"Trust","type":"heading","level":3,"text":"Trust"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Configure only your ecosystem’s roots: "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/issuerRoots","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for credentials, "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"Verifiers the wallet answers, and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"only for registrars, never for Verifiers or issuers, which could then"},{"type":"text","text":" "},{"type":"text","text":"register themselves."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For readers, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","type":"reference","isActive":true},{"type":"text","text":" with"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","type":"reference","isActive":true},{"type":"text","text":", and"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","type":"reference","isActive":true},{"type":"text","text":" where every reader"},{"type":"text","text":" "},{"type":"text","text":"must be a known one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Never ship with ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","type":"reference","isActive":true},{"text":" set.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"To pin your services’ certificates, set"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","isActive":true},{"type":"text","text":": host → base64 SHA-256 digests of a"},{"type":"text","text":" "},{"type":"text","text":"certificate’s SubjectPublicKeyInfo. Pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},{"type":"text","text":"doesn’t break the app, and keep a backup pin: a wrong set locks the"},{"type":"text","text":" "},{"text":"wallet out of that host until an update. Pins cover the SDK’s own","type":"text"},{"text":" ","type":"text"},{"text":"requests, which ","type":"text"},{"type":"codeVoice","code":"NSPinnedDomains"},{"type":"text","text":" doesn’t reach, not your app’s, such"},{"type":"text","text":" "},{"type":"text","text":"as to your Wallet Provider: pin that "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" yourself."}],"type":"paragraph"}]}]},{"anchor":"Privacy","type":"heading","text":"Privacy","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Request batches of copies ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":") and"},{"type":"text","text":" "},{"type":"text","text":"refresh them as they’re used up ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"so presentations stay unlinkable; warn the holder when one wouldn’t"},{"type":"text","text":" "},{"type":"text","text":"be ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Log "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/message","type":"reference","isActive":true},{"type":"text","text":", never claims or credentials."}]}]}]},{"anchor":"The-build","type":"heading","text":"The build","level":3},{"type":"paragraph","inlineContent":[{"text":"Ship the release build of ","type":"text"},{"type":"codeVoice","code":"Mobile"},{"text":", which the package links by default.","type":"text"},{"text":" ","type":"text"},{"text":"Refuse to run on the test build, which carries an in-process issuer and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Verifier: check "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","type":"reference","isActive":true},{"type":"text","text":" at launch."}]},{"text":"A document provider extension","type":"heading","level":3,"anchor":"A-document-provider-extension"},{"inlineContent":[{"type":"text","text":"The app and its extension each update a credential’s record — marking"},{"type":"text","text":" "},{"type":"text","text":"a copy presented, replacing copies on refresh — with a lock that spans"},{"type":"text","text":" "},{"type":"text","text":"only their own process. Refresh credentials when the app becomes"},{"type":"text","text":" "},{"type":"text","text":"active, not while it’s in the background, so the two don’t write the"},{"type":"text","text":" "},{"type":"text","text":"same record at once."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","title":"Going to production","role":"article"},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"generated":true,"anchor":"Essentials"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InMemoryCredentialStore":{"url":"\/documentation\/oid4vcwallet\/inmemorycredentialstore","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWal