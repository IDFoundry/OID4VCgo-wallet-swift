{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingfromalink"]}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"metadata":{"modules":[{"name":"OID4VCWallet"}],"role":"article","roleHeading":"Article","title":"Presenting from a link"},"abstract":[{"text":"Answer a Verifier’s OpenID4VP request: show who is asking and what,","type":"text"},{"text":" ","type":"text"},{"text":"let the holder choose, and present exactly that.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A Verifier asks with an "},{"type":"codeVoice","code":"openid4vp:\/\/"},{"type":"text","text":" link, as a QR code or a link on"},{"type":"text","text":" "},{"type":"text","text":"its page. Register the "},{"type":"codeVoice","code":"openid4vp"},{"type":"text","text":" URL scheme in the app’s Info.plist so"},{"type":"text","text":" "},{"type":"text","text":"links open the app, and hand the link to"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)","type":"reference","isActive":true},{"type":"text","text":". It fetches the Verifier’s"},{"type":"text","text":" "},{"type":"text","text":"signed request, checks its certificate against"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","type":"reference","isActive":true},{"type":"text","text":", and finds the credentials that"},{"type":"text","text":" "},{"type":"text","text":"can answer it. A request from a Verifier the wallet doesn’t trust"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/untrustedVerifier","type":"reference","isActive":true},{"type":"text","text":" before anything is shown."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","isActive":true},{"text":" it returns says:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"who is asking: "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property","isActive":true},{"type":"text","text":", its name, and its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","isActive":true},{"type":"text","text":" when a registrar the"},{"type":"text","text":" "},{"type":"text","text":"wallet trusts ("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/registrarRoots","isActive":true},{"type":"text","text":") registered it,"},{"type":"text","text":" "},{"type":"text","text":"with its purpose and the claims it’s registered to ask for;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"what it asks for: "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/queries","isActive":true},{"type":"text","text":", each with the held"},{"type":"text","text":" "},{"type":"text","text":"credentials that can answer it, and "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/credentialSets","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the request’s alternatives."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Present","level":3,"text":"Present","type":"heading"},{"code":["import Foundation","import OID4VCWallet","","\/\/\/ Answers a request link: `confirm` shows the holder who is asking and","\/\/\/ what sharing would disclose, and returns whether they agree. Returns","\/\/\/ where to send the browser, when the Verifier asks.","func present(requestLink: String, wallet: Wallet,","             confirm: (Presentation, [Presentation.Disclosure]) async -> Bool) async throws -> URL? {","    let presentation = try await wallet.startPresentation(request: requestLink)","    guard presentation.isAnswerable else {","        return try await presentation.decline().redirectURI","    }","    let selection = try await presentation.defaultSelection()","    let disclosures = try await presentation.preview(selection: selection)","    guard await confirm(presentation, disclosures) else {","        return try await presentation.decline().redirectURI","    }","    \/\/ The holder key signs now: Face ID, if the key store asks for it.","    return try await presentation.respond(selection: selection).redirectURI","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/defaultSelection()"},{"text":" picks the first credential that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"answers each query, and the first answerable option of each credential"},{"type":"text","text":" "},{"type":"text","text":"set. To let the holder choose, build a "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection","type":"reference","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"each query’s "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/credentials","type":"reference","isActive":true},{"type":"text","text":" instead: a query that"},{"type":"text","text":" "},{"type":"text","text":"takes one credential gets exactly one. The wallet presents exactly the"},{"type":"text","text":" "},{"type":"text","text":"selection, after checking it answers the request"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","type":"reference","isActive":true},{"type":"text","text":" otherwise), and"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/preview(selection:)","type":"reference","isActive":true},{"type":"text","text":" says what it would disclose"},{"type":"text","text":" "},{"type":"text","text":"without signing or sending anything: show that before the holder"},{"type":"text","text":" "},{"type":"text","text":"agrees."}],"type":"paragraph"},{"inlineContent":[{"text":"Open ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Presented\/redirectURI","isActive":true,"type":"reference"},{"text":", when the Verifier sends","type":"text"},{"text":" ","type":"text"},{"text":"one, in the browser the request came from: it’s how a same-device","type":"text"},{"text":" ","type":"text"},{"text":"flow returns to the Verifier’s page.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Show what’s being asked beyond a registration","anchor":"Show-whats-being-asked-beyond-a-registration","type":"heading"},{"inlineContent":[{"text":"For a Verifier with a verified registration, each query’s","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregistered","type":"reference","isActive":true},{"type":"text","text":" lists the claims it asks for beyond"},{"type":"text","text":" "},{"type":"text","text":"what it’s registered to request, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll","type":"reference","isActive":true},{"type":"text","text":" whether it asks for every claim."},{"type":"text","text":" "},{"type":"text","text":"Nothing is refused for them: show them, and let the holder decide."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Keep-presentations-unlinkable","text":"Keep presentations unlinkable"},{"type":"paragraph","inlineContent":[{"text":"Each presentation uses a copy of the credential, bound to its own key,","type":"text"},{"text":" ","type":"text"},{"text":"so two Verifiers can’t link the holder’s presentations by the","type":"text"},{"text":" ","type":"text"},{"text":"credential. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","isActive":true,"type":"reference"},{"text":" chooses which copy:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perPresentation","type":"reference"},{"text":", the default: a","type":"text"},{"text":" ","type":"text"},{"text":"copy no Verifier has seen, every time.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/CopyPolicy-swift.enum\/perVerifier","isActive":true},{"type":"text","text":": the copy a Verifier"},{"type":"text","text":" "},{"type":"text","text":"has seen before, so it can recognize a returning holder, and an unused"},{"type":"text","text":" "},{"type":"text","text":"one for a new Verifier."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Once every copy is used, one is reused. A candidate’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true,"type":"reference"},{"text":" says whether presenting it now would","type":"text"},{"text":" ","type":"text"},{"text":"hand this Verifier a copy another has seen: warn the holder, and","type":"text"},{"text":" ","type":"text"},{"text":"refresh the credential (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","isActive":true,"type":"reference"},{"text":") when its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","isActive":true,"type":"reference"},{"text":" reaches zero.","type":"text"}]},{"anchor":"When-delivery-is-uncertain","type":"heading","level":3,"text":"When delivery is uncertain"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If sending the response fails in a way that leaves it unknown whether"},{"type":"text","text":" "},{"type":"text","text":"the Verifier received it, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown"},{"type":"text","text":" and doesn’t send it again: the"},{"type":"text","text":" "},{"type":"text","text":"holder should check with the Verifier before sharing again."}]}]}],"seeAlsoSections":[{"title":"Presenting from a link","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink"],"generated":true,"anchor":"Presenting-from-a-link"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Selection":{"abstract":[{"type":"text","text":"What to present: for each query ID, the IDs of the credentials"},{"type":"text","text":" "},{"type":"text","text":"chosen to answer it."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Selection"}],"url":"\/documentation\/oid4vcwallet\/presentation\/selection","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Selection"}],"title":"Presentation.Selection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Selection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/verifier-swift.property":{"kind":"symbol","abstract":[{"type":"text","text":"Who is asking."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Verifier","preciseIdentifier":"s:12OID4VCWallet12PresentationC8VerifierV"}],"url":"\/documentation\/oid4vcwallet\/presentation\/verifier-swift.property","type":"topic","title":"verifier","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/verifier-swift.property"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/RequestLink":{"url":"\/documentation\/oid4vcwallet\/requestlink","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RequestLink","role":"symbol","kind":"symbol","abstract":[{"text":"An OpenID4VP request link’s parts.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RequestLink"}],"title":"RequestLink","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestLink"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startPresentation(request:)":{"kind":"symbol","abstract":[{"type":"text","text":"Fetches and verifies an OpenID4VP request (openid4vp:\/\/…), and"},{"type":"text","text":" "},{"type":"text","text":"finds the credentials that can answer it."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Presentation","preciseIdentifier":"s:12OID4VCWallet12PresentationC"}],"url":"\/documentation\/oid4vcwallet\/wallet\/startpresentation(request:)","type":"topic","title":"startPresentation(request:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startPresentation(request:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/copyPolicy-swift.property":{"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/copypolicy-swift.property","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/copyPolicy-swift.property","title":"copyPolicy","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"copyPolicy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12OID4VCWallet19WalletConfigurationV10CopyPolicyO","kind":"typeIdentifier","text":"CopyPolicy"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Which copy of a credential a presentation uses."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/linkableHere":{"title":"linkableHere","role":"symbol","kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/