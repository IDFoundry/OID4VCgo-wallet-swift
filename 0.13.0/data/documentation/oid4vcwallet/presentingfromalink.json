allet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/deliveryUnknown","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/deliveryunknown","abstract":[{"type":"text","text":"Sending a presentation failed in a way that leaves it unknown"},{"type":"text","text":" "},{"type":"text","text":"whether the Verifier received it: it’s not sent again."}],"title":"deliveryUnknown","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliveryUnknown","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Code","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","kind":"typeIdentifier"}],"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/invalidSelection":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/invalidSelection","title":"invalidSelection","abstract":[{"type":"text","text":"A presentation’s selection doesn’t answer the request as it"},{"type":"text","text":" "},{"type":"text","text":"asks: an unknown query or credential, one that doesn’t answer"},{"type":"text","text":" "},{"type":"text","text":"its query, more than one for a query that takes one, or a"},{"type":"text","text":" "},{"type":"text","text":"required credential set left unanswered."}],"url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/invalidselection","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidSelection","kind":"identifier"},{"text":": ","kind":"text"},{"text":"WalletError","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV"},{"text":".","kind":"text"},{"text":"Code","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Query/unregisteredAll":{"url":"\/documentation\/oid4vcwallet\/presentation\/query\/unregisteredall","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Query\/unregisteredAll","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Whether it asks for every claim, beyond a verified registration."}],"title":"unregisteredAll","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unregisteredAll","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/respond(selection:)":{"kind":"symbol","abstract":[{"type":"text","text":"Presents exactly "},{"type":"codeVoice","code":"selection"},{"type":"text","text":": holder keys sign now, so a key"},{"type":"text","text":" "},{"type":"text","text":"store requiring user presence prompts."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"selection"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12OID4VCWallet12PresentationC9Selectiona","kind":"typeIdentifier","text":"Selection"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet12PresentationC9PresentedV","kind":"typeIdentifier","text":"Presented"}],"url":"\/documentation\/oid4vcwallet\/presentation\/respond(selection:)","type":"topic","title":"respond(selection:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/respond(selection:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Presentation/Registration":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Presentation\/Registration","url":"\/documentation\/oid4vcwallet\/presentation\/registration","abstract":[{"text":"A Verifier’s registration with a registrar: who it is and what it","type":"text"},{"text":" ","type":"text"},{"text":"may request, as the registrar attests.","type":"text"}],"title":"Presentation.Registration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Registration"}],"navigatorTitle":[{"text":"Registration","kind":"identifier"}],"type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","title":"refreshCredential(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refreshCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Replaces a "},{"type":"codeVoice","code":"refreshable"},{"type":"text","text":" credential’s copies with a fresh batch,"},{"type":"text","text":" "},{"type":"text","text":"each bound to a new attested key, without the holder (OpenID4VCI"},{"type":"text","text":" "},{"type":"text","text":"1.0 §13.5). Use it when "},{"type":"codeVoice","code":"copiesLeft"},{"type":"tex