iguration"}],"navigatorTitle":[{"kind":"identifier","text":"ProximityReaderConfiguration"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/proximityreaderconfiguration","title":"ProximityReaderConfiguration","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"ProximityReader"},{"text":"’s configuration.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"title":"OID4VCWallet","role":"collection","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"type":"text","text":" "},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, and in person over Bluetooth."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderConfiguration/statusCacheDir":{"title":"statusCacheDir","role":"symbol","abstract":[{"type":"text","text":"Where "},{"type":"codeVoice","code":"checkStatus"},{"type":"text","text":" keeps lists across launches, as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/statusCacheDir","isActive":true},{"type":"text","text":"."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statusCacheDir","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/proximityreaderconfiguration\/statuscachedir","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration\/statusCacheDir"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/statusCacheDir":{"kind":"symbol","title":"statusCacheDir","abstract":[{"type":"text","text":"Where "},{"code":"checkStatus","type":"codeVoice"},{"type":"text","text":" keeps the lists it verified across launches: a"},{"type":"text","text":" "},{"type":"text","text":"launch then asks each list’s server whether the list it kept is"},{"type":"text","text":" "},{"type":"text","text":"current, a "},{"code":"304 Not Modified","type":"codeVoice"},{"type":"text","text":" rather than the list, and never uses"},{"type":"text","text":" "},{"type":"text","text":"one the server hasn’t confirmed. The lists are authenticated with"},{"type":"text","text":" "},{"type":"text","text":"a key the library makes and keeps in the Keychain, so one anyone"},{"type":"text","text":" "},{"type":"text","text":"else wrote to the directory is dropped. Nil, the default, keeps"},{"type":"text","text":" "},{"type":"text","text":"them in "},{"code":"oid4vcwallet-status-lists","type":"codeVoice"},{"type":"text","text":" in the app’s Caches directory,"},{"type":"text","text":" "},{"type":"text","text":"with complete file protection, or in memory only when that key"},{"type":"text","text":" "},{"type":"text","text":"can’t be had or the directory made, and on macOS; an absolute"},{"type":"text","text":" "},{"type":"text","text":"path, the app’s own, keeps them there, with the protection the"},{"type":"text","text":" "},{"type":"text","text":"app gives it; empty keeps them in memory only. The directory shows"},{"type":"text","text":" "},{"type":"text","text":"whoever can read it which status lists the wallet checks (their"},{"type":"text","text":" "},{"type":"text","text":"URIs, so the issuers of its credentials, not which entries), the"},{"type":"text","text":" "},{"type":"text","text":"lists themselves, and when each was last checked. Under complete"},{"type":"text","text":" "},{"type":"text","text":"protection, a check while the device is locked reads and keeps no"},{"type":"text","text":" "},{"type":"text","text":"list there: it downloads instead."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/statuscachedir","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statusCacheDir"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/statusCacheDir","role":"symbol"}}}