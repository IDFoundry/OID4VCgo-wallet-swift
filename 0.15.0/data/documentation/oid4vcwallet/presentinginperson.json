"\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"]},{"inlineContent":[{"text":"Show ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader"},{"text":" on the consent screen. A","type":"text"},{"text":" ","type":"text"},{"text":"reader that signs its request (reader authentication) is named, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity\/Status-swift.enum\/trusted"},{"text":" when its certificate chains","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots"},{"text":". An unsigned request could","type":"text"},{"text":" ","type":"text"},{"text":"come from anyone who scanned the code. As over the Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader"},{"text":" ends a session","type":"text"},{"text":" ","type":"text"},{"text":"from any other reader before the holder sees it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/cancel()"},{"text":" ends a session at any point, as the","type":"text"},{"text":" ","type":"text"},{"text":"holder leaves the screen, say. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts"},{"text":" sets how long it","type":"text"},{"text":" ","type":"text"},{"text":"waits: by default 60 seconds for a reader to connect, 30 for its","type":"text"},{"text":" ","type":"text"},{"text":"request, and 300 for the holder to decide.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Read as the verifier","anchor":"Read-as-the-verifier","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader"},{"text":" needs no ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},{"text":": give it the IACAs whose","type":"text"},{"text":" ","type":"text"},{"text":"mdocs it accepts, and, to sign its requests so holders see who is","type":"text"},{"text":" ","type":"text"},{"text":"asking, a key in a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4V