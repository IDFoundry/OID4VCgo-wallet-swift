\/Logo","abstract":[{"type":"text","text":"An image the issuer names for display: an https URL or a data: image"},{"type":"text","text":" "},{"type":"text","text":"(nothing else reaches the app, nor an https URL naming an IP address or"},{"type":"text","text":" "},{"type":"text","text":"localhost), with alternative text. Loading the URL tells whoever serves"},{"type":"text","text":" "},{"type":"text","text":"it that the holder is looking: fetch it once, when the holder accepts"},{"type":"text","text":" "},{"type":"text","text":"the credential rather than on the offer’s preview, and keep it."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Logo","kind":"identifier"}],"title":"Logo","navigatorTitle":[{"text":"Logo","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/logo","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"mdocReaderRoots","abstract":[{"type":"text","text":"PEM certificates: the mdoc readers recognized when one signs an"},{"type":"text","text":" "},{"code":"org-iso-mdoc","type":"codeVoice"},{"type":"text","text":" request ("},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"every such request is shown by its origin."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"navigatorTitle":[{"kind":"identifier","text":"WalletConfiguration"}],"identif