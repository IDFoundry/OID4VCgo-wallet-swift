InMemoryCredentialStore","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/inmemorycredentialstore"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/linkableHere":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkableHere","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"title":"linkableHere","abstract":[{"type":"text","text":"Whether presenting it to the Verifier asking would hand it a copy"},{"type":"text","text":" "},{"type":"text","text":"another Verifier has seen. Set only on a presentation’s candidates."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","url":"\/documentation\/oid4vcwallet\/credentialsummary\/linkablehere","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/tlsPins":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tlsPins","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]]","kind":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"tlsPins","abstract":[{"type":"text","text":"Pins hosts’ certificates for the wallet’s own HTTPS requests:"},{"type":"text","text":" "},{"type":"text","text":"host → base64 SHA-256 digests of a certificate’s"},{"type":"text","text":" "},{"type":"text","text":"SubjectPublicKeyInfo, one of which a certificate in the verified"},{"type":"text","text":" "},{"type":"text","text":"chain must have, or the request fails as "},{"code":"tlsPin","type":"codeVoice"},{"type":"text","text":" before anything"},{"type":"text","text":" "},{"type":"text","text":"is sent. A host is a name, or "},{"code":"*.","type":"codeVoice"},{"type":"text","text":" and one, matching any name a"},{"type":"text","text":" "},{"type":"text","text":"label below it; not an IP address. Pins add to certificate"},{"type":"text","text":" "},{"type":"text","text":"verification, never replace it: pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},{"type":"text","text":"doesn’t break the app, and keep a backup pin. They cover the"},{"type":"text","text":" "},{"type":"text","text":"requests the SDK makes (issuers, Authorization Servers,"},{"type":"text","text":" "},{"type":"text","text":"Verifiers, status lists), not the app’s own, such as to its"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider: pin that client yourself."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/tlspins"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/verifierRoots":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/verifierRoots","abstract":[{"type":"text","text":"PEM certificates: the trust anchors for Verifiers’ requests. A request"},{"type":"text","text":" "},{"type":"text","text":"signed by a certificate that doesn’t chain to them is refused unread."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verifierRoots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"title":"verifierRoots","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/verifierroots","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/holderKeyPresent":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/holderKeyPresent","abstract":[{"type":"text","text":"Whether the key store still holds the credential’s key: without it"},{"type":"text","text":" "},{"type":"text","text":"(restored to another device, say) it can’t be presented. Set in"},{"type":"text","text":" "},{"code":"Wallet.credentials()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Wallet.credential(id:)","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"holderKeyPresent","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"title":"holderKeyPresent","url":"\/documentation\/oid4vcwallet\/credentialsummary\/holderkeypresent","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requireTrustedMdocReader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"requireTrustedMdocReader","abstract":[{"type":"text","text":"Refuses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request no recognized reader signed:"},{"type":"text","text":" "},{"type":"codeVoice","code":"startMdocPresentation"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"untrustedVerifier"},{"type":"text","text":", and nothing is"},{"type":"text","text":" "},{"type":"text","text":"shown to the holder. Needs "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":"."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/development":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","abstract":[{"type":"text","text":"Relaxes what production requires, for a wallet talking to services"},{"type":"text","text":" "},{"type":"text","text":"on a development machine. Never ship an app with it set. It lets"},{"type":"text","text":" "},{"type":"text","text":"issuers, Authorization Servers, Verifiers and status lists be on"},{"type":"text","text":" "},{"type":"text","text":"loopback addresses, over http there too, and skips the production"},{"type":"text","text":" "},{"type":"text","text":"checks on receiving credentials: durable stores and keys, and the"},{"type":"text","text":" "},{"type":"text","text":"random source."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"development","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"development","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/development","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}],"title":"WalletProvider","navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore":{"navigatorTitle":[{"text":"KeychainKeyStore","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","url":"\/documentation\/oid4vcwallet\/keychainkeystore","kind":"symbol","title":"KeychainKeyStore","abstract":[{"type":"text","text":"The wallet’s keys, in the Secure Enclave and the Keychain: P-256 keys"},{"type":"text","text":" "},{"type":"text","text":"whose private halves never leave the Security framework. Each key’s"},{"type":"text","text":" "},{"type":"text","text":"ID is its Keychain application tag (after "},{"code":"Options.tagPrefix","type":"codeVoice"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"its label names its purpose. Holder keys also agree keys (ECDH), for"},{"type":"text","text":" "},{"type":"text","text":"deviceMac in person: a P-256 key in the Secure Enclave or the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can, with nothing asked of it at creation."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyStore","kind":"identifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyStore/isDurable":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore\/isDurable","required":true,"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDurable","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","defaultImplementations":1,"title":"isDurable","abstract":[{"type":"text","text":"Whether keys survive the app quitting. Receiving credentials needs"},{"type":"text","text":" "},{"type":"text","text":"a durable store unless the configuration is for development; the"},{"type":"text","text":" "},{"type":"text","text":"default is false."}],"url":"\/documentation\/oid4vcwallet\/keystore\/isdurable"}}}