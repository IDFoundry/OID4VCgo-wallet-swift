ntial set left unanswered."}],"url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/invalidselection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/authorizationDenied":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/authorizationDenied","abstract":[{"type":"text","text":"The Authorization Server refused the authorization: the holder"},{"type":"text","text":" "},{"type":"text","text":"declined, say."}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"authorizationDenied"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code"}],"title":"authorizationDenied","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/authorizationdenied","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/tlsPins":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tlsPins","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]]","kind":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"tlsPins","abstract":[{"type":"text","text":"Pins hosts’ certificates for the wallet’s own HTTPS requests:"},{"type":"text","text":" "},{"type":"text","text":"host → base64 SHA-256 digests of a certificate’s"},{"type":"text","text":" "},{"type":"text","text":"SubjectPublicKeyInfo, one of which a certificate in the verified"},{"type":"text","text":" "},{"type":"text","text":"chain must have, or the request fails as "},{"code":"tlsPin","type":"codeVoice"},{"type":"text","text":" before anything"},{"type":"text","text":" "},{"type":"text","text":"is sent. A host is a name, or "},{"code":"*.","type":"codeVoice"},{"type":"text","text":" and one, matching any name a"},{"type":"text","text":" "},{"type":"text","text":"label below it; not an IP address. Pins add to certificate"},{"type":"text","text":" "},{"type":"text","text":"verification, never replace it: pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},{"type":"text","text":"doesn’t break the app, and keep a backup pin. They cover the"},{"type":"text","text":" "},{"type":"text","text":"requests the SDK makes (issuers, Authorization Servers,"},{"type":"text","text":" "},{"type":"text","text":"Verifiers, status lists), not the app’s own, such as to its"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider: pin that client yourself."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/tlspins"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/wrongStep":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/wrongStep","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wrongStep","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV","text":"WalletError","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12OID4VCWallet11WalletErrorV4CodeV","text":"Code","kind":"typeIdentifier"}],"role":"symbol","type":"topic","kind":"symbol","title":"wrongStep","abstract":[{"type":"text","text":"A session method was called out of turn, or after the session ended."}],"url":"\/documentation\/oid4vcwallet\/walleter