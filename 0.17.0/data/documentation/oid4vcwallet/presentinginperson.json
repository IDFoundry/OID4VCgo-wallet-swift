{"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"],"generated":true,"anchor":"Presenting-in-person","title":"Presenting in person"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentinginperson"]}],"sections":[],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson","interfaceLanguage":"swift"},"kind":"article","metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","role":"article","title":"Presenting in person"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In person, the holder shows a QR code and the reader scans it: the"},{"type":"text","text":" "},{"type":"text","text":"code carries the holder’s ephemeral key and how to reach it over"},{"type":"text","text":" "},{"type":"text","text":"Bluetooth LE. The two devices then exchange encrypted messages over"},{"type":"text","text":" "},{"type":"text","text":"GATT. The package carries the Bluetooth side itself: your app shows or"},{"type":"text","text":" "},{"type":"text","text":"scans the QR code, follows the session’s states, and asks the holder."}]},{"inlineContent":[{"type":"text","text":"Engagement is by QR code only. NFC engagement (a tap instead of the"},{"type":"text","text":" "},{"type":"text","text":"code) is in OID4VCgo’s Kotlin library, not this package: an iOS holder"},{"type":"text","text":" "},{"type":"text","text":"can’t answer a reader’s tap, and an iOS reader can’t tap a holder. An"},{"type":"text","text":" "},{"type":"text","text":"Android reader or holder that offers both still works with this"},{"type":"text","text":" "},{"type":"text","text":"package over the QR code."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both sides need "},{"type":"codeVoice","code":"NSBluetoothAlwaysUsageDescription"},{"type":"text","text":" in the app’s"},{"type":"text","text":" "},{"type":"text","text":"Info.plist. Keep the app in the foreground during a session: neither"},{"type":"text","text":" "},{"type":"text","text":"side keeps one going while the app is suspended. A session answers one"},{"type":"text","text":" "},{"type":"text","text":"request. Bluetooth failures are "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"},{"type":"text","text":"s; protocol failures"},{"type":"text","text":" "},{"type":"text","text":"are "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","isActive":true,"type":"reference"},{"type":"text","text":"s."}],"type":"paragraph"},{"type":"heading","text":"Share as the holder","anchor":"Share-as-the-holder","level":3},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","type":"reference","isActive":true},{"text":" returns a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","type":"reference"},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode","type":"reference","isActive":true},{"type":"text","text":" you"},{"type":"text","text":" "},{"type":"text","text":"show. It offers both "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityBLEMode","type":"reference","isActive":true},{"type":"text","text":"s by default: it advertises"},{"type":"text","text":" "},{"type":"text","text":"for the reader and scans for it at once, until a reader connects"},{"type":"text","text":" "},{"type":"text","text":"either way (a reader offered both should connect in central client"},{"type":"text","text":" "},{"type":"text","text":"mode). Pass "},{"code":"modes","type":"codeVoice"},{"type":"text","text":" to offer one. It then reports"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)","type":"reference","isActive":true},{"type":"text","text":" with who is asking"},{"type":"text","text":" "},{"type":"text","text":"and what: ask the holder, then respond or decline."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import OID4VCWallet","","\/\/\/ What the holder agreed to share: a requested document, the held","\/\/\/ mdoc to answer it with, and the elements to disclose.","struct InPersonAnswer {","    let document: Int","    let credentialID: String","    let elements: [MdocPresentation.Element]","}","","\/\/\/ Shares an mdoc in person. `showQRCode` displays the code; `consent`","\/\/\/ shows the reader's request and returns the holder's answer, or nil","\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"]},{"inlineContent":[{"type":"text","text":"Show "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader","type":"reference","isActive":true},{"type":"text","text":" on the consent screen. A"},{"type":"text","text":" "},{"type":"text","text":"reader that signs its request (reader authentication) is named, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity\/Status-swift.enum\/trusted","type":"reference","isActive":true},{"type":"text","text":" when its certificate chains"},{"type":"text","text":" "},{"type":"text","text":"to "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","type":"reference","isActive":true},{"type":"text","text":". An unsigned request could"},{"type":"text","text":" "},{"type":"text","text":"come from anyone who scanned the code. As over the Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","type":"reference","isActive":true},{"type":"text","text":" ends a session"},{"type":"text","text":" "},{"type":"text","text":"from any other reader before the holder sees it."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/cancel()","type":"reference","isActive":true},{"type":"text","text":" ends a session at any point, as the"},{"type":"text","text":" "},{"type":"text","text":"holder leaves the screen, say. "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","type":"reference","isActive":true},{"type":"text","text":" sets how long it"},{"type":"text","text":" "},{"type":"text","text":"waits: by default 60 seconds for a reader to connect, 30 for its"},{"type":"text","text":" "},{"type":"text","text":"request, and 300 for the holder to decide."}],"type":"paragraph"},{"anchor":"Read-as-the-verifier","level":3,"type":"heading","text":"Read as the verifier"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","type":"reference","isActive":true},{"type":"text","text":" needs no "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","type":"reference","isActive":true},{"type":"text","text":": give it the IACAs whose"},{"type":"text","text":" "},{"type":"text","text":"mdocs it accepts, and, to sign its requests so holders see who is"},{"type":"text","text":" "},{"type":"text","text":"asking, a key in a "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","type":"reference","isActive":true},{"type":"text","text":" and its certificate chain, with the"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration","type":"reference","isActive":true},{"type":"text","text":"). "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader\/start(qrCode:docType:elements:timeouts:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"takes the holder’s QR code and what to ask for."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Reads an mDL's name and portrait from the holder whose QR code was","\/\/\/ scanned. Returns the verified mdoc, or nil if the holder declined or","\/\/\/ the mdoc isn't known to be unrevoked.","func readInPerson(qrCode: String, issuerRoots: String) async throws -> VerifiedMdoc? {","    let reader = try ProximityReader(configuration: ProximityReaderConfiguration(issuerRoots: issuerRoots))","    let session = try reader.start(qrCode: qrCode, docType: \"org.iso.18013.5.1.mDL\",","                                   elements: [\"org.iso.18013.5.1\": [\"given_name\", \"family_name\", \"portrait\"]])","    for await state in session.states {","        switch state {","        case .verified(let mdoc):","            let status = try await session.checkStatus()","            return status == .valid || status == .noStatus ? mdoc : nil","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"]},{"inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc","type":"reference","isActive":true},{"type":"text","text":" carries the disclosed elements, the document signer"},{"type":"text","text":" "},{"type":"text","text":"and the IACA it chains to, and its validity. Decide which issuers to"},{"type":"text","text":" "},{"type":"text","text":"accept on "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuerChain","type":"reference","isActive":true},{"type":"text","text":", the verified certificate path:"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuer","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/trustAnchor","type":"reference","isActive":true},{"type":"text","text":" are names any"},{"type":"text","text":" "},{"type":"text","text":"document signer under a trusted IACA can choose, for display."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The session doesn’t check revocation itself:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderSession\/checkStatus()"},{"type":"text","text":" does, once the session is"},{"type":"text","text":" "},{"type":"codeVoice","code":".verified"},{"type":"text","text":". It fetches the issuer’s status list over the network, so"},{"type":"text","text":" "},{"type":"text","text":"the reader needs a connection then, and verifies the list is signed"},{"type":"text","text":" "},{"type":"text","text":"under the certificate the document names or the CA that signed the"},{"type":"text","text":" "},{"type":"text","text":"document signer (ISO\/IEC 18013-5 §12.3.6). Rely on the document only"},{"type":"text","text":" "},{"type":"text","text":"when it’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/valid"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocStatus\/noStatus"},{"type":"text","text":"."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,"},{"type":"text","text":" "},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"type":"topic","title":"OID4VCWallet","abstract":[{"type":"text","text":"Receive verifiable credentials and present them from an iOS app: over"},{"text":" ","type":"text"},{"type":"text","text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials"},{"text":" ","type":"text"},{"type":"text","text":"API, and in person over Bluetooth."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","url":"\/documentation\/oid4vcwallet","kind":"symbol","role":"collection"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","abstract":[{"type":"text","text":"An error from OID4VCgo: a stable "},{"type":"codeVoice","code":"code"},{"type":"text","text":", the issuer’s, Authorization"},{"type":"text","text":" "},{"type":"text","text":"Server’s or Verifier’s own error code when it gave one"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"protocolError"},{"type":"text","text":"), and a message for logs: it never carries personal"},{"type":"text","text":" "},{"type":"text","text":"data, a remote party’s own description, a URL’s path or query, or"},{"type":"text","text":" "},{"type":"text","text":"control characters. "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"a sentence fit to show the holder; "},{"code":"isRetryable","type":"codeVoice"},{"type":"text","text":" says whether trying"},{"type":"text","text":" "},{"type":"text","text":"the same step again may succeed."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WalletError"}],"title":"WalletError","navigatorTitle":[{"kind":"identifier","text":"WalletError"}],"url":"\/documentation\/oid4vcwallet\/walleterror","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/qrCode":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"qrCode","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"title":"qrCode","abstract":[{"type":"text","text":"The QR code to show: “mdoc:” and the device engagement."}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/qrcode","kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startProximityPresentation(timeouts:modes:)":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","abstract":[{"text":"Starts an ISO\/IEC 18013-5 in-person presentation over BLE: show","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"type":"codeVoice","code":"qrCode"},{"text":". In ","type":"text"},{"type":"codeVoice","code":"modes"},{"text":", both by default, it advertises for a","type":"text"},{"text":" ","type":"text"},{"text":"reader (peripheral server mode) and scans for one (central client","type":"text"},{"text":" ","type":"text"},{"text":"mode) until a reader connects either way; a reader offered both","type":"text"},{"text":" ","type":"text"},{"text":"should choose central client mode. Bluetooth failures end it as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".failed"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"ProximityError"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startProximityPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeouts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17ProximityTimeoutsV","text":"ProximityTimeouts"},{"kind":"text","text":", "},{"kind":"externalParam","text":"modes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16ProximityBLEModeO","text":"ProximityBLEMode"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet21ProximityPresentationC","text":"ProximityPresentation"}],"title":"startProximityPresentation(timeouts:modes:)","url":"\/documentation\/oid4vcwallet\/wallet\/startproximitypresentation(timeouts:modes:)","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/Request/reader":{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"reader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet23ProximityReaderIdentityV","text":"ProximityReaderIdentity"}],"role":"symbol","type":"topic","kind":"symbol","title":"reader","abstract":[{"type":"text","text":"Who sent the request."}],"url":"\/documentation\/oid4vcwallet\/proximitypresentation\/request\/reader"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/VerifiedMdoc/issuerChain":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/issuerChain","abstract":[{"type":"text","text":"The document signer’s verified certificate path, leaf first,"},{"type":"text","text":" "},{"type":"text","text":"ending at the IACA in "},{"type":"codeVoice","code":"ProximityReaderConfiguration.issuerRoots"},{"type":"text","text":" "},{"type":"text","text":"it chains to: decide which issuers to accept on it."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"issuerChain","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"c:@T@SecCertificateRef","text":"SecCertificate","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"issuerChain","url":"\/documentation\/oid4vcwallet\/verifiedmdoc\/issuerchain","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","abstract":[{"type":"text","text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,"},{"type":"text","text":" "},{"type":"text","text":"credential store and Wallet Provider."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Wallet"}],"title":"Wallet","navigatorTitle":[{"kind":"identifier","text":"Wallet"}],"url":"\/documentation\/oid4vcwallet\/wallet","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityError":{"kind":"symbol","title":"ProximityError","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityError","kind":"identifier"}],"type":"topic","url":"\/documentation\/oid4vcwallet\/proximityerror","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError","abstract":[{"text":"An in-person session failed over Bluetooth, rather than in the","type":"text"},{"text":" ","type":"text"},{"text":"protocol (","type":"text"},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":")."}],"navigatorTitle":[{"text":"ProximityError","kind":"identifier"}],"role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityReaderSession/checkStatus()":{"kind":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderSession\/checkStatus()","abstract":[{"type":"text","text":"Checks the revocation status of the mdoc the session verified:"},{"type":"text","text":" "},{"type":"text","text":"fetches the Token Status List its MSO names, over https from a"},{"type":"text","text":" "},{"type":"text","text":"public address, and verifies it’s signed under the certificate the"},{"type":"text","text":" "},{"type":"text","text":"MSO names or else under the CA that signed the document signer"},{"type":"text","text":" "},{"type":"text","text":"(ISO\/IEC 18013-5 §12.3.6). Rely on the document only when this is"},{"type":"text","text":" "},{"type":"codeVoice","code":".valid"},{"type":"text","text":" or "},{"type":"codeVoice","code":".noStatus"},{"type":"text","text":". Call it once the session is "},{"type":"codeVoice","code":".verified"},{"type":"text","text":", after"},{"type":"text","text":" "},{"type":"text","text":"the Bluetooth connection has closed; before, it throws "},{"type":"codeVoice","code":"WalletError"},{"type":"text","text":" "},{"type":"codeVoice","code":".wrongStep"},{"type":"text","text":". A failed fetch is "},{"type":"codeVoice","code":".network"},{"type":"text","text":", a list that doesn’t"},{"type":"text","text":" "},{"type":"text","text":"verify "},{"type":"codeVoice","code":".protocol"},{"type":"text","text":"; cancelling the calling Task cancels it. The list"},{"type":"text","text":" "},{"type":"text","text":"covers many documents, so fetching it doesn’t tell its publisher"},{"type":"text","text":" "},{"type":"text","text":"which one was presented."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkStatus"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet10MdocStatusO","text":"MdocStatus"}],"title":"checkStatus()","url":"\/documentation\/oid4vcwallet\/proximityreadersession\/checkstatus()","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/State