":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderKeyPresent"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":"?","kind":"text"}],"url":"\/documentation\/oid4vcwallet\/credentialsummary\/holderkeypresent","type":"topic","title":"holderKeyPresent","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/holderKeyPresent","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileCredentialStore"}],"kind":"symbol","abstract":[{"type":"text","text":"A credential store of files: one per credential record, in a directory"},{"type":"text","text":" "},{"type":"text","text":"of the app’s (Application Support, by default). Records are written"},{"type":"text","text":" "},{"type":"text","text":"with the given file protection — complete by default: readable only"},{"type":"text","text":" "},{"type":"text","text":"while the device is unlocked — and kept out of backups by default,"},{"type":"text","text":" "},{"type":"text","text":"since a credential is useless without its holder key, which is in"},{"type":"text","text":" "},{"type":"text","text":"this device’s Secure Enclave and can’t be restored elsewhere."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"FileCredentialStore"}],"title":"FileCredentialStore","url":"\/documentation\/oid4vcwallet\/filecredentialstore","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/verifierRoots":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"verifierRoots"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"ki