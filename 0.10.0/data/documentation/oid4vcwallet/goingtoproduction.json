ion/OID4VCWallet/WalletConfiguration/development":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"development"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol","abstract":[{"text":"Relaxes what production requires, for a wallet talking to services","type":"text"},{"text":" ","type":"text"},{"text":"on a development machine. Never ship an app with it set. It lets","type":"text"},{"text":" ","type":"text"},{"text":"issuers, Authorization Servers, Verifiers and status lists be on","type":"text"},{"text":" ","type":"text"},{"text":"loopback addresses, over http there too, and skips the production","type":"text"},{"text":" ","type":"text"},{"text":"checks on receiving credentials: durable stores and keys, and the","type":"text"},{"text":" ","type":"text"},{"text":"random source.","type":"text"}],"type":"topic","title":"development","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/development","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/development","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","title":"requireTrustedMdocReader","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"requireTrustedMdocReader"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Refuses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request no recognized reader signed:"},{"type":"text","text":" "},{"type":"codeVoice","code":"startMdocPresentation"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"untrustedVerifier"},{"type":"text","text":", and nothing is"},{"type":"text","text":" "},{"type":"text","text":"shown to the holder. Needs "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"abstract":[{"type":"text","text":"Tell the holder what went wrong, retry what may succeed, and log what"},{"type":"text","text":" "},{"type":"text","text":"helps without personal data."}],"url":"\/documentation\/oid4vcwallet\/handlingerrors","type":"topic","title":"Handling errors","role":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","kind":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRoots":{"type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","title":"mdocReaderRoots","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mdocReaderRoots","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"PEM certificates: the mdoc readers recognized when one signs an"},{"type":"text","text":" "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request ("},{"type":"codeVoice","code":"MdocPresentation.Request.reader"},{"type":"text","text":"). Empty:"},{"type":"text","text":" "},{"type":"text","text":"every such request is shown by its origin."}],"role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/tlsPins":{"type":"topic","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/tlspins","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/tlsPins","title":"tlsPins","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"tlsPins"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]]"}],"abstract":[{"type":"text","text":"Pins hosts’ certificates for the wallet’s own HTTPS requests:"},{"type":"text","text":" "},{"type":"text","text":"host → base64 SHA-256 digests of a certificate’s"},{"type":"text","text":" "},{"type":"text","text":"SubjectPublicKeyInfo, one of which a certificate in the verified"},{"type":"text","text":" "},{"type":"text","text":"chain must have, or the request fails as "},{"type":"codeVoice","code":"tlsPin"},{"type":"text","text":" before anything"},{"type":"text","text":" "},{"type":"text","text":"is sent. A host is a name, or "},{"type":"codeVoice","code":"*."},{"type":"text","text":" and one, matching any name a"},{"type":"text","text":" "},{"type":"text","text":"label below it; not an IP address. Pins add to certificate"},{"type":"text","text":" "},{"type":"text","text":"verification, never replace it: pin a CA’s key, so a leaf renewal"},{"type":"text","text":" "},{"type":"text","text":"doesn’t break the app, and keep a backup pin. They cover the"},{"type":"text","text":" "},{"type":"text","text":"requests the SDK makes (issuers, Authorization Servers,"},{"type":"text","text":" "},{"type":"text","text":"Verifiers, status lists), not the app’s own, such as to its"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider: pin that client yourself."}],"role":"symbol","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletConfiguration","kind":"identifier"}],"abstract":[{"type":"text","text":"NewWallet’s configuration."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"WalletConfiguration","kind":"identifier"}],"title":"WalletConfiguration","url":"\/documentation\/oid4vcwallet\/walletconfiguration","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore/isDurable":{"abstract":[{"type":"text","text":"Whether records survive the app quitting. Receiving credentials"},{"type":"text","text":" "},{"type":"text","text":"needs a durable store unless the configuration is for development:"},{"type":"text","text":" "},{"type":"text","text":"it also keeps an authorization in progress while the holder is at"},{"type":"text","text":" "},{"type":"text","text":"the issuer’s pages. The default is false."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isDurable","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/oid4vcwallet\/credentialstore\/isdurable","type":"topic","title":"isDurable","required":true,"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/isDurable","defaultImplementations":1,"kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requestRefresh":{"kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","title":"requestRefresh","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestRefresh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Asks Authorization Servers for a refresh token, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"Wallet.refreshCredential(id:)"},{"type":"text","text":" can later replace a credential’s"},{"type":"text","text":" "},{"type":"text","text":"copies without the holder. The server must allow the wallet the"},{"type":"text","text":" "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" scope, or the authorization fails."}],"role":"symbol","type":"topic"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProvider":{"abstract":[{"type":"text","text":"The Wallet Provider’s backend, which attests the wallet and its keys"},{"type":"text","text":" "},{"type":"text","text":"(HAIP 1.0 §4.4.1, §4.5.1). Keys are public JWKs, as JSON; the results"},{"type":"text","text":" "},{"type":"text","text":"are compact JWTs. A real one attests only after checking platform"},{"type":"text","text":" "},{"type":"text","text":"evidence (App Attest) that it’s talking to the genuine app."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProvider","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletprovider","type":"topic","navigatorTitle":[{"text":"WalletProvider","kind":"identifier"}],"title":"WalletProvider","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","kind":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Wallet","kind":"identifier"}],"navigatorTitle":[{"text":"Wallet","kind":"identifier"}],"abstract":[{"type":"text","text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,"},{"type":"text","text":" "},{"type":"text","text":"credential store and Wallet Provider."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet","title":"Wallet","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/GettingStarted":{"type":"topic","abstract":[{"type":"text","text":"Add the package, give the wallet its keys, its storage and a Wallet"},{"type":"text","text":" "},{"type":"text","text":"Provider, and create it at launch."}],"kind":"article","url":"\/documentation\/oid4vcwallet\/gettingstarted","title":"Getting started","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/mdocReaderRequireEKU":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mdocReaderRequireEKU"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Recognizes only reader certificates with the ISO\/IEC 18013-5","type":"text"},{"text":" ","type":"text"},{"text":"reader authentication extended key usage (1.0.18013.5.1.6), so a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"certificate issued for another role under "},{"type":"codeVoice","code":"mdocReaderRoots"},{"type":"text","text":" "},{"type":"text","text":"isn’t taken for a reader’s."}],"kind":"symbol","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderrequireeku","title":"mdocReaderRequireEKU","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/message":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"message","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"abstract":[{"type":"text","text":"Detail for logs: at most 300 characters, with no personal data, no"},{"type":"text","text":" "},{"type":"text","text":"remote party’s own description, and no URL’s path or query."}],"kind":"symbol","type":"topic","title":"message","url":"\/documentation\/oid4vcwallet\/walleterror\/message","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/message","role":"symbol"}}}