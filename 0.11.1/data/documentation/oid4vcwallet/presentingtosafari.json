{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, using the "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" protocol (ISO\/IEC TS"},{"type":"text","text":" "},{"type":"text","text":"18013-7 Annex C). iOS offers the apps that registered a matching"},{"type":"text","text":" "},{"type":"text","text":"document, and shows the chosen app’s document provider extension for"},{"type":"text","text":" "},{"type":"text","text":"the holder’s consent. The extension answers through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","isActive":true},{"type":"text","text":"; the"},{"type":"text","text":" "},{"type":"text","text":"response goes back through Safari, encrypted to the page, with no"},{"type":"text","text":" "},{"type":"text","text":"network request from the wallet."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Safari sends only "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":", not OpenID4VP, and on iOS only:"},{"type":"text","text":" "},{"type":"text","text":"Safari on macOS has no document providers."}]},{"type":"heading","level":3,"anchor":"Set-up-the-app-and-its-extension","text":"Set up the app and its extension"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The extension:","type":"text"}]},{"text":" a target whose Info.plist names the extension","type":"text"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"code":"com.apple.identity-document-services.document-provider-ui","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EXAppExtensionAttributes","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EXExtensionPointIdentifier","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The capability:","type":"text"}]},{"text":" Digital Credentials API – Mobile Document","type":"text"},{"text":" ","type":"text"},{"text":"Provider, on both the app’s and the extension’s App IDs, with the","type":"text"},{"text":" ","type":"text"},{"text":"doctypes the app presents in the","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types","type":"codeVoice"},{"text":" ","type":"text"},{"text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL","type":"text"},{"text":" ","type":"text"},{"text":"and Photo ID.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Shared storage:","type":"text"}]},{"text":" the extension is another process, so the app","type":"text"},{"text":" ","type":"text"},{"text":"keeps its credentials in an App Group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true,"type":"reference"},{"text":"), and its holder keys in","type":"text"},{"text":" ","type":"text"},{"text":"a Keychain access group both list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true,"type":"reference"},{"text":"). Instance and DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keys stay in the app’s own group: the extension presents, but doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"receive. The app saves its configuration where the extension can","type":"text"},{"text":" ","type":"text"},{"text":"read it too.","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"type":"heading","level":3,"anchor":"Register-the-documents","text":"Register the documents"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS offers the app only for documents it registered. Whenever the"},{"type":"text","text":" "},{"type":"text","text":"credentials change, register each presentable mdoc and remove the rest."},{"type":"text","text":" "},{"type":"codeVoice","code":"supportedAuthorityKeyIdentifiers"},{"type":"text","text":" names the reader CAs, by subject key"},{"type":"text","text":" "},{"type":"text","text":"identifier, whose requests the document answers."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"]},{"type":"heading","level":3,"anchor":"Answer-in-the-extension","text":"Answer in the extension"},{"type":"paragraph","inlineContent":[{"text":"iOS hands the extension the request in two stages. First,","type":"text"},{"text":" ","type":"text"},{"code":"ISO18013MobileDocumentRequestContext.request","type":"codeVoice"},{"text":" describes what’s asked,","type":"text"},{"text":" ","type":"text"},{"text":"for the consent screen: show it with the website’s origin, and the","type":"text"},{"text":" ","type":"text"},{"text":"candidates from ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","isActive":true,"type":"reference"},{"text":". Only when the","type":"text"},{"text":" ","type":"text"},{"text":"holder shares does iOS release the request itself, to","type":"text"},{"text":" ","type":"text"},{"code":"sendResponse","type":"codeVoice"},{"text":"‘s closure. Validate it there, parse it, check it’s what","type":"text"},{"text":" ","type":"text"},{"text":"the holder was shown, and answer.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","","    var body: some View {","        Button(\"Share\") { Task { try await share(credentialID: nil) } }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil) for the request's first document.","    func share(credentialID: String?) async throws {","        guard let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let wallet = try SharedWallet.open(provider: nil)","        try await context.sendResponse { raw in","            _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","            let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","            guard let document = presentation.request.documents.first,","                  let chosen = credentialID ?? document.credentials.first?.id else { throw RequestChanged() }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            let response = try await presentation.respond(document: 0, credentialID: chosen, elements: document.elements)","            return ISO18013MobileDocumentResponse(responseData: response.response)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A real consent screen compares the released request with what it","type":"text"},{"text":" ","type":"text"},{"text":"showed — the same document, elements and reader — and refuses one that","type":"text"},{"text":" ","type":"text"},{"text":"changed. The demo wallet’s ","type":"text"},{"code":"DocumentProvider","type":"codeVoice"},{"text":" target does this in full.","type":"text"}]},{"type":"heading","level":3,"anchor":"Name-the-reader","text":"Name the reader"},{"type":"paragraph","inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true,"type":"reference"},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"text":"issued for readers, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}]},{"type":"heading","level":3,"anchor":"Warn-of-linkable-presentations","text":"Warn of linkable presentations"},{"type":"paragraph","inlineContent":[{"text":"Each candidate’s ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true,"type":"reference"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true,"type":"reference"},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"OID4VCWallet"}],"title":"Presenting to Safari","roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"seeAlsoSections":[{"title":"Presenting to Safari","generated":true,"anchor":"Presenting-to-Safari","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"]}],"abstract":[{"type":"text","text":"Answer a web page’s request for an mdoc over the Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, as an iOS document provider."}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/startMdocPresentation(requestData:origin:)":{"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/startmdocpresentation(requestdata:origin:)","title":"startMdocPresentation(requestData:origin:)","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"startMdocPresentation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"requestData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":", "},{"kind":"externalParam","text":"origin"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC","kind":"typeIdentifier","text":"MdocPresentation"}],"abstract":[{"type":"text","text":"Parses an "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request — an mdoc asked for over the"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, as iOS hands one to a document provider"},{"type":"text","text":" "},{"type":"text","text":"extension — and finds the held mdocs that can answer it."},{"type":"text","text":" "},{"type":"codeVoice","code":"requestData"},{"type":"text","text":" is "},{"type":"codeVoice","code":"IdentityDocumentWebPresentmentRawRequest.requestData"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"origin"},{"type":"text","text":" the requesting page’s origin"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.requestingWebsiteOrigin"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"MdocPresentation.origin(of:)"},{"type":"text","text":" serializes it."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/respond(document:credentialID:elements:)":{"type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/respond(document:credentialid:elements:)","abstract":[{"text":"Presents the held mdoc ","type":"text"},{"code":"credentialID","type":"codeVoice"},{"text":" for document number","type":"text"},{"text":" ","type":"text"},{"code":"document","type":"codeVoice"},{"text":", disclosing exactly ","type":"text"},{"code":"elements","type":"codeVoice"},{"text":", each one it requested.","type":"text"},{"text":" ","type":"text"},{"text":"The holder key signs now, so a key store requiring user presence","type":"text"},{"text":" ","type":"text"},{"text":"prompts.","type":"text"}],"title":"respond(document:credentialID:elements:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"respond"},{"kind":"text","text":"("},{"kind":"externalParam","text":"document"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"credentialID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"elements"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC7ElementV","text":"Element"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16MdocPresentationC8ResponseV","text":"Response"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Request-swift.struct/reader":{"title":"reader","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/request-swift.struct\/reader","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"reader"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"abstract":[{"type":"text","text":"The subject common name of the reader that signed the request,"},{"type":"text","text":" "},{"type":"text","text":"when its certificate chains to"},{"type":"text","text":" "},{"code":"WalletConfiguration.mdocReaderRoots","type":"codeVoice"},{"type":"text","text":"; “” when the holder can"},{"type":"text","text":" "},{"type":"text","text":"only be shown "},{"code":"origin","type":"codeVoice"},{"type":"text","text":"."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation/Response/linkable":{"kind":"symbol","title":"linkable","type":"topic","url":"\/documentation\/oid4vcwallet\/mdocpresentation\/response\/linkable","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkable","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether the copy presented had been seen by another Verifier."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requireTrustedMdocReader":{"title":"requireTrustedMdocReader","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requiretrustedmdocreader","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requireTrustedMdocReader"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"text":"Refuses an ","type":"text"},{"code":"org-iso-mdoc","type":"codeVoice"},{"text":" request no recognized reader signed:","type":"text"},{"text":" ","type":"text"},{"code":"startMdocPresentation","type":"codeVoice"},{"text":" throws ","type":"text"},{"code":"untrustedVerifier","type":"codeVoice"},{"text":", and nothing is","type":"text"},{"text":" ","type":"text"},{"text":"shown to the holder. Needs ","type":"text"},{"code":"mdocReaderRoots","type":"codeVoice"},{"text":".","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeychainKeyStore/Options-swift.struct/holderAccessGroup":{"title":"holderAccessGroup","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"holderAccessGroup"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The Keychain access group holder keys are made in, when the"},{"type":"text","text":" "},{"type":"text","text":"app shares them with an extension — a document provider"},{"type":"text","text":" "},{"type":"text","text":"presenting credentials, say — that lists the group in its"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Instance and DPoP keys"},{"type":"text","text":" "},{"type":"text","text":"stay in the app’s default group: only the app issues. nil:"},{"type":"text","text":" "},{"type":"text","text":"every key is in the default group."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/linkableHere":{"type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/linkablehere","abstract":[{"text":"Whether presenting it to the Verifier asking would hand it a copy","type":"text"},{"type":"text","text":" "},{"type":"text","text":"another Verifier has seen. Set only on a presentation’s candidates."}],"title":"linkableHere","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkableHere","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/MdocPresentation":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MdocPresentation"}],"url":"\/documentation\/oid4vcwallet\/mdocpresentation","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" request (ISO\/IEC TS 18013-7 Annex C): show"},{"type":"text","text":" "},{"type":"codeVoice","code":"request"},{"type":"text","text":" for the holder’s consent, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" once; to decline,"},{"type":"text","text":" "},{"type":"text","text":"cancel the platform’s request — nothing is sent to the reader."}],"title":"MdocPresentation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MdocPresentation"