{"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"code":"openid-credential-offer:\/\/","type":"codeVoice"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"code":"openid-credential-offer","type":"codeVoice"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","isActive":true,"type":"reference"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","isActive":true,"type":"reference"},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","isActive":true,"type":"reference"},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The offer names one of two grants:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authorization code:"}]},{"type":"text","text":" the holder signs in at the issuer’s pages, in"},{"type":"text","text":" "},{"type":"text","text":"a browser, which redirects back to the wallet’s redirect URI."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Pre-authorized code:"}]},{"type":"text","text":" the issuer has already authenticated the"},{"type":"text","text":" "},{"type":"text","text":"holder, and may ask for a PIN it sent them separately"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","isActive":true},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Either way, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true,"type":"reference"},{"text":" then requests, checks and","type":"text"},{"text":" ","type":"text"},{"text":"stores the credentials, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","isActive":true,"type":"reference"},{"text":" ends the issuance.","type":"text"}]},{"anchor":"Receive-an-offer","text":"Receive an offer","level":3,"type":"heading"},{"code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","isActive":true,"type":"reference"},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}]},{"anchor":"Open-the-issuers-page","text":"Open the issuer’s page","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"code":"ASWebAuthenticationSession","type":"codeVoice"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}]},{"code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","isActive":true,"type":"reference"},{"text":" can begin again. A redirect is used","type":"text"},{"text":" ","type":"text"},{"text":"up by ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","isActive":true,"type":"reference"},{"text":" whatever happens,","type":"text"},{"text":" ","type":"text"},{"text":"so after a failure there, begin again rather than retrying it.","type":"text"}]},{"anchor":"Resume-after-the-app-is-killed","text":"Resume after the app is killed","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"iOS can terminate the app while the holder is at the issuer’s pages.","type":"text"},{"text":" ","type":"text"},{"text":"The authorization in progress is kept in the credential store, so when","type":"text"},{"text":" ","type":"text"},{"text":"the redirect arrives at a relaunched app, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"completes it and returns an issuance ready for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true,"type":"reference"},{"text":". Handle every redirect this way: in","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI, from ","type":"text"},{"code":"onOpenURL","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"anchor":"Wait-for-a-deferred-credential","text":"Wait for a deferred credential","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","isActive":true,"type":"reference"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","isActive":true,"type":"reference"},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"anchor":"Look-after-held-credentials","text":"Look after held credentials","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()"},{"type":"text","text":" lists them, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)"},{"type":"text","text":" "},{"type":"text","text":"returns one with its claims, for display. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display"},{"type":"text","text":" "},{"type":"text","text":"carries the issuer’s names, logos and colours, in the holder’s"},{"type":"text","text":" "},{"type":"text","text":"language ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)"},{"type":"text","text":" checks revocation against the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"status list, which covers many credentials, so the issuer can’t tell"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each credential arrives as a batch of copies, each bound to its own"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize"},{"type":"text","text":"), so presentations can’t be"},{"type":"text","text":" "},{"type":"text","text":"linked by the credential. When "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft"},{"type":"text","text":" "},{"type":"text","text":"reaches zero, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)"},{"type":"text","text":" replaces them without"},{"type":"text","text":" "},{"type":"text","text":"the holder, if the issuance kept a refresh token"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh"},{"type":"text","text":"). Otherwise it throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired"},{"type":"text","text":": receive the credential again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)"},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}]}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}]},"seeAlsoSections":[{"title":"Receiving credentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"generated":true,"anchor":"Receiving-credentials"}],"variants":[{"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Receive the credentials a Credential Offer offers, with either grant,","type":"text"},{"text":" ","type":"text"},{"text":"and look after them once they’re held.","type":"text"}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deleteCredential(id:)":{"kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/deletecredential(id:)","title":"deleteCredential(id:)","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deleteCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[{"type":"text","text":"Deletes a credential and its holder keys, and its refresh grant"},{"type":"text","text":" "},{"type":"text","text":"once no other credential uses it, first revoking the refresh token"},{"type":"text","text":" "},{"type":"text","text":"at the Authorization Server, best effort."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer/txCode-swift.property":{"title":"txCode","url":"\/documentation\/oid4vcwallet\/offer\/txcode-swift.property","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"txCode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet5OfferV6TxCodeV","text":"TxCode"},{"kind":"text","text":"?"}],"abstract":[{"text":"The PIN to ask the holder for, for a pre-authorized code offer.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/requestRefresh":{"title":"requestRefresh","url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestRefresh"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"type":"text","text":"Asks Authorization Servers for a refresh token, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"Wallet.refreshCredential(id:)"},{"type":"text","text":" can later replace a credential’s"},{"type":"text","text":" "},{"type":"text","text":"copies without the holder. The server must allow the wallet the"},{"type":"text","text":" "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" scope, or the authorization fails."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/Result":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Result"}],"url":"\/documentation\/oid4vcwallet\/issuance\/result","abstract":[{"text":"What ","type":"text"},{"code":"requestCredentials()","type":"codeVoice"},{"text":" obtained.","type":"text"}],"title":"Issuance.Result","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Result"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"title":"refreshCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refreshCredential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","text":"Refreshed"}],"abstract":[{"text":"Replaces a ","type":"text"},{"code":"refreshable","type":"codeVoice"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new attested key, without the holder (OpenID4VCI","type":"text"},{"text":" ","type":"text"},{"text":"1.0 §13.5). Use it when ","type":"text"},{"code":"copiesLeft","type":"codeVoice"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"code":"WalletError.Code.reissueRequired","type":"codeVoice"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credential(id:)":{"title":"credential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/credential(id:)","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"credential"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16CredentialDetailV","text":"CredentialDetail"}],"abstract":[{"text":"One credential with its claims.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DeferredCredential"}],"url":"\/documentation\/oid4vcwallet\/deferredcredential","abstract":[{"type":"text","text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s"},{"type":"text","text":" "},{"type":"text","text":"kept in the credential store until it’s issued, denied or abandoned,"},{"type":"text","text":" "},{"type":"text","text":"so it survives the app quitting."}],"title":"DeferredCredential","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeferredCredential"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialSummary/display":{"type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/credentialsummary\/display","abstract":[{"text":"How to show it, from the issuer’s metadata when it was received.","type":"text"}],"title":"display","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"display"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet17CredentialDisplayV","text":"CredentialDisplay"},{"kind":"text","text":"?"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance/requestCredentials()":{"kind":"symbol","type":"topic","url":"\/documentation\/oid4vcwallet\/issuance\/requestcredentials()","abstract":[{"text":"Requests, checks and stores every offered credential.","type":"text"}],"title":"requestCredentials()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestCredentials"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12OID4VCWallet8IssuanceC6Resu