rIdentity"}],"url":"\/documentation\/oid4vcwallet\/proximityreaderidentity","abstract":[{"type":"text","text":"Who sent a request, as the holder sees it."}],"title":"ProximityReaderIdentity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityReaderIdentity"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/KeyAgreement":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"KeyAgreement"}],"url":"\/documentation\/oid4vcwallet\/keyagreement","abstract":[{"type":"text","text":"ECDH with the wallet’s holder keys inside the key store, for deviceMac"},{"type":"text","text":" "},{"type":"text","text":"in person (ISO\/IEC 18013-5 §9.1.3.5). A "},{"type":"codeVoice","code":"KeyStore"},{"type":"text","text":" that is also one is"},{"type":"text","text":" "},{"type":"text","text":"used for it when "},{"type":"codeVoice","code":"WalletConfiguration.proximityDeviceAuth"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":".macPreferred"},{"type":"text","text":". "},{"type":"codeVoice","code":"KeychainKeyStore"},{"type":"text","text":" is one."}],"title":"KeyAgreement","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyAgreement"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyAgreement"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation":{"title":"ProximityPresentation","url":"\/documentation\/oid4vcwallet\/proximitypresentation","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProximityPresentation"}],"abstract":[{"type":"text","text":"The holder’s side of an ISO\/IEC 18013-5 in-person presentation over"},{"type":"text","text":" "},{"type":"text","text":"BLE: show "},{"type":"codeVoice","code":"qrCode"},{"type":"text","text":", and the reader that scans it connects, or"},{"type":"text","text":" "},{"type":"text","text":"advertises for the holder to connect, in one of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"ProximityBLEMode"},{"type":"text","text":"s the session offers. Follow "},{"type":"codeVoice","code":"states"},{"type":"text","text":": on "},{"type":"codeVoice","code":".requestReceived"},{"type":"text","text":", ask"},{"type":"text","text":" "},{"type":"text","text":"the holder, then "},{"type":"codeVoice","code":"respond"},{"type":"text","text":" or "},{"type":"codeVoice","code":"decline"},{"type":"text","text":". "},{"type":"codeVoice","code":"cancel"},{"type":"text","text":" ends it at any"},{"type":"text","text":" "},{"type":"text","text":"point. One request per session. The app’s Info.plist needs"},{"type":"text","text":" "},{"type":"text","text":"NSBluetoothAlwaysUsageDescription."}],"navigatorTitle":[{"kind":"identifier","text":"ProximityPresentation"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Issuance"}],"url":"\/documentation\/oid4vcwallet\/issuance","abstract":[{"type":"text","text":"Receives one offer’s credentials: show "},{"type":"codeVoice","code":"offer"},{"type":"text","text":"; then"},{"type":"text","text":" "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":", open the URL in ASWebAuthenticationSession and"},{"type":"text","text":" "},{"type":"codeVoice","code":"completeAuthorization(redirect:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"redeemPreAuthorizedCode(pin:)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"then "},{"type":"codeVoice","code":"requestCredentials()"},{"type":"text","text":"; "},{"type":"codeVoice","code":"close()"},{"type":"text","text":" when done."}],"title":"Issuance","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issuance"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/PresentingInPerson":{"type":"topic","kind":"article","url":"\/documentation\/oid4vcwallet\/presentinginperson","abstract":[{"text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,","type":"text"},{"text":" ","type":"text"},{"text":"with ISO\/IEC 18013-5 device retrieval.","type":"text"}],"title":"Presenting in person","role":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Wallet","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/wallet","abstract":[{"text":"A holder’s wallet: OID4VCgo’s walletflow over the app’s key store,","type":"text"},{"text":" ","type":"text"},{"text":"credential store and Wallet Provider.","type":"text"}],"title":"Wallet","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Wallet","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"WalletConfiguration","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration","abstract":[{"text":"NewWallet’s configuration.","type":"text"}],"title":"WalletConfiguration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletConfiguration","kind":"identifier"}],"role":