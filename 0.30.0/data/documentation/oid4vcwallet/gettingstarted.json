ssGroup","url":"\/documentation\/oid4vcwallet\/keychainkeystore\/options-swift.struct\/holderaccessgroup","kind":"symbol","abstract":[{"text":"The Keychain access group holder keys are made in, when the","type":"text"},{"text":" ","type":"text"},{"text":"app shares them with an extension — a document provider","type":"text"},{"text":" ","type":"text"},{"text":"presenting credentials, say — that lists the group in its","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement. Instance and DPoP keys","type":"text"},{"text":" ","type":"text"},{"text":"stay in the app’s default group: only the app issues. nil:","type":"text"},{"text":" ","type":"text"},{"text":"every key is in the default group.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/HandlingErrors":{"role":"article","title":"Handling errors","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","url":"\/documentation\/oid4vcwallet\/handlingerrors","kind":"article","abstract":[{"text":"Tell the holder what went wrong, retry what may succeed, and log what","type":"text"},{"text":" ","type":"text"},{"text":"helps without personal data.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ReceivingCredentials":{"url":"\/documentation\/oid4vcwallet\/receivingcredentials","kind":"article","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","type":"topic","abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"title":"Receiving credentials","role":"article"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"role":"symbol","title":"inAppGroup(_:options:)","type":"topic","fragments":[{"text":"static","kind":"