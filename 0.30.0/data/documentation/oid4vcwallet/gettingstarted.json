{"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeviceAppAttestService","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError"]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true},{"type":"text","text":" needs four things from your app: its configuration, a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true},{"type":"text","text":" for its keys, a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","isActive":true},{"type":"text","text":" for what it holds, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","isActive":true},{"type":"text","text":" that attests it to issuers. The package has standard"},{"type":"text","text":" "},{"type":"text","text":"stores for the first two; the Wallet Provider is your backend."}],"type":"paragraph"},{"text":"Add the package","level":3,"anchor":"Add-the-package","type":"heading"},{"inlineContent":[{"type":"text","text":"Add OID4VCWallet to your app with Swift Package Manager, from"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift"},{"type":"text","text":", at the release"},{"type":"text","text":" "},{"type":"text","text":"whose documentation you’re reading. In "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".package(url: \"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift\", from: \"<version>\")"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The package links a binary framework, "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", which SwiftPM checks"},{"type":"text","text":" "},{"type":"text","text":"against the checksum in the package’s manifest."}],"type":"paragraph"},{"text":"Register the wallet","level":3,"anchor":"Register-the-wallet","type":"heading"},{"inlineContent":[{"type":"text","text":"Issuers’ Authorization Servers know the wallet as an OAuth client: a"},{"type":"text","text":" "},{"type":"text","text":"client ID, and a redirect URI the app opens when the holder returns from"},{"type":"text","text":" "},{"type":"text","text":"the issuer’s pages. Register a private-use URI scheme for it, in the"},{"type":"text","text":" "},{"type":"text","text":"app’s Info.plist ("},{"type":"codeVoice","code":"CFBundleURLTypes"},{"type":"text","text":"), and pass the URL the app receives"},{"type":"text","text":" "},{"type":"text","text":"to the issuance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The wallet trusts only what chains to the roots you give it, as PEM"},{"type":"text","text":" "},{"type":"text","text":"certificates: "},{"type":"codeVoice","code":"issuerRoots"},{"type":"text","text":" for credentials, and "},{"type":"codeVoice","code":"verifierRoots"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the Verifiers it answers. A Credential Offer’s issuer isn’t trusted just"},{"type":"text","text":" "},{"type":"text","text":"because it sent the offer."}],"type":"paragraph"},{"text":"Provide the keys and the storage","level":3,"anchor":"Provide-the-keys-and-the-storage","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true},{"type":"text","text":" keeps every key in the Secure Enclave. A holder"},{"type":"text","text":" "},{"type":"text","text":"key — the one a credential copy is bound to — signs when presenting, and"},{"type":"text","text":" "},{"type":"text","text":"the Credential Request’s proof when receiving or refreshing. By default"},{"type":"text","text":" "},{"type":"text","text":"it asks for Face ID, Touch ID or the passcode each time: add an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":" to the app’s Info.plist, or iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead. "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","isActive":true},{"type":"text","text":" describes the trade-off."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","isActive":true},{"type":"text","text":" keeps each credential as a file with complete"},{"type":"text","text":" "},{"type":"text","text":"data protection, out of backups: a credential is useless without its"},{"type":"text","text":" "},{"type":"text","text":"holder key, which can’t leave this device. An app with a document"},{"type":"text","text":" "},{"type":"text","text":"provider extension keeps both in places the extension can read too; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true},{"type":"text","text":". The app and the"},{"type":"text","text":" "},{"type":"text","text":"extension then share one store: a store of your own implements"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/compareAndSwap(id:expected:record:)","isActive":true},{"type":"text","text":" atomically"},{"type":"text","text":" "},{"type":"text","text":"across both processes, as "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","isActive":true},{"type":"text","text":" does with a file"},{"type":"text","text":" "},{"type":"text","text":"lock."}],"type":"paragraph"},{"text":"Implement the Wallet Provider","level":3,"anchor":"Implement-the-Wallet-Provider","type":"heading"},{"inlineContent":[{"type":"text","text":"Issuers following HAIP accept only a wallet its Wallet Provider has"},{"type":"text","text":" "},{"type":"text","text":"attested: a Wallet Attestation for the wallet’s instance key, and a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the keys a credential will be bound to. Your backend"},{"type":"text","text":" "},{"type":"text","text":"issues them; the app passes the keys and returns its answers. A Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation request also names the issuance’s instance key, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"walletAttestation"},{"type":"text","text":" attested first, so your backend can give the Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation that key’s status. A real Wallet Provider attests only"},{"type":"text","text":" "},{"type":"text","text":"after checking App Attest evidence that it’s talking to your genuine"},{"type":"text","text":" "},{"type":"text","text":"app."}],"type":"paragraph"},{"code":["import Foundation","import OID4VCWallet","","\/\/\/ Asks the app's backend for attestations. The keys are public JWKs,","\/\/\/ as JSON; the answers are compact JWTs.","struct BackendWalletProvider: WalletProvider {","    let backend: URL","","    func walletAttestation(clientID: String, instanceKey: Data) async throws -> String {","        try await post(\"wallet-attestation\", [","            \"client_id\": clientID,","            \"instance_key\": try JSONSerialization.jsonObject(with: instanceKey),","        ])","    }","","    \/\/ instanceKey is the issuance's, which walletAttestation sent first.","    func keyAttestation(instanceKey: Data, keys: [Data], nonce: String) async throws -> String {","        try await post(\"key-attestation\", [","            \"instance_key\": try JSONSerialization.jsonObject(with: instanceKey),","            \"keys\": try keys.map { try JSONSerialization.jsonObject(with: $0) },","            \"nonce\": nonce,","        ])","    }","","    private func post(_ path: String, _ body: [String: Any]) async throws -> String {","        var request = URLRequest(url: backend.appendingPathComponent(path))","        request.httpMethod = \"POST\"","        request.setValue(\"application\/json\", forHTTPHeaderField: \"Content-Type\")","        request.httpBody = try JSONSerialization.data(withJSONObject: body)","        let (data, response) = try await URLSession.shared.data(for: request)","        guard (response as? HTTPURLResponse)?.statusCode == 200 else { throw URLError(.badServerResponse) }","        return String(decoding: data, as: UTF8.self)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"URLError"},{"type":"text","text":" the provider throws reaches the wallet as a retryable"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/network","isActive":true},{"type":"text","text":" error; any other is"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/platform","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Create the wallet","level":3,"anchor":"Create-the-wallet","type":"heading"},{"inlineContent":[{"type":"text","text":"Create one "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true},{"type":"text","text":" when the app starts, and keep it. Creating it"},{"type":"text","text":" "},{"type":"text","text":"makes no network requests. At launch, before anything else, sweep the"},{"type":"text","text":" "},{"type":"text","text":"Keychain of keys no credential uses: an issuance the app quit in the"},{"type":"text","text":" "},{"type":"text","text":"middle of leaves its keys behind. Each trust role whose roots you set"},{"type":"text","text":" "},{"type":"text","text":"needs a revocation choice: checked against the CRLs your app fetches"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/revocation","isActive":true},{"type":"text","text":"), or declined"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/noRevocationCheck","isActive":true},{"type":"text","text":"); see "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/\/ The app's wallet, created once at launch.","@MainActor","final class AppWallet {","    let wallet: Wallet","    private let keys: KeychainKeyStore","","    init(clientID: String, redirectURI: String, issuerRoots: String, verifierRoots: String, crls: String, provider: URL) throws {","        let configuration = WalletConfiguration(","            clientID: clientID,","            redirectURI: redirectURI,","            issuerRoots: issuerRoots,","            verifierRoots: verifierRoots,","            crls: crls,","            revocation: [.issuer, .status, .verifier])","        keys = KeychainKeyStore()","        wallet = try Wallet(","            configuration: configuration,","            keyStore: keys,","            credentialStore: try FileCredentialStore.standard(),","            provider: BackendWalletProvider(backend: provider))","    }","","    \/\/\/ Run once at launch, before any issuance.","    func start() async throws {","        try await wallet.sweepOrphanedKeys(in: keys)","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Ship the release build","level":3,"anchor":"Ship-the-release-build","type":"heading"},{"inlineContent":[{"type":"text","text":"The package links the release build of "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":". OID4VCgo’s own tests"},{"type":"text","text":" "},{"type":"text","text":"use a test build with an in-process issuer and Verifier that a shipped"},{"type":"text","text":" "},{"type":"text","text":"app must never have; "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","isActive":true},{"type":"text","text":" says which one an app has,"},{"type":"text","text":" "},{"type":"text","text":"so it can refuse to run on the test build."}],"type":"paragraph"},{"text":"Next steps","level":3,"anchor":"Next-steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingFromALink"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/IntegrationChecklist"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","modules":[{"name":"OID4VCWallet"}],"role":"article","title":"Getting started"},"kind":"article","abstract":[{"text":"Add the package, give the wallet its keys, its storage and a Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Provider, and create it at launch.","type":"text"}],"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/RegisteredInstance":{"role":"symbol","title":"RegisteredInstance","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegisteredInstance","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/RegisteredInstance","url":"\/documentation\/oid4vcwallet\/registeredinstance","kind":"symbol","navigatorTitle":[{"text":"RegisteredInstance","kind":"identifier"}],"abstract":[{"text":"The wallet’s registration with a Wallet Provider: its registration","type":"text"},{"text":" ","type":"text"},{"text":"key, its App Attest key and the instance ID the provider gave for","type":"text"},{"text":" ","type":"text"},{"text":"them (WALLET_PROVIDER.md, ","type":"text"},{"code":"POST \/v1\/instances","type":"codeVoice"},{"text":"). One per installation.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore":{"role":"symbol","type":"topic","title":"CredentialStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CredentialStore"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","url":"\/documentation\/oid4vcwallet\/credentialstore","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CredentialStore"}],"abstract":[{"type":"text","text":"The wallet’s credentials, as opaque records kept by ID under the"},{"type":"text","text":" "},{"type":"text","text":"platform’s data protection. "},{"type":"codeVoice","code":"FileCredentialStore"},{"type":"text","text":" is the standard one."}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/CredentialStore/compareAndSwap(id:expected:record:)":{"role":"symbol","title":"compareAndSwap(id:expected:record:)","type":"topic","required":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore\/compareAndSwap(id:expected:record:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compareAndSwap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"expected","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"record","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/oid4vcwallet\/credentialstore\/compareandswap(id:expected:record:)","kind":"symbol","abstract":[{"text":"Replaces the record under ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"record","type":"codeVoice"},{"text":" — or deletes it, when","type":"text"},{"text":" ","type":"text"},{"code":"record","type":"codeVoice"},{"text":" is nil — only if what’s stored there is, byte for byte,","type":"text"},{"text":" ","type":"text"},{"code":"expected","type":"codeVoice"},{"text":" (nil: no record), and returns what was stored before,","type":"text"},{"text":" ","type":"text"},{"text":"whether or not it replaced it.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/InstanceRegistry":{"role":"symbol","title":"InstanceRegistry","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InstanceRegistry","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InstanceRegistry","url":"\/documentation\/oid4vcwallet\/instanceregistry","kind":"symbol","navigatorTitle":[{"text":"InstanceRegistry","kind":"identifier"}],"abstract":[{"text":"Where ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HttpWalletProvider","type":"reference"},{"text":" keeps the wallet’s registration, so the","type":"text"},{"text":" ","type":"text"},{"text":"installation registers once, across launches. An instance ID isn’t a","type":"text"},{"text":" ","type":"text"},{"text":"secret — every request naming it is signed with the registration key","type":"text"},{"text":" ","type":"text"},{"text":"— but losing it loses the instance: the wallet then registers again,","type":"text"},{"text":" ","type":"text"},{"text":"with a new registration key and App Attest key, and the instance keys","type":"text"},{"text":" ","type":"text"},{"text":"the lost instance recorded can’t be attested again.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileInstanceRegistry","type":"reference"},{"text":" keeps it in a file;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/InMemoryInstanceRegistry","type":"reference"},{"text":" is for tests.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/AppAttestKeyLostError":{"role":"symbol","type":"topic","title":"AppAttestKeyLostError","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppAttestKeyLostError","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/AppAttestKeyLostError","url":"\/documentation\/oid4vcwallet\/appattestkeylosterror","kind":"symbol","navigatorTitle":[{"text":"AppAttestKeyLostError","kind":"identifier"}],"abstract":[{"text":"The App Attest key the registration names is gone — the app was","type":"text"},{"text":" ","type":"text"},{"text":"restored from a backup, or reinstalled — so it can’t assert: the","type":"text"},{"text":" ","type":"text"},{"text":"installation must register again.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletProviderRefusedError":{"role":"symbol","type":"topic","title":"WalletProviderRefusedError","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletProviderRefusedError","kind":"identifier"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError","url":"\/documentation\/oid4vcwallet\/walletproviderrefusederror","kind":"symbol","navigatorTitle":[{"text":"WalletProviderRefusedError","kind":"identifier"}],"abstract":[{"text":"The Wallet Provider refused a request with one of the protocol’s","type":"text"},{"text":" ","type":"text"},{"text":"errors, or answered other than the protocol documents (a redirect, a","type":"text"},{"text":" ","type":"text"},{"text":"path it doesn’t serve). It reaches the wallet as ","type":"text"},{"code":".platform","type":"codeVoice"},{"text":", its","type":"text"},{"text":" ","type":"text"},{"text":"message naming ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProviderRefusedError\/error","type":"reference"},{"text":".","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet":{"role":"symbol","title":