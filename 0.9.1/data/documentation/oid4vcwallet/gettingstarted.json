{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"kind":"article","abstract":[{"text":"Add the package, give the wallet its keys, its storage and a Wallet","type":"text"},{"text":" ","type":"text"},{"text":"Provider, and create it at launch.","type":"text"}],"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/HandlingErrors","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GoingToProduction","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider"],"title":"Essentials","generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/GettingStarted"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true},{"type":"text","text":" needs four things from your app: its configuration, a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","isActive":true},{"type":"text","text":" for its keys, a "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialStore","isActive":true},{"type":"text","text":" for what it holds, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletProvider","isActive":true},{"type":"text","text":" that attests it to issuers. The package has standard"},{"type":"text","text":" "},{"type":"text","text":"stores for the first two; the Wallet Provider is your backend."}]},{"text":"Add the package","anchor":"Add-the-package","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add OID4VCWallet to your app with Swift Package Manager, from"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift"},{"type":"text","text":". In "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":[".package(url: \"https:\/\/github.com\/IDFoundry\/OID4VCgo-wallet-swift\", from: \"0.9.0\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package links a binary framework, "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", which SwiftPM checks"},{"type":"text","text":" "},{"type":"text","text":"against the checksum in the package’s manifest."}]},{"text":"Register the wallet","anchor":"Register-the-wallet","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Issuers’ Authorization Servers know the wallet as an OAuth client: a"},{"type":"text","text":" "},{"type":"text","text":"client ID, and a redirect URI the app opens when the holder returns from"},{"type":"text","text":" "},{"type":"text","text":"the issuer’s pages. Register a private-use URI scheme for it, in the"},{"type":"text","text":" "},{"type":"text","text":"app’s Info.plist ("},{"type":"codeVoice","code":"CFBundleURLTypes"},{"type":"text","text":"), and pass the URL the app receives"},{"type":"text","text":" "},{"type":"text","text":"to the issuance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet trusts only what chains to the roots you give it, as PEM"},{"type":"text","text":" "},{"type":"text","text":"certificates: "},{"type":"codeVoice","code":"issuerRoots"},{"type":"text","text":" for credentials, and "},{"type":"codeVoice","code":"verifierRoots"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"the Verifiers it answers. A Credential Offer’s issuer isn’t trusted just"},{"type":"text","text":" "},{"type":"text","text":"because it sent the offer."}]},{"text":"Provide the keys and the storage","anchor":"Provide-the-keys-and-the-storage","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore","isActive":true},{"type":"text","text":" keeps every key in the Secure Enclave. A holder"},{"type":"text","text":" "},{"type":"text","text":"key — the one a credential is bound to — signs only when presenting, and"},{"type":"text","text":" "},{"type":"text","text":"by default asks for Face ID, Touch ID or the passcode first: add an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSFaceIDUsageDescription"},{"type":"text","text":" to the app’s Info.plist, or iOS asks for the"},{"type":"text","text":" "},{"type":"text","text":"passcode instead."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore","isActive":true},{"type":"text","text":" keeps each credential as a file with complete"},{"type":"text","text":" "},{"type":"text","text":"data protection, out of backups: a credential is useless without its"},{"type":"text","text":" "},{"type":"text","text":"holder key, which can’t leave this device. An app with a document"},{"type":"text","text":" "},{"type":"text","text":"provider extension keeps both in places the extension can read too; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup","isActive":true},{"type":"text","text":"."}]},{"text":"Implement the Wallet Provider","anchor":"Implement-the-Wallet-Provider","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Issuers following HAIP accept only a wallet its Wallet Provider has"},{"type":"text","text":" "},{"type":"text","text":"attested: a Wallet Attestation for the wallet’s instance key, and a Key"},{"type":"text","text":" "},{"type":"text","text":"Attestation for the keys a credential will be bound to. Your backend"},{"type":"text","text":" "},{"type":"text","text":"issues them; the app passes the keys and returns its answers. A real"},{"type":"text","text":" "},{"type":"text","text":"Wallet Provider attests only after checking App Attest evidence that"},{"type":"text","text":" "},{"type":"text","text":"it’s talking to your genuine app."}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import OID4VCWallet","","\/\/\/ Asks the app's backend for attestations. The keys are public JWKs,","\/\/\/ as JSON; the answers are compact JWTs.","struct BackendWalletProvider: WalletProvider {","    let backend: URL","","    func walletAttestation(clientID: String, instanceKey: Data) async throws -> String {","        try await post(\"wallet-attestation\", [","            \"client_id\": clientID,","            \"instance_key\": try JSONSerialization.jsonObject(with: instanceKey),","        ])","    }","","    func keyAttestation(keys: [Data], nonce: String) async throws -> String {","        try await post(\"key-attestation\", [","            \"keys\": try keys.map { try JSONSerialization.jsonObject(with: $0) },","            \"nonce\": nonce,","        ])","    }","","    private func post(_ path: String, _ body: [String: Any]) async throws -> String {","        var request = URLRequest(url: backend.appending(path: path))","        request.httpMethod = \"POST\"","        request.setValue(\"application\/json\", forHTTPHeaderField: \"Content-Type\")","        request.httpBody = try JSONSerialization.data(withJSONObject: body)","        let (data, response) = try await URLSession.shared.data(for: request)","        guard (response as? HTTPURLResponse)?.statusCode == 200 else { throw URLError(.badServerResponse) }","        return String(decoding: data, as: UTF8.self)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"URLError"},{"type":"text","text":" the provider throws reaches the wallet as a retryable"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/network","isActive":true},{"type":"text","text":" error; any other is"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/platform","isActive":true},{"type":"text","text":"."}]},{"text":"Create the wallet","anchor":"Create-the-wallet","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create one "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","isActive":true},{"type":"text","text":" when the app starts, and keep it. Creating it"},{"type":"text","text":" "},{"type":"text","text":"makes no network requests. At launch, before anything else, sweep the"},{"type":"text","text":" "},{"type":"text","text":"Keychain of keys no credential uses: an issuance the app quit in the"},{"type":"text","text":" "},{"type":"text","text":"middle of leaves its keys behind."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ The app's wallet, created once at launch.","@MainActor","final class AppWallet {","    let wallet: Wallet","    private let keys: KeychainKeyStore","","    init(clientID: String, redirectURI: String, issuerRoots: String, verifierRoots: String, provider: URL) throws {","        let configuration = WalletConfiguration(","            clientID: clientID,","            redirectURI: redirectURI,","            issuerRoots: issuerRoots,","            verifierRoots: verifierRoots)","        keys = KeychainKeyStore()","        wallet = try Wallet(","            configuration: configuration,","            keyStore: keys,","            credentialStore: try FileCredentialStore.standard(),","            provider: BackendWalletProvider(backend: provider))","    }","","    \/\/\/ Run once at launch, before any issuance.","    func start() async throws {","        try await wallet.sweepOrphanedKeys(in: keys)","    }","}"]},{"type":"heading","anchor":"Ship-the-release-build","level":3,"text":"Ship the release build"},{"inlineContent":[{"text":"The package links the release build of ","type":"text"},{"code":"Mobile","type":"codeVoice"},{"text":". OID4VCgo’s own tests","type":"text"},{"text":" ","type":"text"},{"text":"use a test build with an in-process issuer and Verifier that a shipped","type":"text"},{"text":" ","type":"text"},{"text":"app must never have; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/OID4VC\/isTestBuild","type":"reference"},{"type":"text","text":" says which one an app has,"},{"type":"text","text":" "},{"type":"text","text":"so it can refuse to run on the test build."}],"type":"paragraph"},{"type":"heading","anchor":"Next-steps","level":3,"text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OI