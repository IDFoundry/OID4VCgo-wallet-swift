ext"},{"text":" ","type":"text"},{"text":"while the device is unlocked — and kept out of backups by default,","type":"text"},{"text":" ","type":"text"},{"text":"since a credential is useless without its holder key, which is in","type":"text"},{"text":" ","type":"text"},{"text":"this device’s Secure Enclave and can’t be restored elsewhere.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/FileCredentialStore/inAppGroup(_:options:)":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)","title":"inAppGroup(_:options:)","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inAppGroup","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Options","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC7OptionsV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"FileCredentialStore","preciseIdentifier":"s:12OID4VCWallet19FileCredentialStoreC","kind":"typeIdentifier"}],"url":"\/documentation\/oid4vcwallet\/filecredentialstore\/inappgroup(_:options:)","abstract":[{"text":"A store in the app group ","type":"text"},{"code":"identifier","type":"codeVoice"},{"text":"’s container","type":"text"},{"text":" ","type":"text"},{"text":"(Library\/Application Support\/credentials there), which the app and","type":"text"},{"text":" ","type":"text"},{"text":"its extensions listing the group in their","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.security.application-groups","type":"codeVoice"},{"text":" entitlement share.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWall