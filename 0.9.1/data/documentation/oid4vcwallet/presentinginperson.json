: show"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"qrCode"},{"type":"text","text":". In "},{"type":"codeVoice","code":"modes"},{"type":"text","text":", both by default, it advertises for a"},{"type":"text","text":" "},{"type":"text","text":"reader (peripheral server mode) and scans for one (central client"},{"type":"text","text":" "},{"type":"text","text":"mode) until a reader connects either way; a reader offered both"},{"text":" ","type":"text"},{"text":"should choose central client mode. Bluetooth failures end it as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".failed"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"ProximityError"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityTimeouts":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","title":"ProximityTimeouts","type":"topic","kind":"symbol","navigatorTitle":[{"text":"ProximityTimeouts","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProximityTimeouts","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/proximitytimeouts","abstract":[{"text":"How long an in-person session waits (ISO\/IEC 18013-5 recommends at","type":"text"},{"text":" ","type":"text"},{"text":"least 30 seconds from engagement to the request, §8.2.3, and 300","type":"text"},{"text":" ","type":"text"},{"text":"seconds of inactivity before ending a session, §9.1.1.4).","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/cancel()":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/cancel()","title":"cancel()","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identif