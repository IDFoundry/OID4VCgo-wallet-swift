{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingInPerson"},"kind":"article","metadata":{"modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article","role":"article","title":"Presenting in person"},"abstract":[{"type":"text","text":"Share an mdoc with a reader nearby over Bluetooth, or be the reader,"},{"type":"text","text":" "},{"type":"text","text":"with ISO\/IEC 18013-5 device retrieval."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In person, the holder shows a QR code and the reader scans it: the"},{"type":"text","text":" "},{"type":"text","text":"code carries the holder’s ephemeral key and how to reach it over"},{"type":"text","text":" "},{"type":"text","text":"Bluetooth LE. The two devices then exchange encrypted messages over"},{"type":"text","text":" "},{"type":"text","text":"GATT. The package carries the Bluetooth side itself: your app shows or"},{"type":"text","text":" "},{"type":"text","text":"scans the QR code, follows the session’s states, and asks the holder."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both sides need "},{"type":"codeVoice","code":"NSBluetoothAlwaysUsageDescription"},{"type":"text","text":" in the app’s"},{"type":"text","text":" "},{"type":"text","text":"Info.plist. Keep the app in the foreground during a session: neither"},{"type":"text","text":" "},{"type":"text","text":"side keeps one going while the app is suspended. A session answers one"},{"type":"text","text":" "},{"type":"text","text":"request. Bluetooth failures are "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError","type":"reference","isActive":true},{"type":"text","text":"s; protocol failures"},{"type":"text","text":" "},{"type":"text","text":"are "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","type":"reference","isActive":true},{"type":"text","text":"s."}]},{"type":"heading","level":3,"text":"Share as the holder","anchor":"Share-as-the-holder"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startProximityPresentation(timeouts:modes:)","type":"reference","isActive":true},{"type":"text","text":" returns a"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","type":"reference","isActive":true},{"type":"text","text":" whose "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode","type":"reference","isActive":true},{"type":"text","text":" you"},{"type":"text","text":" "},{"type":"text","text":"show. It offers both "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityBLEMode","type":"reference","isActive":true},{"type":"text","text":"s by default: it advertises"},{"type":"text","text":" "},{"type":"text","text":"for the reader and scans for it at once, until a reader connects"},{"type":"text","text":" "},{"type":"text","text":"either way (a reader offered both should connect in central client"},{"type":"text","text":" "},{"type":"text","text":"mode). Pass "},{"type":"codeVoice","code":"modes"},{"type":"text","text":" to offer one. It then reports"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)","type":"reference","isActive":true},{"type":"text","text":" with who is asking"},{"type":"text","text":" "},{"type":"text","text":"and what: ask the holder, then respond or decline."}]},{"type":"codeListing","code":["import Foundation","import OID4VCWallet","","\/\/\/ What the holder agreed to share: a requested document, the held","\/\/\/ mdoc to answer it with, and the elements to disclose.","struct InPersonAnswer {","    let document: Int","    let credentialID: String","    let elements: [MdocPresentation.Element]","}","","\/\/\/ Shares an mdoc in person. `showQRCode` displays the code; `consent`","\/\/\/ shows the reader's request and returns the holder's answer, or nil","\/\/\/ to decline. Returns whether the copy shared had been seen by another","\/\/\/ Verifier, or nil when nothing was shared.","func shareInPerson(wallet: Wallet, showQRCode: (String) -> Void,","                   consent: (ProximityPresentation.Request) async -> InPersonAnswer?) async throws -> Bool? {","    let session = try wallet.startProximityPresentation()","    showQRCode(session.qrCode)","    for await state in session.states {","        switch state {","        case .requestReceived(let request):","            guard let answer = await consent(request) else {","                await session.decline()","                return nil","            }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            return try await session.respond(document: answer.document, credentialID: answer.credentialID,","                                             elements: answer.elements)","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/Request\/reader","type":"reference","isActive":true},{"type":"text","text":" on the consent screen. A"},{"type":"text","text":" "},{"type":"text","text":"reader that signs its request (reader authentication) is named, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity\/Status-swift.enum\/trusted","type":"reference","isActive":true},{"type":"text","text":" when its certificate chains"},{"type":"text","text":" "},{"type":"text","text":"to "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","type":"reference","isActive":true},{"type":"text","text":". An unsigned request could"},{"type":"text","text":" "},{"type":"text","text":"come from anyone who scanned the code. As over the Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","type":"reference","isActive":true},{"type":"text","text":" ends a session"},{"type":"text","text":" "},{"type":"text","text":"from any other reader before the holder sees it."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/cancel()","type":"reference","isActive":true},{"type":"text","text":" ends a session at any point, as the"},{"type":"text","text":" "},{"type":"text","text":"holder leaves the screen, say. "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","type":"reference","isActive":true},{"type":"text","text":" sets how long it"},{"type":"text","text":" "},{"type":"text","text":"waits: by default 60 seconds for a reader to connect, 30 for its"},{"type":"text","text":" "},{"type":"text","text":"request, and 300 for the holder to decide."}]},{"type":"heading","level":3,"text":"Read as the verifier","anchor":"Read-as-the-verifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader","type":"reference","isActive":true},{"type":"text","text":" needs no "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet","type":"reference","isActive":true},{"type":"text","text":": give it the IACAs whose"},{"type":"text","text":" "},{"type":"text","text":"mdocs it accepts, and, to sign its requests so holders see who is"},{"type":"text","text":" "},{"type":"text","text":"asking, a key in a "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeyStore","type":"reference","isActive":true},{"type":"text","text":" and its certificate chain, with the"},{"type":"text","text":" "},{"type":"text","text":"reader authentication extended key usage"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderConfiguration","type":"reference","isActive":true},{"type":"text","text":"). "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReader\/start(qrCode:docType:elements:timeouts:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"takes the holder’s QR code and what to ask for."}]},{"type":"codeListing","code":["\/\/\/ Reads an mDL's name and portrait from the holder whose QR code was","\/\/\/ scanned. Returns the verified mdoc, or nil if the holder declined.","func readInPerson(qrCode: String, issuerRoots: String) async throws -> VerifiedMdoc? {","    let reader = try ProximityReader(configuration: ProximityReaderConfiguration(issuerRoots: issuerRoots))","    let session = try reader.start(qrCode: qrCode, docType: \"org.iso.18013.5.1.mDL\",","                                   elements: [\"org.iso.18013.5.1\": [\"given_name\", \"family_name\", \"portrait\"]])","    for await state in session.states {","        switch state {","        case .verified(let mdoc):","            return mdoc","        case .failed(let error):","            throw error","        case let state where state.isFinal:","            return nil","        default:","            continue","        }","    }","    return nil","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc","type":"reference","isActive":true},{"type":"text","text":" carries the disclosed elements, the document signer"},{"type":"text","text":" "},{"type":"text","text":"and the IACA it chains to, and its validity. Its"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/VerifiedMdoc\/statusList","type":"reference","isActive":true},{"type":"text","text":" is unchecked: check it before relying on"},{"type":"text","text":" "},{"type":"text","text":"the document."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/oid4vcwallet\/presentinginperson"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"seeAlsoSections":[{"title":"Presenting in person","identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityReaderIdentity","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityTimeouts","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityError"],"generated":true,"anchor":"Presenting-in-person"}],"hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/State-swift.enum/requestReceived(_:)":{"type":"topic","url":"\/documentation\/oid4vcwallet\/proximitypresentation\/state-swift.enum\/requestreceived(_:)","title":"ProximityPresentation.State.requestReceived(_:)","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/State-swift.enum\/requestReceived(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"requestReceived"},{"kind":"text","text":"("},{"pr