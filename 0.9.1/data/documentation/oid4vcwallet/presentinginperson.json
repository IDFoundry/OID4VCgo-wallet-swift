},{"type":"text","text":"every such request is shown by its origin."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/mdocreaderroots"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError","title":"WalletError","type":"topic","kind":"symbol","navigatorTitle":[{"text":"WalletError","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WalletError","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/walleterror","abstract":[{"text":"An error from OID4VCgo: a stable ","type":"text"},{"code":"code","type":"codeVoice"},{"text":", the issuer’s, Authorization","type":"text"},{"text":" ","type":"text"},{"text":"Server’s or Verifier’s own error code when it gave one","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"protocolError","type":"codeVoice"},{"text":"), and a message for logs: it never carries personal","type":"text"},{"text":" ","type":"text"},{"text":"data, a remote party’s own description, a URL’s path or query, or","type":"text"},{"text":" ","type":"text"},{"text":"control characters. ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"a sentence fit to show the holder; ","type":"text"},{"code":"isRetryable","type":"codeVoice"},{"text":" says whether trying","type":"text"},{"text":" ","type":"text"},{"text":"the same step again may succeed.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/ProximityPresentation/qrCode":{"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ProximityPresentation\/qrCode","title":"qrCode","type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"qrCode","kind":"identifier"},{"text":": ","kind":"text"},{"prec