llet the"},{"type":"text","text":" "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" scope, or the authorization fails."}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/requestrefresh"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"title":"refreshCredential(id:)","kind":"symbol","role":"symbol","abstract":[{"text":"Replaces a ","type":"text"},{"type":"codeVoice","code":"refreshable"},{"text":" credential’s copies with a fresh batch,","type":"text"},{"text":" ","type":"text"},{"text":"each bound to a new attested key, without the holder (OpenID4VCI","type":"text"},{"text":" ","type":"text"},{"text":"1.0 §13.5). Use it when ","type":"text"},{"type":"codeVoice","code":"copiesLeft"},{"text":" runs low. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"text":" when it can’t be refreshed:","type":"text"},{"text":" ","type":"text"},{"text":"receive it again from a new offer.","type":"text"}],"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV","kind":"typeIdentifier"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deleteCredential(id:)":{"type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/deletecredential(id:)","title":"deleteCredential(id:)","abstract":[{"text":"Deletes a credential and its holder keys, and its refresh grant","type":"text"},{"text":" ","type":"text"},{"text":"once no other credential uses it, first revoking the refresh token","type":"text"},{"text":" ","type":"text"},{"text":"at the Authorization Server, best effort.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"deleteCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet":{"role":"collection","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet","title":"OID4VCWallet","type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet","abstract":[{"text":"Receive verifiable credentials and present them from an iOS app: over","type":"text"},{"text":" ","type":"text"},{"text":"OpenID4VCI and OpenID4VP under HAIP, to Safari’s Digital Credentials","type":"text"},{"text":" ","type":"text"},{"text":"API, and in person over Bluetooth.","type":"text"}]},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletError/Code-swift.struct/reissueRequired":{"type":"topic","url":"\/documentation\/oid4vcwallet\/walleterror\/code-swift.struct\/reissuerequired","title":"reissueRequired","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reissueRequired","kind":"identifier"},{"text":": ","kind":"text"},{"text