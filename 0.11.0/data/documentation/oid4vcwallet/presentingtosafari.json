{"variants":[{"paths":["\/documentation\/oid4vcwallet\/presentingtosafari"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"From iOS 26, a page in Safari can ask for an ISO mdoc with the W3C"},{"type":"text","text":" "},{"type":"text","text":"Digital Credentials API, using the "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":" protocol (ISO\/IEC TS"},{"type":"text","text":" "},{"type":"text","text":"18013-7 Annex C). iOS offers the apps that registered a matching"},{"type":"text","text":" "},{"type":"text","text":"document, and shows the chosen app’s document provider extension for"},{"type":"text","text":" "},{"type":"text","text":"the holder’s consent. The extension answers through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startMdocPresentation(requestData:origin:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/respond(document:credentialID:elements:)","isActive":true},{"type":"text","text":"; the"},{"type":"text","text":" "},{"type":"text","text":"response goes back through Safari, encrypted to the page, with no"},{"type":"text","text":" "},{"type":"text","text":"network request from the wallet."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Safari sends only "},{"type":"codeVoice","code":"org-iso-mdoc"},{"type":"text","text":", not OpenID4VP, and on iOS only:"},{"type":"text","text":" "},{"type":"text","text":"Safari on macOS has no document providers."}]},{"level":3,"type":"heading","text":"Set up the app and its extension","anchor":"Set-up-the-app-and-its-extension"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The extension:"}]},{"text":" a target whose Info.plist names the extension","type":"text"},{"text":" ","type":"text"},{"text":"point ","type":"text"},{"type":"codeVoice","code":"com.apple.identity-document-services.document-provider-ui"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"EXAppExtensionAttributes"},{"text":", ","type":"text"},{"type":"codeVoice","code":"EXExtensionPointIdentifier"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The capability:"}]},{"text":" Digital Credentials API – Mobile Document","type":"text"},{"text":" ","type":"text"},{"text":"Provider, on both the app’s and the extension’s App IDs, with the","type":"text"},{"text":" ","type":"text"},{"text":"doctypes the app presents in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.identity-document-services.document-provider.mobile-document-types"},{"text":" ","type":"text"},{"text":"entitlement. Apple allows only certain doctypes, such as the ISO mDL","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and Photo ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shared storage:"}]},{"type":"text","text":" the extension is another process, so the app"},{"type":"text","text":" "},{"type":"text","text":"keeps its credentials in an App Group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/FileCredentialStore\/inAppGroup(_:options:)"},{"type":"text","text":"), and its holder keys in"},{"type":"text","text":" "},{"type":"text","text":"a Keychain access group both list"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/KeychainKeyStore\/Options-swift.struct\/holderAccessGroup"},{"type":"text","text":"). Instance and DPoP"},{"type":"text","text":" "},{"type":"text","text":"keys stay in the app’s own group: the extension presents, but doesn’t"},{"type":"text","text":" "},{"type":"text","text":"receive. The app saves its configuration where the extension can"},{"type":"text","text":" "},{"type":"text","text":"read it too."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import IdentityDocumentServices","import IdentityDocumentServicesUI","import OID4VCWallet","import SwiftUI","","\/\/\/ What the app and its document provider extension share.","enum SharedWallet {","    static let appGroup = \"group.com.example.wallet\"","    static let holderKeyGroup = \"ABCDE12345.com.example.wallet.shared\"","","    \/\/\/ The configuration the app saved in the group's defaults.","    static func configuration() throws -> WalletConfiguration {","        guard let data = UserDefaults(suiteName: appGroup)?.data(forKey: \"configuration\") else { throw CocoaError(.fileNoSuchFile) }","        return try JSONDecoder().decode(WalletConfiguration.self, from: data)","    }","","    \/\/\/ The wallet over the shared store and holder keys: the app passes","    \/\/\/ its Wallet Provider; the extension, which only presents, nil.","    static func open(provider: (any WalletProvider)?) throws -> Wallet {","        try Wallet(","            configuration: try configuration(),","            keyStore: KeychainKeyStore(options: .init(holderAccessGroup: holderKeyGroup)),","            credentialStore: try FileCredentialStore.inAppGroup(appGroup),","            provider: provider)","    }","}"]},{"type":"heading","anchor":"Register-the-documents","level":3,"text":"Register the documents"},{"type":"paragraph","inlineContent":[{"text":"iOS offers the app only for documents it registered. Whenever the","type":"text"},{"text":" ","type":"text"},{"text":"credentials change, register each presentable mdoc and remove the rest.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"supportedAuthorityKeyIdentifiers"},{"type":"text","text":" names the reader CAs, by subject key"},{"type":"text","text":" "},{"type":"text","text":"identifier, whose requests the document answers."}]},{"type":"codeListing","syntax":"swift","code":["\/\/\/ Registers the held mdocs of `doctypes` with iOS, so Safari offers the","\/\/\/ app for them. The first registration asks the holder to allow it.","@available(iOS 26.0, *)","func registerDocuments(_ credentials: [CredentialSummary], doctypes: Set<String>, readerAuthorities: [Data]) async throws {","    let store = IdentityDocumentProviderRegistrationStore()","    for registration in try await store.registrations {","        try await store.removeRegistration(forDocumentIdentifier: registration.documentIdentifier)","    }","    for credential in credentials where credential.format == \"mso_mdoc\" && doctypes.contains(credential.doctype ?? \"\") {","        try await store.addRegistration(MobileDocumentRegistration(","            mobileDocumentType: credential.doctype ?? \"\",","            supportedAuthorityKeyIdentifiers: readerAuthorities,","            documentIdentifier: credential.id,","            invalidationDate: credential.validUntil))","    }","}"]},{"anchor":"Answer-in-the-extension","type":"heading","level":3,"text":"Answer in the extension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS hands the extension the request in two stages. First,"},{"type":"text","text":" "},{"type":"codeVoice","code":"ISO18013MobileDocumentRequestContext.request"},{"type":"text","text":" describes what’s asked,"},{"type":"text","text":" "},{"type":"text","text":"for the consent screen: show it with the website’s origin, and the"},{"type":"text","text":" "},{"type":"text","text":"candidates from "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/mdocCandidates(origin:)","isActive":true,"type":"reference"},{"text":". Only when the","type":"text"},{"text":" ","type":"text"},{"text":"holder shares does iOS release the request itself, to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sendResponse"},{"text":"‘s closure. Validate it there, parse it, check it’s what","type":"text"},{"text":" ","type":"text"},{"text":"the holder was shown, and answer.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@available(iOS 26.0, *)","struct WalletDocumentProvider: IdentityDocumentProvider {","    var body: some IdentityDocumentRequestScene {","        ISO18013MobileDocumentRequestScene { context in","            ConsentView(context: context)","        }","    }","","    func performRegistrationUpdates() async {}","}","","struct RequestChanged: Error {}","","@available(iOS 26.0, *)","struct ConsentView: View {","    let context: ISO18013MobileDocumentRequestContext","","    var body: some View {","        Button(\"Share\") { Task { try await share(credentialID: nil) } }","    }","","    \/\/\/ Shares the held mdoc `credentialID` (the first candidate when","    \/\/\/ nil) for the request's first document.","    func share(credentialID: String?) async throws {","        guard let originURL = context.requestingWebsiteOrigin,","              let origin = MdocPresentation.origin(of: originURL) else { return }","        let wallet = try SharedWallet.open(provider: nil)","        try await context.sendResponse { raw in","            _ = try IdentityDocumentWebPresentmentRawRequestValidator()","                .validateISO18013MobileDocumentRequest(raw.requestData, origin: originURL)","            let presentation = try await wallet.startMdocPresentation(requestData: raw.requestData, origin: origin)","            guard let document = presentation.request.documents.first,","                  let chosen = credentialID ?? document.credentials.first?.id else { throw RequestChanged() }","            \/\/ The holder key signs now: Face ID, if the key store asks.","            let response = try await presentation.respond(document: 0, credentialID: chosen, elements: document.elements)","            return ISO18013MobileDocumentResponse(responseData: response.response)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A real consent screen compares the released request with what it","type":"text"},{"text":" ","type":"text"},{"text":"showed — the same document, elements and reader — and refuses one that","type":"text"},{"text":" ","type":"text"},{"text":"changed. The demo wallet’s ","type":"text"},{"type":"codeVoice","code":"DocumentProvider"},{"text":" target does this in full.","type":"text"}]},{"anchor":"Name-the-reader","type":"heading","level":3,"text":"Name the reader"},{"type":"paragraph","inlineContent":[{"text":"A page’s request may be signed by its reader’s certificate (ISO\/IEC","type":"text"},{"text":" ","type":"text"},{"text":"18013-5 reader authentication). When the certificate chains to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRoots","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Request-swift.struct\/reader","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"names it; otherwise show only the website’s origin.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/mdocReaderRequireEKU","isActive":true,"type":"reference"},{"text":" accepts only certificates","type":"text"},{"text":" ","type":"text"},{"text":"issued for readers, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requireTrustedMdocReader","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"refuses requests from any other reader before the holder sees them.","type":"text"}]},{"anchor":"Warn-of-linkable-presentations","type":"heading","level":3,"text":"Warn of linkable presentations"},{"type":"paragraph","inlineContent":[{"text":"Each candidate’s ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/linkableHere","isActive":true,"type":"reference"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"text":"presenting it would hand this website a copy another website has seen,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation\/Response\/linkable","isActive":true,"type":"reference"},{"text":" whether it did. The","type":"text"},{"text":" ","type":"text"},{"text":"extension doesn’t refresh used-up copies: have the app do it when it","type":"text"},{"text":" ","type":"text"},{"text":"next becomes active, after listing its credentials again.","type":"text"}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/MdocPresentation"],"title":"Presenting to Safari","generated":true,"anchor":"Presenting-to-Safari"}],"abstract":[{"type":"text","text":"Answer a web page’s request for an mdoc over the Digital Credentials"},{"type":"text","text":" "},{"type":"text","text":"API, as an iOS document provider."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/PresentingToSafari"},"metadata":{"modules":[{"name":"OID4VCWallet"}],"role":"article","title":"Presenting to Safari","roleHe