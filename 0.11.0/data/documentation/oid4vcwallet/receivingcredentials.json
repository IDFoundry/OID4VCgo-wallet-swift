{"variants":[{"paths":["\/documentation\/oid4vcwallet\/receivingcredentials"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An issuer offers credentials with an ","type":"text"},{"type":"codeVoice","code":"openid-credential-offer:\/\/"},{"text":" link,","type":"text"},{"text":" ","type":"text"},{"text":"as a QR code or a link the holder opens. Register the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"openid-credential-offer"},{"text":" URL scheme in the app’s Info.plist so links","type":"text"},{"text":" ","type":"text"},{"text":"open the app, and hand the link to ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/startIssuance(offer:)","isActive":true,"type":"reference"},{"text":". It","type":"text"},{"text":" ","type":"text"},{"text":"resolves the offer and the issuer’s metadata, and returns an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","isActive":true,"type":"reference"},{"text":" whose ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/offer","isActive":true,"type":"reference"},{"text":" you show the holder: who is","type":"text"},{"text":" ","type":"text"},{"text":"offering what.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The offer names one of two grants:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authorization code:"}]},{"type":"text","text":" the holder signs in at the issuer’s pages, in"},{"type":"text","text":" "},{"type":"text","text":"a browser, which redirects back to the wallet’s redirect URI."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Pre-authorized code:"}]},{"type":"text","text":" the issuer has already authenticated the"},{"type":"text","text":" "},{"type":"text","text":"holder, and may ask for a PIN it sent them separately"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer\/txCode-swift.property","type":"reference","isActive":true},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Either way, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true,"type":"reference"},{"text":" then requests, checks and","type":"text"},{"text":" ","type":"text"},{"text":"stores the credentials, and ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/close()","isActive":true,"type":"reference"},{"text":" ends the issuance.","type":"text"}]},{"anchor":"Receive-an-offer","type":"heading","level":3,"text":"Receive an offer"},{"syntax":"swift","type":"codeListing","code":["import AuthenticationServices","import Foundation","import OID4VCWallet","","\/\/\/ Receives the credentials an offer link offers. `askPIN` asks the","\/\/\/ holder for the PIN the issuer sent, or returns nil if they cancel;","\/\/\/ `signIn` opens the issuer's page and returns the redirect back.","func receive(offerLink: String, wallet: Wallet,","             askPIN: (Offer.TxCode?) async -> String?,","             signIn: (URL) async throws -> URL) async throws -> Issuance.Result? {","    let issuance = try await wallet.startIssuance(offer: offerLink)","    switch issuance.offer.grant {","    case .preAuthorizedCode:","        while true {","            guard let pin = await askPIN(issuance.offer.txCode) else {","                try await issuance.close()","                return nil","            }","            do {","                try await issuance.redeemPreAuthorizedCode(pin: pin)","                break","            } catch let error as WalletError where error.isRetryable {","                continue \/\/ A wrong PIN (invalid_grant): ask again.","            }","        }","    case .authorizationCode:","        let url = try await issuance.beginAuthorization()","        let redirect = try await signIn(url)","        try await issuance.completeAuthorization(redirect: redirect)","    }","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/Result","isActive":true,"type":"reference"},{"text":" lists what arrived, what the issuer deferred, and","type":"text"},{"text":" ","type":"text"},{"text":"what failed: one credential the issuer refused doesn’t hold up the","type":"text"},{"text":" ","type":"text"},{"text":"rest.","type":"text"}]},{"anchor":"Open-the-issuers-page","type":"heading","level":3,"text":"Open the issuer’s page"},{"type":"paragraph","inlineContent":[{"text":"Open the authorization URL in an ","type":"text"},{"type":"codeVoice","code":"ASWebAuthenticationSession"},{"text":", with the","type":"text"},{"text":" ","type":"text"},{"text":"redirect URI’s scheme as its callback scheme. An ephemeral session","type":"text"},{"text":" ","type":"text"},{"text":"keeps the issuer’s cookies out of Safari’s.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Opens issuers' authorization pages over `window`.","@MainActor","final class IssuerSignIn: NSObject, ASWebAuthenticationPresentationContextProviding {","    private let window: ASPresentationAnchor","    private let callbackScheme: String","","    init(window: ASPresentationAnchor, callbackScheme: String) {","        self.window = window","        self.callbackScheme = callbackScheme","    }","","    nonisolated func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {","        MainActor.assumeIsolated { window }","    }","","    \/\/\/ The issuer's redirect back, or `ASWebAuthenticationSessionError`","    \/\/\/ `.canceledLogin` when the holder closes the page.","    func open(_ url: URL) async throws -> URL {","        try await withCheckedThrowingContinuation { continuation in","            let session = ASWebAuthenticationSession(url: url, callbackURLScheme: callbackScheme) { redirect, error in","                if let redirect {","                    continuation.resume(returning: redirect)","                } else {","                    continuation.resume(throwing: error ?? URLError(.unknown))","                }","            }","            session.presentationContextProvider = self","            session.prefersEphemeralWebBrowserSession = true","            session.start()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"If the holder closes the page, the offer stays open:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/beginAuthorization()","isActive":true,"type":"reference"},{"text":" can begin again. A redirect is used","type":"text"},{"text":" ","type":"text"},{"text":"up by ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/completeAuthorization(redirect:)","isActive":true,"type":"reference"},{"text":" whatever happens,","type":"text"},{"text":" ","type":"text"},{"text":"so after a failure there, begin again rather than retrying it.","type":"text"}]},{"anchor":"Resume-after-the-app-is-killed","type":"heading","level":3,"text":"Resume after the app is killed"},{"type":"paragraph","inlineContent":[{"text":"iOS can terminate the app while the holder is at the issuer’s pages.","type":"text"},{"text":" ","type":"text"},{"text":"The authorization in progress is kept in the credential store, so when","type":"text"},{"text":" ","type":"text"},{"text":"the redirect arrives at a relaunched app, ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/resumeIssuance(redirect:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"completes it and returns an issuance ready for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance\/requestCredentials()","isActive":true,"type":"reference"},{"text":". Handle every redirect this way: in","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI, from ","type":"text"},{"type":"codeVoice","code":"onOpenURL"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Completes an authorization the app was killed during, from the","\/\/\/ redirect iOS delivers to the relaunched app.","func resume(redirect: URL, wallet: Wallet) async throws -> Issuance.Result {","    let issuance = try await wallet.resumeIssuance(redirect: redirect)","    let result = try await issuance.requestCredentials()","    try await issuance.close()","    return result","}"]},{"type":"paragraph","inlineContent":[{"text":"A redirect that matches no authorization in progress throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/notFound","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"anchor":"Wait-for-a-deferred-credential","type":"heading","level":3,"text":"Wait for a deferred credential"},{"type":"paragraph","inlineContent":[{"text":"An issuer may issue a credential later, after a review, say. It’s kept","type":"text"},{"text":" ","type":"text"},{"text":"in the credential store until it’s issued, denied or abandoned, so it","type":"text"},{"text":" ","type":"text"},{"text":"survives the app quitting. ","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","isActive":true,"type":"reference"},{"text":" lists them","type":"text"},{"text":" ","type":"text"},{"text":"without network requests; poll each at the interval the issuer asks for.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Polls a deferred credential until the issuer settles it: the","\/\/\/ credential, or a `.credentialDenied` error.","func waitFor(_ deferred: DeferredCredential, wallet: Wallet) async throws -> CredentialSummary {","    var interval = deferred.intervalSeconds","    while true {","        try await Task.sleep(for: .seconds(max(interval, 5)))","        switch try await wallet.pollDeferred(id: deferred.id) {","        case .issued(let credential): return credential","        case .pending(let next): interval = next","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/abandonDeferred(id:)","isActive":true,"type":"reference"},{"text":" gives one up, deleting its keys: once","type":"text"},{"text":" ","type":"text"},{"text":"its access token has expired, say (","type":"text"},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"anchor":"Look-after-held-credentials","type":"heading","level":3,"text":"Look after held credentials"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credentials()","type":"reference","isActive":true},{"type":"text","text":" lists them, and "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns one with its claims, for display. "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/display","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"carries the issuer’s names, logos and colours, in the holder’s"},{"type":"text","text":" "},{"type":"text","text":"language ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","type":"reference","isActive":true},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/checkStatus(id:)","type":"reference","isActive":true},{"type":"text","text":" checks revocation against the issuer’s"},{"type":"text","text":" "},{"type":"text","text":"status list, which covers many credentials, so the issuer can’t tell"},{"type":"text","text":" "},{"type":"text","text":"which one is checked."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each credential arrives as a batch of copies, each bound to its own"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","type":"reference","isActive":true},{"type":"text","text":"), so presentations can’t be"},{"type":"text","text":" "},{"type":"text","text":"linked by the credential. When "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/CredentialSummary\/copiesLeft","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reaches zero, "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","type":"reference","isActive":true},{"type":"text","text":" replaces them without"},{"type":"text","text":" "},{"type":"text","text":"the holder, if the issuance kept a refresh token"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/requestRefresh","type":"reference","isActive":true},{"type":"text","text":"). Otherwise it throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletError\/Code-swift.struct\/reissueRequired","type":"reference","isActive":true},{"type":"text","text":": receive the credential again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deleteCredential(id:)","type":"reference","isActive":true},{"type":"text","text":" deletes a credential and its keys,"},{"type":"text","text":" "},{"type":"text","text":"revoking its refresh token at the issuer."}]}]}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Issuance","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredStatus"],"title":"Receiving credentials","generated":true,"anchor":"Receiving-credentials"}],"abstract":[{"type":"text","text":"Receive the credentials a Credential Offer offers, with either grant,"},{"type":"text","text":" "},{"type":"text","text":"and look after them once they’re held."}],"identifier":{"url":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/ReceivingCredentials","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Receiving credentials","modules":[{"name":"OID4VCWallet"}],"roleHeading":"Article"},"references":{"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/locales":{"kind":"symbol","title":"locales","type":"topic","abstract":[{"type":"text","text":"The holder’s preferred languages (BCP 47, most preferred first),"},{"type":"text","text":" "},{"type":"text","text":"for issuers’ display metadata. "},{"type":"codeVoice","code":"Locale.preferredLanguages"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"usual choice."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"locales","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/locales","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/locales","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential":{"navigatorTitle":[{"kind":"identifier","text":"DeferredCredential"}],"kind":"symbol","title":"DeferredCredential","type":"topic","abstract":[{"text":"A credential an issuer will issue later (OpenID4VCI 1.0 §9). It’s","type":"text"},{"text":" ","type":"text"},{"text":"kept in the credential store until it’s issued, denied or abandoned,","type":"text"},{"text":" ","type":"text"},{"text":"so it survives the app quitting.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeferredCredential"}],"url":"\/documentation\/oid4vcwallet\/deferredcredential","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/deferredCredentials()":{"url":"\/documentation\/oid4vcwallet\/wallet\/deferredcredentials()","abstract":[{"type":"text","text":"The credentials issuers have deferred and not yet settled, oldest"},{"type":"text","text":" "},{"type":"text","text":"first — including ones from before the app last quit. Makes no"},{"type":"text","text":" "},{"type":"text","text":"network calls: poll each at its interval."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deferredCredentials","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"DeferredCredential","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet18DeferredCredentialV"},{"text":"]","kind":"text"}],"title":"deferredCredentials()","kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/deferredCredentials()","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/WalletConfiguration/batchSize":{"kind":"symbol","title":"batchSize","type":"topic","abstract":[{"type":"text","text":"How many copies of each credential to request when an issuer"},{"type":"text","text":" "},{"type":"text","text":"offers batches, each bound to its own key, so each presentation"},{"type":"text","text":" "},{"type":"text","text":"can use one no Verifier has seen. 0 means the SDK’s default (5);"},{"type":"text","text":" "},{"type":"text","text":"it’s capped at the issuer’s batch size."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/oid4vcwallet\/walletconfiguration\/batchsize","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/WalletConfiguration\/batchSize","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/refreshCredential(id:)":{"url":"\/documentation\/oid4vcwallet\/wallet\/refreshcredential(id:)","abstract":[{"type":"text","text":"Replaces a "},{"type":"codeVoice","code":"refreshable"},{"type":"text","text":" credential’s copies with a fresh batch,"},{"type":"text","text":" "},{"type":"text","text":"each bound to a new attested key, without the holder (OpenID4VCI"},{"type":"text","text":" "},{"type":"text","text":"1.0 §13.5). Use it when "},{"type":"codeVoice","code":"copiesLeft"},{"type":"text","text":" runs low. Throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"WalletError.Code.reissueRequired"},{"type":"text","text":" when it can’t be refreshed:"},{"type":"text","text":" "},{"type":"text","text":"receive it again from a new offer."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refreshCredential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Refreshed","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet6WalletC9RefreshedV"}],"title":"refreshCredential(id:)","kind":"symbol","type":"topic","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/refreshCredential(id:)","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Offer":{"navigatorTitle":[{"text":"Offer","kind":"identifier"}],"kind":"symbol","title":"Offer","type":"topic","abstract":[{"text":"What a Credential Offer offers.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Offer","kind":"identifier"}],"url":"\/documentation\/oid4vcwallet\/offer","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Offer","role":"symbol"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/DeferredCredential/accessTokenExpiresAt":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessTokenExpiresAt","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"When the access token it’s polled with expires, if the issuer"},{"type":"text","text":" "},{"type":"text","text":"said: after it, polls fail and it can only be abandoned."}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/DeferredCredential\/accessTokenExpiresAt","type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/deferredcredential\/accesstokenexpiresat","title":"accessTokenExpiresAt"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Wallet/credential(id:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"credential","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"CredentialDetail","kind":"typeIdentifier","preciseIdentifier":"s:12OID4VCWallet16CredentialDetailV"}],"abstract":[{"text":"One credential with its claims.","type":"text"}],"role":"symbol","identifier":"doc:\/\/oid4vcwallet.OID4VCWallet\/documentation\/OID4VCWallet\/Wallet\/credential(id:)","type":"topic","kind":"symbol","url":"\/documentation\/oid4vcwallet\/wallet\/credential(id:)","title":"credential(id:)"},"doc://oid4vcwallet.OID4VCWallet/documentation/OID4VCWallet/Issuance":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issuance"}],"abstract":[{"type":"text","text":"Receives one offer’s credentials: show "},{"type":"codeVoice","code":"offer"},{"type":"text","text":"; then"},{"type":"text","text":" "},{"type":"codeVoice","code":"beginAuthorization()"},{"type":"text","text":", open the URL in ASWebAuthentic